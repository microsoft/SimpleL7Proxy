    .identity-access-change, .identity-access-config-change { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 0.4rem; color: #596c96; font-size: 0.78rem; }
    .identity-access-config-change { margin-top: 0.85rem; padding: 0.65rem 0.75rem; border-radius: 8px; background: rgba(255, 204, 0, 0.12); }
    .identity-access-panel > .configuration-fields-grid, .identity-access-panel > fieldset > .configuration-fields-grid { margin-top: 1rem; }

    @@media (max-width: 767.98px) {
        .identity-access-editor { grid-template-columns: minmax(0, 1fr); min-height: 0; }
        .identity-access-tabs { flex-direction: row; overflow-x: auto; margin-bottom: 1rem; padding: 0 0 0.75rem; border-right: 0; border-bottom: 1px solid #dce5f2; }
        .identity-access-tabs button { width: auto; flex: 0 0 auto; white-space: nowrap; }
        .identity-access-panel { padding-left: 0; }
        .identity-access-panel-heading { flex-direction: column; }
        .identity-access-form-row { grid-template-columns: minmax(0, 1fr); gap: 0.4rem; }
    }
</style>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public IReadOnlyList<AppConfigurationScaffoldSetting> ConfigurationSettings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public ProfileConfigurationEditor.EditorState ProfileFileState { get; set; } = new();

    private string _selectedView = "overview";
    private bool _showPrimaryKey;
    private bool _showSecondaryKey;
    private readonly List<JsonObject> _appEntries = new();
    private readonly HashSet<JsonObject> _appSelected = new(ReferenceEqualityComparer.Instance);
    private string _appSavedJson = "[]";
    private string _appSearch = string.Empty;
    private bool _appEditingIsNew;
    private string _appEditDescription = string.Empty;
    private string _appEditText = string.Empty;
    private JsonObject? _appEditing;
    private string? _appError;
    private bool _appBusy;
    private bool _appLoaded;
    private readonly List<JsonObject> _suspendedEntries = new();
    private readonly HashSet<JsonObject> _suspendedSelected = new(ReferenceEqualityComparer.Instance);
    private string _suspendedSavedJson = "[]";
    private string _suspendedSearch = string.Empty;
    private bool _suspendedEditingIsNew;
    private string _suspendedEditReason = string.Empty;
    private string _suspendedEditSuspendedAt = string.Empty;
    private string _suspendedEditUserId = string.Empty;
    private JsonObject? _suspendedEditing;
    private string? _suspendedError;
    private bool _suspendedBusy;
    private bool _suspendedLoaded;

    private AppConfigurationScaffoldSetting? AuthenticationConfigSetting => FindSetting("Auth:Config");

    private bool AuthenticationEnabled =>
        bool.TryParse(AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "enabled"), out var enabled) && enabled;

    private string AuthenticationMode => NormalizeAuthenticationMode(
        AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "mode"));

    private string AuthenticationHeader =>
        AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "header") is { Length: > 0 } header
            ? header
            : "S7P-KEY";

    private bool UsesApiKey => AuthenticationMode is "key" or "mixed";
    private bool UsesOAuth => AuthenticationMode is "oauth2" or "mixed";
    private string OAuthIssuer => AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "issuer");
    private string OAuthAudience => AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "audience", "audiences");
    private string OAuthMetadataAddress => AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "metadataaddress");
    private string OAuthClockSkewMinutes =>
        AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "clockskewminutes") is { Length: > 0 } value ? value : "1";

    public static string AuthenticationSummary(IEnumerable<AppConfigurationScaffoldSetting> settings)
    {
        var rawConfig = FindSetting(settings, "Auth:Config")?.DraftValue;
        if (!bool.TryParse(AuthenticationConfigValue(rawConfig, "enabled"), out var enabled) || !enabled)
        {
            return "Disabled";
        }

        return NormalizeAuthenticationMode(AuthenticationConfigValue(rawConfig, "mode")) switch
        {
            "oauth2" => "OAuth token",
            "mixed" => "Mixed",
            "none" => "Disabled",
            _ => "API key",
        };
    }

    public static bool ApplicationAccessEnabled(IEnumerable<AppConfigurationScaffoldSetting> settings) =>
        bool.TryParse(FindSetting(settings, "Auth:ValidateAppIDEnabled")?.DraftValue, out var enabled) && enabled;

    public static bool UserProfilesEnabled(IEnumerable<AppConfigurationScaffoldSetting> settings) =>
        bool.TryParse(FindSetting(settings, "User:UseProfiles")?.DraftValue, out var enabled) && enabled;

    public static string SuspendedUsersSummary(IEnumerable<AppConfigurationScaffoldSetting> settings) =>
        string.IsNullOrWhiteSpace(FindSetting(settings, "SuspendedUser:ConfigUrl")?.DraftValue)
            ? "Not configured"
            : "Configured";

    private void SelectView(string view) => _selectedView = view;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_selectedView == "applications" && !_appLoaded && !_appBusy)
        {
            await LoadAppIdsAsync();
            StateHasChanged();
        }
        if (_selectedView == "suspended" && !_suspendedLoaded && !_suspendedBusy)
        {
            await LoadSuspendedUsersAsync();
            StateHasChanged();
        }
    }

    private AppConfigurationScaffoldSetting? AppConfigUrlSetting => ConfigurationSettings.FirstOrDefault(item =>
        item.Name.Equals("Auth:ConfigUrl", StringComparison.OrdinalIgnoreCase)
        || item.Key.EndsWith("Profiles:Auth:ConfigUrl", StringComparison.OrdinalIgnoreCase));

    private string AppIdFieldName =>
        FindSetting("Auth:ValidateFieldName")?.DraftValue is { Length: > 0 } configuredName ? configuredName : "authAppID";

    private IEnumerable<JsonObject> VisibleAppEntries =>
        string.IsNullOrWhiteSpace(_appSearch)
            ? _appEntries
            : _appEntries.Where(entry => AppIdOf(entry).Contains(_appSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool AppIdsDirty => ExportAppIds() != _appSavedJson;

    private string AppIdOf(JsonObject entry) =>
        entry[AppIdFieldName] is JsonValue value && value.TryGetValue<string>(out var id) ? id : string.Empty;

    private string ExportAppIds()
    {
        var array = new JsonArray();
        foreach (var entry in _appEntries)
        {
            array.Add(entry.DeepClone());
        }
        return array.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
    }

    private static List<JsonObject> ParseAppIdsArray(string json)
    {
        var array = JsonNode.Parse(json) as JsonArray ?? throw new InvalidDataException("The application list must be a JSON array.");
        var entries = new List<JsonObject>();
        foreach (var node in array)
        {
            entries.Add(node as JsonObject ?? throw new InvalidDataException("Each application entry must be a JSON object."));
        }
        return entries;
    }

    private static (string Host, string Container, string Blob)? ParseAppIdsBlobUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || !Uri.TryCreate(url, UriKind.Absolute, out var uri) || uri.Scheme != "azblob")
        {
            return null;
        }
        var parts = uri.AbsolutePath.Trim('/').Split('/', 2);
        return parts.Length == 2 ? (uri.Host, parts[0], parts[1]) : null;
    }

    private async Task LoadAppIdsAsync()
    {
        _appLoaded = true;
        var url = AppConfigUrlSetting?.DraftValue;
        if (string.IsNullOrWhiteSpace(url) || url == "-")
        {
            return;
        }
        var target = ParseAppIdsBlobUrl(url);
        if (target is null)
        {
            _appError = $"Application list URL must be azblob://account/container/blob. Found: {url}";
            return;
        }

        _appBusy = true;
        try
        {
            var blob = StorageBackend.CreateBlobContainerClient(target.Value.Host, target.Value.Container).GetBlobClient(target.Value.Blob);
            var entries = ParseAppIdsArray((await blob.DownloadContentAsync()).Value.Content.ToString());
            _appEntries.Clear();
            _appEntries.AddRange(entries);
            _appSavedJson = ExportAppIds();
        }
        catch (Azure.RequestFailedException exception) when (exception.Status == 404)
        {
            // A missing blob means no application list has been saved yet.
        }
        catch (Exception exception) when (exception is Azure.RequestFailedException or JsonException or InvalidDataException or InvalidOperationException)
        {
            _appError = $"Application list not loaded from {url}: {exception.Message}";
        }
        finally
        {
            _appBusy = false;
        }
    }

    private async Task SaveAppIdsAsync()
    {
        _appError = null;
        if (_appEditingIsNew)
        {
            _appError = "Finish or cancel the new application before saving.";
            return;
        }
        var setting = AppConfigUrlSetting;
        if (setting is null || string.IsNullOrWhiteSpace(setting.DraftValue) || setting.DraftValue == "-")
        {
            var account = Configuration["CompanionApp:Profiles:StorageAccountName"];
            if (string.IsNullOrWhiteSpace(account))
            {
                _appError = "Storage account was not read from CompanionApp:Profiles:StorageAccountName. The application list cannot be created.";
                return;
            }
            var containerName = Configuration["CompanionApp:Profiles:BlobContainerName"];
            if (string.IsNullOrWhiteSpace(containerName))
            {
                containerName = "profiles";
            }
            if (setting is null)
            {
                if (ConfigurationSettings is not IList<AppConfigurationScaffoldSetting> settings)
                {
                    _appError = "The application list URL was not in the loaded settings, and the settings list cannot be updated.";
                    return;
                }
                var sibling = settings.FirstOrDefault(item => item.Key.Contains(":Profiles:", StringComparison.OrdinalIgnoreCase));
                setting = new AppConfigurationScaffoldSetting(
                    "Warm:Profiles:Auth:ConfigUrl",
                    "Warm",
                    "Profiles",
                    "Auth:ConfigUrl",
                    sibling?.Label ?? string.Empty,
                    string.Empty) {
                    IsNew = true
                };
                settings.Add(setting);
            }
            setting.DraftValue = $"azblob://{account}/{containerName}/appids.json";
        }

        var target = ParseAppIdsBlobUrl(setting.DraftValue);
        if (target is null)
        {
            _appError = $"Application list URL must be azblob://account/container/blob. Found: {setting.DraftValue}";
            return;
        }

        _appBusy = true;
        try
        {
            var json = ExportAppIds();
            var blob = StorageBackend.CreateBlobContainerClient(target.Value.Host, target.Value.Container).GetBlobClient(target.Value.Blob);
            await blob.UploadAsync(
                BinaryData.FromString(json),
                new BlobUploadOptions
                {
                    HttpHeaders = new BlobHttpHeaders { ContentType = "application/json" }
                });
            _appSavedJson = json;
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is Azure.RequestFailedException or InvalidOperationException)
        {
            _appError = $"Application list not saved: {exception.Message}";
        }
        finally
        {
            _appBusy = false;
        }
    }

    private void CancelAppIds()
    {
        _appEntries.Clear();
        _appEntries.AddRange(ParseAppIdsArray(_appSavedJson));
        _appSelected.Clear();
        _appEditing = null;
        _appEditingIsNew = false;
        _appError = null;
    }

    private void AddAppId()
    {
        if (_appEditing is not null)
        {
            _appError = "Finish editing the current application before adding another.";
            return;
        }
        var entry = new JsonObject { [AppIdFieldName] = string.Empty, ["DateAdded"] = DateTimeOffset.UtcNow.ToString("o") };
        _appSearch = string.Empty;
        _appEntries.Insert(0, entry);
        _appEditing = entry;
        _appEditingIsNew = true;
        _appEditText = string.Empty;
        _appEditDescription = string.Empty;
        _appError = null;
    }

    private void BeginEditAppId(JsonObject entry)
    {
        if (_appEditingIsNew)
        {
            _appError = "Finish or cancel the new application before editing another.";
            return;
        }
        _appEditing = entry;
        _appEditText = AppIdOf(entry);
        _appEditDescription = entry["Description"] is JsonValue existing && existing.TryGetValue<string>(out var existingText) ? existingText : string.Empty;
        _appError = null;
    }

    private void CommitEditAppId()
    {
        var entry = _appEditing;
        if (entry is null)
        {
            return;
        }
        var id = _appEditText.Trim();
        _appError = ValidateAppId(id, entry);
        if (_appError is not null)
        {
            return;
        }
        entry[AppIdFieldName] = id;
        var description = _appEditDescription.Trim();
        if (description.Length > 0)
        {
            entry["Description"] = description;
        }
        else
        {
            entry.Remove("Description");
        }
        _appEditing = null;
        _appEditingIsNew = false;
    }

    private void RemoveAppEntries(IReadOnlyCollection<JsonObject> entries)
    {
        _appEntries.RemoveAll(entry => entries.Contains(entry));
        _appSelected.ExceptWith(entries);
        if (_appEditing is not null && entries.Contains(_appEditing))
        {
            _appEditing = null;
            _appEditingIsNew = false;
        }
    }

    private void SetAppSelected(JsonObject entry, bool selected)
    {
        if (selected)
        {
            _appSelected.Add(entry);
        }
        else
        {
            _appSelected.Remove(entry);
        }
    }

    private string? ValidateAppId(string id, JsonObject? current)
    {
        if (id.Length == 0)
        {
            return "Enter an application ID.";
        }
        return _appEntries.Any(entry => !ReferenceEquals(entry, current) && AppIdOf(entry).Equals(id, StringComparison.OrdinalIgnoreCase))
            ? $"Application ID '{id}' already exists."
            : null;
    }

    private AppConfigurationScaffoldSetting? SuspendedConfigUrlSetting => ConfigurationSettings.FirstOrDefault(item =>
        item.Name.Equals("SuspendedUser:ConfigUrl", StringComparison.OrdinalIgnoreCase)
        || item.Key.EndsWith("Profiles:SuspendedUser:ConfigUrl", StringComparison.OrdinalIgnoreCase));

    private string SuspendedUserIdFieldName =>
        FindSetting("Profiles:User:IDFieldName")?.DraftValue is { Length: > 0 } configuredName ? configuredName : "userId";

    private IEnumerable<JsonObject> VisibleSuspendedEntries =>
        string.IsNullOrWhiteSpace(_suspendedSearch)
            ? _suspendedEntries
            : _suspendedEntries.Where(entry => FieldOf(entry, SuspendedUserIdFieldName).Contains(_suspendedSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private bool SuspendedUsersDirty => ExportSuspendedUsers() != _suspendedSavedJson;

    private static string FieldOf(JsonObject entry, string name) =>
        entry[name] is JsonValue value && value.TryGetValue<string>(out var text) ? text : string.Empty;

    private string ExportSuspendedUsers()
    {
        var array = new JsonArray();
        foreach (var entry in _suspendedEntries)
        {
            array.Add(entry.DeepClone());
        }
        return array.ToJsonString(new JsonSerializerOptions { WriteIndented = true });
    }

    private async Task LoadSuspendedUsersAsync()
    {
        _suspendedLoaded = true;
        var url = SuspendedConfigUrlSetting?.DraftValue;
        if (string.IsNullOrWhiteSpace(url) || url == "-")
        {
            return;
        }
        var target = ParseAppIdsBlobUrl(url);
        if (target is null)
        {
            _suspendedError = $"Suspended user list URL must be azblob://account/container/blob. Found: {url}";
            return;
        }

        _suspendedBusy = true;
        try
        {
            var blob = StorageBackend.CreateBlobContainerClient(target.Value.Host, target.Value.Container).GetBlobClient(target.Value.Blob);
            var entries = ParseAppIdsArray((await blob.DownloadContentAsync()).Value.Content.ToString());
            _suspendedEntries.Clear();
            _suspendedEntries.AddRange(entries);
            _suspendedSavedJson = ExportSuspendedUsers();
        }
        catch (Azure.RequestFailedException exception) when (exception.Status == 404)
        {
            // A missing blob means no suspended user list has been saved yet.
        }
        catch (Exception exception) when (exception is Azure.RequestFailedException or JsonException or InvalidDataException or InvalidOperationException)
        {
            _suspendedError = $"Suspended user list not loaded from {url}: {exception.Message}";
        }
        finally
        {
            _suspendedBusy = false;
        }
    }

    private async Task SaveSuspendedUsersAsync()
    {
        _suspendedError = null;
        if (_suspendedEditingIsNew)
        {
            _suspendedError = "Finish or cancel the new suspended user before saving.";
            return;
        }
        var setting = SuspendedConfigUrlSetting;
        if (setting is null || string.IsNullOrWhiteSpace(setting.DraftValue) || setting.DraftValue == "-")
        {
            var account = Configuration["CompanionApp:Profiles:StorageAccountName"];
            if (string.IsNullOrWhiteSpace(account))
            {
                _suspendedError = "Storage account was not read from CompanionApp:Profiles:StorageAccountName. The suspended user list cannot be created.";
                return;
            }
            var containerName = Configuration["CompanionApp:Profiles:BlobContainerName"];
            if (string.IsNullOrWhiteSpace(containerName))
            {
                containerName = "profiles";
            }
            if (setting is null)
            {
                if (ConfigurationSettings is not IList<AppConfigurationScaffoldSetting> settings)
                {
                    _suspendedError = "The suspended user list URL was not in the loaded settings, and the settings list cannot be updated.";
                    return;
                }
                var sibling = settings.FirstOrDefault(item => item.Key.Contains(":Profiles:", StringComparison.OrdinalIgnoreCase));
                setting = new AppConfigurationScaffoldSetting(
                    "Warm:Profiles:SuspendedUser:ConfigUrl",
                    "Warm",
                    "Profiles",
                    "SuspendedUser:ConfigUrl",
                    sibling?.Label ?? string.Empty,
                    string.Empty) {
                    IsNew = true
                };
                settings.Add(setting);
            }
            setting.DraftValue = $"azblob://{account}/{containerName}/suspended.json";
        }

        var target = ParseAppIdsBlobUrl(setting.DraftValue);
        if (target is null)
        {
            _suspendedError = $"Suspended user list URL must be azblob://account/container/blob. Found: {setting.DraftValue}";
            return;
        }

        _suspendedBusy = true;
        try
        {
            var json = ExportSuspendedUsers();
            var blob = StorageBackend.CreateBlobContainerClient(target.Value.Host, target.Value.Container).GetBlobClient(target.Value.Blob);
            await blob.UploadAsync(
                BinaryData.FromString(json),
                new BlobUploadOptions
                {
                    HttpHeaders = new BlobHttpHeaders { ContentType = "application/json" }
                });
            _suspendedSavedJson = json;
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is Azure.RequestFailedException or InvalidOperationException)
        {
            _suspendedError = $"Suspended user list not saved: {exception.Message}";
        }
        finally
        {
            _suspendedBusy = false;
        }
    }

    private void CancelSuspendedUsers()
    {
        _suspendedEntries.Clear();
        _suspendedEntries.AddRange(ParseAppIdsArray(_suspendedSavedJson));
        _suspendedSelected.Clear();
        _suspendedEditing = null;
        _suspendedEditingIsNew = false;
        _suspendedError = null;
    }

    private void AddSuspendedUser()
    {
        if (_suspendedEditing is not null)
        {
            _suspendedError = "Finish editing the current suspended user before adding another.";
            return;
        }
        var entry = new JsonObject { [SuspendedUserIdFieldName] = string.Empty };
        _suspendedSearch = string.Empty;
        _suspendedEntries.Insert(0, entry);
        _suspendedEditing = entry;
        _suspendedEditingIsNew = true;
        _suspendedEditUserId = string.Empty;
        _suspendedEditReason = string.Empty;
        _suspendedEditSuspendedAt = string.Empty;
        _suspendedError = null;
    }

    private void BeginEditSuspendedUser(JsonObject entry)
    {
        if (_suspendedEditingIsNew)
        {
            _suspendedError = "Finish or cancel the new suspended user before editing another.";
            return;
        }
        _suspendedEditing = entry;
        _suspendedEditUserId = FieldOf(entry, SuspendedUserIdFieldName);
        _suspendedEditReason = FieldOf(entry, "Reason");
        _suspendedEditSuspendedAt = FieldOf(entry, "SuspendedAt");
        _suspendedError = null;
    }

    private void CommitEditSuspendedUser()
    {
        var entry = _suspendedEditing;
        if (entry is null)
        {
            return;
        }
        var id = _suspendedEditUserId.Trim();
        _suspendedError = ValidateSuspendedUserId(id, entry);
        if (_suspendedError is not null)
        {
            return;
        }
        var suspendedAt = _suspendedEditSuspendedAt.Trim();
        if (suspendedAt.Length > 0)
        {
            if (!DateTimeOffset.TryParse(suspendedAt, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeUniversal, out var parsedAt))
            {
                _suspendedError = $"Suspended At must be a date and time, for example 2026-10-01T00:00:00Z. Found: {suspendedAt}";
                return;
            }
            suspendedAt = parsedAt.ToUniversalTime().ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);
        }
        var reason = _suspendedEditReason.Trim();

        entry[SuspendedUserIdFieldName] = id;
        if (reason.Length > 0)
        {
            entry["Reason"] = reason;
        }
        else
        {
            entry.Remove("Reason");
        }
        if (suspendedAt.Length > 0)
        {
            entry["SuspendedAt"] = suspendedAt;
        }
        else
        {
            entry.Remove("SuspendedAt");
        }
        _suspendedEditing = null;
        _suspendedEditingIsNew = false;
    }

    private void RemoveSuspendedEntries(IReadOnlyCollection<JsonObject> entries)
    {
        _suspendedEntries.RemoveAll(entry => entries.Contains(entry));
        _suspendedSelected.ExceptWith(entries);
        if (_suspendedEditing is not null && entries.Contains(_suspendedEditing))
        {
            _suspendedEditing = null;
            _suspendedEditingIsNew = false;
        }
    }

    private void SetSuspendedSelected(JsonObject entry, bool selected)
    {
        if (selected)
        {
            _suspendedSelected.Add(entry);
        }
        else
        {
            _suspendedSelected.Remove(entry);
        }
    }

    private string? ValidateSuspendedUserId(string id, JsonObject? current)
    {
        if (id.Length == 0)
        {
            return "Enter a user ID.";
        }
        return _suspendedEntries.Any(entry => !ReferenceEquals(entry, current) && FieldOf(entry, SuspendedUserIdFieldName).Equals(id, StringComparison.Ordinal))
            ? $"User ID '{id}' is already in the suspended list."
            : null;
    }

    private bool IsAuthenticationMode(string mode) =>
        string.Equals(AuthenticationMode, mode, StringComparison.OrdinalIgnoreCase);

    private AppConfigurationScaffoldSetting? FindSetting(string name) => FindSetting(Settings, name);

    private static AppConfigurationScaffoldSetting? FindSetting(
        IEnumerable<AppConfigurationScaffoldSetting> settings,
        string name) =>
        settings.FirstOrDefault(setting => string.Equals(setting.Name, name, StringComparison.OrdinalIgnoreCase));

    private async Task SetAuthenticationEnabledAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is true;
        if (enabled && AuthenticationMode == "none")
        {
            await UpdateAuthenticationConfigAsync(("enabled", "true"), ("mode", "key"));
            return;
        }

        await UpdateAuthenticationConfigAsync(("enabled", enabled ? "true" : "false"));
    }

    private Task SetAuthenticationModeAsync(string mode) =>
        UpdateAuthenticationConfigAsync(("mode", mode));

    private Task SetAuthenticationHeaderAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("header", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthIssuerAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("issuer", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthAudienceAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("audience", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthMetadataAddressAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("metadataaddress", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthClockSkewAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("clockskewminutes", args.Value?.ToString() ?? string.Empty));

    private async Task UpdateAuthenticationConfigAsync(params (string Key, string Value)[] updates)
    {
        if (AuthenticationConfigSetting is not { } setting)
        {
            return;
        }

        var segments = AuthenticationConfigSegments(setting.DraftValue);
        foreach (var update in updates)
        {
            SetAuthenticationConfigSegment(segments, update.Key, update.Value);
        }

        setting.DraftValue = string.Join(';', segments);
        await OnChanged.InvokeAsync();
    }

    private async Task SetBooleanSettingAsync(AppConfigurationScaffoldSetting? setting, bool enabled)
    {
        if (setting is null)
        {
            return;
        }

        setting.DraftValue = enabled ? "true" : "false";
        await OnChanged.InvokeAsync();
    }

    private async Task SetSettingValueAsync(AppConfigurationScaffoldSetting setting, string? value)
    {
        setting.DraftValue = value ?? string.Empty;
        await OnChanged.InvokeAsync();
    }

    private async Task RevertAsync(AppConfigurationScaffoldSetting setting)
    {
        setting.RevertDraft();
        await OnChanged.InvokeAsync();
    }

    private static string NormalizeAuthenticationMode(string? mode) =>
        mode?.Trim().ToLowerInvariant() switch
        {
            "oauth" or "oauth2" => "oauth2",
            "mixed" => "mixed",
            "none" => "none",
            _ => "key",
        };

    private static List<string> AuthenticationConfigSegments(string? rawConfig)
    {
        if (string.IsNullOrWhiteSpace(rawConfig))
        {
            return new List<string>();
        }

        var separator = rawConfig.Contains(';') ? ';' : ',';
        return rawConfig.Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(segment => !string.IsNullOrWhiteSpace(segment))
            .ToList();
    }

    private static string AuthenticationConfigValue(string? rawConfig, string key, params string[] aliases)
    {
        var acceptedKeys = aliases.Prepend(key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var segments = AuthenticationConfigSegments(rawConfig);
        for (var index = segments.Count - 1; index >= 0; index--)
        {
            var separatorIndex = segments[index].IndexOf('=');
            if (separatorIndex <= 0 || !acceptedKeys.Contains(segments[index][..separatorIndex].Trim()))
            {
                continue;
            }

            return segments[index][(separatorIndex + 1)..].Trim();
        }

        return string.Empty;
    }

    private static void SetAuthenticationConfigSegment(List<string> segments, string key, string value)
    {
        var acceptedKeys = key.Equals("audience", StringComparison.OrdinalIgnoreCase)
            ? new HashSet<string>(["audience", "audiences"], StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>([key], StringComparer.OrdinalIgnoreCase);
        var replacementIndex = -1;

        for (var index = 0; index < segments.Count; index++)
        {
            var separatorIndex = segments[index].IndexOf('=');
            if (separatorIndex <= 0 || !acceptedKeys.Contains(segments[index][..separatorIndex].Trim()))
            {
                continue;
            }

            if (replacementIndex < 0)
            {
                replacementIndex = index;
                segments[index] = $"{key}={value}";
            }
            else
            {
                segments.RemoveAt(index);
                index--;
            }
        }

        if (replacementIndex < 0)
        {
            segments.Add($"{key}={value}");
        }
    }
}
