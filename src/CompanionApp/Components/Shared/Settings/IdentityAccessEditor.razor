@namespace CompanionApp.Components.Shared
@using System.Text.Json
@using System.Text.Json.Nodes
@using Azure.Storage.Blobs
@using Azure.Storage.Blobs.Models
@inject IConfiguration Configuration

<div class="identity-access-editor">
    <div class="identity-access-tabs" role="tablist" aria-label="Identity and access settings" aria-orientation="vertical">
        <button id="identity-tab-overview" type="button" role="tab"
                class="@(_selectedView == "overview" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "overview" ? "true" : "false")"
                aria-controls="identity-panel-overview"
                @onclick='@(() => SelectView("overview"))'>
            <span class="bi bi-shield-check" aria-hidden="true"></span>
            <span>Authentication</span>
        </button>
        <button id="identity-tab-pr" type="button" role="tab"
                class="@(_selectedView == "pr" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "pr" ? "true" : "false")"
                aria-controls="identity-panel-pr"
                @onclick='@(() => SelectView("pr"))'>
            <span class="bi bi-arrow-repeat" aria-hidden="true"></span>
            <span>Profile Reader</span>
        </button>
        <button id="identity-tab-authentication" type="button" role="tab"
                class="@(_selectedView == "authentication" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "authentication" ? "true" : "false")"
                aria-controls="identity-panel-authentication"
                @onclick='@(() => SelectView("authentication"))'>
            <span class="bi bi-key-fill" aria-hidden="true"></span>
            <span>OldAuth</span>
        </button>
        <button id="identity-tab-applications" type="button" role="tab"
                class="@(_selectedView == "applications" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "applications" ? "true" : "false")"
                aria-controls="identity-panel-applications"
                @onclick='@(() => SelectView("applications"))'>
            <span class="bi bi-grid-fill" aria-hidden="true"></span>
            <span>Applications</span>
        </button>
        <button id="identity-tab-profiles" type="button" role="tab"
                class="@(_selectedView == "profiles" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "profiles" ? "true" : "false")"
                aria-controls="identity-panel-profiles"
                @onclick='@(() => SelectView("profiles"))'>
            <span class="bi bi-person" aria-hidden="true"></span>
            <span>oldPR</span>
        </button>
        <button id="identity-tab-profile-editor" type="button" role="tab"
                class="@(_selectedView == "profile-editor" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "profile-editor" ? "true" : "false")"
                aria-controls="identity-panel-profile-editor"
                @onclick='@(() => SelectView("profile-editor"))'>
            <span class="bi bi-person-lines-fill" aria-hidden="true"></span>
            <span>Profiles</span>
        </button>
        <button id="identity-tab-rules" type="button" role="tab"
                class="@(_selectedView == "rules" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "rules" ? "true" : "false")"
                aria-controls="identity-panel-rules"
                @onclick='@(() => SelectView("rules"))'>
            <span class="bi bi-file-earmark-ruled" aria-hidden="true"></span>
            <span>Rules</span>
        </button>
        <button id="identity-tab-suspended" type="button" role="tab"
                class="@(_selectedView == "suspended" ? "is-selected" : string.Empty)"
                aria-selected="@(_selectedView == "suspended" ? "true" : "false")"
                aria-controls="identity-panel-suspended"
                @onclick='@(() => SelectView("suspended"))'>
            <span class="bi bi-slash-circle" aria-hidden="true"></span>
            <span>Suspended Users</span>
        </button>
    </div>

    @if (_selectedView == "overview")
    {
        var overviewPrimaryKeySetting = FindSetting("Auth:Key1");
        var overviewSecondaryKeySetting = FindSetting("Auth:Key2");
        var overviewAppValidationSetting = FindSetting("Auth:ValidateAppIDEnabled");
        var overviewAppHeaderSetting = FindSetting("Auth:ValidateAppIDHeader");
        var overviewAppFieldSetting = FindSetting("Auth:ValidateFieldName");
        var overviewProfileEnabledSetting = FindSetting("User:UseProfiles");
        var overviewProfileIdSetting = FindSetting("User:IDFieldName");
        var overviewProfileHeaderSetting = FindSetting("User:ProfileHeader");
        var overviewRequireProfileSetting = FindSetting("User:ConfigRequired");
        var overviewRequireProfile = bool.TryParse(overviewRequireProfileSetting?.DraftValue, out var requireProfileValue) && requireProfileValue;
        <section id="identity-panel-overview" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-overview">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>Authentication</h3>
                    <p>Configure how callers authenticate and how identities are validated.</p>
                </div>
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Client Authentication</h4>
                        <p>Require callers to authenticate with the proxy.</p>
                    </div>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@AuthenticationEnabled"
                               disabled="@(AuthenticationConfigSetting is null)" @onchange="SetAuthenticationEnabledAsync" />
                        <span>@(AuthenticationEnabled ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
                @if (AuthenticationEnabled)
                {
                <fieldset class="identity-access-fieldset" disabled="@(!AuthenticationEnabled || AuthenticationConfigSetting is null)">
                    <legend>Authentication method</legend>
                    <div class="identity-access-method-group">
                        <label class="identity-access-method" for="identity-overview-auth-key">
                            <input id="identity-overview-auth-key" class="form-check-input" type="radio" name="identity-overview-auth-method"
                                   checked='@IsAuthenticationMode("key")'
                                   @onchange="@(() => SetAuthenticationModeAsync("key"))" />
                            <span><strong>API key</strong></span>
                        </label>
                        <label class="identity-access-method" for="identity-overview-auth-oauth">
                            <input id="identity-overview-auth-oauth" class="form-check-input" type="radio" name="identity-overview-auth-method"
                                   checked='@IsAuthenticationMode("oauth2")'
                                   @onchange="@(() => SetAuthenticationModeAsync("oauth2"))" />
                            <span><strong>OAuth token</strong></span>
                        </label>
                        <label class="identity-access-method" for="identity-overview-auth-mixed">
                            <input id="identity-overview-auth-mixed" class="form-check-input" type="radio" name="identity-overview-auth-method"
                                   checked='@IsAuthenticationMode("mixed")'
                                   @onchange="@(() => SetAuthenticationModeAsync("mixed"))" />
                            <span><strong>Mixed (API key or OAuth)</strong></span>
                        </label>
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-header">API key header name</label>
                        </div>
                        <input id="identity-overview-header" class="form-control" type="text" autocomplete="off"
                               value="@AuthenticationHeader" @oninput="SetAuthenticationHeaderAsync" />
                    </div>
                    @if (UsesApiKey)
                    {
                        @if (overviewPrimaryKeySetting is not null)
                        {
                            <div class="identity-access-form-row @(overviewPrimaryKeySetting.IsChanged ? "config-field-changed" : string.Empty)">
                                <div class="config-setting-heading">
                                    <label for="identity-overview-key1">Key 1</label>
                                    <ConfigurationHelp Section="Profiles" Topic="@overviewPrimaryKeySetting.Name" />
                                </div>
                                <div>
                                    <div class="input-group">
                                        <input id="identity-overview-key1" class="form-control" autocomplete="off"
                                               type="@(_showPrimaryKey ? "text" : "password")"
                                               @bind:get="overviewPrimaryKeySetting.DraftValue"
                                               @bind:set="@(value => SetSettingValueAsync(overviewPrimaryKeySetting, value))"
                                               @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button"
                                                aria-label="@(_showPrimaryKey ? "Hide key 1" : "Show key 1")"
                                                aria-pressed="@(_showPrimaryKey ? "true" : "false")"
                                                @onclick="@(() => _showPrimaryKey = !_showPrimaryKey)">
                                            <span class="bi @(_showPrimaryKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                    @if (overviewPrimaryKeySetting.IsChanged)
                                    {
                                        <div class="identity-access-change">
                                            <span>Current: (hidden)</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="@(() => RevertAsync(overviewPrimaryKeySetting))">Revert</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (overviewSecondaryKeySetting is not null)
                        {
                            <div class="identity-access-form-row @(overviewSecondaryKeySetting.IsChanged ? "config-field-changed" : string.Empty)">
                                <div class="config-setting-heading">
                                    <label for="identity-overview-key2">Key 2 <span>Optional</span></label>
                                    <ConfigurationHelp Section="Profiles" Topic="@overviewSecondaryKeySetting.Name" />
                                </div>
                                <div>
                                    <div class="input-group">
                                        <input id="identity-overview-key2" class="form-control" autocomplete="off"
                                               type="@(_showSecondaryKey ? "text" : "password")"
                                               @bind:get="overviewSecondaryKeySetting.DraftValue"
                                               @bind:set="@(value => SetSettingValueAsync(overviewSecondaryKeySetting, value))"
                                               @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button"
                                                aria-label="@(_showSecondaryKey ? "Hide key 2" : "Show key 2")"
                                                aria-pressed="@(_showSecondaryKey ? "true" : "false")"
                                                @onclick="@(() => _showSecondaryKey = !_showSecondaryKey)">
                                            <span class="bi @(_showSecondaryKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                    @if (overviewSecondaryKeySetting.IsChanged)
                                    {
                                        <div class="identity-access-change">
                                            <span>Current: (hidden)</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="@(() => RevertAsync(overviewSecondaryKeySetting))">Revert</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    @if (UsesOAuth)
                    {
                        @if (string.IsNullOrWhiteSpace(OAuthIssuer) || string.IsNullOrWhiteSpace(OAuthAudience))
                        {
                            <div class="alert alert-warning py-2" role="alert">
                                OAuth authentication requires an issuer and at least one audience before the configuration is saved.
                            </div>
                        }
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <div class="config-setting-heading">
                                <label for="identity-overview-oauth-header">Bearer token header</label>
                                <ConfigurationHelp Section="Profiles" Topic="Auth:Config" />
                            </div>
                            <input id="identity-overview-oauth-header" class="form-control" type="text" autocomplete="off"
                                   value="@AuthenticationHeader" @oninput="SetAuthenticationHeaderAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-issuer">Issuer URL</label>
                            <input id="identity-overview-oauth-issuer" class="form-control" type="url" autocomplete="off"
                                   value="@OAuthIssuer" @oninput="SetOAuthIssuerAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-audience">Audience</label>
                            <input id="identity-overview-oauth-audience" class="form-control" type="text" autocomplete="off"
                                   value="@OAuthAudience" @oninput="SetOAuthAudienceAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-metadata">Metadata address <span>Optional</span></label>
                            <input id="identity-overview-oauth-metadata" class="form-control" type="url" autocomplete="off"
                                   placeholder="Derived from the issuer URL"
                                   value="@OAuthMetadataAddress" @oninput="SetOAuthMetadataAddressAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-skew">Clock skew (minutes)</label>
                            <input id="identity-overview-oauth-skew" class="form-control" type="number" min="0" step="1"
                                   value="@OAuthClockSkewMinutes" @oninput="SetOAuthClockSkewAsync" />
                        </div>
                    }
                </fieldset>
                }
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Application Validation</h4>
                        <p>Validate that the caller is an approved application.</p>
                    </div>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@ApplicationAccessEnabled(Settings)"
                               disabled="@(overviewAppValidationSetting is null)"
                               @onchange="@(args => SetBooleanSettingAsync(overviewAppValidationSetting, args.Value is true))" />
                        <span>@(ApplicationAccessEnabled(Settings) ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
                @if (ApplicationAccessEnabled(Settings))
                {
                <div class="identity-access-form-grid">
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-app-header">Application ID header name</label>
                        </div>
                        <input id="identity-overview-app-header" class="form-control" type="text" autocomplete="off"
                               value="@overviewAppHeaderSetting?.DraftValue" disabled="@(overviewAppHeaderSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewAppHeaderSetting!, args.Value?.ToString()))" />
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-app-field">Application ID field name</label>
                        </div>
                        <input id="identity-overview-app-field" class="form-control" type="text" autocomplete="off"
                               value="@overviewAppFieldSetting?.DraftValue" disabled="@(overviewAppFieldSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewAppFieldSetting!, args.Value?.ToString()))" />
                    </div>
                </div>
                <div class="alert alert-info py-2" role="alert">
                    Approved application IDs are managed under the <strong>Applications</strong> tab.
                </div>
                }
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Profile Validation</h4>
                        <p>Require a user profile and map the request to a profile.</p>
                    </div>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@UserProfilesEnabled(Settings)"
                               disabled="@(overviewProfileEnabledSetting is null)"
                               @onchange="@(args => SetBooleanSettingAsync(overviewProfileEnabledSetting, args.Value is true))" />
                        <span>@(UserProfilesEnabled(Settings) ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
                @if (UserProfilesEnabled(Settings))
                {
                <div class="identity-access-form-grid">
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-profile-id">Profile identifier field name</label>
                        </div>
                        <input id="identity-overview-profile-id" class="form-control" type="text" autocomplete="off"
                               value="@overviewProfileIdSetting?.DraftValue" disabled="@(overviewProfileIdSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewProfileIdSetting!, args.Value?.ToString()))" />
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-profile-header">Profile header name</label>
                        </div>
                        <input id="identity-overview-profile-header" class="form-control" type="text" autocomplete="off"
                               value="@overviewProfileHeaderSetting?.DraftValue" disabled="@(overviewProfileHeaderSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewProfileHeaderSetting!, args.Value?.ToString()))" />
                    </div>
                </div>
                <label class="identity-access-check">
                    <input class="form-check-input" type="checkbox" checked="@overviewRequireProfile"
                           disabled="@(overviewRequireProfileSetting is null)"
                           @onchange="@(args => SetBooleanSettingAsync(overviewRequireProfileSetting, args.Value is true))" />
                    <span>
                        <strong>Require profile configuration</strong>
                        <small>Reject requests when a profile is not found.</small>
                    </span>
                </label>
                <div class="alert alert-info py-2" role="alert">
                    User profiles are managed under the <strong>Profile Reader</strong> and <strong>Profiles</strong> tabs.
                </div>
                }
            </div>
        </section>
    }
    else if (_selectedView == "pr")
    {
        var refreshIntervalSetting = FindSetting("RefreshIntervalSecs");
        var softDeleteTtlSetting = FindSetting("SoftDeleteTTLMinutes");
        var applicationsUrlSetting = FindSetting("Auth:ConfigUrl");
        var userProfilesUrlSetting = FindSetting("User:UserConfigUrl");
        var suspendedUrlSetting = FindSetting("SuspendedUser:ConfigUrl");
        <section id="identity-panel-pr" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-pr">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>Profile Reader</h3>
                    <p>Configure where identity data is loaded from and how often it is refreshed.</p>
                </div>
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Refresh Settings</h4>
                        <p>Control how often profile data is refreshed and how long to keep soft-deleted entries.</p>
                    </div>
                </div>
                <div class="identity-access-form-grid">
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-pr-refresh">Refresh interval (seconds)</label>
                        </div>
                        <input id="identity-pr-refresh" class="form-control" type="number" min="1"
                               value="@refreshIntervalSetting?.DraftValue" disabled="@(refreshIntervalSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(refreshIntervalSetting!, args.Value?.ToString()))" />
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-pr-soft-delete">Soft delete TTL (minutes)</label>
                        </div>
                        <input id="identity-pr-soft-delete" class="form-control" type="number" min="1"
                               value="@softDeleteTtlSetting?.DraftValue" disabled="@(softDeleteTtlSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(softDeleteTtlSetting!, args.Value?.ToString()))" />
                    </div>
                </div>
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Profile Data Sources</h4>
                        <p>Specify the configuration sources for applications, user profiles, and suspended users.</p>
                    </div>
                </div>
                <div class="identity-access-form-row">
                    <div class="config-setting-heading">
                        <h5>Applications</h5>
                        <label for="identity-pr-applications-url">Config URL</label>
                    </div>
                    <input id="identity-pr-applications-url" class="form-control" type="text" autocomplete="off"
                           placeholder="azblob://account/container/applications.json"
                           value="@applicationsUrlSetting?.DraftValue" disabled="@(applicationsUrlSetting is null)"
                           @oninput="@(args => SetSettingValueAsync(applicationsUrlSetting!, args.Value?.ToString()))" />
                </div>
                <div class="identity-access-form-row">
                    <div class="config-setting-heading">
                        <h5>User Profiles</h5>
                        <label for="identity-pr-profiles-url">Config URL</label>
                    </div>
                    <input id="identity-pr-profiles-url" class="form-control" type="text" autocomplete="off"
                           placeholder="azblob://account/container/profiles.json"
                           value="@userProfilesUrlSetting?.DraftValue" disabled="@(userProfilesUrlSetting is null)"
                           @oninput="@(args => SetSettingValueAsync(userProfilesUrlSetting!, args.Value?.ToString()))" />
                </div>
                <div class="identity-access-form-row">
                    <div class="config-setting-heading">
                        <h5>Suspended Users</h5>
                        <label for="identity-pr-suspended-url">Config URL</label>
                    </div>
                    <input id="identity-pr-suspended-url" class="form-control" type="text" autocomplete="off"
                           placeholder="azblob://account/container/suspended.json"
                           value="@suspendedUrlSetting?.DraftValue" disabled="@(suspendedUrlSetting is null)"
                           @oninput="@(args => SetSettingValueAsync(suspendedUrlSetting!, args.Value?.ToString()))" />
                </div>
                <div class="alert alert-info py-2 mt-3" role="alert">
                    These sources are read according to the refresh interval. The data is used by
                    <strong>Authentication</strong>, <strong>Profiles</strong>, <strong>Applications</strong>, and <strong>Suspended Users</strong>.
                </div>
            </div>
        </section>
    }
    else if (_selectedView == "authentication")
    {
        var configSetting = FindSetting("Auth:Config");
        var primaryKeySetting = FindSetting("Auth:Key1");
        var secondaryKeySetting = FindSetting("Auth:Key2");
        <section id="identity-panel-authentication" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-authentication">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>OldAuth</h3>
                    <p>Configure how clients authenticate with the proxy.</p>
                </div>
                <label class="identity-access-switch form-switch">
                    <input class="form-check-input" type="checkbox" checked="@AuthenticationEnabled"
                           disabled="@(configSetting is null)" @onchange="SetAuthenticationEnabledAsync" />
                    <span>Require authentication</span>
                </label>
            </div>
            <ConfigurationExplanation Section="Identity & Access" Topic="Authentication" />

            <fieldset class="identity-access-fieldset" disabled="@(!AuthenticationEnabled || configSetting is null)">
                <legend>Authentication method</legend>
                <label class="identity-access-method" for="identity-auth-key">
                    <input id="identity-auth-key" class="form-check-input" type="radio" name="identity-auth-method"
                           checked='@IsAuthenticationMode("key")'
                           @onchange="@(() => SetAuthenticationModeAsync("key"))" />
                    <span>
                        <strong>API key</strong>
                        <small>Clients provide a static key in the request header.</small>
                    </span>
                </label>
                <label class="identity-access-method" for="identity-auth-oauth">
                    <input id="identity-auth-oauth" class="form-check-input" type="radio" name="identity-auth-method"
                           checked='@IsAuthenticationMode("oauth2")'
                           @onchange="@(() => SetAuthenticationModeAsync("oauth2"))" />
                    <span>
                        <strong>OAuth token</strong>
                        <small>Clients provide a signed bearer token, such as one issued by Microsoft Entra ID.</small>
                    </span>
                </label>
                <label class="identity-access-method" for="identity-auth-mixed">
                    <input id="identity-auth-mixed" class="form-check-input" type="radio" name="identity-auth-method"
                           checked='@IsAuthenticationMode("mixed")'
                           @onchange="@(() => SetAuthenticationModeAsync("mixed"))" />
                    <span>
                        <strong>Mixed</strong>
                        <small>Clients can use either an API key or an OAuth token. Both settings sections are shown.</small>
                    </span>
                </label>
            </fieldset>

            @if (UsesApiKey)
            {
                <fieldset class="identity-access-fieldset" disabled="@(!AuthenticationEnabled)">
                    <legend>API key settings</legend>
                    <div class="identity-access-form-row @(configSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                        <div class="config-setting-heading">
                            <label for="identity-auth-header">API key header name</label>
                            <ConfigurationHelp Section="Profiles" Topic="Auth:Config" />
                        </div>
                        <input id="identity-auth-header" class="form-control" type="text" autocomplete="off"
                               value="@AuthenticationHeader" @oninput="SetAuthenticationHeaderAsync" />
                    </div>
                    @if (primaryKeySetting is not null)
                    {
                        <div class="identity-access-form-row @(primaryKeySetting.IsChanged ? "config-field-changed" : string.Empty)">
                            <div class="config-setting-heading">
                                <label for="@primaryKeySetting.Key">Primary key</label>
                                <ConfigurationHelp Section="Profiles" Topic="@primaryKeySetting.Name" />
                            </div>
                            <div>
                                <div class="input-group">
                                    <input id="@primaryKeySetting.Key" class="form-control" autocomplete="off"
                                           type="@(_showPrimaryKey ? "text" : "password")"
                                           @bind:get="primaryKeySetting.DraftValue"
                                           @bind:set="@(value => SetSettingValueAsync(primaryKeySetting, value))"
                                           @bind:event="oninput" />
                                    <button class="btn btn-outline-secondary" type="button"
                                            aria-label="@(_showPrimaryKey ? "Hide primary key" : "Show primary key")"
                                            aria-pressed="@(_showPrimaryKey ? "true" : "false")"
                                            @onclick="@(() => _showPrimaryKey = !_showPrimaryKey)">
                                        <span class="bi @(_showPrimaryKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                                    </button>
                                </div>
                                @if (primaryKeySetting.IsChanged)
                                {
                                    <div class="identity-access-change">
                                        <span>Current: (hidden)</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="@(() => RevertAsync(primaryKeySetting))">Revert</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (secondaryKeySetting is not null)
                    {
                        <div class="identity-access-form-row @(secondaryKeySetting.IsChanged ? "config-field-changed" : string.Empty)">
                            <div class="config-setting-heading">
                                <label for="@secondaryKeySetting.Key">Secondary key <span>Optional</span></label>
                                <ConfigurationHelp Section="Profiles" Topic="@secondaryKeySetting.Name" />
                            </div>
                            <div>
                                <div class="input-group">
                                    <input id="@secondaryKeySetting.Key" class="form-control" autocomplete="off"
                                           type="@(_showSecondaryKey ? "text" : "password")"
                                           @bind:get="secondaryKeySetting.DraftValue"
                                           @bind:set="@(value => SetSettingValueAsync(secondaryKeySetting, value))"
                                           @bind:event="oninput" />
                                    <button class="btn btn-outline-secondary" type="button"
                                            aria-label="@(_showSecondaryKey ? "Hide secondary key" : "Show secondary key")"
                                            aria-pressed="@(_showSecondaryKey ? "true" : "false")"
                                            @onclick="@(() => _showSecondaryKey = !_showSecondaryKey)">
                                        <span class="bi @(_showSecondaryKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                                    </button>
                                </div>
                                @if (secondaryKeySetting.IsChanged)
                                {
                                    <div class="identity-access-change">
                                        <span>Current: (hidden)</span>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="@(() => RevertAsync(secondaryKeySetting))">Revert</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </fieldset>
            }

            @if (UsesOAuth)
            {
                <fieldset class="identity-access-fieldset" disabled="@(!AuthenticationEnabled)">
                    <legend>OAuth token settings</legend>
                    @if (string.IsNullOrWhiteSpace(OAuthIssuer) || string.IsNullOrWhiteSpace(OAuthAudience))
                    {
                        <div class="alert alert-warning py-2" role="alert">
                            OAuth authentication requires an issuer and at least one audience before the configuration is saved.
                        </div>
                    }
                    <div class="identity-access-form-row @(configSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                        <div class="config-setting-heading">
                            <label for="identity-oauth-header">Bearer token header</label>
                            <ConfigurationHelp Section="Profiles" Topic="Auth:Config" />
                        </div>
                        <input id="identity-oauth-header" class="form-control" type="text" autocomplete="off"
                               value="@AuthenticationHeader" @oninput="SetAuthenticationHeaderAsync" />
                    </div>
                    <div class="identity-access-form-row @(configSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                        <label for="identity-oauth-issuer">Issuer URL</label>
                        <input id="identity-oauth-issuer" class="form-control" type="url" autocomplete="off"
                               value="@OAuthIssuer" @oninput="SetOAuthIssuerAsync" />
                    </div>
                    <div class="identity-access-form-row @(configSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                        <label for="identity-oauth-audience">Audience</label>
                        <input id="identity-oauth-audience" class="form-control" type="text" autocomplete="off"
                               value="@OAuthAudience" @oninput="SetOAuthAudienceAsync" />
                    </div>
                    <div class="identity-access-form-row @(configSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                        <label for="identity-oauth-metadata">Metadata address <span>Optional</span></label>
                        <input id="identity-oauth-metadata" class="form-control" type="url" autocomplete="off"
                               placeholder="Derived from the issuer URL"
                               value="@OAuthMetadataAddress" @oninput="SetOAuthMetadataAddressAsync" />
                    </div>
                    <div class="identity-access-form-row @(configSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                        <label for="identity-oauth-skew">Clock skew (minutes)</label>
                        <input id="identity-oauth-skew" class="form-control" type="number" min="0" step="1"
                               value="@OAuthClockSkewMinutes" @oninput="SetOAuthClockSkewAsync" />
                    </div>
                </fieldset>
            }

            @if (configSetting is { IsChanged: true })
            {
                <div class="identity-access-config-change">
                    <span>Authentication settings have local changes.</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            @onclick="@(() => RevertAsync(configSetting))">Revert authentication</button>
                </div>
            }
        </section>
    }
    else if (_selectedView == "applications")
    {
        var enabledSetting = FindSetting("Auth:ValidateAppIDEnabled");
        <section id="identity-panel-applications" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-applications">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>Applications</h3>
                    <p>Manage the list of approved application IDs that are allowed to access the proxy.</p>
                </div>
                <div class="app-id-heading-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            @onclick="AddAppId"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add application</button>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@ApplicationAccessEnabled(Settings)"
                               disabled="@(enabledSetting is null)"
                               @onchange="@(args => SetBooleanSettingAsync(enabledSetting, args.Value is true))" />
                        <span>Validate application IDs</span>
                    </label>
                </div>
            </div>
            <ConfigurationExplanation Section="Identity & Access" Topic="Application Access" />
            @if (ApplicationAccessEnabled(Settings) && !UserProfilesEnabled(Settings))
            {
                <div class="alert alert-warning py-2" role="alert">
                    Application ID validation also requires profiles to be enabled in Profile Reader.
                </div>
            }
            <div class="app-id-editor">
                <div class="app-id-toolbar">
                    <input class="form-control form-control-sm" type="search" placeholder="Search application IDs..."
                           value="@_appSearch" @oninput="@(args => _appSearch = args.Value?.ToString() ?? string.Empty)" />
                    <span class="app-id-count">@VisibleAppEntries.Count() applications</span>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            disabled="@(_appSelected.Count == 0 || _appBusy)"
                            @onclick="@(() => RemoveAppEntries(_appSelected.ToList()))">Delete selected</button>
                </div>
                @if (_appError is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_appError</div>
                }
                <table class="app-id-table">
                    <thead>
                        <tr>
                            <th scope="col" class="app-id-select"><input type="checkbox" class="form-check-input" aria-label="Select all visible application IDs"
                                                                         checked="@(VisibleAppEntries.Any() && VisibleAppEntries.All(entry => _appSelected.Contains(entry)))"
                                                                         @onchange="@(args => { foreach (var entry in VisibleAppEntries.ToList()) { SetAppSelected(entry, args.Value is true); } })" /></th>
                            <th scope="col">Application ID</th>
                            <th scope="col">Description (optional)</th>
                            <th scope="col">DateAdded</th>
                            <th scope="col" class="app-id-actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in VisibleAppEntries)
                        {
                            var current = entry;
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@_appSelected.Contains(current)"
                                           @onchange="@(args => SetAppSelected(current, args.Value is true))" />
                                </td>
                                <td>
                                    @if (ReferenceEquals(_appEditing, current))
                                    {
                                        <input class="form-control form-control-sm" @bind="_appEditText" />
                                    }
                                    else
                                    {
                                        <code>@AppIdOf(current)</code>
                                    }
                                </td>
                                <td>
                                    @if (ReferenceEquals(_appEditing, current))
                                    {
                                        <input class="form-control form-control-sm" @bind="_appEditDescription" />
                                    }
                                    else
                                    {
                                        <span>@(current["Description"] is JsonValue descriptionValue && descriptionValue.TryGetValue<string>(out var descriptionText) ? descriptionText : string.Empty)</span>
                                    }
                                </td>
                                <td>
                                    <span>@(current["DateAdded"] is JsonValue addedValue && addedValue.TryGetValue<string>(out var addedText) && DateTimeOffset.TryParse(addedText, out var addedAt) ? addedAt.LocalDateTime.ToString("g") : "—")</span>
                                </td>
                                <td class="text-end">
                                    @if (ReferenceEquals(_appEditing, current))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CommitEditAppId">Done</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="@(() => { if (_appEditingIsNew) { _appEntries.Remove(current); } _appEditing = null; _appEditingIsNew = false; _appError = null; })">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-link app-id-icon-btn" aria-label="Edit application ID" title="Edit"
                                                @onclick="@(() => BeginEditAppId(current))"><span class="bi bi-pencil" aria-hidden="true"></span></button>
                                        <button type="button" class="btn btn-sm btn-link app-id-icon-btn text-danger" aria-label="Delete application ID" title="Delete"
                                                @onclick="@(() => RemoveAppEntries(new[] { current }))"><span class="bi bi-trash" aria-hidden="true"></span></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="app-id-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!AppIdsDirty || _appBusy)"
                            @onclick="CancelAppIds">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" disabled="@(!AppIdsDirty || _appBusy)"
                            @onclick="SaveAppIdsAsync">Save</button>
                </div>
            </div>
            @if (enabledSetting is { IsChanged: true })
            {
                <div class="identity-access-config-change">
                    <span>Application validation has local changes.</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            @onclick="@(() => RevertAsync(enabledSetting))">Revert validation</button>
                </div>
            }
        </section>
    }
    else if (_selectedView == "profiles")
    {
        var enabledSetting = FindSetting("User:UseProfiles");
        var profileSettings = Settings.Where(setting =>
            (setting.Name.StartsWith("User:", StringComparison.OrdinalIgnoreCase)
                && !string.Equals(setting.Name, "User:UseProfiles", StringComparison.OrdinalIgnoreCase))
            || !setting.Name.Contains(':'))
            .ToList();
        <section id="identity-panel-profiles" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-profiles">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>oldPR</h3>
                    <p>Load caller profiles and control how requests map to them.</p>
                </div>
                <label class="identity-access-switch form-switch">
                    <input class="form-check-input" type="checkbox" checked="@UserProfilesEnabled(Settings)"
                           disabled="@(enabledSetting is null)"
                           @onchange="@(args => SetBooleanSettingAsync(enabledSetting, args.Value is true))" />
                    <span>Enable user profiles</span>
                </label>
            </div>
            <ConfigurationExplanation Section="Identity & Access" Topic="User Profiles" />
            <ConfigurationFields Settings="profileSettings" OnChanged="OnChanged" />
            @if (enabledSetting is { IsChanged: true })
            {
                <div class="identity-access-config-change">
                    <span>User profile enablement has local changes.</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            @onclick="@(() => RevertAsync(enabledSetting))">Revert enablement</button>
                </div>
            }
        </section>
    }
    else if (_selectedView == "suspended")
    {
        <section id="identity-panel-suspended" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-suspended">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>Suspended Users</h3>
                    <p>Manage the list of suspended users. Suspended users are blocked from accessing the proxy.</p>
                </div>
                <div class="app-id-heading-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary"
                            @onclick="AddSuspendedUser"><span class="bi bi-plus-lg" aria-hidden="true"></span> Add suspended user</button>
                </div>
            </div>
            <ConfigurationExplanation Section="Identity & Access" Topic="Suspended Users" />
            <div class="app-id-editor">
                <div class="app-id-toolbar">
                    <input class="form-control form-control-sm" type="search" placeholder="Search user IDs..."
                           value="@_suspendedSearch" @oninput="@(args => _suspendedSearch = args.Value?.ToString() ?? string.Empty)" />
                    <span class="app-id-count">@VisibleSuspendedEntries.Count() suspended users</span>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                            disabled="@(_suspendedSelected.Count == 0 || _suspendedBusy)"
                            @onclick="@(() => RemoveSuspendedEntries(_suspendedSelected.ToList()))">Delete selected</button>
                </div>
                @if (_suspendedError is not null)
                {
                    <div class="alert alert-danger py-2" role="alert">@_suspendedError</div>
                }
                <table class="app-id-table">
                    <thead>
                        <tr>
                            <th scope="col" class="app-id-select"><input type="checkbox" class="form-check-input" aria-label="Select all visible suspended users"
                                                                         checked="@(VisibleSuspendedEntries.Any() && VisibleSuspendedEntries.All(entry => _suspendedSelected.Contains(entry)))"
                                                                         @onchange="@(args => { foreach (var entry in VisibleSuspendedEntries.ToList()) { SetSuspendedSelected(entry, args.Value is true); } })" /></th>
                            <th scope="col">User ID</th>
                            <th scope="col">Reason (optional)</th>
                            <th scope="col">Suspended At (UTC, optional)</th>
                            <th scope="col" class="app-id-actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in VisibleSuspendedEntries)
                        {
                            var current = entry;
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@_suspendedSelected.Contains(current)"
                                           @onchange="@(args => SetSuspendedSelected(current, args.Value is true))" />
                                </td>
                                <td>
                                    @if (ReferenceEquals(_suspendedEditing, current))
                                    {
                                        <input class="form-control form-control-sm" @bind="_suspendedEditUserId" />
                                    }
                                    else
                                    {
                                        <code>@FieldOf(current, SuspendedUserIdFieldName)</code>
                                    }
                                </td>
                                <td>
                                    @if (ReferenceEquals(_suspendedEditing, current))
                                    {
                                        <input class="form-control form-control-sm" @bind="_suspendedEditReason" />
                                    }
                                    else
                                    {
                                        <span>@FieldOf(current, "Reason")</span>
                                    }
                                </td>
                                <td>
                                    @if (ReferenceEquals(_suspendedEditing, current))
                                    {
                                        <input class="form-control form-control-sm" placeholder="2026-10-01T00:00:00Z" @bind="_suspendedEditSuspendedAt" />
                                    }
                                    else
                                    {
                                        <span>@FieldOf(current, "SuspendedAt")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (ReferenceEquals(_suspendedEditing, current))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CommitEditSuspendedUser">Done</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="@(() => { if (_suspendedEditingIsNew) { _suspendedEntries.Remove(current); } _suspendedEditing = null; _suspendedEditingIsNew = false; _suspendedError = null; })">Cancel</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-link app-id-icon-btn" aria-label="Edit suspended user" title="Edit"
                                                @onclick="@(() => BeginEditSuspendedUser(current))"><span class="bi bi-pencil" aria-hidden="true"></span></button>
                                        <button type="button" class="btn btn-sm btn-link app-id-icon-btn text-danger" aria-label="Delete suspended user" title="Delete"
                                                @onclick="@(() => RemoveSuspendedEntries(new[] { current }))"><span class="bi bi-trash" aria-hidden="true"></span></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="app-id-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!SuspendedUsersDirty || _suspendedBusy)"
                            @onclick="CancelSuspendedUsers">Cancel</button>
                    <button type="button" class="btn btn-sm btn-primary" disabled="@(!SuspendedUsersDirty || _suspendedBusy)"
                            @onclick="SaveSuspendedUsersAsync">Save</button>
                </div>
            </div>
        </section>
    }
    <div class="identity-access-panel" hidden="@(_selectedView is not ("profile-editor" or "rules"))">
        <ProfileConfigurationEditor View="@_selectedView" State="ProfileFileState"
                                    ConfigurationSettings="ConfigurationSettings" OnChanged="OnChanged"
                                    IdentityField='@(FindSetting("Profiles:User:IDFieldName")?.DraftValue ?? FindSetting("UserIDFieldName")?.DraftValue ?? "userId")' />
    </div>
</div>

<style>
    .identity-access-editor { display: grid; grid-template-columns: 12rem minmax(0, 1fr); min-height: 32rem; color: #071c61; }
    .identity-access-tabs { display: flex; flex-direction: column; gap: 0.35rem; padding-right: 1rem; border-right: 1px solid #dce5f2; }
    .identity-access-tabs button { display: flex; align-items: center; gap: 0.75rem; width: 100%; min-height: 3rem; padding: 0.7rem 0.8rem; border: 0; border-radius: 8px; background: transparent; color: #071c61; text-align: left; }
    .identity-access-tabs button:hover { background: #f1f6fd; }
    .identity-access-tabs button.is-selected { background: #e2efff; color: #0066cc; }
    .identity-access-tabs button:focus-visible { outline: 2px solid #1976f3; outline-offset: 2px; }
    .identity-access-tabs .bi { width: 1.5rem; flex: 0 0 1.5rem; font-size: 1.2rem; text-align: center; }
    .identity-access-panel { min-width: 0; padding-left: 1.25rem; }
    .identity-access-panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #dce5f2; }
    .identity-access-panel-heading h3 { margin: 0; color: #071c61; font-size: 1.25rem; font-weight: 700; }
    .identity-access-card { margin-top: 1rem; padding: 1rem 1.1rem; border: 1px solid #dce5f2; border-radius: 10px; background: #fff; }
    .identity-access-card-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .identity-access-card-heading h4 { margin: 0; color: #071c61; font-size: 1.05rem; font-weight: 700; }
    .identity-access-card-heading p { margin: 0.2rem 0 0; color: #5a6b8c; font-size: 0.9rem; }
    .identity-access-form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 1rem; }
    .identity-access-check { display: flex; align-items: flex-start; gap: 0.6rem; margin-top: 0.75rem; }
    .identity-access-check small { display: block; color: #5a6b8c; }
    .identity-access-panel-heading p { margin: 0.3rem 0 0; color: #596c96; font-size: 0.875rem; }
    .app-id-toolbar, .app-id-actions { display: flex; align-items: center; gap: 0.5rem; margin: 1rem 0 0.75rem; }
    .app-id-toolbar input { max-width: 18rem; }
    .app-id-count { color: #596c96; font-size: 0.875rem; margin-left: auto; }
    .app-id-table { width: 100%; border-collapse: collapse; }
    .app-id-table th { text-align: left; color: #596c96; font-size: 0.8rem; font-weight: 600; padding: 0.4rem 0.5rem; border-bottom: 1px solid #dce5f2; }
    .app-id-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid #eef2f9; vertical-align: middle; }
    .app-id-select { width: 2.5rem; }
    .app-id-heading-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
    .app-id-icon-btn { padding: 0.1rem 0.4rem; line-height: 1; }
    .app-id-table code { color: #071c61; }
    .app-id-actions { justify-content: flex-end; }
    .identity-access-switch { display: inline-flex; align-items: center; gap: 0.65rem; flex: 0 0 auto; margin: 0; white-space: nowrap; }
    .identity-access-switch .form-check-input { width: 2.5rem; height: 1.35rem; margin: 0; }
    .identity-access-fieldset { min-width: 0; margin: 0; padding: 1rem 0; border: 0; border-bottom: 1px solid #dce5f2; }
    .identity-access-fieldset:disabled { opacity: 0.58; }
    .identity-access-fieldset legend { float: none; width: auto; margin: 0 0 0.75rem; color: #071c61; font-size: 1rem; font-weight: 700; }
    .identity-access-method { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.4rem 0.55rem; border-radius: 8px; cursor: pointer; }
    .identity-access-method:hover { background: #f4f8ff; }
    .identity-access-method .form-check-input { flex: 0 0 auto; margin-top: 0.25rem; }
    .identity-access-method span { display: flex; flex-direction: column; gap: 0.15rem; }
    .identity-access-method small { color: #596c96; }
    .identity-access-method-group { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
    .identity-access-form-row { display: grid; grid-template-columns: minmax(9rem, 0.45fr) minmax(14rem, 1fr); gap: 1rem; align-items: center; margin: 0 -0.6rem; padding: 0.6rem; border-radius: 8px; }
    .identity-access-form-row > label, .identity-access-form-row .config-setting-heading > label { margin: 0; color: #071c61; font-size: 0.875rem; font-weight: 500; text-transform: none; letter-spacing: normal; }
