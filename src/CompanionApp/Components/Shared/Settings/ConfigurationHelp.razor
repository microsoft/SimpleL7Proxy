@namespace CompanionApp.Components.Shared
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var configuredUrl = string.IsNullOrWhiteSpace(Topic)
        ? Configuration[$"{CompanionAppOptions.UiSectionName}:Documentation:{Section}"]
        : Configuration[$"{CompanionAppOptions.UiSectionName}:TopicDocumentation:{Section}:{Topic}"];
    var description = $"Open documentation for {Topic ?? Section}";
    var resolvedTopic = HelpTopic ?? Topic ?? "top";
    var helpEntryForTopic = Configuration.GetSection($"{CompanionAppOptions.UiSectionName}:PopupHelp:{Section}:{resolvedTopic}");
    var helpLinesForTopic = (helpEntryForTopic.Value is { } topicValue
        ? new[] { topicValue }
        : helpEntryForTopic.GetChildren().Select(line => line.Value ?? string.Empty))
        .Where(line => !string.IsNullOrWhiteSpace(line));
    var helpUrl = helpLinesForTopic.FirstOrDefault(line => Uri.TryCreate(line.Trim(), UriKind.Absolute, out var candidate)
        && (candidate.Scheme == Uri.UriSchemeHttps || candidate.Scheme == Uri.UriSchemeHttp));
    var documentationUrl = "https://github.com/microsoft/SimpleL7Proxy/tree/main/docs";
    if (Uri.TryCreate(helpUrl ?? configuredUrl, UriKind.Absolute, out var documentationUri)
        && (documentationUri.Scheme == Uri.UriSchemeHttps || documentationUri.Scheme == Uri.UriSchemeHttp)
        && documentationUri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase))
    {
        documentationUrl = documentationUri.AbsoluteUri;
    }
    else
    {
        documentationUrl = "https://github.com/microsoft/SimpleL7Proxy/tree/main/docs";
    }
}
@if (ChildContent is not null)
{
    <a class="config-help-link" href="@documentationUrl" target="_blank" rel="noopener noreferrer"
       title="@description" @onclick:stopPropagation="true">@ChildContent</a>
}

<style>
    .config-help-link { display: inline-flex; flex-shrink: 0; color: #0b57a4; font: inherit; text-decoration: underline; text-underline-offset: .15em; }
    .config-help-link:hover { color: #073b75; }
    .config-help-link:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
</style>

@code {
    [Parameter] public string Section { get; set; } = string.Empty;
    [Parameter] public string? Topic { get; set; }
    [Parameter] public string? HelpTopic { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}