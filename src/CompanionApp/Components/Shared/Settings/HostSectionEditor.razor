@namespace CompanionApp.Components.Shared
@using SimpleL7Proxy.Tokenomics
@inject AppConfigurationScaffoldService AppConfiguration
@inject IJSRuntime JS
@inject ModelDefaults ChatCatalog
@inject VisionModelCatalog VisionCatalog

@if (SingleHost is { } singleHost)
{
    <textarea id="HOST1" class="form-control" aria-label="Host1 value" aria-haspopup="dialog" rows="2"
              @bind:get="singleHost.DraftValue" @bind:set="@(value => OnHostSaved.InvokeAsync(value))" @bind:event="oninput"
              @onclick="() => EditHost(singleHost)"></textarea>
}
else
{
<div class="config-host-toolbar">
    <button type="button" class="btn btn-sm btn-primary" @onclick="AddHost">
        <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Add host
    </button>
</div>

<table class="table table-sm align-middle config-host-table config-host-list mb-0">
    <thead>
        <tr>
            <th scope="col">Host</th>
            @foreach (var column in HostColumns)
            {
                <th scope="col"><ConfigurationHelp Section="Hosts" Topic="@column">@column</ConfigurationHelp></th>
            }
            @if (TokenomicsEnabled)
            {
                <th scope="col">APIs</th>
                <th scope="col">Models</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var setting in Hosts.Where(setting => !setting.IsDeleted))
        {
            var tokenomicsHostOptions = TokenomicsEnabled ? HostTokenomicsOptions(setting) : null;
            <tr class="config-host-row @(setting.IsChanged ? "config-row-changed" : string.Empty)" @key="setting.Key"
                @onclick="() => EditHost(setting)">
                <th scope="row">
                    <button type="button" class="btn btn-link p-0 fw-semibold text-start" @onclick:stopPropagation="true" @onclick="() => EditHost(setting)">@setting.Name</button>
                </th>
                @foreach (var column in HostColumns)
                {
                    var fieldValue = HostFieldValue(setting, column);
                    <td>
                        @if (IsBooleanColumn(column))
                        {
                            <input class="form-check-input" type="checkbox" checked="@HostListChecked(column, fieldValue)"
                                   @onclick:stopPropagation="true" @onchange="args => ToggleHostBool(setting, column, args)" />
                        }
                        else
                        {
                            <span class="text-break">@fieldValue</span>
                        }
                    </td>
                }
                @if (TokenomicsEnabled)
                {
                    <td>
                        <div class="config-tokenomics-api-badges">
                            @if (_tokenomicsOptionsError is not null)
                            {
                                <span class="text-danger small">Unavailable</span>
                            }
                            else if (tokenomicsHostOptions?.APIs.Count > 0)
                            {
                                @foreach (var api in tokenomicsHostOptions.APIs.OrderBy(api => api.Key, StringComparer.OrdinalIgnoreCase))
                                {
                                    <span class="badge config-tokenomics-api-badge">@TokenomicsApiBadge(api.Key)</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </div>
                    </td>
                    <td class="config-host-models-cell">
                        @{
                            var hostModels = ModelsForHost(setting);
                        }
                        @if (_tokenomicsOptionsError is not null)
                        {
                            <span class="text-danger small">Unavailable</span>
                        }
                        else if (hostModels.Count == 0)
                        {
                            <span class="text-muted">—</span>
                        }
                        else
                        {
                            <div class="config-tokenomics-api-badges">
                                @foreach (var modelId in hostModels)
                                {
                                    <span class="badge config-tokenomics-api-badge">@modelId</span>
                                }
                            </div>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
}

@if (_showNewHostDialog)
{
    var loadedHost = _editingHost is null ? null : _editingHost with { DraftValue = _editingHost.LoadedValue };
    var changedFields = HostFieldSchema.Where(field =>
    {
        var loadedValue = loadedHost is null ? string.Empty : HostFieldValue(loadedHost, field.Name);
        if (field.Kind == "bool" && string.IsNullOrEmpty(loadedValue))
        {
            loadedValue = field.Default;
        }
        return !string.Equals(NewHostValue(field.Name), loadedValue, StringComparison.Ordinal);
    }).Select(field => field.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var hostModelSelectionChanged = TokenomicsEnabled
        && _tokenomicsOptionsError is null
        && HostModelSelectionChanged(_editingHost?.DraftName ?? string.Empty);
    var hostModelChoices = HostModelChoices;
    var availableModelGroups = hostModelChoices
        .Where(model => !_selectedHostModels.Contains(model.Id))
        .GroupBy(model => model.Provider, StringComparer.OrdinalIgnoreCase)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase)
        .ToList();
    var selectedHostModelChoices = hostModelChoices
        .Where(model => _selectedHostModels.Contains(model.Id))
        .ToList();
    foreach (var modelId in _selectedHostModels.OrderBy(id => id, StringComparer.OrdinalIgnoreCase))
    {
        if (selectedHostModelChoices.Any(model => string.Equals(model.Id, modelId, StringComparison.OrdinalIgnoreCase)))
        {
            continue;
        }

        selectedHostModelChoices.Add(new ModelInfo
        {
            Id = modelId,
            Provider = "Configured",
            DisplayName = modelId
        });
    }
    RenderFragment hostDialog = @<div class="config-modal-backdrop config-modal-backdrop-top" @onclick="CancelNewHost">
        <div class="config-modal config-newhost-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="@(_editingHost is null ? "New host" : "Edit host")">
            <div class="config-modal-header">
                <div>
                    <h2 class="h5 mb-0">@(_editingHost is null ? "New Host" : "Edit Host")</h2>
                    <p class="config-host-subtitle mb-0">Configure the connection, authentication, and routing settings for this backend host.</p>
                </div>
                <div class="config-host-header-controls">
                    <label class="form-check form-switch mb-0 config-host-enabled">
                        <input class="form-check-input" type="checkbox" role="switch"
                               checked='@(!string.Equals(NewHostValue("enabled"), "false", StringComparison.OrdinalIgnoreCase))'
                               @onchange='args => SetNewHostBool("enabled", args)' />
                        <span>Enabled</span>
                    </label>
                    @if (_editingHost is not null)
                    {
                        <div class="config-host-identity">
                            <strong>@_editingHost.DraftName</strong>
                            <span class="badge">@(string.IsNullOrEmpty(NewHostValue("mode")) ? "APIM" : NewHostValue("mode").ToUpperInvariant())</span>
                        </div>
                    }
                </div>
                <button type="button" class="btn-close" aria-label="Close" data-dialog-cancel @onclick="CancelNewHost"></button>
            </div>
            <div class="config-newhost-body">
                <details class="config-host-editor-section config-host-editor-basic" open="@(_editingHost is null)">
                    <summary class="config-host-editor-summary">
                        <span><span class="bi bi-hdd-network me-2" aria-hidden="true"></span>Connection &amp; Routing</span>
                        <span class="bi bi-chevron-down" aria-hidden="true"></span>
                    </summary>
                    <div class="config-newhost-grid">
                        <div class="config-newhost-field @(!string.Equals(_newHostName, _editingHost?.Name ?? string.Empty, StringComparison.Ordinal) ? "config-field-changed" : string.Empty)">
                            <div class="config-setting-heading">
                                <ConfigurationHelp Section="Hosts" Topic="Host name" HelpTopic="Name">
                                    <label class="form-label" for="newHostName">Name</label>
                                </ConfigurationHelp>
                            </div>
                            <input id="newHostName" @ref="_newHostNameInput" class="form-control form-control-sm" placeholder="Host_name"
                                   disabled="@(_editingHost is not null)"
                                   @bind="_newHostName" @bind:event="oninput" />
                            <small class="text-muted mt-1">Names without a Host prefix are saved as Host_&lt;name&gt;.</small>
                        </div>
                        @foreach (var field in BasicHostFields)
                        {
                            <div class='config-newhost-field @((changedFields.Contains(field.Name) || (field.Name == "host" && changedFields.Contains("ipaddress"))) ? "config-field-changed" : string.Empty)'>
                                <div class="config-setting-heading">
                                    <ConfigurationHelp Section="Hosts" Topic="@field.Name"
                                                       HelpTopic='@(string.Equals(field.Name, "host", StringComparison.OrdinalIgnoreCase) ? "Hostname" : field.Name)'>
                                        <label class="form-label" title="@field.Description">@HostLabel(field)</label>
                                    </ConfigurationHelp>
                                </div>
                                @if (string.Equals(field.Name, "host", StringComparison.OrdinalIgnoreCase))
                                {
                                    <input class="form-control form-control-sm" placeholder="host.address.com[ip]"
                                           @bind:get="HostCombinedValue()" @bind:set="SetHostCombined" @bind:event="oninput" />
                                }
                                else if (string.Equals(field.Name, "via", StringComparison.OrdinalIgnoreCase))
                                {
                                    @if (string.Equals(NewHostValue("mode"), "indirect", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <select class="form-select form-select-sm" value="@NewHostValue(field.Name)"
                                                @onchange="args => SetNewHostValue(field.Name, args.Value?.ToString())">
                                            <option value=""></option>
                                            @if (!string.IsNullOrEmpty(NewHostValue(field.Name)) && !OtherHostNames.Contains(NewHostValue(field.Name), StringComparer.OrdinalIgnoreCase))
                                            {
                                                <option value="@NewHostValue(field.Name)">@NewHostValue(field.Name)</option>
                                            }
                                            @foreach (var otherName in OtherHostNames)
                                            {
                                                <option value="@otherName">@otherName</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm" disabled />
                                    }
                                }
                                else if (field.Kind == "bool")
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" checked="@(NewHostValue(field.Name) == "true")"
                                               @onchange="args => SetNewHostBool(field.Name, args)" />
                                    </div>
                                }
                                else if (HostChoices(field.Name) is { } choices)
                                {
                                    <select class="form-select form-select-sm" value="@NewHostValue(field.Name)" disabled="@IsFieldDisabled(field.Name)"
                                            @onchange="args => SetNewHostValue(field.Name, args.Value?.ToString())">
                                        <option value=""></option>
                                        @foreach (var choice in choices)
                                        {
                                            <option value="@choice">@choice</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                     <input class="form-control form-control-sm" placeholder="@field.Default" @bind:get="NewHostValue(field.Name)"
                                         @bind:set="@(value => SetNewHostValue(field.Name, value))" @bind:event="oninput" />
                                }
                            </div>
                        }
                    </div>
                </details>

                @if (TokenomicsEnabled)
                {
                    <details class="config-tokenomics-host-summary config-host-model-details @(hostModelSelectionChanged ? "config-field-changed" : string.Empty)">
                        <summary class="config-host-editor-summary">
                            <span><span class="bi bi-diagram-3 me-2" aria-hidden="true"></span>Supported models</span>
                            <span class="bi bi-chevron-down" aria-hidden="true"></span>
                        </summary>
                        <div class="config-tokenomics-host-summary-heading">
                            <div>
                                <h3 id="tokenomics-host-summary-heading" class="h6 mb-0">Supported models</h3>
                                <span class="small text-muted">Models already assigned to this host are listed here. Newly selected models accept their standard APIs.</span>
                            </div>
                            <span class="small text-muted">@_selectedHostModels.Count selected</span>
                        </div>

                        @if (_tokenomicsOptionsError is not null)
                        {
                            <div class="alert alert-warning py-2 mb-0" role="status">@_tokenomicsOptionsError</div>
                        }
                        else
                        {
                            <div class="config-host-model-add">
                                <label class="visually-hidden" for="host-model-add">Add a supported model</label>
                                <select id="host-model-add" @key="_modelPickerVersion" class="form-select form-select-sm" value=""
                                        disabled="@(availableModelGroups.Count == 0)" @onchange="AddHostModel">
                                    <option value="">@(availableModelGroups.Count == 0 ? "All models selected" : "Add a model...")</option>
                                    @foreach (var group in availableModelGroups)
                                    {
                                        <optgroup label="@group.Key">
                                            @foreach (var model in group)
                                            {
                                                <option value="@model.Id">@HostModelOptionLabel(model)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            @if (selectedHostModelChoices.Count == 0)
                            {
                                <div class="config-tokenomics-host-empty">No models selected.</div>
                            }
                            else
                            {
                                <ul class="config-host-model-selected" aria-label="Selected models">
                                    @foreach (var model in selectedHostModelChoices)
                                    {
                                        var modelId = model.Id;
                                        var previewApis = PreviewApisForModel(modelId);
                                        <li>
                                            <span class="config-host-model-name">
                                                <strong>@model.DisplayName</strong>
                                                @if (!string.Equals(model.DisplayName, modelId, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="text-muted">@modelId</span>
                                                }
                                            </span>
                                            <span class="config-tokenomics-api-badges">
                                                @if (previewApis.Count == 0)
                                                {
                                                    <span class="text-muted">No standard APIs</span>
                                                }
                                                else
                                                {
                                                    @foreach (var api in previewApis)
                                                    {
                                                        <span class="badge config-tokenomics-api-badge">@api</span>
                                                    }
                                                }
                                            </span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Remove @model.DisplayName" @onclick="() => RemoveHostModel(modelId)">Remove</button>
                                        </li>
                                    }
                                </ul>
                            }
                            <p class="config-host-model-note mb-0">Existing assignments keep their current API settings. Change path handling on Model &amp; API Routing.</p>
                        }
                    </details>
                }

                <details class="config-host-editor-section config-host-editor-collapsible" open>
                    <summary class="config-host-editor-summary">
                        <span class="config-host-section-title"><span class="bi bi-lock-fill" aria-hidden="true"></span><span>Authentication<small>Choose how the proxy authenticates with this host.</small></span></span>
                        <span class="bi bi-chevron-down" aria-hidden="true"></span>
                    </summary>
                    <div class="config-host-editor-section-body">
                        <div class="config-auth-section">
                    <fieldset class="config-host-auth-options">
                        <legend class="visually-hidden">Authentication method</legend>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="host-authentication" checked="@IsTokenAuth"
                                   @onchange='() => SetTokenAuth(new ChangeEventArgs { Value = "token" })' />
                            <span>Managed Identity / Token</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="host-authentication" checked='@(NewHostValue("__authMode") == "key")'
                                   @onchange='() => SetTokenAuth(new ChangeEventArgs { Value = "key" })' />
                            <span>API Key</span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="radio" name="host-authentication" checked='@(NewHostValue("__authMode") == "none")'
                                   @onchange='() => SetTokenAuth(new ChangeEventArgs { Value = "none" })' />
                            <span>None (no authentication)</span>
                        </label>
                    </fieldset>
                    <div class="config-auth-columns">
                        @if (IsTokenAuth)
                        {
                        <div class="config-auth-col config-host-auth-settings">
                            <div class="config-auth-subheading">Managed Identity / Token Settings</div>
                            <div class="config-auth-fields">
                                <div class='config-newhost-field @(changedFields.Contains("authprovider") ? "config-field-changed" : string.Empty)'>
                                    <div class="config-setting-heading">
                                        <ConfigurationHelp Section="Hosts" Topic="authprovider">
                                            <label class="form-label">Auth provider</label>
                                        </ConfigurationHelp>
                                    </div>
                                    <select class="form-select form-select-sm" value='@NewHostValue("authprovider")' disabled="@(!IsTokenAuth)"
                                            @onchange='args => SetNewHostValue("authprovider", args.Value?.ToString())'>
                                        <option value=""></option>
                                        @if (!string.IsNullOrEmpty(NewHostValue("authprovider")) && !AuthProviderChoices.Contains(NewHostValue("authprovider"), StringComparer.OrdinalIgnoreCase))
                                        {
                                            <option value='@NewHostValue("authprovider")'>@NewHostValue("authprovider")</option>
                                        }
                                        @foreach (var provider in AuthProviderChoices)
                                        {
                                            <option value="@provider">@provider</option>
                                        }
                                    </select>
                                </div>
                                <div class='config-newhost-field @(changedFields.Contains("audience") ? "config-field-changed" : string.Empty)'>
                                    <div class="config-setting-heading">
                                        <ConfigurationHelp Section="Hosts" Topic="audience">
                                            <label class="form-label">Audience</label>
                                        </ConfigurationHelp>
                                    </div>
                                     <input class="form-control form-control-sm" @bind:get='@(NewHostValue("audience"))' disabled="@(!IsTokenAuth)"
                                         @bind:set='@(value => SetNewHostValue("audience", value))' @bind:event="oninput" />
                                </div>
                            </div>
                        </div>
                        }
                        else if (NewHostValue("__authMode") == "key")
                        {
                        <div class="config-auth-col config-host-auth-settings">
                            <div class="config-auth-subheading">API Key Settings</div>
                            <div class="config-auth-fields">
                                <div class='config-newhost-field @(changedFields.Contains("api-key-header") ? "config-field-changed" : string.Empty)'>
                                    <div class="config-setting-heading">
                                        <ConfigurationHelp Section="Hosts" Topic="api-key-header">
                                            <label class="form-label">API key header</label>
                                        </ConfigurationHelp>
                                    </div>
                                     <input class="form-control form-control-sm" placeholder="api-key" @bind:get='@(NewHostValue("api-key-header"))' disabled="@IsTokenAuth"
                                         @bind:set='@(value => SetNewHostValue("api-key-header", value))' @bind:event="oninput" />
                                </div>
                                <div class='config-newhost-field @(changedFields.Contains("api-key") ? "config-field-changed" : string.Empty)'>
                                    <div class="config-setting-heading">
                                        <ConfigurationHelp Section="Hosts" Topic="api-key">
                                            <label class="form-label">API key</label>
                                        </ConfigurationHelp>
                                    </div>
                                     <input type="password" autocomplete="off" class="form-control form-control-sm" @bind:get='@(NewHostValue("api-key"))' disabled="@IsTokenAuth"
                                         @bind:set='@(value => SetNewHostValue("api-key", value))' @bind:event="oninput" />
                                </div>
                            </div>
                        </div>
                        }
                    </div>
                        </div>
                    </div>
                </details>

                <details class="config-host-editor-section config-host-editor-collapsible" open>
                    <summary class="config-host-editor-summary">
                        <span class="config-host-section-title"><span class="bi bi-bar-chart-fill" aria-hidden="true"></span><span>Token Processing<small>Select how token usage from this host should be processed for reporting, limits, and budgets.</small></span></span>
                        <span class="bi bi-chevron-down" aria-hidden="true"></span>
                    </summary>
                    <div class="config-host-editor-section-body config-host-token-grid">
                        <div class='config-newhost-field @(changedFields.Contains("processor") ? "config-field-changed" : string.Empty)'>
                            <label class="form-label" for="host-token-processor">Token metrics processor</label>
                            <select id="host-token-processor" class="form-select form-select-sm" value='@NewHostValue("processor")'
                                    @onchange='args => SetNewHostValue("processor", args.Value?.ToString())'>
                                <option value="">Default</option>
                                @* REVIEW: Selection policies resolved by ProxyWorker independently of host mode. *@
                                <option value="AutoDetect">auto-detect</option>
                                <option value="APIMResponseHeader">APIM Response Header</option>
                                @if (!string.IsNullOrEmpty(NewHostValue("processor"))
                                    && !string.Equals(NewHostValue("processor"), "AutoDetect", StringComparison.OrdinalIgnoreCase)
                                    && !string.Equals(NewHostValue("processor"), "APIMResponseHeader", StringComparison.OrdinalIgnoreCase)
                                    && !(HostChoices("processor") ?? Array.Empty<string>()).Contains(NewHostValue("processor"), StringComparer.OrdinalIgnoreCase))
                                {
                                    <option value='@NewHostValue("processor")'>@NewHostValue("processor")</option>
                                }
                                @foreach (var processor in HostChoices("processor") ?? Array.Empty<string>())
                                {
                                    <option value="@processor">@processor</option>
                                }
                            </select>
                        </div>
                        <div class="config-host-token-note">
                            <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
                            <span>The selected token processor determines how token usage returned by this backend is interpreted.</span>
                        </div>
                    </div>
                </details>

                <details class="config-host-editor-section config-host-editor-collapsible" open>
                    <summary class="config-host-editor-summary">
                        <span class="config-host-section-title"><span class="bi bi-list-task" aria-hidden="true"></span><span>Priorities<small>Specify the priority group and which request priorities this host can accept.</small></span></span>
                        <span class="bi bi-chevron-down" aria-hidden="true"></span>
                    </summary>
                    <div class="config-host-editor-section-body">
                        <div class="config-newhost-grid config-priorities-grid">
                            @foreach (var field in PriorityHostFields.Where(field => field.Name != "processor"))
                            {
                                <div class='config-newhost-field @(changedFields.Contains(field.Name) ? "config-field-changed" : string.Empty) @(string.Equals(field.Name, "acceptablePriorities", StringComparison.OrdinalIgnoreCase) ? "config-priority-field-wide" : string.Empty)'>
                                    <div class="config-setting-heading">
                                        <ConfigurationHelp Section="Hosts" Topic="@field.Name" HelpTopic="@field.Name">
                                            <label class="form-label" title="@field.Description">@HostLabel(field)</label>
                                        </ConfigurationHelp>
                                    </div>
                                    @if (string.Equals(field.Name, "acceptablePriorities", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="config-priority-group">
                                            @foreach (var priority in PriorityValueChoices)
                                            {
                                                <label class="config-priority-item">
                                                    <input type="checkbox" class="form-check-input" checked="@IsPriorityChecked(priority)"
                                                           disabled="@(SingleHost is not null)"
                                                           @onchange="args => TogglePriority(priority, args)" />
                                                    <span>@priority</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else if (field.Kind == "bool")
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" checked="@(NewHostValue(field.Name) == "true")"
                                                   @onchange="args => SetNewHostBool(field.Name, args)" />
                                        </div>
                                    }
                                    else if (HostChoices(field.Name) is { } choices)
                                    {
                                        <select class="form-select form-select-sm" value="@NewHostValue(field.Name)" disabled="@IsFieldDisabled(field.Name)"
                                                @onchange="args => SetNewHostValue(field.Name, args.Value?.ToString())">
                                            <option value=""></option>
                                            @foreach (var choice in choices)
                                            {
                                                <option value="@choice">@choice</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                             <input class="form-control form-control-sm" placeholder="@field.Default" @bind:get="NewHostValue(field.Name)"
                                               disabled="@(SingleHost is not null && string.Equals(field.Name, "priorityGroup", StringComparison.OrdinalIgnoreCase))"
                                                 @bind:set="@(value => SetNewHostValue(field.Name, value))" @bind:event="oninput" />
                                    }
                                    @if (SingleHost is not null && field.Name is "priorityGroup" or "acceptablePriorities")
                                    {
                                        <small class="text-muted mt-auto pt-1">Only available with App Config mode.</small>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </details>
            </div>
            <div class="config-newhost-footer">
                @if (_editingHost is not null && SingleHost is null)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger me-auto"
                            disabled="@(_tokenomicsOptionsError is not null)"
                            title="@(_tokenomicsOptionsError is not null ? "Fix the tokenomics configuration before deleting this host." : "Stage host deletion until Save changes.")"
                            @onclick="DeleteHostAsync">
                        <span class="bi bi-trash me-1" aria-hidden="true"></span>Delete host
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelNewHost">Cancel</button>
                <button type="button" class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(_newHostName)" @onclick="CommitNewHost">@(_editingHost is null ? "Add host" : "Save")</button>
            </div>
        </div>
    </div>;
    @if (SingleHost is not null)
    {
        <dialog @ref="_singleHostDialog" class="config-single-host-dialog" aria-label="Edit Host1">
            @hostDialog
        </dialog>
    }
    else
    {
        @hostDialog
    }
}

<style>
