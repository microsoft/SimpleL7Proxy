@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Hosts { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();

    // Full label-filtered settings, used to source authprovider and priority choices from sibling keys.
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();

    [Parameter] public string Label { get; set; } = string.Empty;

    [Parameter] public EventCallback<AppConfigurationScaffoldSetting> OnHostCreated { get; set; }

    [Parameter] public AppConfigurationScaffoldSetting? SingleHost { get; set; }

    [Parameter] public EventCallback<string> OnHostSaved { get; set; }

    [Parameter] public EventCallback OnChanged { get; set; }

    private ElementReference _singleHostDialog;

    private bool _showNewHostDialog;
    private AppConfigurationScaffoldSetting? _editingHost;
    private string _newHostName = string.Empty;
    private readonly Dictionary<string, string> _newHostFields = new(StringComparer.OrdinalIgnoreCase);
    private ElementReference _newHostNameInput;
    private bool _focusNewHostName;
    private TokenomicsSettings _tokenomicsOptions = new();
    private string? _observedTokenomicsDraft;
    private string? _tokenomicsOptionsError;
    private readonly HashSet<string> _selectedHostModels = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _loadedHostModels = new(StringComparer.OrdinalIgnoreCase);
    private int _modelPickerVersion;

    private string HostDocsUrl => AppConfiguration.HostFieldsDocUrl;

    private sealed record HostFieldDef(string Name, string Kind, string Default, string Description);

    private sealed record TokenomicsApiDefinition(string Name, string Badge, string DefaultPath);

    private static readonly TokenomicsApiDefinition[] TokenomicsApiCatalog =
    {
        new("OpenAI Chat Completions", "Chat", "/v1/chat/completions"),
        new("OpenAI Responses", "Responses", "/openai/responses"),
        new("OpenAI Chat Completions (vision)", "Vision", "/v1/chat/completions"),
        new("OpenAI Responses (vision)", "Vision", "/v1/responses"),
        new("Anthropic Messages", "Anthropic", "/v1/messages"),
        new("Google Gemini", "Gemini", "/v1beta/models/{model}:generateContent")
    };

    private AppConfigurationScaffoldSetting? TokenomicsEnableSetting => Settings.FirstOrDefault(setting =>
        string.Equals(setting.Name, "Enable", StringComparison.OrdinalIgnoreCase)
        && IsTokenomicsSetting(setting));

    private AppConfigurationScaffoldSetting? TokenomicsOptionsSetting => Settings.FirstOrDefault(setting =>
        string.Equals(setting.Name, "Options", StringComparison.OrdinalIgnoreCase)
        && IsTokenomicsSetting(setting));

    private bool TokenomicsEnabled =>
        bool.TryParse(TokenomicsEnableSetting?.DraftValue, out var enabled) && enabled;

    private static bool IsTokenomicsSetting(AppConfigurationScaffoldSetting setting) =>
        setting.Section.Contains("Tokenomics", StringComparison.OrdinalIgnoreCase)
        || setting.Key.Contains(":Tokenomics:", StringComparison.OrdinalIgnoreCase);

    // Canonical backend host schema (see docs/reference/backend-hosts.md).
    private static readonly HostFieldDef[] HostFieldSchema =
    {
        new("host", "text", string.Empty, "Backend hostname. Pin a DNS override inline as host[ip], e.g. api.backend.com[10.0.1.5]. https:// is assumed if omitted."),
        new("ipaddress", "text", string.Empty, "DNS override IP; entered inline in the hostname as host[ip]."),
        new("mode", "choice", "apim", "apim probes and calls the host; direct calls it without probes; indirect delegates through 'via'."),
        new("via", "text", string.Empty, "Named apim gateway host (e.g. Host_apim); required with mode=indirect."),
        new("path", "text", "/", "Path prefix used for routing."),
        new("probe", "text", "echo/resource?param1=sample", "Health probe path (used only by mode=apim)."),
        new("processor", "choice", string.Empty, "Custom stream processor name (auto-defaulted in direct mode)."),
        new("priorityGroup", "text", "1", "Failover group; lower groups are exhausted before higher ones."),
        new("acceptablePriorities", "text", "*", "Priorities accepted by this host (from Request:Priority:PriorityValues). All (or none) checked accepts every priority."),
        new("stripprefix", "bool", "true", "Strip the matched path prefix before forwarding."),
        new("retryafter", "bool", "true", "Honour the Retry-After header returned by the backend."),
        new("usemi", "bool", "false", "Attach a Managed Identity / OAuth token to every request and probe."),
        new("audience", "text", string.Empty, "OAuth token audience; required when usemi=true."),
        new("authprovider", "text", "AzureProvider", "Simple class name of an IBackendTokenProvider."),
        new("api-key", "text", string.Empty, "API key sent on every forwarded request and probe."),
        new("api-key-header", "text", "api-key", "Header name used when api-key is set."),
        // Managed via the Hosts list toggle; kept in the schema but not shown in the dialog.
        new("enabled", "bool", "true", "Whether this host is eligible for selection; set false to disable it without removing it."),
    };

    // Auth fields render in a dedicated two-column Token/Key section, not the generic grid.
    private static readonly HashSet<string> AuthFields =
        new(StringComparer.OrdinalIgnoreCase) { "usemi", "audience", "authprovider", "api-key", "api-key-header" };

    private static readonly HashSet<string> PrioritySectionFields =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "processor", "priorityGroup", "acceptablePriorities"
        };

    private static IEnumerable<HostFieldDef> DialogHostFields =>
        HostFieldSchema.Where(item =>
            !string.Equals(item.Name, "enabled", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(item.Name, "ipaddress", StringComparison.OrdinalIgnoreCase)
            && !AuthFields.Contains(item.Name));

    private static IEnumerable<HostFieldDef> BasicHostFields =>
        DialogHostFields.Where(item => !PrioritySectionFields.Contains(item.Name));

    private static IEnumerable<HostFieldDef> PriorityHostFields =>
        DialogHostFields.Where(item => PrioritySectionFields.Contains(item.Name));

    // Display labels differ from the connection-string keys for a couple of fields.
    private static string HostLabel(HostFieldDef field) => field.Name.ToLowerInvariant() switch
    {
        "host" => "hostname",
        "processor" => "token metrics processor",
        "prioritygroup" => "priority group",
        "acceptablepriorities" => "acceptable priorities",
        "stripprefix" => "strip prefix",
        "retryafter" => "retry after",
        "authprovider" => "auth provider",
        "usemi" => "use token auth",
        _ => field.Name,
    };

    private void AddHost()
    {
        LoadTokenomicsOptions();
        _editingHost = null;
        _newHostName = string.Empty;
        _newHostFields.Clear();
        foreach (var field in HostFieldSchema)
        {
            _newHostFields[field.Name] = field.Kind == "bool" ? field.Default : string.Empty;
        }

        _newHostFields["processor"] = "AutoDetect";
        _newHostFields["__authMode"] = "none";
        LoadSelectedHostModels(null);
        _showNewHostDialog = true;
        _focusNewHostName = true;
    }

    private void EditHost(AppConfigurationScaffoldSetting setting)
    {
        LoadTokenomicsOptions();
        _editingHost = setting;
        _newHostName = setting.DraftName;
        _newHostFields.Clear();
        foreach (var field in HostFieldSchema)
        {
            var current = HostFieldValue(setting, field.Name);
            _newHostFields[field.Name] = field.Kind == "bool" && string.IsNullOrEmpty(current)
                ? field.Default
                : current;
        }
        _newHostFields["__authMode"] = IsTokenAuth ? "token"
            : string.IsNullOrWhiteSpace(NewHostValue("api-key")) ? "none" : "key";
        LoadSelectedHostModels(setting.DraftName);
        _showNewHostDialog = true;
        _focusNewHostName = true;
    }

    private async Task CancelNewHost()
    {
        if (SingleHost is not null)
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/AdminConfigurationPage.razor.js");
            await module.InvokeVoidAsync("close", _singleHostDialog);
        }
        _showNewHostDialog = false;
        _editingHost = null;
    }

    private async Task DeleteHostAsync()
    {
        if (_editingHost is not { } host || SingleHost is not null || _tokenomicsOptionsError is not null)
        {
            return;
        }

        if (!await JS.InvokeAsync<bool>("confirm", $"Delete {host.DraftName} and its model-routing assignments? This is staged until Save changes and can be undone with Reset all."))
        {
            return;
        }

        if (TokenomicsOptionsSetting is { } optionsSetting)
        {
            var aliases = HostAliases(host);
            var routingChanged = false;
            foreach (var model in _tokenomicsOptions.ModelHostOptions.Keys.ToList())
            {
                var hosts = _tokenomicsOptions.ModelHostOptions[model];
                foreach (var key in hosts.Keys.Where(aliases.Contains).ToList())
                {
                    hosts.Remove(key);
                    routingChanged = true;
                }

                if (hosts.Count == 0)
                {
                    _tokenomicsOptions.ModelHostOptions.Remove(model);
                    routingChanged = true;
                }
            }

            if (routingChanged)
            {
                optionsSetting.DraftValue = _tokenomicsOptions.ToString();
                _observedTokenomicsDraft = optionsSetting.DraftValue;
            }
        }

        host.IsDeleted = true;
        await OnChanged.InvokeAsync();
        await CancelNewHost();
    }

    private string NewHostValue(string name) =>
        _newHostFields.TryGetValue(name, out var value) ? value : string.Empty;

    private void SetNewHostValue(string name, string? value)
    {
        _newHostFields[name] = value ?? string.Empty;

        // via is only valid with mode=indirect; clear it when mode changes away.
        if (string.Equals(name, "mode", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(_newHostFields[name], "indirect", StringComparison.OrdinalIgnoreCase))
        {
            _newHostFields["via"] = string.Empty;
        }
    }

    // hostname merges host + ipaddress as host[ip].
    private string HostCombinedValue()
    {
        var host = NewHostValue("host");
        var ip = NewHostValue("ipaddress");
        return string.IsNullOrEmpty(ip) ? host : $"{host}[{ip}]";
    }

    private void SetHostCombined(string? value)
    {
        var text = value ?? string.Empty;
        var open = text.IndexOf('[');
        var close = text.IndexOf(']');
        if (open >= 0 && close > open)
        {
            _newHostFields["host"] = text[..open].Trim();
            _newHostFields["ipaddress"] = text[(open + 1)..close].Trim();
        }
        else
        {
            _newHostFields["host"] = text.Trim();
            _newHostFields["ipaddress"] = string.Empty;
        }
    }

    // via targets must be apim gateways; an omitted mode defaults to apim per the docs.
    private IEnumerable<string> OtherHostNames =>
        Hosts
            .Where(setting => !ReferenceEquals(setting, _editingHost))
            .Where(IsApimHost)
            .Select(setting => setting.Name)
            .Where(name => !string.IsNullOrEmpty(name))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(name => name, StringComparer.OrdinalIgnoreCase);

    private static bool IsApimHost(AppConfigurationScaffoldSetting setting)
    {
        var mode = HostFieldValue(setting, "mode");
        return string.IsNullOrEmpty(mode) || string.Equals(mode, "apim", StringComparison.OrdinalIgnoreCase);
    }

    private void SetNewHostBool(string name, ChangeEventArgs args) =>
        _newHostFields[name] = args.Value is bool isChecked && isChecked ? "true" : "false";

    // Token (managed identity/OAuth) and key auth are mutually exclusive in the dialog.
    private bool IsTokenAuth => string.Equals(NewHostValue("usemi"), "true", StringComparison.OrdinalIgnoreCase);

    private void SetTokenAuth(ChangeEventArgs args)
    {
        _newHostFields["__authMode"] = args.Value?.ToString() ?? "none";
        _newHostFields["usemi"] = NewHostValue("__authMode") == "token" ? "true" : "false";
    }

    // authprovider choices come from the proxy's AuthProviderClass setting (comma-delimited),
    // reduced to simple class names; falls back to the proxy default when unset.
    private IEnumerable<string> AuthProviderChoices
    {
        get
        {
            var setting = Settings.FirstOrDefault(s => string.Equals(s.Name, "AuthProviderClass", StringComparison.OrdinalIgnoreCase));
            var raw = string.IsNullOrWhiteSpace(setting?.DraftValue) ? "Auth.AzureProvider" : setting!.DraftValue;
            return raw
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(SimpleClassName)
                .Where(name => !string.IsNullOrEmpty(name))
                .Distinct(StringComparer.OrdinalIgnoreCase);
        }
    }

    private static string SimpleClassName(string fullName)
    {
        var dot = fullName.LastIndexOf('.');
        return dot >= 0 ? fullName[(dot + 1)..] : fullName;
    }

    // Priority checkboxes are sourced from the proxy's Request:Priority:PriorityValues setting.
    private IEnumerable<string> PriorityValueChoices
    {
        get
        {
            var setting = Settings.FirstOrDefault(s => s.Key.EndsWith("Request:Priority:PriorityValues", StringComparison.OrdinalIgnoreCase));
            var raw = string.IsNullOrWhiteSpace(setting?.DraftValue) ? "1,2,3" : setting!.DraftValue;
            return raw
                .Split(new[] { '[', ']', ',', ':', ' ', ';' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(value => value.Trim())
                .Where(value => value.Length > 0)
                .Distinct(StringComparer.OrdinalIgnoreCase);
        }
    }

    private HashSet<string> AcceptedPriorities()
    {
        var raw = NewHostValue("acceptablePriorities").Trim();
        if (string.IsNullOrEmpty(raw) || raw == "*")
        {
            return new HashSet<string>(PriorityValueChoices, StringComparer.OrdinalIgnoreCase);
        }

        return new HashSet<string>(
            raw.Split(':', StringSplitOptions.RemoveEmptyEntries).Select(value => value.Trim()),
            StringComparer.OrdinalIgnoreCase);
    }

    private bool IsPriorityChecked(string value) => AcceptedPriorities().Contains(value);

    private void TogglePriority(string value, ChangeEventArgs args)
    {
        var accepted = AcceptedPriorities();
        if (args.Value is bool on && on)
        {
            accepted.Add(value);
        }
        else
        {
            accepted.Remove(value);
        }

        _newHostFields["acceptablePriorities"] = string.Join(":", PriorityValueChoices.Where(accepted.Contains));
    }

    private string BuildHostValue()
    {
        // Token and key auth are mutually exclusive; emit only the active side.
        var isToken = string.Equals(NewHostValue("usemi"), "true", StringComparison.OrdinalIgnoreCase);
        var parts = new List<string>();
        foreach (var field in HostFieldSchema)
        {
            if ((isToken || NewHostValue("__authMode") == "none") && (string.Equals(field.Name, "api-key", StringComparison.OrdinalIgnoreCase)
                || string.Equals(field.Name, "api-key-header", StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }
            if (!isToken && (string.Equals(field.Name, "audience", StringComparison.OrdinalIgnoreCase)
                || string.Equals(field.Name, "authprovider", StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            var value = NewHostValue(field.Name).Trim();
            if (field.Kind == "bool")
            {
                if (!string.Equals(value, field.Default, StringComparison.OrdinalIgnoreCase))
                {
                    parts.Add($"{field.Name}={value}");
                }
            }
            else if (!string.IsNullOrEmpty(value))
            {
                parts.Add($"{field.Name}={value}");
            }
        }

        return string.Join(", ", parts);
    }

    private async Task CommitNewHost()
    {
        var name = _newHostName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            return;
        }

        var suffix = name.StartsWith("Host", StringComparison.OrdinalIgnoreCase)
            ? name["Host".Length..]
            : string.Empty;
        var isNamedHost = suffix.Length > 1 && suffix[0] is '_' or '-';
        var isIndexedHost = suffix.Length > 0
            && suffix.All(char.IsDigit)
            && int.TryParse(suffix, out var hostIndex)
            && hostIndex > 0;
        if (!isNamedHost && !isIndexedHost)
        {
            name = $"Host_{name}";
        }

        var value = BuildHostValue();

        if (_editingHost is { } editing)
        {
            if (SingleHost is not null)
            {
                await OnHostSaved.InvokeAsync(value);
            }
            else
            {
                editing.DraftValue = value;
            }
        }
        else
        {
            var host = new AppConfigurationScaffoldSetting(
                Key: $"Warm:{name}",
                Mode: "Warm",
                Section: "Hosts",
                Name: name,
                Label: Label,
                LoadedValue: string.Empty)
            {
                IsNew = true,
                DraftName = name,
                DraftValue = value,
            };

            await OnHostCreated.InvokeAsync(host);
        }

        ApplyHostModels(_editingHost?.DraftName ?? name);
        await OnChanged.InvokeAsync();
        await CancelNewHost();
    }

    private void LoadSelectedHostModels(string? hostName)
    {
        _selectedHostModels.Clear();
        _loadedHostModels.Clear();
        _modelPickerVersion = 0;
        if (string.IsNullOrWhiteSpace(hostName) || _editingHost is null || _tokenomicsOptionsError is not null)
        {
            return;
        }

        var aliases = HostAliases(_editingHost);
        foreach (var (model, hosts) in _tokenomicsOptions.ModelHostOptions)
        {
            if (hosts.Keys.Any(key => aliases.Contains(key)))
            {
                _selectedHostModels.Add(model);
                _loadedHostModels.Add(model);
            }
        }
    }

    private static string HostModelOptionLabel(ModelInfo model) =>
        string.Equals(model.DisplayName, model.Id, StringComparison.OrdinalIgnoreCase)
            ? model.DisplayName
            : $"{model.DisplayName} ({model.Id})";

    private IReadOnlyList<ModelInfo> HostModelChoices
    {
        get
        {
            var choices = new Dictionary<string, ModelInfo>(StringComparer.OrdinalIgnoreCase);
            foreach (var model in ChatCatalog.ListModels())
            {
                if (!string.IsNullOrWhiteSpace(model.Id))
                {
                    choices[model.Id] = model;
                }
            }

            foreach (var model in VisionCatalog.ListModels())
            {
                if (!string.IsNullOrWhiteSpace(model.Id) && !choices.ContainsKey(model.Id))
                {
                    choices[model.Id] = new ModelInfo
                    {
                        Id = model.Id,
                        Provider = model.Provider,
                        DisplayName = model.DisplayName
                    };
                }
            }

            foreach (var modelId in TokenomicsModelIds())
            {
                if (!choices.ContainsKey(modelId))
                {
                    choices[modelId] = new ModelInfo
                    {
                        Id = modelId,
                        Provider = "Configured",
                        DisplayName = modelId
                    };
                }
            }

            return choices.Values
                .OrderBy(model => model.Provider, StringComparer.OrdinalIgnoreCase)
                .ThenBy(model => model.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ThenBy(model => model.Id, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private IEnumerable<string> TokenomicsModelIds() =>
        _tokenomicsOptions.ModelHierarchy.Values
            .SelectMany(models => models)
            .Concat([_tokenomicsOptions.DefaultModel])
            .Concat(_tokenomicsOptions.ModelCostPerToken.Keys)
            .Concat(_tokenomicsOptions.ModelHostOptions.Keys)
            .Select(model => model.Trim())
            .Where(model => model.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private void AddHostModel(ChangeEventArgs args)
    {
        var modelId = args.Value?.ToString()?.Trim() ?? string.Empty;
        if (modelId.Length == 0 || !_selectedHostModels.Add(modelId))
        {
            return;
        }

        _modelPickerVersion++;
    }

    private void RemoveHostModel(string modelId) => _selectedHostModels.Remove(modelId);

    private bool HostModelSelectionChanged(string hostName)
    {
        var assigned = AssignedModelsForEditingHost();
        return assigned.Count != _selectedHostModels.Count
            || assigned.Any(model => !_selectedHostModels.Contains(model));
    }

    private IReadOnlyList<string> PreviewApisForModel(string modelId)
    {
        if (_loadedHostModels.Contains(modelId)
            && _editingHost is not null
            && _tokenomicsOptions.ModelHostOptions.TryGetValue(modelId, out var hosts))
        {
            var aliases = HostAliases(_editingHost);
            var match = hosts.FirstOrDefault(entry => aliases.Contains(entry.Key));
            if (!string.IsNullOrEmpty(match.Key) && match.Value.APIs.Count > 0)
            {
                return match.Value.APIs.Keys
                    .OrderBy(api => api, StringComparer.OrdinalIgnoreCase)
                    .ToList();
            }
        }

        return StandardApisForModel(modelId);
    }

    private List<string> StandardApisForModel(string model) =>
        ChatCatalog.ApisForModel(model)
            .Select(api => api.DisplayName)
            .Concat(VisionCatalog.ApisForModel(model).Select(api => api.DisplayName))
            .Where(api => !string.IsNullOrWhiteSpace(api))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private void ApplyHostModels(string hostName)
    {
        if (!TokenomicsEnabled
            || _tokenomicsOptionsError is not null
            || TokenomicsOptionsSetting is not { } setting
            || string.IsNullOrWhiteSpace(hostName)
            || !HostModelSelectionChanged(hostName))
        {
            return;
        }

        var aliases = _editingHost is null
            ? new HashSet<string>(StringComparer.OrdinalIgnoreCase) { hostName }
            : HostAliases(_editingHost);
        aliases.Add(hostName);

        foreach (var model in _tokenomicsOptions.ModelHostOptions.Keys.ToList())
        {
            if (_selectedHostModels.Contains(model))
            {
                continue;
            }

            var hosts = _tokenomicsOptions.ModelHostOptions[model];
            foreach (var key in hosts.Keys.Where(key => aliases.Contains(key)).ToList())
            {
                hosts.Remove(key);
            }

            if (hosts.Count == 0)
            {
                _tokenomicsOptions.ModelHostOptions.Remove(model);
            }
        }

        var writeKey = PreferredHostKey(hostName);
        foreach (var model in _selectedHostModels)
        {
            if (!_tokenomicsOptions.ModelHostOptions.TryGetValue(model, out var hosts))
            {
                hosts = new Dictionary<string, TokenomicsHostOptions>(StringComparer.OrdinalIgnoreCase);
                _tokenomicsOptions.ModelHostOptions[model] = hosts;
            }

            if (hosts.Keys.Any(key => aliases.Contains(key)))
            {
                continue;
            }

            var hostOptions = new TokenomicsHostOptions();
            foreach (var apiName in StandardApisForModel(model))
            {
                hostOptions.APIs[apiName] = new TokenomicsApiOptions
                {
                    PassThrough = false,
                    OverridePath = false,
                    Path = null
                };
            }

            hosts[writeKey] = hostOptions;
        }

        setting.DraftValue = _tokenomicsOptions.ToString();
        _observedTokenomicsDraft = setting.DraftValue;
    }

    private HashSet<string> HostAliases(AppConfigurationScaffoldSetting setting)
    {
        var aliases = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        AddHostAlias(aliases, setting.DraftName);
        AddHostAlias(aliases, setting.Name);
        var colon = setting.Key.LastIndexOf(':');
        if (colon >= 0 && colon < setting.Key.Length - 1)
        {
            AddHostAlias(aliases, setting.Key[(colon + 1)..]);
        }

        AddHostAlias(aliases, HostFieldValue(setting, "host"));
        return aliases;
    }

    private static void AddHostAlias(HashSet<string> aliases, string? value)
    {
        var alias = value?.Trim() ?? string.Empty;
        if (alias.Length == 0)
        {
            return;
        }

        aliases.Add(alias);
        if (alias.StartsWith("Host_", StringComparison.OrdinalIgnoreCase) && alias.Length > 5)
        {
            aliases.Add(alias[5..]);
        }
        else if (alias.StartsWith("Host-", StringComparison.OrdinalIgnoreCase) && alias.Length > 5)
        {
            aliases.Add(alias[5..]);
        }
        else if (!alias.StartsWith("Host", StringComparison.OrdinalIgnoreCase))
        {
            aliases.Add($"Host_{alias}");
        }
    }

    private HashSet<string> AssignedModelsForEditingHost()
    {
        if (_editingHost is null)
        {
            return new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }

        return ModelsForHost(_editingHost).ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private string PreferredHostKey(string fallback)
    {
        if (_editingHost is not null)
        {
            var aliases = HostAliases(_editingHost);
            foreach (var hosts in _tokenomicsOptions.ModelHostOptions.Values)
            {
                foreach (var key in hosts.Keys)
                {
                    if (aliases.Contains(key))
                    {
                        return key;
                    }
                }
            }
        }

        return string.IsNullOrWhiteSpace(fallback) ? _editingHost?.DraftName ?? string.Empty : fallback;
    }

    private IReadOnlyList<string> ModelsForHost(AppConfigurationScaffoldSetting setting)
    {
        if (_tokenomicsOptionsError is not null)
        {
            return Array.Empty<string>();
        }

        var aliases = HostAliases(setting);
        return _tokenomicsOptions.ModelHostOptions
            .Where(entry => entry.Value.Keys.Any(key => aliases.Contains(key)))
            .Select(entry => entry.Key)
            .OrderBy(model => model, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void LoadTokenomicsOptions()
    {
        if (TokenomicsOptionsSetting is null)
        {
            _tokenomicsOptions = new TokenomicsSettings();
            _observedTokenomicsDraft = null;
            _tokenomicsOptionsError = TokenomicsEnabled
                ? "Tokenomics:Options is unavailable for this configuration."
                : null;
            return;
        }

        var raw = TokenomicsOptionsSetting?.DraftValue ?? string.Empty;
        if (string.Equals(raw, _observedTokenomicsDraft, StringComparison.Ordinal))
        {
            return;
        }

        _observedTokenomicsDraft = raw;
        var options = new TokenomicsSettings();
        if (string.IsNullOrWhiteSpace(raw) || options.TryParse(raw))
        {
            _tokenomicsOptions = options;
            _tokenomicsOptionsError = null;
            return;
        }

        _tokenomicsOptions = new TokenomicsSettings();
        _tokenomicsOptionsError = "Tokenomics:Options could not be parsed.";
    }

    private TokenomicsHostOptions? HostTokenomicsOptions(AppConfigurationScaffoldSetting? setting)
    {
        if (setting is null || _tokenomicsOptionsError is not null)
        {
            return null;
        }

        var aliases = HostAliases(setting);
        var modelHosts = _tokenomicsOptions.ModelHostOptions.Values
            .SelectMany(hosts => hosts.Where(entry => aliases.Contains(entry.Key)))
            .Select(entry => entry.Value)
            .ToList();
        return modelHosts.Count == 0 ? null : new TokenomicsHostOptions {
            Enabled = modelHosts.Any(options => options.Enabled),
            APIs = modelHosts.SelectMany(options => options.APIs)
                .GroupBy(api => api.Key, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(group => group.Key, group => group.First().Value, StringComparer.OrdinalIgnoreCase)
        };
    }

    private static TokenomicsApiDefinition TokenomicsApiDefinitionFor(string apiName) =>
        TokenomicsApiCatalog.FirstOrDefault(definition =>
            string.Equals(definition.Name, apiName, StringComparison.OrdinalIgnoreCase))
        ?? new TokenomicsApiDefinition(apiName, "Custom", string.Empty);

    private static string TokenomicsApiBadge(string apiName) =>
        TokenomicsApiDefinitionFor(apiName).Badge;

    private string TokenomicsHostStatus(TokenomicsHostOptions? options) =>
        _tokenomicsOptionsError is not null
            ? "Unavailable"
            : options is null
                ? "Not configured"
                : options.Enabled ? "Enabled" : "Disabled";

    private string TokenomicsHostStatusClass(TokenomicsHostOptions? options) =>
        _tokenomicsOptionsError is not null || options is null
            ? "text-bg-light border"
            : options.Enabled ? "text-bg-success" : "text-bg-secondary";

    protected override void OnParametersSet()
    {
        LoadTokenomicsOptions();
    }

    private static readonly string[] HostColumnOrder =
        { "host", "path", "probe", "mode", "processor", "api-key-header", "api-key", "audience", "usemi", "enabled" };

    private IReadOnlyList<string> HostColumns
    {
        get
        {
            // Config-driven list columns; fall back to the union of all fields.
            if (AppConfiguration.HostListColumns.Count > 0)
            {
                return AppConfiguration.HostListColumns
                    .Where(column => !string.Equals(column, "path", StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            var keys = new List<string>();
            foreach (var setting in Hosts)
            {
                foreach (var (key, _) in ParseHostFields(setting.DraftValue))
                {
                    if (!keys.Contains(key, StringComparer.OrdinalIgnoreCase))
                    {
                        keys.Add(key);
                    }
                }
            }

            return keys
                .Where(key => !string.Equals(key, "path", StringComparison.OrdinalIgnoreCase))
                .OrderBy(key =>
                {
                    var index = Array.FindIndex(HostColumnOrder, column => string.Equals(column, key, StringComparison.OrdinalIgnoreCase));
                    return index < 0 ? int.MaxValue : index;
                })
                .ThenBy(key => key, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private static List<(string Key, string Value)> ParseHostFields(string value)
    {
        var fields = new List<(string, string)>();
        if (string.IsNullOrWhiteSpace(value))
        {
            return fields;
        }

        foreach (var token in value.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
        {
            var trimmed = token.Trim();
            var equals = trimmed.IndexOf('=');
            if (equals <= 0)
            {
                continue;
            }

            fields.Add((trimmed[..equals].Trim(), trimmed[(equals + 1)..].Trim()));
        }

        return fields;
    }

    private static string HostFieldValue(AppConfigurationScaffoldSetting setting, string column)
    {
        foreach (var (key, value) in ParseHostFields(setting.DraftValue))
        {
            if (string.Equals(key, column, StringComparison.OrdinalIgnoreCase))
            {
                return value;
            }
        }

        return string.Empty;
    }

    private static bool IsHostBoolean(string value) =>
        string.Equals(value, "true", StringComparison.OrdinalIgnoreCase)
        || string.Equals(value, "false", StringComparison.OrdinalIgnoreCase);

    // Schema-defined booleans retain their defaults when omitted; other columns are inferred from populated values.
    private bool IsBooleanColumn(string column)
    {
        var hasBooleanValue = false;
        foreach (var setting in Hosts)
        {
            var value = HostFieldValue(setting, column);
            if (string.IsNullOrEmpty(value))
            {
                continue;
            }

            if (!IsHostBoolean(value))
            {
                return false;
            }

            hasBooleanValue = true;
        }

        return hasBooleanValue
            || HostFieldSchema.Any(field =>
                string.Equals(field.Name, column, StringComparison.OrdinalIgnoreCase)
                && string.Equals(field.Kind, "bool", StringComparison.OrdinalIgnoreCase));
    }

    // List checkbox state honours the schema default when the field is absent (e.g. enabled defaults true).
    private static bool HostListChecked(string column, string value)
    {
        if (!string.IsNullOrEmpty(value))
        {
            return string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
        }

        var field = HostFieldSchema.FirstOrDefault(f => string.Equals(f.Name, column, StringComparison.OrdinalIgnoreCase));
        return field is not null && string.Equals(field.Default, "true", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleHostBool(AppConfigurationScaffoldSetting setting, string column, ChangeEventArgs args)
    {
        var value = args.Value is bool isChecked && isChecked ? "true" : "false";
        var field = HostFieldSchema.FirstOrDefault(f => string.Equals(f.Name, column, StringComparison.OrdinalIgnoreCase));
        var isDefault = field is not null && string.Equals(field.Default, value, StringComparison.OrdinalIgnoreCase);
        SetHostFieldValue(setting, column, isDefault ? string.Empty : value);
    }

    private static void SetHostFieldValue(AppConfigurationScaffoldSetting setting, string column, string value)
    {
        var fields = ParseHostFields(setting.DraftValue);
        var index = fields.FindIndex(field => string.Equals(field.Key, column, StringComparison.OrdinalIgnoreCase));
        if (string.IsNullOrEmpty(value))
        {
            if (index >= 0)
            {
                fields.RemoveAt(index);
            }
        }
        else if (index >= 0)
        {
            fields[index] = (fields[index].Key, value);
        }
        else
        {
            fields.Add((column, value));
        }

        setting.DraftValue = string.Join(", ", fields.Select(field => $"{field.Key}={field.Value}"));
    }

    private string[]? HostChoices(string column)
    {
        foreach (var choice in AppConfiguration.HostFieldChoices)
        {
            if (string.Equals(choice.Key, column, StringComparison.OrdinalIgnoreCase))
            {
                return choice.Value;
            }
        }

        return null;
    }

    // token metrics processor only applies in direct mode.
    private bool IsFieldDisabled(string name) =>
        string.Equals(name, "processor", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(NewHostValue("mode"), "direct", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusNewHostName)
        {
            _focusNewHostName = false;
            if (SingleHost is not null)
            {
                await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/AdminConfigurationPage.razor.js");
                await module.InvokeVoidAsync("open", _singleHostDialog);
            }
            else if (_editingHost is null)
            {
                await _newHostNameInput.FocusAsync();
            }
        }
    }
