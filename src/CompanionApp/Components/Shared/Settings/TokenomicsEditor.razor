@namespace CompanionApp.Components.Shared
@using System.Globalization
@using System.Reflection
@using SimpleL7Proxy.Tokenomics
@using CompanionApp.Components.Widgets.TokenomicsConfiguration
@inject ModelDefaults ChatCatalog
@inject VisionModelCatalog VisionCatalog

<div class="tokenomics-configuration">
    <TokenomicsSettingsToolbarWidget EnableSetting="EnableSetting" MetricsServerSetting="MetricsServerSetting"
        Enabled="Enabled" OptionsChanged="@(_parseError is null && OptionsSetting is { IsChanged: true })"
        OnEnabledChanged="SetEnabledAsync" OnMetricsServerChanged="SetMetricsServer" OnChanged="NotifyChangedAsync"
        OnRevertEnabled="RevertEnabledAsync" OnRevertMetricsServer="RevertMetricsServerAsync" OnRevertOptions="RevertOptionsAsync" />

@if (Enabled)
{
<div id="tokenomics-settings-content" class="tokenomics-settings-content">
@if (OptionsSetting is { } optionsSetting)
{
    @if (_parseError is null && _options.IgnoredFields.Count > 0)
    {
        <div class="alert alert-warning py-2" role="status">
            <strong>Some Tokenomics fields were ignored when loading these options.</strong>
            Unknown fields or invalid values were not applied; existing or default values remain in use.
            <div>Ignored fields: <code>@string.Join(", ", _options.IgnoredFields)</code></div>
        </div>
    }
    @if (_parseError is not null)
    {
        <section class="tokenomics-editor-section" aria-labelledby="tokenomics-options-heading">
            <div class="tokenomics-section-heading">
                <h3 id="tokenomics-options-heading" class="h6 mb-0">Options</h3>
                @if (optionsSetting.IsChanged || RawOptionsChanged)
                {
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="RevertOptionsAsync">
                        <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Revert
                    </button>
                }
            </div>
            <div class="alert alert-danger py-2" role="alert">@_parseError</div>
            <label class="form-label" for="tokenomics-raw-options">Raw Tokenomics options</label>
            <textarea id="tokenomics-raw-options" class="form-control form-control-sm font-monospace" rows="6"
                      @bind:get="_rawOptions" @bind:set="SetRawOptions"
                      @bind:event="oninput" @onchange="NotifyChangedAsync"></textarea>
        </section>
    }
    else
    {
        <div class="tokenomics-summary-grid" role="group" aria-label="Select Tokenomics settings to edit">
            <TokenomicsLimitsBudgetsSettingsWidget IsSummary="true" IsSelected="@(_expandedWidget == "limits")"
                OnSelected="@(() => { _limitsSnapshot = _options.ToString(); _limitsModel = null; _expandedWidget = "limits"; })">
                <Summary>
                    <span><strong>Tokens:</strong> @CompactNumber(_options.DefaultLimits.HourlyTokenLimit) hourly · @CompactNumber(_options.DefaultLimits.DailyTokenLimit) daily · @CompactNumber(_options.DefaultLimits.MonthlyTokenLimit) monthly</span>
                    <span><strong>Budgets:</strong> $@CompactNumber(_options.DefaultLimits.HourlyBudgetUsd) hourly · $@CompactNumber(_options.DefaultLimits.DailyBudgetUsd) daily · $@CompactNumber(_options.DefaultLimits.MonthlyBudgetUsd) monthly</span>
                    <span><strong>On exceed:</strong> @PeriodActions(_options.DefaultLimitActions.HourlyLimitAction, _options.DefaultLimitActions.DailyLimitAction, _options.DefaultLimitActions.MonthlyLimitAction)</span>
                </Summary>
            </TokenomicsLimitsBudgetsSettingsWidget>
            <TokenomicsRequestPrioritySettingsWidget IsSummary="true" IsSelected="@(_expandedWidget == "priority")"
                OnSelected="@(() => _expandedWidget = "priority")">
                <Summary>
                    <span><strong>Abuse detected:</strong> @SummaryAction(_options.AbuseDetectedAction)</span>
                    <span><strong>Administrator override:</strong> @SummaryAction(_options.AdministratorOverrideAction)</span>
                </Summary>
            </TokenomicsRequestPrioritySettingsWidget>
            <TokenomicsModelRoutingSettingsWidget IsSummary="true" IsSelected="@(_expandedWidget == "routing")"
                OnSelected="@(() => _expandedWidget = "routing")">
                <Summary>
                    <span><strong>Default model:</strong> <span class="tokenomics-summary-model" title="@_options.DefaultModel">@(string.IsNullOrWhiteSpace(_options.DefaultModel) ? "Not configured" : _options.DefaultModel)</span></span>
                    <span><strong>Hierarchy:</strong> @(_options.ModelHierarchy.Values.SelectMany(models => models).Distinct(StringComparer.OrdinalIgnoreCase).Count() is var modelCount && modelCount > 0 ? $"{modelCount} {(modelCount == 1 ? "model" : "models")}" : "No models configured")</span>
                    <span><strong>Host routing:</strong> @(_options.ModelHostOptions.Count == 0 ? "No model hosts configured" : $"{_options.ModelHostOptions.Count} {_options.ModelHostOptions.Count switch { 1 => "model", _ => "models" }} · {_options.ModelHostOptions.Values.Sum(hosts => hosts.Count)} host assignments")</span>
                    <span><strong>Fallback:</strong> @SummaryAction(_options.PreferredModelReplacementAction) when permitted · otherwise @FieldLabel(_options.PreferredModelUnavailableAction.ToString())</span>
                </Summary>
            </TokenomicsModelRoutingSettingsWidget>
            <TokenomicsModelCostsSettingsWidget IsSummary="true" IsSelected="@(_expandedWidget == "costs")"
                OnSelected="@(() => { SyncAssignedModelCostRows(); _expandedWidget = "costs"; })">
                <Summary>
                    @if (_options.ModelCostPerToken.Count == 0)
                    {
                        <span><strong>No model pricing configured</strong></span>
                        <span>Models without pricing are excluded from spend totals.</span>
                    }
                    else
                    {
                        <span><strong>@_options.ModelCostPerToken.Count @(_options.ModelCostPerToken.Count == 1 ? "model priced" : "models priced")</strong></span>
                        <span>Input, cached-input, and output rates configured per token.</span>
                    }
                </Summary>
            </TokenomicsModelCostsSettingsWidget>
        </div>
        @if (_fieldErrors.Count > 0 || _modelCosts.Any(row => row.ModelError is not null || row.InputCostError is not null || row.CachedInputCostError is not null || row.OutputCostError is not null))
        {
            <div class="alert alert-warning py-2" role="alert">
                Some edits need correction. Select the relevant settings summary to review field errors; invalid values have not been applied to the draft.
            </div>
        }
        @if (_expandedWidget is not null)
        {
        <div class="config-modal-backdrop tokenomics-widget-backdrop" @onclick="@(() => _expandedWidget = null)">
        <div id="tokenomics-expanded-panel" class="config-modal tokenomics-widget-popup" role="dialog" aria-modal="true"
             aria-labelledby="@($"tokenomics-summary-{_expandedWidget}")" @onclick:stopPropagation="true">
            <div class="tokenomics-widget-popup-toolbar">
                <span>Changes stay local until Save changes is selected on the configuration page.</span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-dialog-cancel
                        @onclick="@(() => _expandedWidget = null)">Close</button>
            </div>
            <div class="tokenomics-widget-popup-body">
            @if (_expandedWidget == "limits")
            {
            <TokenomicsLimitsBudgetsSettingsWidget FieldContent="@(name => RenderField(name, true, _limitsModel))"
                Models="@_options.ModelHostOptions.Keys.OrderBy(model => model, StringComparer.OrdinalIgnoreCase).ToArray()"
                SelectedModel="@_limitsModel"
                OverriddenModels="@_options.ModelLimits.Keys.Concat(_options.ModelLimitActions.Keys).ToHashSet(StringComparer.OrdinalIgnoreCase)"
                UseDefaults="@(_limitsModel is null || !_options.ModelLimits.ContainsKey(_limitsModel) && !_options.ModelLimitActions.ContainsKey(_limitsModel))"
                HasErrors="@_fieldErrors.Keys.Any(key => key.StartsWith("limits:", StringComparison.Ordinal))"
                OnModelSelected="@((string? model) => _limitsModel = model)"
                OnUseDefaultsChanged="@(async (bool useDefaults) => {
                    if (_limitsModel is not { } model) { return; }
                    if (useDefaults) {
                        _options.ModelLimits.Remove(model);
                        _options.ModelLimitActions.Remove(model);
                    } else {
                        var copy = ParseOptions(_options.ToString())!;
                        _options.ModelLimits.TryAdd(model, copy.DefaultLimits);
                        _options.ModelLimitActions.TryAdd(model, copy.DefaultLimitActions);
                    }
                    foreach (var key in _fieldErrors.Keys.Where(key => key.StartsWith($"limits:{model}:", StringComparison.Ordinal)).ToArray()) {
                        _fieldErrors.Remove(key);
                    }
                    CommitOptions();
                    await OnChanged.InvokeAsync();
                })"
                OnReset="@(async () => {
                    if (_limitsModel is { } model) {
                        _options.ModelLimits.Remove(model);
                        _options.ModelLimitActions.Remove(model);
                    } else {
                        _options.DefaultLimits = new();
                        _options.DefaultLimitActions = new();
                    }
                    var workloadDefaults = new TokenomicsLimitActions();
                    _options.PremiumWorkloadLimitActions = new();
                    _options.CriticalWorkloadLimitActions.HourlyBudgetExceededAction = workloadDefaults.HourlyBudgetExceededAction;
                    _options.CriticalWorkloadLimitActions.DailyBudgetExceededAction = workloadDefaults.DailyBudgetExceededAction;
                    _options.CriticalWorkloadLimitActions.MonthlyBudgetExceededAction = workloadDefaults.MonthlyBudgetExceededAction;
                    _options.CriticalWorkloadLimitActions.HourlyLimitAction = workloadDefaults.HourlyLimitAction;
                    _options.CriticalWorkloadLimitActions.DailyLimitAction = workloadDefaults.DailyLimitAction;
                    _options.CriticalWorkloadLimitActions.MonthlyLimitAction = workloadDefaults.MonthlyLimitAction;
                    foreach (var key in _fieldErrors.Keys.Where(key => key.StartsWith("limits:PremiumWorkload:", StringComparison.Ordinal)
                        || key.StartsWith("limits:CriticalWorkload:", StringComparison.Ordinal)).ToArray()) {
                        _fieldErrors.Remove(key);
                    }
                    foreach (var key in _fieldErrors.Keys.Where(key => key.StartsWith($"limits:{_limitsModel ?? "default"}:", StringComparison.Ordinal)).ToArray()) {
                        _fieldErrors.Remove(key);
                    }
                    CommitOptions();
                    await OnChanged.InvokeAsync();
                })"
                OnSave="@(() => _expandedWidget = null)"
                OnCancel="@(async () => {
                    if (_limitsSnapshot is not null) { _options = ParseOptions(_limitsSnapshot)!; }
                    foreach (var key in _fieldErrors.Keys.Where(key => key.StartsWith("limits:", StringComparison.Ordinal)).ToArray()) {
                        _fieldErrors.Remove(key);
                    }
                    CommitOptions();
                    _expandedWidget = null;
                    await OnChanged.InvokeAsync();
                })" />
            }
            else if (_expandedWidget == "priority")
            {
            <TokenomicsRequestPrioritySettingsWidget
                ActionNames="@(ActionsForTab("priority").Select(property => property.Name))" FieldContent="@(name => RenderField(name))" />
            }
            else if (_expandedWidget == "routing")
            {
            <TokenomicsModelRoutingSettingsWidget NumericNames="@(NumericForTab("routing").Select(property => property.Name))"
                ActionNames="@(ActionsForTab("routing").Select(property => property.Name))" FieldContent="@(name => RenderField(name))"
                Models="RoutingModels" HostSettings="Hosts" HostOptions="_options.HostOptions"
                ModelHostOptions="_options.ModelHostOptions" ApiDefinitions="RoutingApis"
                LoadedAllowedHosts="@_loadedOptions.ModelHostOptions.ToDictionary(
                    entry => entry.Key,
                    entry => entry.Value.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase),
                    StringComparer.OrdinalIgnoreCase)"
                Error="@(_fieldErrors.TryGetValue(nameof(TokenomicsSettings.ModelHostOptions), out var allowedHostsError) ? allowedHostsError : null)"
                OnHostsChanged="SetAllowedHostsAsync" OnHostApiChanged="SetHostApiAsync"
                OnModelHostApiChanged="SetModelHostApiAsync" />
            }
            else if (_expandedWidget == "costs")
            {
                    <TokenomicsModelCostsSettingsWidget Search="@_modelSearch" Page="_modelPage" PageSize="_modelPageSize"
                        PageCount="ModelPageCount" TotalCount="_modelCosts.Count" FilteredCount="FilteredModelCostCount"
                        ResultSummary="@ModelResultSummary" Rows="VisibleModelCosts" IsChanged="IsModelCostChanged"
                        CostsPerMillion="_costsPerMillion" OnCostsPerMillionChanged="SetCostsPerMillion"
                        OnSearchChanged="SetModelSearch" OnPageSizeChanged="SetModelPageSize" OnPageChanged="SetModelPage"
                        OnAdd="AddModelCost" OnClearSearch="ClearModelSearch" OnRemove="RemoveModelCostAsync"
                        OnModelChanged="@(change => SetModelCostAsync(change.Row, change.Value, null, null, null))"
                        OnInputChanged="@(change => SetModelCostAsync(change.Row, null, change.Value, null, null))"
                        OnCachedInputChanged="@(change => SetModelCostAsync(change.Row, null, null, change.Value, null))"
                        OnOutputChanged="@(change => SetModelCostAsync(change.Row, null, null, null, change.Value))" />
            }
            </div>
        </div>
        </div>
        }
    }
}

@if (_unhandledSettings.Count > 0)
{
    <section class="tokenomics-editor-section" aria-labelledby="tokenomics-additional-heading">
        <div class="tokenomics-section-heading">
            <h3 id="tokenomics-additional-heading" class="h6 mb-0">Additional settings</h3>
        </div>
        <ConfigurationFields Settings="_unhandledSettings" OnChanged="OnChanged" />
    </section>
}
</div>
}

</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();

    [Parameter] public IReadOnlyList<AppConfigurationScaffoldSetting> Hosts { get; set; } =
        Array.Empty<AppConfigurationScaffoldSetting>();

    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly PropertyInfo[] OptionProperties = typeof(TokenomicsSettings)
        .GetProperties(BindingFlags.Public | BindingFlags.Instance)
        .Concat(typeof(TokenomicsLimits).GetProperties(BindingFlags.Public | BindingFlags.Instance))
        .Concat(typeof(TokenomicsLimitActions).GetProperties(BindingFlags.Public | BindingFlags.Instance))
        .Where(property => property.CanRead && property.CanWrite && property.Name != nameof(TokenomicsSettings.ModelCostPerToken))
        .ToArray();

    private static IEnumerable<PropertyInfo> NumericProperties =>
        OptionProperties.Where(property => property.PropertyType != typeof(TokenActionEnum));

    private static IEnumerable<PropertyInfo> ActionProperties =>
        OptionProperties.Where(property => property.PropertyType == typeof(TokenActionEnum));

    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private readonly List<ModelCostRow> _modelCosts = new();
    private bool _costsPerMillion = true;
    private const decimal TokensPerMillion = 1_000_000m;
    private string? _expandedWidget;
    private string? _limitsModel;
    private string? _limitsSnapshot;
    private static string CompactNumber(decimal value) =>
        value != 0 && value % 1000 == 0
            ? $"{(value / 1000).ToString("0.##", CultureInfo.InvariantCulture)}K"
            : value.ToString("0.##", CultureInfo.InvariantCulture);

    private static string SummaryAction(TokenActionEnum action) {
        var label = FieldLabel(action.ToString());
        return char.ToUpperInvariant(label[0]) + label[1..];
    }

    private static string PeriodActions(TokenActionEnum hourly, TokenActionEnum daily, TokenActionEnum monthly) =>
        hourly == daily && daily == monthly
            ? SummaryAction(hourly)
            : $"{SummaryAction(hourly)} hourly · {SummaryAction(daily)} daily · {SummaryAction(monthly)} monthly";
    private string _modelSearch = string.Empty;
    private int _modelPage = 1;
    private int _modelPageSize = 50;
    private TokenomicsSettings _options = new();
    private TokenomicsSettings _loadedOptions = new();
    private IReadOnlyList<AppConfigurationScaffoldSetting>? _trackedSettings;
    private IReadOnlyList<AppConfigurationScaffoldSetting> _unhandledSettings = Array.Empty<AppConfigurationScaffoldSetting>();
    private AppConfigurationScaffoldSetting? _trackedOptionsSetting;
    private string? _observedDraftValue;
    private string _rawOptions = string.Empty;
    private string? _parseError;
    private bool _loadedOptionsValid;

    private AppConfigurationScaffoldSetting? EnableSetting => Settings.FirstOrDefault(setting =>
        string.Equals(setting.Name, "Enable", StringComparison.OrdinalIgnoreCase));

    private AppConfigurationScaffoldSetting? OptionsSetting => Settings.FirstOrDefault(setting =>
        string.Equals(setting.Name, "Options", StringComparison.OrdinalIgnoreCase));

    private AppConfigurationScaffoldSetting? MetricsServerSetting => Settings.FirstOrDefault(setting =>
        string.Equals(setting.Name, "MetricsServer", StringComparison.OrdinalIgnoreCase));

    private bool Enabled => bool.TryParse(EnableSetting?.DraftValue, out var enabled) && enabled;

    private IReadOnlyList<string> HostNames => Hosts
        .Select(host => host.DraftName.Trim())
        .Where(name => name.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private bool RawOptionsChanged => OptionsSetting is { } setting
        && !string.Equals(_rawOptions, setting.DraftValue, StringComparison.Ordinal);

    private IReadOnlyList<string> RoutingModels => _options.ModelHierarchy.Values
        .SelectMany(models => models)
        .Concat([_options.DefaultModel])
        .Concat(_options.ModelCostPerToken.Keys)
        .Concat(_options.ModelHostOptions.Keys)
        .Concat(ChatCatalog.ListModels().Select(model => model.Id))
        .Concat(VisionCatalog.ListModels().Select(model => model.Id))
        .Select(model => model.Trim())
        .Where(model => model.Length > 0)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(model => model, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private IReadOnlyList<TokenomicsModelRoutingSettingsWidget.ApiDefinition> RoutingApis =>
        ChatCatalog.ListApis()
            .Select(api => new TokenomicsModelRoutingSettingsWidget.ApiDefinition(api.DisplayName, api.Endpoint))
            .Concat(VisionCatalog.ListApis()
                .Select(api => new TokenomicsModelRoutingSettingsWidget.ApiDefinition(api.DisplayName, api.Endpoint)))
            .GroupBy(api => api.Name, StringComparer.OrdinalIgnoreCase)
            .Select(group => group.First())
            .ToList();

    private IEnumerable<ModelCostRow> FilteredModelCosts => _modelCosts
        .Where(ModelMatchesSearch)
        .OrderBy(row => string.IsNullOrWhiteSpace(row.Model) ? 0 : 1)
        .ThenBy(row => row.Model, StringComparer.OrdinalIgnoreCase);

    private int FilteredModelCostCount => _modelCosts.Count(ModelMatchesSearch);

    private int ModelPageCount => Math.Max(1, (int)Math.Ceiling(FilteredModelCostCount / (double)_modelPageSize));

    private IEnumerable<ModelCostRow> VisibleModelCosts => FilteredModelCosts
        .Skip((_modelPage - 1) * _modelPageSize)
        .Take(_modelPageSize);

    private string ModelResultSummary {
        get {
            var filteredCount = FilteredModelCostCount;
            if (filteredCount == 0) {
                return $"0 of {_modelCosts.Count} models";
            }

            var first = ((_modelPage - 1) * _modelPageSize) + 1;
            var last = Math.Min(_modelPage * _modelPageSize, filteredCount);
            var suffix = string.IsNullOrWhiteSpace(_modelSearch) ? "" : $" of {_modelCosts.Count}";
            return $"{first}-{last} of {filteredCount}{suffix} models";
        }
    }

    private bool ModelMatchesSearch(ModelCostRow row) =>
        string.IsNullOrWhiteSpace(_modelSearch)
        || row.Model.Contains(_modelSearch.Trim(), StringComparison.OrdinalIgnoreCase);

    private IEnumerable<PropertyInfo> NumericForTab(string tab) => NumericProperties.Where(property => tab switch
    {
        "limits" => property.Name is nameof(TokenomicsLimits.HourlyTokenLimit)
            or nameof(TokenomicsLimits.DailyTokenLimit)
            or nameof(TokenomicsLimits.MonthlyTokenLimit),
        "budgets" => property.Name is nameof(TokenomicsLimits.HourlyBudgetUsd)
            or nameof(TokenomicsLimits.DailyBudgetUsd)
            or nameof(TokenomicsLimits.MonthlyBudgetUsd),
        "capacity" => property.Name is nameof(TokenomicsSettings.CurrentCapacityUtilizationPercent)
            or nameof(TokenomicsSettings.CapacityConstraintThresholdPercent)
            or nameof(TokenomicsSettings.HighQueueDepthThreshold)
            or nameof(TokenomicsSettings.LargeContextThreshold)
            or nameof(TokenomicsSettings.DelayDuration),
        "priority" => property.Name is nameof(TokenomicsSettings.CriticalPriority) or nameof(TokenomicsSettings.HighPriority),
        "routing" => property.Name is nameof(TokenomicsSettings.DefaultModel) or nameof(TokenomicsSettings.ModelHierarchy),
        _ => false,
    });

    private IEnumerable<PropertyInfo> ActionsForTab(string tab) =>
        ActionProperties.Where(property => string.Equals(ActionTab(property.Name), tab, StringComparison.Ordinal)
            && property.Name is not (nameof(TokenomicsSettings.CriticalPriorityAction)
                or nameof(TokenomicsSettings.HighPriorityEntitledTenantAction)
                or nameof(TokenomicsSettings.TenantEntitlementAction)
                or nameof(TokenomicsSettings.GovernanceWorkloadAction)
                or nameof(TokenomicsSettings.DefaultAction)));

    private static string ActionTab(string name) => name switch {
        nameof(TokenomicsLimitActions.HourlyLimitAction)
            or nameof(TokenomicsLimitActions.DailyLimitAction)
            or nameof(TokenomicsLimitActions.MonthlyLimitAction) => "limits",
        nameof(TokenomicsLimitActions.HourlyBudgetExceededAction)
            or nameof(TokenomicsLimitActions.DailyBudgetExceededAction)
            or nameof(TokenomicsLimitActions.MonthlyBudgetExceededAction) => "budgets",
        nameof(TokenomicsSettings.CapacityCriticalWorkloadAction)
            or nameof(TokenomicsSettings.CapacityHighPriorityAction)
            or nameof(TokenomicsSettings.CapacityConstrainedAction)
            or nameof(TokenomicsSettings.QueueCriticalPriorityAction)
            or nameof(TokenomicsSettings.QueueDepthHighAction)
            or nameof(TokenomicsSettings.LargeContextCapacityAvailableAction)
            or nameof(TokenomicsSettings.LargeContextRequestAction) => "capacity",
        nameof(TokenomicsSettings.AbuseDetectedAction)
            or nameof(TokenomicsSettings.DefaultAction)
            or nameof(TokenomicsSettings.AdministratorOverrideAction)
            or nameof(TokenomicsSettings.CriticalPriorityAction)
            or nameof(TokenomicsSettings.HighPriorityEntitledTenantAction)
            or nameof(TokenomicsSettings.TenantEntitlementAction)
            or nameof(TokenomicsSettings.GovernanceWorkloadAction) => "priority",
        nameof(TokenomicsSettings.PreferredModelReplacementAction)
            or nameof(TokenomicsSettings.PreferredModelUnavailableAction) => "routing",
        _ => throw new InvalidOperationException($"No Tokenomics tab is assigned to action '{name}'.")
    };

    public static bool IsEnabled(IEnumerable<AppConfigurationScaffoldSetting> settings) {
        var enable = settings.FirstOrDefault(setting => string.Equals(setting.Name, "Enable", StringComparison.OrdinalIgnoreCase));
        return bool.TryParse(enable?.DraftValue, out var enabled) && enabled;
    }

    protected override void OnParametersSet() {
        if (!ReferenceEquals(Settings, _trackedSettings)) {
            _trackedSettings = Settings;
            _unhandledSettings = Settings
                .Where(setting => setting.Name.ToLowerInvariant() is not ("enable" or "options" or "metricsserver"))
                .ToList();
        }


        var setting = OptionsSetting;
        if (!ReferenceEquals(setting, _trackedOptionsSetting)
            || !string.Equals(setting?.DraftValue, _observedDraftValue, StringComparison.Ordinal)) {
            LoadOptions(setting);
        }
    }

    private void LoadOptions(AppConfigurationScaffoldSetting? setting) {
        _trackedOptionsSetting = setting;
        _observedDraftValue = setting?.DraftValue;
        _rawOptions = setting?.DraftValue ?? string.Empty;
        _modelPage = 1;
        _fieldErrors.Clear();
        _modelCosts.Clear();

        if (setting is null) {
            _options = new TokenomicsSettings();
            _loadedOptions = new TokenomicsSettings();
            _loadedOptionsValid = false;
            _parseError = null;
            return;
        }

        var parsedOptions = ParseOptions(setting.DraftValue);
        var parsedLoadedOptions = ParseOptions(setting.LoadedValue);
        _loadedOptionsValid = parsedLoadedOptions is not null;
        _loadedOptions = parsedLoadedOptions ?? new TokenomicsSettings();

        if (parsedOptions is null) {
            _options = new TokenomicsSettings();
            _parseError = "Tokenomics:Options must contain comma- or semicolon-separated key=value pairs.";
            return;
        }

        _options = parsedOptions;
        _parseError = null;
        foreach (var modelCost in _options.ModelCostPerToken) {
            _modelCosts.Add(new ModelCostRow(
                modelCost.Key,
                FormatStoredCost(modelCost.Value.Input),
                FormatStoredCost(modelCost.Value.CachedInput),
                FormatStoredCost(modelCost.Value.Output)));
        }

        var configuredModels = _modelCosts
            .Select(row => row.Model.Trim())
            .ToHashSet(StringComparer.Ordinal);
        foreach (var model in _options.ModelHierarchy.Values
            .SelectMany(models => models)
            .Select(model => model.Trim())
            .Where(model => model.Length > 0)) {
            if (configuredModels.Add(model)) {
                _modelCosts.Add(new ModelCostRow(model, string.Empty, string.Empty, string.Empty));
            }
        }

        SyncAssignedModelCostRows();
    }

    private static TokenomicsSettings? ParseOptions(string? value) {
        var options = new TokenomicsSettings();
        return string.IsNullOrWhiteSpace(value) || options.TryParse(value) ? options : null;
    }

    private async Task SetEnabledAsync(ChangeEventArgs args) {
        if (EnableSetting is not { } setting) {
            return;
        }

        var enabled = args.Value is bool isChecked && isChecked;
        setting.DraftValue = enabled ? "true" : "false";
        if (!enabled) {
            _expandedWidget = null;
        }
        await OnChanged.InvokeAsync();
    }

    private async Task RevertEnabledAsync() {
        if (EnableSetting is not { } setting) {
            return;
        }

        setting.RevertDraft();
        if (!Enabled) {
            _expandedWidget = null;
        }
        await OnChanged.InvokeAsync();
    }

    private void SetMetricsServer(string? value) {
        if (MetricsServerSetting is not { } setting) {
            return;
        }

        setting.DraftValue = value ?? string.Empty;
    }

    private Task NotifyChangedAsync() {
        if (MetricsServerSetting is { } setting
            && string.IsNullOrEmpty(setting.LoadedValue)
            && string.IsNullOrEmpty(setting.DraftValue)) {
            setting.DraftValue = "http://localhost:9100";
        }

        return OnChanged.InvokeAsync();
    }

    private async Task RevertMetricsServerAsync() {
        if (MetricsServerSetting is not { } setting) {
            return;
        }

        setting.RevertDraft();
        await OnChanged.InvokeAsync();
    }

    private void SetRawOptions(string? value) {
        if (OptionsSetting is not { } setting) {
            return;
        }

        _rawOptions = value ?? string.Empty;
        if (ParseOptions(_rawOptions) is null) {
            _parseError = "Tokenomics:Options must contain comma- or semicolon-separated key=value pairs.";
            return;
        }

        setting.DraftValue = _rawOptions;
        LoadOptions(setting);
    }

    private async Task SetOptionAsync(PropertyInfo property, ChangeEventArgs args, string? limitModel = null, string? workload = null) {
        var value = args.Value?.ToString() ?? string.Empty;
        var isLimit = property.DeclaringType == typeof(TokenomicsLimits) || property.DeclaringType == typeof(TokenomicsLimitActions);
        var errorKey = isLimit ? $"limits:{workload ?? limitModel ?? "default"}:{property.Name}" : property.Name;
        if (!TryParseValue(property.PropertyType, property.Name, value, out var parsedValue)
            || property.Name == nameof(TokenomicsSettings.DelayDuration) && parsedValue is int duration && duration < 0
            || property.DeclaringType == typeof(TokenomicsLimits) && Convert.ToDecimal(parsedValue, CultureInfo.InvariantCulture) < 0) {
            _fieldErrors[errorKey] = $"Enter a valid non-negative {FieldLabel(property.Name)} value.";
            await OnChanged.InvokeAsync();
            return;
        }

        var previousHierarchyModels = property.Name == nameof(TokenomicsSettings.ModelHierarchy)
            ? _options.ModelHierarchy.Values
                .SelectMany(models => models)
                .Select(model => model.Trim())
                .ToHashSet(StringComparer.Ordinal)
            : null;

        _fieldErrors.Remove(errorKey);
        if (isLimit && workload is null && limitModel is not null && (!_options.ModelLimits.ContainsKey(limitModel) || !_options.ModelLimitActions.ContainsKey(limitModel))) {
            var copy = ParseOptions(_options.ToString())!;
            _options.ModelLimits.TryAdd(limitModel, copy.DefaultLimits);
            _options.ModelLimitActions.TryAdd(limitModel, copy.DefaultLimitActions);
        }
        object target = workload == "PremiumWorkload" ? _options.PremiumWorkloadLimitActions
            : workload == "CriticalWorkload" ? _options.CriticalWorkloadLimitActions
            : property.DeclaringType == typeof(TokenomicsLimits)
            ? limitModel is null ? _options.DefaultLimits : _options.ModelLimits[limitModel]
            : property.DeclaringType == typeof(TokenomicsLimitActions)
                ? limitModel is null ? _options.DefaultLimitActions : _options.ModelLimitActions[limitModel]
                : _options;
        property.SetValue(target, parsedValue);

        if (property.Name == nameof(TokenomicsSettings.ModelHierarchy)) {
            var hierarchyModels = _options.ModelHierarchy.Values
                .SelectMany(models => models)
                .Select(model => model.Trim())
                .Where(model => model.Length > 0)
                .ToHashSet(StringComparer.Ordinal);

            _modelCosts.RemoveAll(row =>
                string.IsNullOrWhiteSpace(row.InputCost)
                && string.IsNullOrWhiteSpace(row.CachedInputCost)
                && string.IsNullOrWhiteSpace(row.OutputCost)
                && previousHierarchyModels!.Contains(row.Model.Trim())
                && !hierarchyModels.Contains(row.Model.Trim()));

            var configuredModels = _modelCosts
                .Select(row => row.Model.Trim())
                .ToHashSet(StringComparer.Ordinal);
            foreach (var model in hierarchyModels) {
                if (configuredModels.Add(model)) {
                    _modelCosts.Add(new ModelCostRow(model, string.Empty, string.Empty, string.Empty));
                }
            }

            _modelSearch = string.Empty;
            _modelPage = 1;
        }

        CommitOptions();
        await OnChanged.InvokeAsync();
    }

    private async Task SetAllowedHostsAsync((string Model, ChangeEventArgs Args) change) {
        var selectedHosts = change.Args.Value switch {
            string[] values => values,
            null => [],
            _ => null
        };
        if (selectedHosts is null) {
            _fieldErrors[nameof(TokenomicsSettings.ModelHostOptions)] = "Select hosts from the configured host list.";
            await OnChanged.InvokeAsync();
            return;
        }

        var existingHosts = _options.ModelHostOptions.TryGetValue(change.Model, out var currentModelHosts)
            ? currentModelHosts.Keys.ToHashSet(StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var selectableHosts = HostNames
            .Concat(existingHosts)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var normalizedHosts = selectedHosts
            .Select(host => host.Trim())
            .Where(host => host.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (normalizedHosts.Any(host => !selectableHosts.Contains(host))) {
            _fieldErrors[nameof(TokenomicsSettings.ModelHostOptions)] = "Select hosts from the configured host list.";
            await OnChanged.InvokeAsync();
            return;
        }

        foreach (var host in normalizedHosts.Where(host => !existingHosts.Contains(host))) {
            if (!_options.ModelHostOptions.TryGetValue(change.Model, out var modelHosts)) {
                modelHosts = new Dictionary<string, TokenomicsHostOptions>(StringComparer.OrdinalIgnoreCase);
                _options.ModelHostOptions[change.Model] = modelHosts;
            }

            var modelApis = ApisForRoutingModel(change.Model);
            var modelHostOptions = new TokenomicsHostOptions();
            foreach (var apiName in modelApis) {
                modelHostOptions.APIs[apiName] = new TokenomicsApiOptions {
                    PassThrough = false,
                    OverridePath = false,
                    Path = null
                };
            }
            modelHosts[host] = modelHostOptions;
        }

        foreach (var host in existingHosts.Where(host => !normalizedHosts.Contains(host, StringComparer.OrdinalIgnoreCase))) {
            if (_options.ModelHostOptions.TryGetValue(change.Model, out var modelHosts)) {
                modelHosts.Remove(host);
                if (modelHosts.Count == 0) {
                    _options.ModelHostOptions.Remove(change.Model);
                }
            }
        }

        _fieldErrors.Remove(nameof(TokenomicsSettings.ModelHostOptions));

        CommitOptions();
        await OnChanged.InvokeAsync();
    }

    private List<string> ApisForRoutingModel(string model) =>
        ChatCatalog.ApisForModel(model)
            .Select(api => api.DisplayName)
            .Concat(VisionCatalog.ApisForModel(model).Select(api => api.DisplayName))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task SetHostApiAsync(
        (string? Model, string Host, string Api, TokenomicsApiOptions? Options) change) {
        if (change.Model is null
            || !_options.ModelHostOptions.TryGetValue(change.Model, out var modelHosts)
            || !modelHosts.TryGetValue(change.Host, out var hostOptions)) {
            return;
        }

        if (change.Options is null) {
            hostOptions.APIs.Remove(change.Api);
        } else {
            hostOptions.APIs[change.Api] = new TokenomicsApiOptions {
                PassThrough = change.Options.PassThrough,
                OverridePath = change.Options.OverridePath,
                Path = change.Options.Path
            };
        }

        CommitOptions();
        await OnChanged.InvokeAsync();
    }

    private async Task SetModelHostApiAsync(
        (string Model, string Host, string Api, TokenomicsApiOptions Options) change) {
        if (!_options.ModelHostOptions.TryGetValue(change.Model, out var modelHosts)) {
            modelHosts = new Dictionary<string, TokenomicsHostOptions>(StringComparer.OrdinalIgnoreCase);
            _options.ModelHostOptions[change.Model] = modelHosts;
        }
        if (!modelHosts.TryGetValue(change.Host, out var hostOptions)) {
            hostOptions = new TokenomicsHostOptions();
            modelHosts[change.Host] = hostOptions;
        }

        hostOptions.APIs[change.Api] = new TokenomicsApiOptions {
            PassThrough = change.Options.PassThrough,
            OverridePath = change.Options.OverridePath,
            Path = change.Options.Path
        };
        CommitOptions();
        await OnChanged.InvokeAsync();
    }

    private static bool TryParseValue(Type type, string propertyName, string value, out object? parsedValue) {
        parsedValue = null;
        if (propertyName == nameof(TokenomicsSettings.DelayDuration)) {
            var durationParts = value.Split(':');
            if (durationParts.Length == 3
                && durationParts[0].Length >= 2
                && durationParts[1].Length == 2
                && durationParts[2].Length == 3
                && long.TryParse(durationParts[0], NumberStyles.None, CultureInfo.InvariantCulture, out var minutes)
                && minutes >= 0
                && minutes <= int.MaxValue / 60000L
                && int.TryParse(durationParts[1], NumberStyles.None, CultureInfo.InvariantCulture, out var seconds)
                && seconds is >= 0 and <= 59
                && int.TryParse(durationParts[2], NumberStyles.None, CultureInfo.InvariantCulture, out var milliseconds)
                && milliseconds is >= 0 and <= 999) {
                var totalMilliseconds = (minutes * 60000L) + (seconds * 1000L) + milliseconds;
                if (totalMilliseconds <= int.MaxValue) {
                    parsedValue = (int)totalMilliseconds;
                }
            }
        } else if (type == typeof(string)) {
            parsedValue = value;
        } else if (type == typeof(int) && int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var integer)) {
            parsedValue = integer;
        } else if (type == typeof(decimal) && decimal.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var decimalValue)) {
            parsedValue = decimalValue;
        } else if (type == typeof(double) && double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var doubleValue) && double.IsFinite(doubleValue)) {
            parsedValue = doubleValue;
        } else if (type == typeof(float) && float.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var floatValue) && float.IsFinite(floatValue)) {
            parsedValue = floatValue;
        } else if (type == typeof(bool) && bool.TryParse(value, out var boolValue)) {
            parsedValue = boolValue;
        } else if (type == typeof(TokenActionEnum)
            && Enum.TryParse<TokenActionEnum>(value, true, out var action)
            && Enum.IsDefined(action)) {
            parsedValue = action;
        } else if (type == typeof(Dictionary<string, List<string>>)) {
            var options = new TokenomicsSettings();
            if (!value.Contains(';')
                && !value.Contains('=')
                && options.TryParse($"{nameof(TokenomicsSettings.ModelHierarchy)}={value}")) {
                parsedValue = options.ModelHierarchy;
            }
        }

        return parsedValue is not null;
    }

    private void AddModelCost() {
        _modelCosts.Insert(0, new ModelCostRow(string.Empty, string.Empty, string.Empty, string.Empty));
        _modelSearch = string.Empty;
        _modelPage = 1;
    }

    private void SetModelSearch(ChangeEventArgs args) {
        _modelSearch = args.Value?.ToString() ?? string.Empty;
        _modelPage = 1;
    }

    private void ClearModelSearch() {
        _modelSearch = string.Empty;
        _modelPage = 1;
    }

    private void SetModelPageSize(ChangeEventArgs args) {
        if (int.TryParse(args.Value?.ToString(), out var pageSize) && pageSize is 25 or 50 or 100) {
            _modelPageSize = pageSize;
            _modelPage = 1;
        }
    }

    private void SetModelPage(int page) {
        _modelPage = Math.Clamp(page, 1, ModelPageCount);
    }

    private async Task SetModelCostAsync(
        ModelCostRow row,
        string? model,
        string? inputCost,
        string? cachedInputCost,
        string? outputCost) {
        if (model is not null) {
            row.Model = model;
        }
        if (inputCost is not null) {
            row.InputCost = inputCost;
        }
        if (cachedInputCost is not null) {
            row.CachedInputCost = cachedInputCost;
        }
        if (outputCost is not null) {
            row.OutputCost = outputCost;
        }

        TryCommitModelCosts();
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveModelCostAsync(ModelCostRow row) {
        _modelCosts.Remove(row);
        _modelPage = Math.Min(_modelPage, ModelPageCount);
        TryCommitModelCosts();
        await OnChanged.InvokeAsync();
    }

    private bool TryCommitModelCosts() {
        var costs = new Dictionary<string, ModelTokenPricing>(StringComparer.Ordinal);
        var models = new HashSet<string>(StringComparer.Ordinal);
        var hierarchyModels = _options.ModelHierarchy.Values
            .SelectMany(hierarchy => hierarchy)
            .Select(model => model.Trim())
            .ToHashSet(StringComparer.Ordinal);
        var valid = true;
        foreach (var row in _modelCosts) {
            row.ModelError = null;
            row.InputCostError = null;
            row.CachedInputCostError = null;
            row.OutputCostError = null;
            var model = row.Model.Trim();
            if (string.IsNullOrEmpty(model)) {
                row.ModelError = "Enter a model name.";
                valid = false;
            } else if (!models.Add(model)) {
                row.ModelError = "Model names must be unique.";
                valid = false;
            }

            var isUnpricedPlaceholder = row.ModelError is null
                && string.IsNullOrWhiteSpace(row.InputCost)
                && string.IsNullOrWhiteSpace(row.CachedInputCost)
                && string.IsNullOrWhiteSpace(row.OutputCost)
                && (hierarchyModels.Contains(model) || _options.ModelHostOptions.ContainsKey(model));
            if (isUnpricedPlaceholder) {
                continue;
            }

            if (!TryParseEditorCost(row.InputCost, out var inputCost)) {
                row.InputCostError = "Enter a non-negative input cost.";
                valid = false;
            }

            if (!TryParseEditorCost(row.CachedInputCost, out var cachedInputCost)) {
                row.CachedInputCostError = "Enter a non-negative cached input cost.";
                valid = false;
            }

            if (!TryParseEditorCost(row.OutputCost, out var outputCost)) {
                row.OutputCostError = "Enter a non-negative output cost.";
                valid = false;
            }

            if (row.ModelError is null
                && row.InputCostError is null
                && row.CachedInputCostError is null
                && row.OutputCostError is null) {
                costs[model] = new ModelTokenPricing {
                    Input = inputCost,
                    CachedInput = cachedInputCost,
                    Output = outputCost
                };
            }
        }

        if (!valid) {
            return false;
        }

        _options.ModelCostPerToken = costs;
        CommitOptions();
        return true;
    }

    private void CommitOptions() {
        if (OptionsSetting is not { } setting) {
            return;
        }

        var serialized = _options.ToString();
        setting.DraftValue = _loadedOptionsValid
            && string.Equals(serialized, _loadedOptions.ToString(), StringComparison.Ordinal)
                ? setting.LoadedValue
                : serialized;
        _observedDraftValue = setting.DraftValue;
    }

    private async Task RevertOptionsAsync() {
        if (OptionsSetting is not { } setting) {
            return;
        }

        setting.RevertDraft();
        LoadOptions(setting);
        await OnChanged.InvokeAsync();
    }

    private bool IsOptionChanged(PropertyInfo property, string? model = null, string? workload = null) {
        if (workload is not null) {
            var current = workload == "PremiumWorkload" ? _options.PremiumWorkloadLimitActions : _options.CriticalWorkloadLimitActions;
            var loaded = workload == "PremiumWorkload" ? _loadedOptions.PremiumWorkloadLimitActions : _loadedOptions.CriticalWorkloadLimitActions;
            return !Equals(property.GetValue(current), property.GetValue(loaded));
        }
        if (property.DeclaringType == typeof(TokenomicsLimits)) {
            var current = model is not null && _options.ModelLimits.TryGetValue(model, out var limits) ? limits : _options.DefaultLimits;
            var loaded = model is not null && _loadedOptions.ModelLimits.TryGetValue(model, out var loadedLimits) ? loadedLimits : _loadedOptions.DefaultLimits;
            return !Equals(property.GetValue(current), property.GetValue(loaded))
                || model is not null && _options.ModelLimits.ContainsKey(model) != _loadedOptions.ModelLimits.ContainsKey(model);
        }
        if (property.DeclaringType == typeof(TokenomicsLimitActions)) {
            var current = model is not null && _options.ModelLimitActions.TryGetValue(model, out var actions) ? actions : _options.DefaultLimitActions;
            var loaded = model is not null && _loadedOptions.ModelLimitActions.TryGetValue(model, out var loadedActions) ? loadedActions : _loadedOptions.DefaultLimitActions;
            return !Equals(property.GetValue(current), property.GetValue(loaded))
                || model is not null && _options.ModelLimitActions.ContainsKey(model) != _loadedOptions.ModelLimitActions.ContainsKey(model);
        }
        if (property.Name == nameof(TokenomicsSettings.ModelHierarchy)) {
            return _options.ModelHierarchy.Count != _loadedOptions.ModelHierarchy.Count
                || _options.ModelHierarchy.Any(entry =>
                    !_loadedOptions.ModelHierarchy.TryGetValue(entry.Key, out var loadedModels)
                    || !entry.Value.SequenceEqual(loadedModels, StringComparer.Ordinal));
        }

        return !Equals(property.GetValue(_options), property.GetValue(_loadedOptions));
    }

    private bool IsModelCostChanged(ModelCostRow row) {
        var model = row.Model.Trim();
        if (string.IsNullOrWhiteSpace(row.InputCost)
            && string.IsNullOrWhiteSpace(row.CachedInputCost)
            && string.IsNullOrWhiteSpace(row.OutputCost)
            && IsUnpricedModelPlaceholder(model)) {
            return _loadedOptions.ModelCostPerToken.ContainsKey(model);
        }

        if (!_loadedOptions.ModelCostPerToken.TryGetValue(model, out var loadedPricing)) {
            return true;
        }

        return !string.Equals(row.InputCost.Trim(), FormatStoredCost(loadedPricing.Input), StringComparison.Ordinal)
            || !string.Equals(row.CachedInputCost.Trim(), FormatStoredCost(loadedPricing.CachedInput), StringComparison.Ordinal)
            || !string.Equals(row.OutputCost.Trim(), FormatStoredCost(loadedPricing.Output), StringComparison.Ordinal);
    }

    private bool IsUnpricedModelPlaceholder(string model) =>
        _options.ModelHierarchy.Values
            .SelectMany(models => models)
            .Any(hierarchyModel => string.Equals(hierarchyModel.Trim(), model, StringComparison.Ordinal))
        || _options.ModelHostOptions.ContainsKey(model);

    private void SyncAssignedModelCostRows() {
        var configuredModels = new HashSet<string>(
            _modelCosts.Select(row => row.Model.Trim()),
            StringComparer.OrdinalIgnoreCase);
        foreach (var model in _options.ModelHostOptions.Keys) {
            var trimmed = model.Trim();
            if (trimmed.Length == 0 || !configuredModels.Add(trimmed)) {
                continue;
            }

            _modelCosts.Add(new ModelCostRow(trimmed, string.Empty, string.Empty, string.Empty));
        }
    }

    private void SetCostsPerMillion(ChangeEventArgs args) {
        var next = args.Value is bool isChecked && isChecked;
        if (next == _costsPerMillion) {
            return;
        }

        foreach (var row in _modelCosts) {
            row.InputCost = RescaleCostText(row.InputCost, next);
            row.CachedInputCost = RescaleCostText(row.CachedInputCost, next);
            row.OutputCost = RescaleCostText(row.OutputCost, next);
        }

        _costsPerMillion = next;
    }

    private string RescaleCostText(string text, bool toPerMillion) {
        if (string.IsNullOrWhiteSpace(text)
            || !decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value)) {
            return text;
        }

        var scaled = toPerMillion ? value * TokensPerMillion : value / TokensPerMillion;
        return FormatCost(scaled);
    }

    private string FormatStoredCost(decimal perToken) =>
        FormatCost(_costsPerMillion ? perToken * TokensPerMillion : perToken);

    private static string FormatCost(decimal value) =>
        value.ToString("0.#############################", CultureInfo.InvariantCulture);

    private bool TryParseEditorCost(string text, out decimal perToken) {
        perToken = 0;
        if (!decimal.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var entered) || entered < 0) {
            return false;
        }

        perToken = _costsPerMillion ? entered / TokensPerMillion : entered;
        return true;
    }

    private static string InputStep(Type type) => type == typeof(int) ? "1" : "any";

    private static string FormatValue(object? value, string? propertyName = null) => value switch {
        null => string.Empty,
        int duration when propertyName == nameof(TokenomicsSettings.DelayDuration) && duration >= 0 =>
            string.Create(CultureInfo.InvariantCulture,
                $"{duration / 60000:D2}:{duration / 1000 % 60:D2}:{duration % 1000:D3}"),
        bool boolean => boolean.ToString().ToLowerInvariant(),
        Dictionary<string, List<string>> hierarchy => string.Join(", ", hierarchy.Select(entry =>
            $"{Uri.EscapeDataString(entry.Key)}: [{string.Join(", ", entry.Value.Select(Uri.EscapeDataString))}]")),
        IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture) ?? string.Empty,
        _ => value.ToString() ?? string.Empty
    };

    private static string FieldLabel(string name) {
        if (name == nameof(TokenomicsSettings.DelayDuration)) {
            return "delay duration (mm:ss:mmm)";
        }

        var builder = new System.Text.StringBuilder(name.Length + 8);
        for (var index = 0; index < name.Length; index++) {
            var character = name[index];
            if (index > 0 && char.IsUpper(character) && !char.IsUpper(name[index - 1])) {
                builder.Append(' ');
            }
            builder.Append(char.ToLowerInvariant(character));
        }

        return builder.ToString().Replace(" usd", " USD", StringComparison.Ordinal);
    }


    private RenderFragment RenderField(string name, bool compact = false, string? model = null) {
        var workload = name switch {
            nameof(TokenomicsSettings.PremiumWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.HourlyLimitAction)
                or nameof(TokenomicsSettings.PremiumWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.DailyLimitAction)
                or nameof(TokenomicsSettings.PremiumWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.MonthlyLimitAction)
                or nameof(TokenomicsSettings.PremiumWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.HourlyBudgetExceededAction)
                or nameof(TokenomicsSettings.PremiumWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.DailyBudgetExceededAction)
                or nameof(TokenomicsSettings.PremiumWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.MonthlyBudgetExceededAction) => "PremiumWorkload",
            nameof(TokenomicsSettings.CriticalWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.HourlyLimitAction)
                or nameof(TokenomicsSettings.CriticalWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.DailyLimitAction)
                or nameof(TokenomicsSettings.CriticalWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.MonthlyLimitAction)
                or nameof(TokenomicsSettings.CriticalWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.HourlyBudgetExceededAction)
                or nameof(TokenomicsSettings.CriticalWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.DailyBudgetExceededAction)
                or nameof(TokenomicsSettings.CriticalWorkloadLimitActions) + "." + nameof(TokenomicsLimitActions.MonthlyBudgetExceededAction) => "CriticalWorkload",
            _ => null
        };
        var propertyName = workload switch {
            "PremiumWorkload" => name[(nameof(TokenomicsSettings.PremiumWorkloadLimitActions).Length + 1)..],
            "CriticalWorkload" => name[(nameof(TokenomicsSettings.CriticalWorkloadLimitActions).Length + 1)..],
            _ => name
        };
        var property = OptionProperties.Single(property => property.Name == propertyName);
        object target = workload == "PremiumWorkload" ? _options.PremiumWorkloadLimitActions
            : workload == "CriticalWorkload" ? _options.CriticalWorkloadLimitActions
            : property.DeclaringType == typeof(TokenomicsLimits)
            ? model is not null && _options.ModelLimits.TryGetValue(model, out var limits) ? limits : _options.DefaultLimits
            : property.DeclaringType == typeof(TokenomicsLimitActions)
                ? model is not null && _options.ModelLimitActions.TryGetValue(model, out var actions) ? actions : _options.DefaultLimitActions
                : _options;
        var errorKey = property.DeclaringType == typeof(TokenomicsLimits) || property.DeclaringType == typeof(TokenomicsLimitActions)
            ? $"limits:{workload ?? model ?? "default"}:{property.Name}" : property.Name;
        if (name == nameof(TokenomicsSettings.DefaultModelAPI)) {
            var apiNames = RoutingApis.Select(api => api.Name)
                .Concat(_options.ModelHostOptions.Values.SelectMany(hosts => hosts.Values)
                    .SelectMany(host => host.APIs.Keys))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();
            return @<div class="config-newhost-field @(IsOptionChanged(property) ? "config-field-changed" : string.Empty)">
                <div class="config-setting-heading">
                    <ConfigurationHelp Section="Tokenomics" Topic="DefaultModelAPI">
                        <label class="form-label" for="tokenomics-DefaultModelAPI">Default Model API</label>
                    </ConfigurationHelp>
                </div>
                <select id="tokenomics-DefaultModelAPI" class="form-select form-select-sm" value="@_options.DefaultModelAPI"
                        aria-label="Default Model API" @onchange="@(args => SetOptionAsync(property, args))">
                    <option value="">Not configured</option>
                    @if (!string.IsNullOrEmpty(_options.DefaultModelAPI)
                        && !apiNames.Contains(_options.DefaultModelAPI, StringComparer.OrdinalIgnoreCase))
                    {
                        <option value="@_options.DefaultModelAPI" disabled>@_options.DefaultModelAPI</option>
                    }
                    @foreach (var apiName in apiNames)
                    {
                        <option value="@apiName">@apiName</option>
                    }
                </select>
                @if (_fieldErrors.TryGetValue(property.Name, out var apiError))
                {
                    <span class="small text-danger" role="alert">@apiError</span>
                }
            </div>;
        }
        return @<TokenomicsOptionFieldWidget Name="@name"
            Label="@(workload is null ? FieldLabel(name) : $"{(workload == "CriticalWorkload" ? "Privileged workload" : "Premium workload")} {FieldLabel(property.Name)}")"
            Value="@FormatValue(property.GetValue(target), property.Name)" Step="@InputStep(property.PropertyType)"
            InputType="@(property.PropertyType == typeof(string) || property.Name == nameof(TokenomicsSettings.DelayDuration) ? "text" : "number")"
            Error="@(_fieldErrors.TryGetValue(errorKey, out var error) ? error : null)"
            IsChanged="@IsOptionChanged(property, model, workload)" IsAction="@(property.PropertyType == typeof(TokenActionEnum))"
            Compact="compact" ActionLabel="@(action => FieldLabel(action.ToString()))"
            OnChanged="@(args => SetOptionAsync(property, args, model, workload))" />;
    }


    /// <summary>Editable model pricing and validation state shared with the model-cost widget.</summary>
    public sealed class ModelCostRow(
        string model,
        string inputCost,
        string cachedInputCost,
        string outputCost) {
        public Guid Id { get; } = Guid.NewGuid();
        public string Model { get; set; } = model;
        public string InputCost { get; set; } = inputCost;
        public string CachedInputCost { get; set; } = cachedInputCost;
        public string OutputCost { get; set; } = outputCost;
        public string? ModelError { get; set; }
        public string? InputCostError { get; set; }
        public string? CachedInputCostError { get; set; }
        public string? OutputCostError { get; set; }
    }
