    .header-policy-section-heading { margin-bottom: 0.75rem; }
    .header-policy-section-heading h3 { margin-bottom: 0; }
    .header-policy-section-heading p { margin: 0.2rem 0 0; color: #596c96; font-size: 0.82rem; }
