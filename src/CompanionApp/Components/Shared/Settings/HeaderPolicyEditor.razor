@namespace CompanionApp.Components.Shared
@using SimpleL7Proxy.Config

@{
    var requiredHeaders = FindSetting(Settings, "RequiredHeaders");
    var blockedHeaders = FindSetting(Settings, "DisallowedHeaders");
    var validatedHeaders = FindSetting(Settings, "Headers:ValidateHeaders");
    var priorityHeader = FindSetting(Settings, "Headers:PriorityKeyHeader");
    var timeoutHeader = FindSetting(Settings, "Headers:TimeoutHeader");
    var ttlHeader = FindSetting(Settings, "Headers:TTLHeader");
    var asyncModeHeader = FindSetting(Settings, "Headers:AsyncMode");
    var uniqueUserHeaders = FindSetting(Settings, "Headers:UniqueUserHeaders");
    var strippedRequestHeaders = FindSetting(Settings, "StripRequestHeaders");
    var strippedResponseHeaders = FindSetting(Settings, "StripResponseHeaders");
    var dependencyHeaders = FindSetting(Settings, "DependancyHeaders");
    var selectedHeaderSetting = string.IsNullOrWhiteSpace(SelectedHeaderSet)
        ? null
        : FindSetting(Settings, SelectedHeaderSet);
    var isValidationHeaderSet = IsValidationHeaderSet(selectedHeaderSetting?.Name);
    var selectedHeaders = isValidationHeaderSet
        ? []
        : ParseHeaderValues(selectedHeaderSetting?.DraftValue);
    var validationRules = ParseValidationRules(validatedHeaders?.DraftValue, out var validationParseError);

    var proxyHeaderSettings = new[] { priorityHeader, timeoutHeader, ttlHeader, asyncModeHeader, uniqueUserHeaders }
        .OfType<AppConfigurationScaffoldSetting>()
        .ToList();
}

<div class="header-policy-editor">
    @if (selectedHeaderSetting is null)
    {
        <div class="header-policy-info" role="note">
            <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
            <p>Configure how headers are validated, removed, forwarded, and captured by the proxy.</p>
        </div>

        <section class="header-policy-section" aria-labelledby="header-policy-flow-heading">
            <h3 id="header-policy-flow-heading">Header flow</h3>
            <div class="header-policy-flow-image">
                <img src="images/azure/flow.png"
                     alt="Header policy flow showing incoming header checks, request processing through the proxy and backend, response-header filtering, and the HTTP 417 rejection path." />
            </div>
        </section>

        <section class="header-policy-section" aria-labelledby="header-policy-summary-heading">
            <h3 id="header-policy-summary-heading">Summary</h3>
            <div class="header-policy-summary-grid">
                <button type="button" class="header-policy-summary-card" disabled="@(requiredHeaders is null)"
                        @onclick="() => OpenHeaderSetAsync(requiredHeaders)">
                    <span>Required headers</span>
                    <strong>@CountValues(requiredHeaders)</strong>
                    <small>Headers must be present</small>
                </button>
                <button type="button" class="header-policy-summary-card" disabled="@(validatedHeaders is null)"
                        @onclick="() => OpenHeaderSetAsync(validatedHeaders)">
                    <span>Validated headers</span>
                    <strong>@(validationParseError is null ? validationRules.Count.ToString() : "!")</strong>
                    <small>Values must match an allowlist</small>
                </button>
                <button type="button" class="header-policy-summary-card" disabled="@(blockedHeaders is null)"
                        @onclick="() => OpenHeaderSetAsync(blockedHeaders)">
                    <span>Blocked headers</span>
                    <strong>@CountValues(blockedHeaders)</strong>
                    <small>Removed from requests</small>
                </button>
                <button type="button" class="header-policy-summary-card" disabled="@(strippedRequestHeaders is null)"
                        @onclick="() => OpenHeaderSetAsync(strippedRequestHeaders)">
                    <span>Removed before backend</span>
                    <strong>@CountValues(strippedRequestHeaders)</strong>
                    <small>Stripped from requests</small>
                </button>
                <button type="button" class="header-policy-summary-card" disabled="@(strippedResponseHeaders is null)"
                        @onclick="() => OpenHeaderSetAsync(strippedResponseHeaders)">
                    <span>Removed before client</span>
                    <strong>@CountValues(strippedResponseHeaders)</strong>
                    <small>Stripped from responses</small>
                </button>
                <button type="button" class="header-policy-summary-card" disabled="@(dependencyHeaders is null)"
                        @onclick="() => OpenHeaderSetAsync(dependencyHeaders)">
                    <span>Dependency headers</span>
                    <strong>@CountValues(dependencyHeaders)</strong>
                    <small>Captured for dependency events</small>
                </button>
            </div>
        </section>

        @if (validationParseError is not null)
        {
            <div class="alert alert-danger py-2" role="alert">
                <strong>Validated headers could not be read.</strong> @validationParseError
            </div>
        }

        <section class="header-policy-section" aria-labelledby="header-policy-proxy-heading">
            <div class="header-policy-section-heading">
                <h3 id="header-policy-proxy-heading">Common proxy headers</h3>
                <p>Configure the request headers used for priority, timeout, TTL, asynchronous mode, and user identity.</p>
            </div>
            <ConfigurationFields Settings="proxyHeaderSettings" OnChanged="OnChanged" />
        </section>

    }
    else if (isValidationHeaderSet)
    {
        <div class="header-validation-editor">
            @if (validationParseError is not null)
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Validated headers could not be read.</strong> @validationParseError
                </div>
            }
            else if (_isEditingValidationRule)
            {
                <form @onsubmit="SaveValidationRuleAsync" @onsubmit:preventDefault="true">
                    <div class="header-set-info" role="note">
                        <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
                        <p>Requests must contain all headers in this set, and each header value must match one of the allowed values. Header names and values are case-insensitive.</p>
                    </div>

                    <div class="header-validation-layout">
                        <div class="header-validation-fields">
                            <div>
                                <label class="form-label" for="validation-header-name">Header name <span class="text-danger">*</span></label>
                                <input id="validation-header-name" class="form-control" autocomplete="off"
                                       placeholder="X-Requested-Model"
                                       @bind="_validationHeaderName" @bind:event="oninput" />
                                <div class="form-text">Name of the header to validate.</div>
                            </div>

                            <fieldset class="header-validation-match">
                                <legend>Match type <span class="bi bi-question-circle text-primary" title="Exact matching compares the full value. Prefix wildcard matching enables a trailing * wildcard." aria-hidden="true"></span></legend>
                                <div class="header-validation-match-options">
                                    <label for="validation-match-exact">
                                        <span>
                                            <input id="validation-match-exact" class="form-check-input" type="radio"
                                                   name="validation-match-type"
                                                   checked="@(_validationMatchType == HeaderValidationMatchType.Exact)"
                                                   @onchange="_ => _validationMatchType = HeaderValidationMatchType.Exact" />
                                            <strong>Exact match</strong>
                                        </span>
                                        <small>Header value must exactly match one of the allowed values.</small>
                                    </label>
                                    <label for="validation-match-prefix">
                                        <span>
                                            <input id="validation-match-prefix" class="form-check-input" type="radio"
                                                   name="validation-match-type"
                                                   checked="@(_validationMatchType == HeaderValidationMatchType.PrefixWildcard)"
                                                   @onchange="_ => _validationMatchType = HeaderValidationMatchType.PrefixWildcard" />
                                            <strong>Prefix wildcard</strong>
                                        </span>
                                        <small>A trailing * is treated as a wildcard (e.g. gpt-4*).</small>
                                    </label>
                                </div>
                            </fieldset>

                            <div>
                                <label class="form-label" for="validation-allowed-values">Allowed values <span class="text-danger">*</span></label>
                                <textarea id="validation-allowed-values" class="form-control" rows="3"
                                          placeholder="gpt-4o,gpt-4.1"
                                          @bind="_validationAllowedValues" @bind:event="oninput"></textarea>
                                <div class="form-text">Comma-separated list of allowed values. Spaces are trimmed.</div>
                            </div>

                            <div>
                                <label class="form-label" for="validation-allowlist-header">
                                    Map to another header (optional)
                                    <span class="bi bi-question-circle text-primary" title="Values from this header are added to the allowlist after profile enrichment." aria-hidden="true"></span>
                                </label>
                                <input id="validation-allowlist-header" class="form-control" autocomplete="off"
                                       placeholder="e.g., X-Requested-Model=X-Allowed-Models"
                                       @bind="_validationAllowedValuesHeader" @bind:event="oninput" />
                                <div class="form-text">If configured, values from the mapped header are added to this rule's allowlist.</div>
                            </div>
                        </div>

                        <aside class="header-validation-help" aria-label="Header validation behavior">
                            <h3>How it works <span class="bi bi-question-circle text-primary" aria-hidden="true"></span></h3>
                            <ol>
                                <li>
                                    <span>1</span>
                                    <div>
                                        <strong>Exact match</strong>
                                        <p>Allowed value: <code>gpt-4o</code></p>
                                        <p>Matches: <code>gpt-4o</code>, <code>GPT-4O</code></p>
                                    </div>
                                </li>
                                <li>
                                    <span>2</span>
                                    <div>
                                        <strong>Prefix wildcard</strong>
                                        <p>Allowed value: <code>gpt-4*</code></p>
                                        <p>Matches: <code>gpt-4o</code>, <code>gpt-4.1</code></p>
                                        <p>Only a trailing <code>*</code> is interpreted as a wildcard.</p>
                                    </div>
                                </li>
                                <li>
                                    <span>3</span>
                                    <div>
                                        <strong>Map to another header (optional)</strong>
                                        <p>Example: <code>X-Requested-Model=X-Allowed-Models</code></p>
                                        <p>Values from <code>X-Allowed-Models</code> are added to the configured allowlist.</p>
                                    </div>
                                </li>
                            </ol>

                            <h3>Limitations <span class="bi bi-question-circle text-primary" aria-hidden="true"></span></h3>
                            <ul>
                                <li>Contains or suffix matching is not supported</li>
                                <li>Leading or middle wildcards are not supported</li>
                                <li>Regular expressions are not supported</li>
                                <li>Numeric comparisons are not supported</li>
                                <li>AND conditions within one rule are not supported</li>
                            </ul>
                        </aside>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_headerSetError))
                    {
                        <div class="alert alert-danger py-2 mt-3" role="alert">@_headerSetError</div>
                    }

                    <div class="header-validation-actions">
                        <div>
                            @if (_editingValidationRuleIndex.HasValue)
                            {
                                <button type="button" class="btn btn-outline-danger" @onclick="RemoveValidationRuleAsync">
                                    <span class="bi bi-trash me-1" aria-hidden="true"></span>Remove header
                                </button>
                            }
                        </div>
                        <div>
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelValidationRuleAsync">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save</button>
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="header-set-info" role="note">
                    <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
                    <p>Select a validated header to edit its allowlist and matching behavior.</p>
                </div>

                <section class="header-set-section" aria-labelledby="validated-header-list-heading">
                    <div class="header-set-list-heading">
                        <h3 id="validated-header-list-heading">Headers (@validationRules.Count)</h3>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartAddingValidationRule">
                            <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Add header
                        </button>
                    </div>
                    <div class="table-responsive header-set-list-scroll">
                        <table class="table table-sm align-middle header-set-table">
                            <thead>
                                <tr><th scope="col">Name</th></tr>
                            </thead>
                            <tbody>
                                @for (var index = 0; index < validationRules.Count; index++)
                                {
                                    var ruleIndex = index;
                                    var rule = validationRules[index];
                                    <tr>
                                        <td>
                                            <button type="button" class="validation-rule-link"
                                                    @onclick="() => EditValidationRule(ruleIndex)">
                                                @rule.HeaderName
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>
    }
    else
    {
        <div class="header-set-editor">
            <div class="header-set-info" role="note">
                <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
                <p>@HeaderSetGuidance(selectedHeaderSetting.Name)</p>
            </div>

            <section class="header-set-section" aria-labelledby="header-set-list-heading">
                <div class="header-set-list-heading">
                    <h3 id="header-set-list-heading">Headers (@selectedHeaders.Count)</h3>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartAddingHeader">
                        <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Add header
                    </button>
                </div>

                <div class="table-responsive header-set-list-scroll">
                    <table class="table table-sm align-middle header-set-table">
                        <thead>
                            <tr>
                                <th scope="col">Name</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (selectedHeaders.Count == 0)
                            {
                                <tr>
                                    <td class="text-muted">
                                        No headers are configured in this set.
                                    </td>
                                </tr>
                            }
                            @foreach (var header in selectedHeaders)
                            {
                                <tr>
                                    <td class="font-monospace">@header</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            @if (_isAddingHeader)
            {
                <form class="header-set-form" @onsubmit="SaveHeaderAsync" @onsubmit:preventDefault="true">
                    <h3>Add header</h3>
                    <div class="header-set-form-grid">
                        <div>
                            <label class="form-label" for="header-set-name">Header name <span class="text-danger">*</span></label>
                            <input id="header-set-name" class="form-control" autocomplete="off"
                                   placeholder="e.g., X-Client-Version"
                                   @bind="_headerName" @bind:event="oninput" />
                        </div>
                        <div class="header-set-add-behavior">
                            <strong>Action</strong>
                            <span>@HeaderSetBehavior(selectedHeaderSetting.Name)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_headerSetError))
                    {
                        <div class="text-danger small mt-2" role="alert">@_headerSetError</div>
                    }
                    <div class="header-set-form-actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelAddHeader">Cancel</button>
                        <button type="submit" class="btn btn-primary">Add</button>
                    </div>
                </form>
            }

            <div class="header-set-info header-set-info-compact" role="note">
                <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
                <p>Headers are matched by name only. Values are not used.</p>
            </div>
        </div>
    }
</div>

<style>
    .header-policy-editor { color: #071c61; }
    .header-policy-info, .header-set-info { display: flex; align-items: flex-start; gap: 0.85rem; margin-bottom: 1rem; padding: 0.85rem 1rem; border: 1px solid #86b7fe; border-radius: 6px; background: #e8f2ff; color: #38558b; }
    .header-policy-info > .bi, .header-set-info > .bi { flex: 0 0 auto; margin-top: 0.1rem; color: #0d6efd; font-size: 1.35rem; }
