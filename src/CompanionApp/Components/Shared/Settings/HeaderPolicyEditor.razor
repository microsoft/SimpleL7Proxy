    .header-set-form-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(12rem, 1fr); align-items: end; gap: 1rem; margin-top: 0.85rem; }
    .header-set-add-behavior { display: flex; flex-direction: column; min-height: 2.4rem; padding-bottom: 0.35rem; }
    .header-set-add-behavior span { color: #596c96; font-size: 0.78rem; }
    .header-set-form-actions { display: flex; justify-content: flex-end; gap: 0.65rem; margin-top: 0.85rem; }
    .header-set-info-compact { flex: 0 0 auto; margin: 1rem 0 0; }
    .header-validation-layout { display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(18rem, 1fr); gap: 1.25rem; }
