    .header-validation-help ol li { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: 0.6rem; }
    .header-validation-help ol li > span { display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; background: #6d7d9c; color: #fff; font-size: 0.75rem; font-weight: 700; }
    .header-validation-help p { margin: 0.2rem 0 0; color: #596c96; font-size: 0.78rem; line-height: 1.45; }
    .header-validation-help code { padding: 0.08rem 0.28rem; border-radius: 4px; background: #e6e9ef; color: #3b4b6b; }
    .header-validation-help ul { margin: 0; padding-left: 1.15rem; color: #3d517d; font-size: 0.8rem; line-height: 1.65; }
