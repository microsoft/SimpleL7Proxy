    .validation-rule-link { width: 100%; padding: 0; border: 0; background: transparent; color: #0d6efd; font-family: var(--bs-font-monospace); text-align: left; }
    .validation-rule-link:hover { text-decoration: underline; }
    .validation-rule-link:focus-visible { outline: 3px solid rgba(13, 110, 253, 0.3); outline-offset: 2px; }
    @@media (max-width: 767.98px) {
        .header-policy-summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .header-set-form-grid { grid-template-columns: minmax(0, 1fr); }
        .header-validation-layout { grid-template-columns: minmax(0, 1fr); }
        .header-validation-fields { padding-right: 0; padding-bottom: 1rem; border-right: 0; border-bottom: 1px solid #dce5f2; }
        .header-validation-match-options { grid-template-columns: minmax(0, 1fr); }
        .header-validation-actions { align-items: stretch; flex-direction: column; }
        .header-validation-actions > div:last-child { justify-content: flex-end; }
    }
</style>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public string? SelectedHeaderSet { get; set; }
    [Parameter] public EventCallback<string?> SelectedHeaderSetChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private string? _activeHeaderSet;
    private bool _isAddingHeader;
    private string _headerName = string.Empty;
    private string? _headerSetError;
    private bool _isEditingValidationRule;
    private int? _editingValidationRuleIndex;
    private string _validationHeaderName = string.Empty;
    private HeaderValidationMatchType _validationMatchType = HeaderValidationMatchType.Exact;
    private string _validationAllowedValues = string.Empty;
    private string _validationAllowedValuesHeader = string.Empty;

    protected override void OnParametersSet()
    {
        if (string.Equals(_activeHeaderSet, SelectedHeaderSet, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _activeHeaderSet = SelectedHeaderSet;
        _isAddingHeader = false;
        _headerName = string.Empty;
        _headerSetError = null;
        _isEditingValidationRule = false;
        _editingValidationRuleIndex = null;
        _validationHeaderName = string.Empty;
        _validationMatchType = HeaderValidationMatchType.Exact;
        _validationAllowedValues = string.Empty;
        _validationAllowedValuesHeader = string.Empty;

        if (!IsValidationHeaderSet(SelectedHeaderSet))
        {
            return;
        }

        var setting = FindSetting(Settings, SelectedHeaderSet!);
        var rules = ParseValidationRules(setting?.DraftValue, out var parseError);
        if (parseError is not null)
        {
            _headerSetError = parseError;
            return;
        }

        if (rules.Count == 0)
        {
            LoadValidationRule(null, null);
        }
    }

    public static bool IsHeaderPolicySetting(AppConfigurationScaffoldSetting setting)
    {
        if (string.Equals(setting.Section, "Response", StringComparison.OrdinalIgnoreCase))
        {
            return string.Equals(setting.Name, "StripResponseHeaders", StringComparison.OrdinalIgnoreCase);
        }

        return string.Equals(setting.Section, "Request", StringComparison.OrdinalIgnoreCase)
            && setting.Name.ToLowerInvariant() is
                "disallowedheaders"
                or "headers:asyncmode"
                or "headers:prioritykeyheader"
                or "headers:timeoutheader"
                or "headers:ttlheader"
                or "headers:uniqueuserheaders"
                or "headers:validateheaders"
                or "dependancyheaders"
                or "requiredheaders"
                or "striprequestheaders";
    }

    public static string Summary(IEnumerable<AppConfigurationScaffoldSetting> settings)
    {
        var settingsList = settings.ToList();
        var required = CountValues(FindSetting(settingsList, "RequiredHeaders"));
        var blocked = CountValues(FindSetting(settingsList, "DisallowedHeaders"));
        var validated = ParseValidationRules(
            FindSetting(settingsList, "Headers:ValidateHeaders")?.DraftValue,
            out _).Count;
        var requestStripped = CountValues(FindSetting(settingsList, "StripRequestHeaders"));
        var responseStripped = CountValues(FindSetting(settingsList, "StripResponseHeaders"));
        var dependency = CountValues(FindSetting(settingsList, "DependancyHeaders"));
        return $"{required} required · {validated} validated · {blocked} blocked · {requestStripped} backend strip · {responseStripped} client strip · {dependency} dependency";
    }

