    {
        "requiredheaders" => "Every header in this set must be present or the request is rejected. Header names are case-insensitive.",
        "disallowedheaders" => "Every header in this set is removed from the incoming request. Header names are case-insensitive.",
        "striprequestheaders" => "Every header in this set is removed before the request is forwarded to a backend. Header names are case-insensitive.",
        "stripresponseheaders" => "Every header in this set is removed before the response is returned to the client. Header names are case-insensitive.",
        "dependancyheaders" => "Every field in this set is copied from failed backend attempts into dependency event records.",
