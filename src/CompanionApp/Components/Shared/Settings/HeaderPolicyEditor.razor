    private async Task OpenHeaderSetAsync(AppConfigurationScaffoldSetting? setting)
    {
        if (setting is null)
        {
            _headerSetError = "This header set is not available in the current configuration.";
            return;
        }

        await SelectedHeaderSetChanged.InvokeAsync(setting.Name);
    }

    private void StartAddingValidationRule() =>
        LoadValidationRule(null, null);

    private void EditValidationRule(int index)
    {
        var setting = FindSetting(Settings, "Headers:ValidateHeaders");
        var rules = ParseValidationRules(setting?.DraftValue, out var parseError);
        if (parseError is not null)
        {
            _headerSetError = parseError;
            return;
        }
        if (index < 0 || index >= rules.Count)
        {
            _headerSetError = "The selected validation rule could not be found. Reopen the editor and try again.";
            return;
        }

        LoadValidationRule(rules[index], index);
    }

    private void LoadValidationRule(HeaderValidationRule? rule, int? index)
    {
        _isEditingValidationRule = true;
        _editingValidationRuleIndex = index;
        _validationHeaderName = rule?.HeaderName ?? string.Empty;
        _validationMatchType = rule?.MatchType ?? HeaderValidationMatchType.Exact;
        _validationAllowedValues = rule is null ? string.Empty : string.Join(',', rule.AllowedValues);
        _validationAllowedValuesHeader = rule?.AllowedValuesHeader ?? string.Empty;
        _headerSetError = null;
    }

    private async Task CancelValidationRuleAsync()
    {
        var setting = FindSetting(Settings, "Headers:ValidateHeaders");
        var rules = ParseValidationRules(setting?.DraftValue, out _);
        if (rules.Count > 0)
        {
            _isEditingValidationRule = false;
            _editingValidationRuleIndex = null;
            _headerSetError = null;
            return;
        }

        await SelectedHeaderSetChanged.InvokeAsync(null);
    }

    private async Task SaveValidationRuleAsync()
    {
        var setting = FindSetting(Settings, "Headers:ValidateHeaders");
        if (setting is null)
        {
            _headerSetError = "The validated headers setting is no longer available.";
            return;
        }

        var rules = ParseValidationRules(setting.DraftValue, out var parseError);
        if (parseError is not null)
        {
            _headerSetError = parseError;
            return;
        }

        var headerName = _validationHeaderName.Trim();
        if (!ConfigParser.IsValidHeaderName(headerName))
        {
            _headerSetError = "Enter a valid HTTP header name without spaces, colons, or commas.";
            return;
        }

        var allowedValues = ParseAllowedValues(_validationAllowedValues);
        if (allowedValues.Count == 0)
        {
            _headerSetError = "Enter at least one allowed value.";
            return;
        }

        string? allowedValuesHeader = null;
        var mapValue = _validationAllowedValuesHeader.Trim();
        if (mapValue.Length > 0)
        {
            var separatorIndex = mapValue.IndexOf('=');
            if (separatorIndex >= 0)
            {
                var mappedSource = mapValue[..separatorIndex].Trim();
                allowedValuesHeader = mapValue[(separatorIndex + 1)..].Trim();
                if (!string.Equals(mappedSource, headerName, StringComparison.OrdinalIgnoreCase))
                {
                    _headerSetError = "The mapped source must match the header name.";
                    return;
                }
            }
            else
            {
                allowedValuesHeader = mapValue;
            }

            if (!ConfigParser.IsValidHeaderName(allowedValuesHeader))
            {
                _headerSetError = "Enter a valid mapped HTTP header name.";
                return;
            }
        }

        var duplicateIndex = rules.FindIndex(rule =>
            string.Equals(rule.HeaderName, headerName, StringComparison.OrdinalIgnoreCase));
        if (duplicateIndex >= 0 && duplicateIndex != _editingValidationRuleIndex)
        {
            _headerSetError = $"{headerName} already has a validation rule.";
            return;
        }

        var rule = new HeaderValidationRule
        {
            HeaderName = headerName,
            MatchType = _validationMatchType,
            AllowedValues = allowedValues,
            AllowedValuesHeader = allowedValuesHeader
        };

        if (_editingValidationRuleIndex is int index && index >= 0 && index < rules.Count)
        {
            rules[index] = rule;
        }
        else
        {
            rules.Add(rule);
        }

        try
        {
            setting.DraftValue = ConfigParser.SerializeHeaderValidationRules(rules);
        }
        catch (FormatException ex)
        {
            _headerSetError = ex.Message;
            return;
        }

        _headerSetError = null;
        await OnChanged.InvokeAsync();
        await SelectedHeaderSetChanged.InvokeAsync(null);
    }

    private async Task RemoveValidationRuleAsync()
    {
        var setting = FindSetting(Settings, "Headers:ValidateHeaders");
        var rules = ParseValidationRules(setting?.DraftValue, out var parseError);
        if (setting is null || parseError is not null)
        {
            _headerSetError = parseError ?? "The validated headers setting is no longer available.";
            return;
        }
        if (_editingValidationRuleIndex is not int index || index < 0 || index >= rules.Count)
        {
            _headerSetError = "The selected validation rule could not be found. Reopen the editor and try again.";
            return;
        }

        rules.RemoveAt(index);
        setting.DraftValue = ConfigParser.SerializeHeaderValidationRules(rules);
        _headerSetError = null;
        await OnChanged.InvokeAsync();
        await SelectedHeaderSetChanged.InvokeAsync(null);
    }

    private void StartAddingHeader()
    {
        _isAddingHeader = true;
        _headerName = string.Empty;
        _headerSetError = null;
    }

    private void CancelAddHeader()
    {
        _isAddingHeader = false;
        _headerName = string.Empty;
        _headerSetError = null;
    }

    private async Task SaveHeaderAsync()
    {
        var setting = FindSetting(Settings, SelectedHeaderSet ?? string.Empty);
        if (setting is null)
        {
            _headerSetError = "The selected header set is no longer available.";
            return;
        }

        var headerName = _headerName.Trim();
        if (!IsValidHeaderName(headerName))
        {
            _headerSetError = "Enter a valid HTTP header name without spaces, colons, or commas.";
            return;
        }

        var headers = ParseHeaderValues(setting.DraftValue);
        var duplicateIndex = headers.FindIndex(header =>
            string.Equals(header, headerName, StringComparison.OrdinalIgnoreCase));
        if (duplicateIndex >= 0)
        {
            _headerSetError = $"{headerName} is already in this header set.";
            return;
        }

        headers.Add(headerName);
        setting.DraftValue = System.Text.Json.JsonSerializer.Serialize(headers);
        _isAddingHeader = false;
        _headerName = string.Empty;
        _headerSetError = null;
        await OnChanged.InvokeAsync();
    }

    private static bool IsValidHeaderName(string value) =>
        ConfigParser.IsValidHeaderName(value);

    private static bool IsValidationHeaderSet(string? name) =>
        string.Equals(name, "Headers:ValidateHeaders", StringComparison.OrdinalIgnoreCase);

    private static AppConfigurationScaffoldSetting? FindSetting(
        IEnumerable<AppConfigurationScaffoldSetting> settings,
        string name) =>
        settings.FirstOrDefault(setting => string.Equals(setting.Name, name, StringComparison.OrdinalIgnoreCase));

    private static List<string> ParseHeaderValues(string? rawValue)
    {
        var value = (rawValue ?? string.Empty).Trim();
        if (value.StartsWith('[') && value.EndsWith(']'))
        {
            value = value[1..^1];
        }

        return value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(item => item.Trim().Trim('"'))
            .Where(item => item.Length > 0)
            .ToList();
    }

    private static List<string> ParseAllowedValues(string value) =>
        value.Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(item => item.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private static List<HeaderValidationRule> ParseValidationRules(string? rawValue, out string? error)
    {
        try
        {
            error = null;
            return ConfigParser.ParseHeaderValidationRules(rawValue);
        }
        catch (FormatException ex)
        {
            error = ex.Message;
            return [];
        }
    }

    private static int CountValues(AppConfigurationScaffoldSetting? setting) =>
        ParseHeaderValues(setting?.DraftValue).Count;

}
