    {
        "requiredheaders" => "Required headers",
        "headers:validateheaders" => "Validated headers",
        "disallowedheaders" => "Blocked headers",
        "striprequestheaders" => "Headers removed before backend",
        "stripresponseheaders" => "Headers removed before client",
        "dependancyheaders" => "Dependency headers",
        _ => "Header set",
    };

    public static string HeaderSetDescription(string? name) => name?.ToLowerInvariant() switch
    {
        "requiredheaders" => "Define headers that must be present in the request.",
        "headers:validateheaders" => "Define headers to validate and the allowed values they must contain.",
        "disallowedheaders" => "Define client headers that the proxy removes from incoming requests.",
        "striprequestheaders" => "Define headers removed before a request is forwarded to a backend.",
        "stripresponseheaders" => "Define headers removed before a response is returned to the client.",
        "dependancyheaders" => "Define backend fields preserved in dependency event records.",
        _ => "Configure the headers in this policy set.",
    };

