    .header-validation-match-options label { display: flex; flex-direction: column; gap: 0.3rem; cursor: pointer; }
    .header-validation-match-options label > span { display: flex; align-items: center; gap: 0.55rem; }
    .header-validation-match-options small { padding-left: 1.9rem; color: #596c96; line-height: 1.35; }
    .header-validation-help { padding: 1rem; border: 1px solid #e0e6f0; border-radius: 8px; background: #f7f8fb; }
