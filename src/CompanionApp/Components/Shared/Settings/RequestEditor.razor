@namespace CompanionApp.Components.Shared

@foreach (var group in Settings.GroupBy(setting => GroupName(setting.Name)).OrderBy(group => group.Key switch
{
    "Timeouts" => 0,
    "Headers" => 1,
    "Priorities" => 2,
    _ => 3,
}))
{
    <section class="mb-3">
        <h3 class="h6 border-bottom pb-2">@group.Key</h3>
        <ConfigurationExplanation Section="Request" Topic="@group.Key" />
        <ConfigurationFields Settings="group.ToList()" OnChanged="OnChanged" />
    </section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public EventCallback OnChanged { get; set; }

    private static string GroupName(string name) => name.ToLowerInvariant() switch
    {
        "defaulttimeout" or "defaultttlsecs" => "Timeouts",
        var key when key.StartsWith("priority:") => "Priorities",
        var key when key.Contains("header") => "Headers",
        _ => "Processing",
    };
}