@namespace CompanionApp.Components.Shared
@using System.Globalization
@using SimpleL7Proxy.Config

@{
    var timeoutSetting = FindSetting(Settings, "DefaultTimeout");
    var ttlSetting = FindSetting(Settings, "DefaultTTLSecs");
    var defaultPrioritySetting = FindSetting(Settings, "Priority:DefaultPriority");
    var priorityKeysSetting = FindSetting(Settings, "Priority:PriorityKeys");
    var priorityValuesSetting = FindSetting(Settings, "Priority:PriorityValues");
    var priorityWorkerSetting = FindSetting(Settings, "Priority:PriorityWorker");
    var timeoutValue = timeoutSetting is null
        ? -1L
        : ConfigParser.ReadEnvironmentVariableOrDefault(
            new Dictionary<string, string> { ["value"] = timeoutSetting.DraftValue },
            "value",
            -1L);
    var ttlValue = ttlSetting is null
        ? -1L
        : ConfigParser.ReadEnvironmentVariableOrDefault(
            new Dictionary<string, string> { ["value"] = ttlSetting.DraftValue },
            "value",
            -1L);
    var priorityRows = BuildPriorityRows(Settings);
    var mappedPriorities = priorityRows
        .Where(row => int.TryParse(row.Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
        .GroupBy(row => row.Value, StringComparer.Ordinal)
        .Select(group => group.First())
        .ToList();
}

<div class="request-processing-editor">
    <div class="request-processing-info" role="note">
        <span class="bi bi-info-circle-fill" aria-hidden="true"></span>
        <div>
            <p>Request processing controls how incoming requests are interpreted and prepared for routing. Model detection is handled by Tokenomics.</p>
            <a href="https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/advanced-configuration.md#priority-mapping"
               target="_blank" rel="noopener noreferrer">
                Learn more <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span>
            </a>
        </div>
    </div>

    <section class="request-processing-section" aria-labelledby="request-processing-timeouts">
        <div class="request-processing-section-heading">
            <h3 id="request-processing-timeouts">Timeouts</h3>
            <p>Set the default timeout for requests and a time-to-live (TTL) for cached results.</p>
        </div>
        <div class="request-processing-field-grid">
            @if (timeoutSetting is not null)
            {
                <div class="request-processing-field @(timeoutSetting.IsChanged ? "config-field-changed" : string.Empty)">
                    <div class="config-setting-heading">
                        <label for="@timeoutSetting.Key">Default timeout (ms)</label>
                        <ConfigurationHelp Section="Request" Topic="@timeoutSetting.Name" />
                    </div>
                    <div class="request-processing-value-with-unit">
                        <input id="@timeoutSetting.Key" class="form-control" type="number" min="0" step="1"
                               value="@(timeoutValue >= 0 ? timeoutValue.ToString(CultureInfo.InvariantCulture) : string.Empty)"
                               @oninput="@(args => SetSettingValueAsync(timeoutSetting, args.Value?.ToString()))" />
                        <span>@DurationLabel(timeoutSetting.DraftValue, milliseconds: true)</span>
                    </div>
                </div>
            }
            @if (ttlSetting is not null)
            {
                <div class="request-processing-field @(ttlSetting.IsChanged ? "config-field-changed" : string.Empty)">
                    <div class="config-setting-heading">
                        <label for="@ttlSetting.Key">Default TTL (seconds)</label>
                        <ConfigurationHelp Section="Request" Topic="@ttlSetting.Name" />
                    </div>
                    <div class="request-processing-value-with-unit">
                        <input id="@ttlSetting.Key" class="form-control" type="number" min="0" step="1"
                               value="@(ttlValue >= 0 ? ttlValue.ToString(CultureInfo.InvariantCulture) : string.Empty)"
                               @oninput="@(args => SetSettingValueAsync(ttlSetting, args.Value?.ToString()))" />
                        <span>@DurationLabel(ttlSetting.DraftValue, milliseconds: false)</span>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="request-processing-section request-processing-priority-section" aria-labelledby="request-processing-priorities">
        <div class="request-processing-section-heading">
            <h3 id="request-processing-priorities">Request Prioritization</h3>
            <p>Control how request priorities are determined and mapped to internal values.</p>
        </div>
        <div class="request-processing-field-grid">
            @if (defaultPrioritySetting is not null)
            {
                <div class="request-processing-field @(defaultPrioritySetting.IsChanged ? "config-field-changed" : string.Empty)">
                    <div class="config-setting-heading">
                        <label for="@defaultPrioritySetting.Key">Default priority</label>
                        <ConfigurationHelp Section="Request" Topic="@defaultPrioritySetting.Name" />
                    </div>
                    <select id="@defaultPrioritySetting.Key" class="form-select"
                            value="@defaultPrioritySetting.DraftValue"
                            @onchange="@(args => SetSettingValueAsync(defaultPrioritySetting, args.Value?.ToString()))">
                        @if (!mappedPriorities.Any(row => string.Equals(row.Value, defaultPrioritySetting.DraftValue, StringComparison.Ordinal)))
                        {
                            <option value="@defaultPrioritySetting.DraftValue">@defaultPrioritySetting.DraftValue</option>
                        }
                        @foreach (var row in mappedPriorities)
                        {
                            <option value="@row.Value">@PriorityOptionLabel(row)</option>
                        }
                    </select>
                </div>
            }
        </div>

        <div class="request-priority-mapping @((priorityKeysSetting?.IsChanged == true || priorityValuesSetting?.IsChanged == true || priorityWorkerSetting?.IsChanged == true) ? "config-field-changed" : string.Empty)">
            <div class="request-priority-mapping-heading">
                <div>
                    <h4>Priority mapping</h4>
                    <p>Define the priority levels recognized from requests and how they map to internal values and worker allocation.</p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary"
                        disabled="@(priorityKeysSetting is null || priorityValuesSetting is null || priorityWorkerSetting is null)"
                        @onclick="StartAddingPriority">
                    <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Add priority
                </button>
            </div>

            @if (_editingPriorityIndex is not null)
            {
                <form class="request-priority-edit-form" @onsubmit="SavePriorityAsync" @onsubmit:preventDefault="true">
                    <h5>@(_editingPriorityIndex == -1 ? "Add priority" : "Edit priority")</h5>
                    <div class="request-priority-edit-grid">
                        <div>
                            <label class="form-label" for="request-priority-name">Priority name</label>
                            <input id="request-priority-name" class="form-control form-control-sm" autocomplete="off"
                                   @bind="_priorityName" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="form-label" for="request-priority-value">Value</label>
                            <input id="request-priority-value" class="form-control form-control-sm" type="number" step="1"
                                   @bind="_priorityValue" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="form-label" for="request-priority-workers">Worker weight</label>
                            <input id="request-priority-workers" class="form-control form-control-sm" type="number" min="0" step="1"
                                   @bind="_priorityWorkerWeight" @bind:event="oninput" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_priorityEditError))
                    {
                        <div class="text-danger small" role="alert">@_priorityEditError</div>
                    }
                    <div class="request-priority-edit-actions">
                        <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CancelPriorityEdit">Cancel</button>
                        <button class="btn btn-sm btn-primary" type="submit">Save priority</button>
                    </div>
                </form>
            }

            <div class="table-responsive">
                <table class="table table-sm align-middle request-priority-table">
                    <thead>
                        <tr>
                            <th scope="col">Priority name</th>
                            <th scope="col">Value <ConfigurationHelp Section="Request" Topic="Priority:PriorityValues" /></th>
                            <th scope="col">Worker weight <ConfigurationHelp Section="Request" Topic="Priority:PriorityWorker" /></th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (priorityRows.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-muted">No priority mappings configured.</td>
                            </tr>
                        }
                        @for (var index = 0; index < priorityRows.Count; index++)
                        {
                            var rowIndex = index;
                            var row = priorityRows[index];
                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(row.Name) ? "(missing)" : row.Name)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.Value) ? "(missing)" : row.Value)</td>
                                <td>@row.WorkerWeight</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-link" type="button"
                                            title="@($"Edit {row.Name} priority")" aria-label="@($"Edit {row.Name} priority")"
                                            @onclick="@(() => StartEditingPriority(rowIndex, row))">
                                        <span class="bi bi-pencil" aria-hidden="true"></span>
                                    </button>
                                    <button class="btn btn-sm btn-link text-danger" type="button"
                                            title="@($"Delete {row.Name} priority")" aria-label="@($"Delete {row.Name} priority")"
                                            @onclick="@(() => DeletePriorityAsync(rowIndex))">
                                        <span class="bi bi-trash" aria-hidden="true"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<style>
    .request-processing-editor { color: #071c61; }
    .request-processing-info { display: flex; align-items: flex-start; gap: 0.85rem; margin-bottom: 1rem; padding: 0.85rem 1rem; border: 1px solid #86b7fe; border-radius: 6px; background: #e8f2ff; color: #38558b; }
    .request-processing-info > .bi { flex: 0 0 auto; margin-top: 0.1rem; color: #0d6efd; font-size: 1.35rem; }
