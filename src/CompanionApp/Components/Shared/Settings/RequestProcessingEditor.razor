@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public EventCallback OnChanged { get; set; }

    private int? _editingPriorityIndex;
    private string _priorityName = string.Empty;
    private string _priorityValue = string.Empty;
    private string _priorityWorkerWeight = "0";
    private string? _priorityEditError;

    public static bool IsRequestProcessingSetting(AppConfigurationScaffoldSetting setting) =>
        string.Equals(setting.Section, "Request", StringComparison.OrdinalIgnoreCase)
        && setting.Name.ToLowerInvariant() is
            "defaulttimeout"
            or "defaultttlsecs"
            or "priority:defaultpriority"
            or "priority:prioritykeys"
            or "priority:priorityvalues"
            or "priority:priorityworker";

    public static string Summary(IEnumerable<AppConfigurationScaffoldSetting> settings)
    {
        var settingsList = settings.ToList();
        var timeout = FindSetting(settingsList, "DefaultTimeout")?.DraftValue;
        var ttl = FindSetting(settingsList, "DefaultTTLSecs")?.DraftValue;
        var priorityCount = SplitCsv(FindSetting(settingsList, "Priority:PriorityKeys")?.DraftValue).Count;

        if (string.IsNullOrWhiteSpace(timeout) && string.IsNullOrWhiteSpace(ttl) && priorityCount == 0)
        {
            return "Not configured";
        }

        return $"timeout {ShortDurationLabel(timeout, milliseconds: true)} · TTL {ShortDurationLabel(ttl, milliseconds: false)} · {priorityCount} {(priorityCount == 1 ? "priority" : "priorities")}";
    }

    private static AppConfigurationScaffoldSetting? FindSetting(
        IEnumerable<AppConfigurationScaffoldSetting> settings,
        string name) =>
        settings.FirstOrDefault(setting => string.Equals(setting.Name, name, StringComparison.OrdinalIgnoreCase));

    private static List<PriorityRow> BuildPriorityRows(IEnumerable<AppConfigurationScaffoldSetting> settings)
    {
        var settingsList = settings.ToList();
        var names = SplitCsv(FindSetting(settingsList, "Priority:PriorityKeys")?.DraftValue);
        var values = SplitCsv(FindSetting(settingsList, "Priority:PriorityValues")?.DraftValue);
        var workers = ParseWorkerWeights(FindSetting(settingsList, "Priority:PriorityWorker")?.DraftValue);
        var count = Math.Max(names.Count, values.Count);
        var rows = new List<PriorityRow>(count);

        for (var index = 0; index < count; index++)
        {
            var name = index < names.Count ? names[index] : string.Empty;
            var value = index < values.Count ? values[index] : string.Empty;
            var workerWeight = int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var priorityValue)
                && workers.TryGetValue(priorityValue, out var configuredWeight)
                    ? configuredWeight
                    : 0;
            rows.Add(new PriorityRow(name, value, workerWeight));
        }

        return rows;
    }

    private static List<string> SplitCsv(string? value)
    {
        var normalized = (value ?? string.Empty).Trim();
        if (normalized.StartsWith('[') && normalized.EndsWith(']'))
        {
            normalized = normalized[1..^1];
        }

        return normalized
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(token => token.Trim().Trim('"'))
            .ToList();
    }

    private static Dictionary<int, int> ParseWorkerWeights(string? value)
    {
        var weights = new Dictionary<int, int>();
        foreach (var token in SplitCsv(value))
        {
            var separator = token.IndexOf(':');
            if (separator <= 0
                || !int.TryParse(token[..separator], NumberStyles.Integer, CultureInfo.InvariantCulture, out var priority)
                || !int.TryParse(token[(separator + 1)..], NumberStyles.Integer, CultureInfo.InvariantCulture, out var weight))
            {
                continue;
            }

            weights[priority] = weight;
        }

        return weights;
    }

    private static string PriorityOptionLabel(PriorityRow row)
    {
        if (string.IsNullOrWhiteSpace(row.Name))
        {
            return row.Value;
        }

        var label = char.ToUpperInvariant(row.Name[0]) + row.Name[1..];
        return $"{label} ({row.Value})";
    }

    private static string DurationLabel(string? value, bool milliseconds)
    {
        const string settingName = "value";
        var amount = ConfigParser.ReadEnvironmentVariableOrDefault(
            new Dictionary<string, string> { [settingName] = value ?? string.Empty },
            settingName,
            -1L);
        if (amount < 0)
        {
            return string.Empty;
        }

        var day = milliseconds ? 86_400_000L : 86_400L;
        var hour = milliseconds ? 3_600_000L : 3_600L;
        var minute = milliseconds ? 60_000L : 60L;
        if (amount >= day && amount % day == 0)
        {
            return ParenthesizedDuration(amount / day, "day");
        }
        if (amount >= hour && amount % hour == 0)
        {
            return ParenthesizedDuration(amount / hour, "hour");
        }
        if (amount >= minute && amount % minute == 0)
        {
            return ParenthesizedDuration(amount / minute, "minute");
        }

        return ParenthesizedDuration(milliseconds ? amount / 1_000d : amount, "second");
    }

    private static string ParenthesizedDuration(double amount, string unit) =>
        $"({amount.ToString("0.###", CultureInfo.InvariantCulture)} {unit}{(amount == 1 ? string.Empty : "s")})";

    private static string ShortDurationLabel(string? value, bool milliseconds)
    {
        const string settingName = "value";
        var amount = ConfigParser.ReadEnvironmentVariableOrDefault(
            new Dictionary<string, string> { [settingName] = value ?? string.Empty },
            settingName,
            -1L);
        if (amount < 0)
        {
            return "--";
        }

        var hour = milliseconds ? 3_600_000L : 3_600L;
        var minute = milliseconds ? 60_000L : 60L;
        if (amount >= hour && amount % hour == 0)
        {
            return $"{(amount / hour).ToString(CultureInfo.InvariantCulture)} hr";
        }
        if (amount >= minute && amount % minute == 0)
        {
            return $"{(amount / minute).ToString(CultureInfo.InvariantCulture)} min";
        }

        var seconds = milliseconds ? amount / 1_000d : amount;
        return $"{seconds.ToString("0.###", CultureInfo.InvariantCulture)} sec";
    }

    private async Task SetSettingValueAsync(AppConfigurationScaffoldSetting setting, string? value)
    {
        setting.DraftValue = value ?? string.Empty;
        await OnChanged.InvokeAsync();
    }

    private void StartAddingPriority()
    {
        _editingPriorityIndex = -1;
        _priorityName = string.Empty;
        _priorityValue = string.Empty;
        _priorityWorkerWeight = "0";
        _priorityEditError = null;
    }

    private void StartEditingPriority(int index, PriorityRow row)
    {
        _editingPriorityIndex = index;
        _priorityName = row.Name;
        _priorityValue = row.Value;
        _priorityWorkerWeight = row.WorkerWeight.ToString(CultureInfo.InvariantCulture);
        _priorityEditError = null;
    }

    private void CancelPriorityEdit()
    {
        _editingPriorityIndex = null;
        _priorityEditError = null;
    }

    private async Task SavePriorityAsync()
    {
        var name = _priorityName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            _priorityEditError = "Priority name is required.";
            return;
        }
        if (name.Contains(','))
        {
            _priorityEditError = "Priority name cannot contain a comma.";
            return;
        }
        if (!int.TryParse(_priorityValue, NumberStyles.Integer, CultureInfo.InvariantCulture, out var value))
        {
            _priorityEditError = "Value must be an integer.";
            return;
        }
        if (!int.TryParse(_priorityWorkerWeight, NumberStyles.Integer, CultureInfo.InvariantCulture, out var workerWeight)
            || workerWeight < 0)
        {
            _priorityEditError = "Worker weight must be zero or a positive integer.";
            return;
        }

        var rows = BuildPriorityRows(Settings);
        var editingIndex = _editingPriorityIndex ?? -1;
        if (rows.Where((_, index) => index != editingIndex)
            .Any(row => string.Equals(row.Name, name, StringComparison.Ordinal)))
        {
            _priorityEditError = "Priority name must be unique.";
            return;
        }

        var updatedRow = new PriorityRow(name, value.ToString(CultureInfo.InvariantCulture), workerWeight);
        if (editingIndex == -1)
        {
            rows.Add(updatedRow);
        }
        else if (editingIndex >= 0 && editingIndex < rows.Count)
        {
            rows[editingIndex] = updatedRow;
        }
        else
        {
            _priorityEditError = "The selected priority is no longer available.";
            return;
        }

        for (var index = 0; index < rows.Count; index++)
        {
            if (index != editingIndex
                && string.Equals(rows[index].Value, updatedRow.Value, StringComparison.Ordinal))
            {
                rows[index] = rows[index] with { WorkerWeight = workerWeight };
            }
        }

        await ApplyPriorityRowsAsync(rows);
        CancelPriorityEdit();
    }

    private async Task DeletePriorityAsync(int index)
    {
        var rows = BuildPriorityRows(Settings);
        if (index < 0 || index >= rows.Count)
        {
            return;
        }

        rows.RemoveAt(index);
        await ApplyPriorityRowsAsync(rows);
        CancelPriorityEdit();
    }

    private async Task ApplyPriorityRowsAsync(IReadOnlyList<PriorityRow> rows)
    {
        var keysSetting = FindSetting(Settings, "Priority:PriorityKeys");
        var valuesSetting = FindSetting(Settings, "Priority:PriorityValues");
        var workersSetting = FindSetting(Settings, "Priority:PriorityWorker");
        if (keysSetting is null || valuesSetting is null || workersSetting is null)
        {
            _priorityEditError = "Priority mapping settings are unavailable.";
            return;
        }

        keysSetting.DraftValue = string.Join(',', rows.Select(row => row.Name));
        valuesSetting.DraftValue = string.Join(',', rows.Select(row => row.Value));
        workersSetting.DraftValue = string.Join(',', rows
            .Where(row => row.WorkerWeight > 0
                && int.TryParse(row.Value, NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
            .GroupBy(row => row.Value, StringComparer.Ordinal)
            .Select(group => $"{group.Key}:{group.First().WorkerWeight}"));
        await OnChanged.InvokeAsync();
    }

    private sealed record PriorityRow(string Name, string Value, int WorkerWeight);
}
