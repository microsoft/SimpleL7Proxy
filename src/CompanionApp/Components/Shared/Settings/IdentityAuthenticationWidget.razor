@namespace CompanionApp.Components.Shared

@{
var overviewPrimaryKeySetting = FindSetting("Auth:Key1");
var overviewSecondaryKeySetting = FindSetting("Auth:Key2");
var overviewAppValidationSetting = FindSetting("Auth:ValidateAppIDEnabled");
var overviewAppHeaderSetting = FindSetting("Auth:ValidateAppIDHeader");
var overviewAppFieldSetting = FindSetting("Auth:ValidateFieldName");
var overviewProfileEnabledSetting = FindSetting("User:UseProfiles");
var overviewProfileIdSetting = FindSetting("User:IDFieldName");
var overviewProfileHeaderSetting = FindSetting("User:ProfileHeader");
var overviewRequireProfileSetting = FindSetting("User:ConfigRequired");
var overviewRequireProfile = bool.TryParse(overviewRequireProfileSetting?.DraftValue, out var requireProfileValue) && requireProfileValue;
}
        <section id="identity-panel-overview" class="identity-access-panel" role="tabpanel"
                 aria-labelledby="identity-tab-overview">
            <div class="identity-access-panel-heading">
                <div>
                    <h3>Authentication</h3>
                    <p>Configure how callers authenticate and how identities are validated.</p>
                </div>
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Client Authentication</h4>
                        <p>Require callers to authenticate with the proxy.</p>
                    </div>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@AuthenticationEnabled"
                               disabled="@(AuthenticationConfigSetting is null)" @onchange="SetAuthenticationEnabledAsync" />
                        <span>@(AuthenticationEnabled ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
                @if (AuthenticationEnabled)
                {
                <fieldset class="identity-access-fieldset" disabled="@(!AuthenticationEnabled || AuthenticationConfigSetting is null)">
                    <legend>Authentication method</legend>
                    <div class="identity-access-method-group">
                        <label class="identity-access-method" for="identity-overview-auth-key">
                            <input id="identity-overview-auth-key" class="form-check-input" type="radio" name="identity-overview-auth-method"
                                   checked='@IsAuthenticationMode("key")'
                                   @onchange="@(() => SetAuthenticationModeAsync("key"))" />
                            <span><strong>API key</strong></span>
                        </label>
                        <label class="identity-access-method" for="identity-overview-auth-oauth">
                            <input id="identity-overview-auth-oauth" class="form-check-input" type="radio" name="identity-overview-auth-method"
                                   checked='@IsAuthenticationMode("oauth2")'
                                   @onchange="@(() => SetAuthenticationModeAsync("oauth2"))" />
                            <span><strong>OAuth token</strong></span>
                        </label>
                        <label class="identity-access-method" for="identity-overview-auth-mixed">
                            <input id="identity-overview-auth-mixed" class="form-check-input" type="radio" name="identity-overview-auth-method"
                                   checked='@IsAuthenticationMode("mixed")'
                                   @onchange="@(() => SetAuthenticationModeAsync("mixed"))" />
                            <span><strong>Mixed (API key or OAuth)</strong></span>
                        </label>
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-header">API key header name</label>
                        </div>
                        <input id="identity-overview-header" class="form-control" type="text" autocomplete="off"
                               value="@AuthenticationHeader" @oninput="SetAuthenticationHeaderAsync" />
                    </div>
                    @if (UsesApiKey)
                    {
                        @if (overviewPrimaryKeySetting is not null)
                        {
                            <div class="identity-access-form-row @(overviewPrimaryKeySetting.IsChanged ? "config-field-changed" : string.Empty)">
                                <div class="config-setting-heading">
                                    <ConfigurationHelp Section="Profiles" Topic="@overviewPrimaryKeySetting.Name">
                                        <label for="identity-overview-key1">Key 1</label>
                                    </ConfigurationHelp>
                                </div>
                                <div>
                                    <div class="input-group">
                                        <input id="identity-overview-key1" class="form-control" autocomplete="off"
                                               type="@(_showPrimaryKey ? "text" : "password")"
                                               @bind:get="overviewPrimaryKeySetting.DraftValue"
                                               @bind:set="@(value => SetSettingValueAsync(overviewPrimaryKeySetting, value))"
                                               @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button"
                                                aria-label="@(_showPrimaryKey ? "Hide key 1" : "Show key 1")"
                                                aria-pressed="@(_showPrimaryKey ? "true" : "false")"
                                                @onclick="@(() => _showPrimaryKey = !_showPrimaryKey)">
                                            <span class="bi @(_showPrimaryKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                    @if (overviewPrimaryKeySetting.IsChanged)
                                    {
                                        <div class="identity-access-change">
                                            <span>Current: (hidden)</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="@(() => RevertAsync(overviewPrimaryKeySetting))">Revert</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (overviewSecondaryKeySetting is not null)
                        {
                            <div class="identity-access-form-row @(overviewSecondaryKeySetting.IsChanged ? "config-field-changed" : string.Empty)">
                                <div class="config-setting-heading">
                                    <ConfigurationHelp Section="Profiles" Topic="@overviewSecondaryKeySetting.Name">
                                        <label for="identity-overview-key2">Key 2 <span>Optional</span></label>
                                    </ConfigurationHelp>
                                </div>
                                <div>
                                    <div class="input-group">
                                        <input id="identity-overview-key2" class="form-control" autocomplete="off"
                                               type="@(_showSecondaryKey ? "text" : "password")"
                                               @bind:get="overviewSecondaryKeySetting.DraftValue"
                                               @bind:set="@(value => SetSettingValueAsync(overviewSecondaryKeySetting, value))"
                                               @bind:event="oninput" />
                                        <button class="btn btn-outline-secondary" type="button"
                                                aria-label="@(_showSecondaryKey ? "Hide key 2" : "Show key 2")"
                                                aria-pressed="@(_showSecondaryKey ? "true" : "false")"
                                                @onclick="@(() => _showSecondaryKey = !_showSecondaryKey)">
                                            <span class="bi @(_showSecondaryKey ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></span>
                                        </button>
                                    </div>
                                    @if (overviewSecondaryKeySetting.IsChanged)
                                    {
                                        <div class="identity-access-change">
                                            <span>Current: (hidden)</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    @onclick="@(() => RevertAsync(overviewSecondaryKeySetting))">Revert</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    @if (UsesOAuth)
                    {
                        @if (string.IsNullOrWhiteSpace(OAuthIssuer) || string.IsNullOrWhiteSpace(OAuthAudience))
                        {
                            <div class="alert alert-warning py-2" role="alert">
                                OAuth authentication requires an issuer and at least one audience before the configuration is saved.
                            </div>
                        }
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <div class="config-setting-heading">
                                <ConfigurationHelp Section="Profiles" Topic="Auth:Config">
                                <label for="identity-overview-oauth-header">Bearer token header</label>
                                </ConfigurationHelp>
                            </div>
                            <input id="identity-overview-oauth-header" class="form-control" type="text" autocomplete="off"
                                   value="@AuthenticationHeader" @oninput="SetAuthenticationHeaderAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-issuer">Issuer URL</label>
                            <input id="identity-overview-oauth-issuer" class="form-control" type="url" autocomplete="off"
                                   value="@OAuthIssuer" @oninput="SetOAuthIssuerAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-audience">Audience</label>
                            <input id="identity-overview-oauth-audience" class="form-control" type="text" autocomplete="off"
                                   value="@OAuthAudience" @oninput="SetOAuthAudienceAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-metadata">Metadata address <span>Optional</span></label>
                            <input id="identity-overview-oauth-metadata" class="form-control" type="url" autocomplete="off"
                                   placeholder="Derived from the issuer URL"
                                   value="@OAuthMetadataAddress" @oninput="SetOAuthMetadataAddressAsync" />
                        </div>
                        <div class="identity-access-form-row @(AuthenticationConfigSetting?.IsChanged == true ? "config-field-changed" : string.Empty)">
                            <label for="identity-overview-oauth-skew">Clock skew (minutes)</label>
                            <input id="identity-overview-oauth-skew" class="form-control" type="number" min="0" step="1"
                                   value="@OAuthClockSkewMinutes" @oninput="SetOAuthClockSkewAsync" />
                        </div>
                    }
                </fieldset>
                }
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Application Validation</h4>
                        <p>Validate that the caller is an approved application.</p>
                    </div>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@IdentityAccessEditor.ApplicationAccessEnabled(Settings)"
                               disabled="@(overviewAppValidationSetting is null)"
                               @onchange="@(args => SetBooleanSettingAsync(overviewAppValidationSetting, args.Value is true))" />
                        <span>@(IdentityAccessEditor.ApplicationAccessEnabled(Settings) ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
                @if (IdentityAccessEditor.ApplicationAccessEnabled(Settings))
                {
                <div class="identity-access-form-grid">
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-app-header">Application ID header name</label>
                        </div>
                        <input id="identity-overview-app-header" class="form-control" type="text" autocomplete="off"
                               value="@overviewAppHeaderSetting?.DraftValue" disabled="@(overviewAppHeaderSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewAppHeaderSetting!, args.Value?.ToString()))" />
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-app-field">Application ID field name</label>
                        </div>
                        <input id="identity-overview-app-field" class="form-control" type="text" autocomplete="off"
                               value="@overviewAppFieldSetting?.DraftValue" disabled="@(overviewAppFieldSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewAppFieldSetting!, args.Value?.ToString()))" />
                    </div>
                </div>
                <div class="alert alert-info py-2" role="alert">
                    Approved application IDs are managed under the <strong>Applications</strong> tab.
                </div>
                }
            </div>

            <div class="identity-access-card">
                <div class="identity-access-card-heading">
                    <div>
                        <h4>Profile Validation</h4>
                        <p>Require a user profile and map the request to a profile.</p>
                    </div>
                    <label class="identity-access-switch form-switch">
                        <input class="form-check-input" type="checkbox" checked="@IdentityAccessEditor.UserProfilesEnabled(Settings)"
                               disabled="@(overviewProfileEnabledSetting is null)"
                               @onchange="@(args => SetBooleanSettingAsync(overviewProfileEnabledSetting, args.Value is true))" />
                        <span>@(IdentityAccessEditor.UserProfilesEnabled(Settings) ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
                @if (IdentityAccessEditor.UserProfilesEnabled(Settings))
                {
                <div class="identity-access-form-grid">
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-profile-id">Profile identifier field name</label>
                        </div>
                        <input id="identity-overview-profile-id" class="form-control" type="text" autocomplete="off"
                               value="@overviewProfileIdSetting?.DraftValue" disabled="@(overviewProfileIdSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewProfileIdSetting!, args.Value?.ToString()))" />
                    </div>
                    <div class="identity-access-form-row">
                        <div class="config-setting-heading">
                            <label for="identity-overview-profile-header">Profile header name</label>
                        </div>
                        <input id="identity-overview-profile-header" class="form-control" type="text" autocomplete="off"
                               value="@overviewProfileHeaderSetting?.DraftValue" disabled="@(overviewProfileHeaderSetting is null)"
                               @oninput="@(args => SetSettingValueAsync(overviewProfileHeaderSetting!, args.Value?.ToString()))" />
                    </div>
                </div>
                <label class="identity-access-check">
                    <input class="form-check-input" type="checkbox" checked="@overviewRequireProfile"
                           disabled="@(overviewRequireProfileSetting is null)"
                           @onchange="@(args => SetBooleanSettingAsync(overviewRequireProfileSetting, args.Value is true))" />
                    <span>
                        <strong>Require profile configuration</strong>
                        <small>Reject requests when a profile is not found.</small>
                    </span>
                </label>
                <div class="alert alert-info py-2" role="alert">
                    User profiles are managed under the <strong>Profile Reader</strong> and <strong>Profiles</strong> tabs.
                </div>
                }
            </div>
        </section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public EventCallback OnChanged { get; set; }
    private bool _showPrimaryKey;
    private bool _showSecondaryKey;
    private AppConfigurationScaffoldSetting? AuthenticationConfigSetting => FindSetting("Auth:Config");

    private bool AuthenticationEnabled =>
        bool.TryParse(AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "enabled"), out var enabled) && enabled;

    private string AuthenticationMode => NormalizeAuthenticationMode(
        AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "mode"));

    private string AuthenticationHeader =>
        AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "header") is { Length: > 0 } header
            ? header
            : "S7P-KEY";

    private bool UsesApiKey => AuthenticationMode is "key" or "mixed";
    private bool UsesOAuth => AuthenticationMode is "oauth2" or "mixed";
    private string OAuthIssuer => AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "issuer");
    private string OAuthAudience => AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "audience", "audiences");
    private string OAuthMetadataAddress => AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "metadataaddress");
    private string OAuthClockSkewMinutes =>
        AuthenticationConfigValue(AuthenticationConfigSetting?.DraftValue, "clockskewminutes") is { Length: > 0 } value ? value : "1";
    private bool IsAuthenticationMode(string mode) =>
        string.Equals(AuthenticationMode, mode, StringComparison.OrdinalIgnoreCase);

    private AppConfigurationScaffoldSetting? FindSetting(string name) => FindSetting(Settings, name);

    private static AppConfigurationScaffoldSetting? FindSetting(
        IEnumerable<AppConfigurationScaffoldSetting> settings,
        string name) =>
        settings.FirstOrDefault(setting => string.Equals(setting.Name, name, StringComparison.OrdinalIgnoreCase));

    private async Task SetAuthenticationEnabledAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is true;
        if (enabled && AuthenticationMode == "none")
        {
            await UpdateAuthenticationConfigAsync(("enabled", "true"), ("mode", "key"));
            return;
        }

        await UpdateAuthenticationConfigAsync(("enabled", enabled ? "true" : "false"));
    }

    private Task SetAuthenticationModeAsync(string mode) =>
        UpdateAuthenticationConfigAsync(("mode", mode));

    private Task SetAuthenticationHeaderAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("header", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthIssuerAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("issuer", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthAudienceAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("audience", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthMetadataAddressAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("metadataaddress", args.Value?.ToString() ?? string.Empty));

    private Task SetOAuthClockSkewAsync(ChangeEventArgs args) =>
        UpdateAuthenticationConfigAsync(("clockskewminutes", args.Value?.ToString() ?? string.Empty));

    private async Task UpdateAuthenticationConfigAsync(params (string Key, string Value)[] updates)
    {
        if (AuthenticationConfigSetting is not { } setting)
        {
            return;
        }

        var segments = AuthenticationConfigSegments(setting.DraftValue);
        foreach (var update in updates)
        {
            SetAuthenticationConfigSegment(segments, update.Key, update.Value);
        }

        setting.DraftValue = string.Join(';', segments);
        await OnChanged.InvokeAsync();
    }

    private async Task SetBooleanSettingAsync(AppConfigurationScaffoldSetting? setting, bool enabled)
    {
        if (setting is null)
        {
            return;
        }

        setting.DraftValue = enabled ? "true" : "false";
        await OnChanged.InvokeAsync();
    }

    private async Task SetSettingValueAsync(AppConfigurationScaffoldSetting setting, string? value)
    {
        setting.DraftValue = value ?? string.Empty;
        await OnChanged.InvokeAsync();
    }

    private async Task RevertAsync(AppConfigurationScaffoldSetting setting)
    {
        setting.RevertDraft();
        await OnChanged.InvokeAsync();
    }
    private static string NormalizeAuthenticationMode(string? mode) =>
        mode?.Trim().ToLowerInvariant() switch
        {
            "oauth" or "oauth2" => "oauth2",
            "mixed" => "mixed",
            "none" => "none",
            _ => "key",
        };

    private static List<string> AuthenticationConfigSegments(string? rawConfig)
    {
        if (string.IsNullOrWhiteSpace(rawConfig))
        {
            return new List<string>();
        }

        var separator = rawConfig.Contains(';') ? ';' : ',';
        return rawConfig.Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(segment => !string.IsNullOrWhiteSpace(segment))
            .ToList();
    }

    private static string AuthenticationConfigValue(string? rawConfig, string key, params string[] aliases)
    {
        var acceptedKeys = aliases.Prepend(key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var segments = AuthenticationConfigSegments(rawConfig);
        for (var index = segments.Count - 1; index >= 0; index--)
        {
            var separatorIndex = segments[index].IndexOf('=');
            if (separatorIndex <= 0 || !acceptedKeys.Contains(segments[index][..separatorIndex].Trim()))
            {
                continue;
            }

            return segments[index][(separatorIndex + 1)..].Trim();
        }

        return string.Empty;
    }

    private static void SetAuthenticationConfigSegment(List<string> segments, string key, string value)
    {
        var acceptedKeys = key.Equals("audience", StringComparison.OrdinalIgnoreCase)
            ? new HashSet<string>(["audience", "audiences"], StringComparer.OrdinalIgnoreCase)
            : new HashSet<string>([key], StringComparer.OrdinalIgnoreCase);
        var replacementIndex = -1;

        for (var index = 0; index < segments.Count; index++)
        {
            var separatorIndex = segments[index].IndexOf('=');
            if (separatorIndex <= 0 || !acceptedKeys.Contains(segments[index][..separatorIndex].Trim()))
            {
                continue;
            }

            if (replacementIndex < 0)
            {
                replacementIndex = index;
                segments[index] = $"{key}={value}";
            }
            else
            {
                segments.RemoveAt(index);
                index--;
            }
        }

        if (replacementIndex < 0)
        {
            segments.Add($"{key}={value}");
        }
    }
}
