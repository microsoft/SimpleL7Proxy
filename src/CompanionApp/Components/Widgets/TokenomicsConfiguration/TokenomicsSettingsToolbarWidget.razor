@namespace CompanionApp.Components.Widgets.TokenomicsConfiguration
@if (EnableSetting is { } enableSetting)
{
    <div class="tokenomics-global-toolbar">
        <div class="tokenomics-page-title">
            <span class="bi bi-database-fill" aria-hidden="true"></span>
            <div><h2>Tokenomics</h2><p>Control token usage, costs, capacity, priority, and model routing.</p></div>
        </div>
        <div class="tokenomics-global-settings">
            <label class="tokenomics-enabled-toggle form-switch" for="tokenomics-enabled">
                <input id="tokenomics-enabled" class="form-check-input" type="checkbox" checked="@Enabled"
                       aria-controls="tokenomics-settings-content" aria-expanded="@(Enabled ? "true" : "false")"
                       @onchange="OnEnabledChanged" />
                <span>Enabled</span>
            </label>
            @if (Enabled && MetricsServerSetting is { } metricsServerSetting)
            {
                <div class="tokenomics-metrics-server @(metricsServerSetting.IsChanged ? "config-field-changed" : string.Empty)">
                    <label class="form-label" for="tokenomics-metrics-server-url">Metrics server URL</label>
                    <input id="tokenomics-metrics-server-url" class="form-control form-control-sm" type="url"
                           placeholder="http://localhost:9100" spellcheck="false"
                           @bind:get="metricsServerSetting.DraftValue" @bind:set="OnMetricsServerChanged.InvokeAsync"
                           @bind:event="oninput" @onblur="OnChanged" />
                </div>
            }
        </div>
        <div class="tokenomics-global-actions">
            @if (enableSetting.IsChanged)
            {
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="OnRevertEnabled">
                    <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Revert enabled
                </button>
            }
            @if (Enabled && MetricsServerSetting is { IsChanged: true })
            {
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="OnRevertMetricsServer">
                    <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Revert URL
                </button>
            }
            @if (Enabled && OptionsChanged)
            {
                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="OnRevertOptions">
                    <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Revert options
                </button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public AppConfigurationScaffoldSetting? EnableSetting { get; set; }
    [Parameter] public AppConfigurationScaffoldSetting? MetricsServerSetting { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public bool OptionsChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnEnabledChanged { get; set; }
    [Parameter] public EventCallback<string?> OnMetricsServerChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public EventCallback OnRevertEnabled { get; set; }
    [Parameter] public EventCallback OnRevertMetricsServer { get; set; }
    [Parameter] public EventCallback OnRevertOptions { get; set; }
}
