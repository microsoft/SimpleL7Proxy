@namespace CompanionApp.Components.Widgets.AppConfiguration
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<AppConfigurationSectionWidget Section="@Section" Icon="bi-gear-fill" ChangedCount="@Settings.Count(setting => setting.IsChanged)"
    IsLoading="IsLoading" Tooltip='@(Configuration[$"{CompanionAppOptions.UiSectionName}:SectionTooltips:{Section}"] ?? $"Edit {Section} settings.")' OnSelected="OnSelected">
    <SummaryContent>
        <span class="config-box-meta">
            Experimental · @(Settings.Any(setting =>
                string.Equals(setting.Name, "Enabled", StringComparison.OrdinalIgnoreCase)
                && bool.TryParse(setting.DraftValue, out var enabled)
                && enabled) ? "Enabled" : "Disabled")
        </span>
    </SummaryContent>
</AppConfigurationSectionWidget>

@code {
    [Parameter] public string Section { get; set; } = "Async";
    [Parameter] public IEnumerable<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnSelected { get; set; }
}
