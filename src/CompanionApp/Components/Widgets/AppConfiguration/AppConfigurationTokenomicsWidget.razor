@namespace CompanionApp.Components.Widgets.AppConfiguration
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<AppConfigurationSectionWidget Section="@Section" Icon="bi-database-fill" ChangedCount="@Settings.Count(setting => setting.IsChanged)"
    IsLoading="IsLoading" IsInline="true" Tooltip='@(Configuration[$"{CompanionAppOptions.UiSectionName}:SectionTooltips:{Section}"] ?? $"Edit {Section} settings.")' OnSelected="OnSelected">
    <SummaryContent><span class="config-box-meta">@(TokenomicsEditor.IsEnabled(Settings) ? "Enabled" : "Disabled")</span></SummaryContent>
</AppConfigurationSectionWidget>

@code {
    [Parameter] public string Section { get; set; } = "Tokenomics";
    [Parameter] public IEnumerable<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnSelected { get; set; }
}
