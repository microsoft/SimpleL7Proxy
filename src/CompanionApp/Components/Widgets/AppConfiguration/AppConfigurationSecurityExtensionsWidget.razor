@namespace CompanionApp.Components.Widgets.AppConfiguration
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var settings = Settings.ToList();
    var ignoreCertificateSetting = FindSetting(settings, "IgnoreSSLCert");
    var validateCertificates = ignoreCertificateSetting is not null
        && SecurityExtensionsEditor.ValidateBackendCertificates(ignoreCertificateSetting);
}

<AppConfigurationSectionWidget Section="@Section" Icon="bi-shield-fill-check" ChangedCount="@settings.Count(setting => setting.IsChanged)"
    IsLoading="IsLoading" Tooltip='@(Configuration[$"{CompanionAppOptions.UiSectionName}:SectionTooltips:{Section}"] ?? "Edit security and extension settings.")' OnSelected="OnSelected">
    <SummaryContent>
        <span class="proxy-configuration-summary">
            <span class="proxy-configuration-description">Backend connection security and extensibility.</span>
            <span class="proxy-configuration-summary-grid">
                <span>Validate backend certificates</span>
                <strong>
                    <span class="proxy-configuration-status-dot @(validateCertificates ? "is-enabled" : string.Empty)" aria-hidden="true"></span>
                    @(validateCertificates ? "Enabled" : "Disabled")
                </strong>
                <span>Request preprocessor plugins</span><strong>@PluginSummary(settings)</strong>
            </span>
            <span class="proxy-configuration-summary-footer">Includes additional options (0).</span>
        </span>
    </SummaryContent>
</AppConfigurationSectionWidget>

@code {
    [Parameter] public string Section { get; set; } = "Security & Extensions";
    [Parameter] public IEnumerable<AppConfigurationScaffoldSetting> Settings { get; set; } = Array.Empty<AppConfigurationScaffoldSetting>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnSelected { get; set; }

    private static AppConfigurationScaffoldSetting? FindSetting(
        IEnumerable<AppConfigurationScaffoldSetting> settings,
        string name) =>
        settings.FirstOrDefault(setting => string.Equals(setting.Name, name, StringComparison.OrdinalIgnoreCase));

    private static string PluginSummary(IEnumerable<AppConfigurationScaffoldSetting> settings)
    {
        var value = FindSetting(settings, "RequestPreprocessorPlugins")?.DraftValue;
        var count = (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Length;
        return count switch
        {
            0 => "None configured",
            1 => "1 configured",
            _ => $"{count} configured",
        };
    }
}
