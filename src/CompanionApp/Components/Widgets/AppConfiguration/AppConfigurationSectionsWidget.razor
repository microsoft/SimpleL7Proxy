@namespace CompanionApp.Components.Widgets.AppConfiguration

<div class="config-section-grid" hidden="@IsHidden">
    @foreach (var group in Groups.Where(group => !string.Equals(group.Key, "Tokenomics", StringComparison.OrdinalIgnoreCase)))
    {
        @switch (group.Key.ToLowerInvariant())
        {
            case "async":
                <AppConfigurationAsyncWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "circuitbreaker":
                <AppConfigurationCircuitBreakerWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "healthprobe":
                <AppConfigurationHealthProbeWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "hosts":
                <AppConfigurationHostsWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "loadbalancing":
                <AppConfigurationLoadBalancingWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "logging":
                <AppConfigurationLoggingWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "profiles":
                <AppConfigurationProfilesWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "request":
                <AppConfigurationRequestWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "response":
                <AppConfigurationResponseWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            case "server":
                <AppConfigurationServerWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            default:
                <AppConfigurationGenericWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
        }
    }
    @if (!Groups.Any(group => string.Equals(group.Key, "Hosts", StringComparison.OrdinalIgnoreCase)))
    {
        <AppConfigurationHostsWidget IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync("Hosts"))" />
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<IGrouping<string, AppConfigurationScaffoldSetting>> Groups { get; set; } = Array.Empty<IGrouping<string, AppConfigurationScaffoldSetting>>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsHidden { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }
}
