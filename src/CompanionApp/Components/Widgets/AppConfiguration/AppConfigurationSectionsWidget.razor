@namespace CompanionApp.Components.Widgets.AppConfiguration
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var groups = Groups.ToList();
    var proxyRuntimeSettings = GroupSettings(groups, "Proxy Runtime");
    var backendRoutingSettings = GroupSettings(groups, "Backend Routing");
}

<div class="config-section-grid" hidden="@IsHidden" aria-label="Configuration sections">
    <AppConfigurationProxyRuntimeWidget Settings="proxyRuntimeSettings" IsLoading="IsLoading"
        OnSelected="@(() => OnSelected.InvokeAsync("Proxy Runtime"))" @key='"Proxy Runtime"' />
    <AppConfigurationBackendRoutingWidget Settings="backendRoutingSettings" IsLoading="IsLoading"
        OnSelected="@(() => OnSelected.InvokeAsync("Backend Routing"))" @key='"Backend Routing"' />

    @foreach (var group in groups.Where(group =>
        !string.Equals(group.Key, "Tokenomics", StringComparison.OrdinalIgnoreCase)
        && !IsProxyConfigurationGroup(group.Key)))
    {
        @switch (group.Key.ToLowerInvariant())
        {
            case "async":
            case "backend resilience":
            case "circuitbreaker":
            case "healthprobe":
            case "header policy":
            case "hosts":
            case "loadbalancing":
            case "logging":
            case "request":
            case "request processing":
            case "response":
            case "server":
                @ThinTile(group.Key, group)
                break;
            case "identity & access":
                <AppConfigurationIdentityAccessWidget Section="@group.Key" Settings="group" IsLoading="IsLoading" OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key" />
                break;
            default:
                <AppConfigurationSectionWidget Section="@group.Key"
                    Icon="@AppConfigurationSectionCatalog.ForGenericSection(group.Key).Icon"
                    ChangedCount="@group.Count(setting => setting.IsChanged)"
                    IsLoading="IsLoading"
                    Tooltip='@(Configuration[$"{CompanionAppOptions.UiSectionName}:SectionTooltips:{group.Key}"] ?? $"Edit {group.Key} settings.")'
                    OnSelected="@(() => OnSelected.InvokeAsync(group.Key))" @key="group.Key">
                    <SummaryContent><span class="config-box-meta">@AppConfigurationSectionCatalog.ForGenericSection(group.Key).Summarize(group)</span></SummaryContent>
                </AppConfigurationSectionWidget>
                break;
        }
    }
    @if (!groups.Any(group => string.Equals(group.Key, "Hosts", StringComparison.OrdinalIgnoreCase)))
    {
        @EmptyThinTile("Hosts")
    }
    @if (!groups.Any(group => string.Equals(group.Key, "Request Processing", StringComparison.OrdinalIgnoreCase)))
    {
        @EmptyThinTile("Request Processing")
    }
    @if (!groups.Any(group => string.Equals(group.Key, "Header Policy", StringComparison.OrdinalIgnoreCase)))
    {
        @EmptyThinTile("Header Policy")
    }
    @if (!groups.Any(group => string.Equals(group.Key, "Backend Resilience", StringComparison.OrdinalIgnoreCase)))
    {
        @EmptyThinTile("Backend Resilience")
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<IGrouping<string, AppConfigurationScaffoldSetting>> Groups { get; set; } = Array.Empty<IGrouping<string, AppConfigurationScaffoldSetting>>();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsHidden { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }

    private static IReadOnlyList<AppConfigurationScaffoldSetting> GroupSettings(
        IEnumerable<IGrouping<string, AppConfigurationScaffoldSetting>> groups,
        string name)
    {
        var group = groups.FirstOrDefault(group =>
            string.Equals(group.Key, name, StringComparison.OrdinalIgnoreCase));
        return group is null ? Array.Empty<AppConfigurationScaffoldSetting>() : group.ToList();
    }

    private static bool IsProxyConfigurationGroup(string name) =>
        name.ToLowerInvariant() is "proxy runtime" or "backend routing";

    private RenderFragment ThinTile(string section, IEnumerable<AppConfigurationScaffoldSetting> settings) =>
        CatalogTile(section, settings, keyed: true);

    private RenderFragment EmptyThinTile(string section) =>
        CatalogTile(section, Array.Empty<AppConfigurationScaffoldSetting>(), keyed: false);

    private RenderFragment CatalogTile(
        string section,
        IEnumerable<AppConfigurationScaffoldSetting> settings,
        bool keyed)
    {
        if (!AppConfigurationSectionCatalog.TryGetThinSection(section, out var descriptor))
        {
            throw new InvalidOperationException($"No thin section catalog entry for '{section}'.");
        }

        var tooltip = Configuration[$"{CompanionAppOptions.UiSectionName}:SectionTooltips:{section}"]
            ?? descriptor.TooltipFor(section);
        var changedCount = settings.Count(setting => setting.IsChanged);
        var summary = descriptor.Summarize(settings);
        if (keyed)
        {
            return @<AppConfigurationSectionWidget Section="@section" Icon="@descriptor.Icon" ChangedCount="@changedCount"
                IsLoading="IsLoading" Tooltip="@tooltip" OnSelected="@(() => OnSelected.InvokeAsync(section))" @key="section">
                <SummaryContent><span class="@descriptor.SummaryClass">@summary</span></SummaryContent>
            </AppConfigurationSectionWidget>;
        }

        return @<AppConfigurationSectionWidget Section="@section" Icon="@descriptor.Icon" ChangedCount="@changedCount"
            IsLoading="IsLoading" Tooltip="@tooltip" OnSelected="@(() => OnSelected.InvokeAsync(section))">
            <SummaryContent><span class="@descriptor.SummaryClass">@summary</span></SummaryContent>
        </AppConfigurationSectionWidget>;
    }
}
