@page "/admin/images"
@namespace CompanionApp.Components.Pages
@rendermode InteractiveServer
@implements IDisposable
@using CompanionApp.Components.Shared
@inject ImageSyncService ImageSync
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime ApplicationLifetime
@inject ILogger<ImageSyncPage> Logger

<PageTitle>Updates</PageTitle>

<SectionContent SectionName="page-heading">
    <h1 class="h4 mb-0">Updates</h1>
</SectionContent>

<div class="card shadow-sm mb-3">
    <div class="card-body" aria-live="polite" aria-busy="@(_busy ? "true" : "false")">
        <h2 class="h5">CompanionApp</h2>
        <p class="text-muted">@CompanionTag</p>
        @if (_restarting)
        {
            <p role="status">Restarting. Reload this page in a moment.</p>
        }
        else if (_busy)
        {
            <p role="status">@(_updatingCompanion ? "Updating..." : "Checking for updates...")</p>
        }
        else if (_restartReady && CompanionImageMatches)
        {
            <p class="fw-semibold">Update complete.</p>
            <button type="button" class="btn btn-primary" disabled="@(!RendererInfo.IsInteractive || !CanRestart)" @onclick="RestartAsync">Restart</button>
            @if (!CanRestart)
            {
                <p class="small mt-2 mb-0">Running locally? Stop and start the app to restart.</p>
            }
        }
        else if (!ImageSync.HasTarget)
        {
            <p>Updates aren't set up yet. Open Details to finish setup.</p>
        }
        else if (_error is not null || CompanionRepository?.Error is not null)
        {
            <p class="text-danger">Couldn't check for updates. Try again.</p>
        }
        else if (CompanionUpdateAvailable)
        {
            <p class="fw-semibold">Update available.</p>
            <button type="button" class="btn btn-primary" disabled="@(!RendererInfo.IsInteractive)" @onclick="UpdateCompanionAsync">Click to update</button>
        }
        else if (CompanionRepository is { } customRepository
            && !string.Equals(customRepository.TargetName, "companionapp", StringComparison.Ordinal))
        {
            <p>Use Details to update your custom image.</p>
        }
        else if (CompanionRepository?.SourceDigests.ContainsKey(CompanionTag) == true)
        {
            <p>No new update found.</p>
        }
        else if (_repositories.Count == 0)
        {
            <p role="status">Checking for updates...</p>
        }
        else
        {
            <p>No update found for this version.</p>
        }
        @if (!_busy && !_restarting && ImageSync.HasTarget)
        {
            <button type="button" class="btn btn-outline-secondary mt-2" disabled="@(!RendererInfo.IsInteractive)" @onclick="LoadAsync">Check for updates</button>
        }
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (CompanionRepository?.Error is not null)
{
    <div class="alert alert-danger" role="alert">@CompanionRepository.Error</div>
}

<details class="card shadow-sm mb-3">
    <summary class="card-header">Restart the other apps</summary>
    <div class="card-body">
        <p>Restart the proxy and metrics server separately in the Azure Portal.</p>
        <ol>
            <li>Copy the required image under <strong>Details</strong>.</li>
            <li>Open its Container App in the Azure Portal.</li>
            <li>Open <strong>Revisions and replicas</strong>, select the active revision, then choose <strong>Restart</strong>.</li>
            <li>Wait for healthy replicas and check the startup logs.</li>
        </ol>
        <p>Installing a different version? Use <strong>Containers → Edit and deploy</strong> to select the new image first. Restarting alone doesn't change the selected image.</p>
        <p class="mb-0"><strong>Health probe:</strong> a sidecar restarts with the proxy. A separate health probe app must be restarted separately. An internal probe needs no separate update.</p>
    </div>
</details>

<details>
<summary class="mb-3">Details</summary>
<p class="small">The quick update copies the published image for @CompanionTag to <code>@ImageSync.TargetLoginServer/companionapp:@CompanionTag</code>. Before restarting, confirm ACA uses that image. A restart does not change the configured tag or guarantee a new digest. To use a different version, copy its tag below and select it in ACA under <strong>Containers → Edit and deploy</strong>.</p>
<div class="card shadow-sm mb-3">
    <div class="card-header bg-secondary text-white d-flex align-items-baseline gap-2">
        <span class="fw-semibold">Registries</span>
    </div>
    <div class="card-body">
        <p class="mb-1">Source (public): <code>@ImageSyncService.SourceLoginServer</code></p>
        <p class="mb-3">
            Target (deployment):
            @if (ImageSync.HasTarget)
            {
                <code>@ImageSync.TargetLoginServer</code>
            }
            else
            {
                <span class="text-danger">not configured</span>
            }
        </p>
        @if (!ImageSync.HasTarget)
        {
            <div class="alert alert-warning" role="alert">
                Set <code>CompanionApp__proxyacr</code> to the deployment registry name to synchronize images. The Bicep deployment sets it automatically and grants this app's managed identity <code>AcrPush</code> on that registry.
            </div>
        }
        <button type="button" class="btn btn-primary" disabled="@(!RendererInfo.IsInteractive || _busy)" @onclick="LoadAsync">
            @(_repositories.Count == 0 ? "Check public images" : "Refresh")
        </button>
    </div>
</div>

@if (_repositories.Count > 0)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-secondary text-white d-flex align-items-baseline gap-2">
            <span class="fw-semibold">Public images</span>
            <span class="small">Select missing tags or tags whose image digest has changed.</span>
        </div>
        <div class="card-body">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th scope="col">Repository</th>
                        <th scope="col">Target repository</th>
                        <th scope="col">Tags</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var repository in _repositories)
                    {
                        <tr @key="repository.Name">
                            <td><code>@repository.Name</code></td>
                            <td>
                                <input class="form-control form-control-sm" aria-label="@($"Target repository for {repository.Name}")"
                                       value="@repository.TargetName" disabled="@(_busy || !ImageSync.HasTarget)"
                                       @onchange="@(args => ChangeTargetAsync(repository, args.Value?.ToString()))" />
                                @if (!ImageSyncService.IsValidRepositoryName(repository.TargetName))
                                {
                                    <div class="small text-danger">Use lowercase letters, digits, and '.', '_', '-', or '/' separators.</div>
                                }
                            </td>
                            <td>
                                @if (repository.Error is not null)
                                {
                                    <span class="text-danger small">@repository.Error</span>
                                }
                                else if (repository.SourceTags.Count == 0)
                                {
                                    <span class="text-muted small">No tags</span>
                                }
                                @foreach (var tag in repository.SourceTags)
                                {
                                    var present = repository.TargetDigests.TryGetValue(tag, out var targetDigest);
                                    var digestMatches = present
                                        && repository.SourceDigests.TryGetValue(tag, out var sourceDigest)
                                        && string.Equals(sourceDigest, targetDigest, StringComparison.Ordinal);
                                    var id = $"sync-{repository.Name}-{tag}";
                                    <div class="form-check form-check-inline" @key="tag">
                                        <input class="form-check-input" type="checkbox" id="@id"
                                               checked="@repository.Selected.Contains(tag)" disabled="@(_busy || !ImageSync.HasTarget)"
                                               @onchange="@(args => ToggleTag(repository, tag, args.Value is true))" />
                                        <label class="form-check-label" for="@id">
                                            @tag
                                            @if (ImageSync.HasTarget && repository.Error is null && digestMatches)
                                            {
                                                <span class="badge text-bg-success ms-1">in local</span>
                                            }
                                            else if (ImageSync.HasTarget && repository.Error is null && present)
                                            {
                                                <span class="badge text-bg-warning ms-1">changed</span>
                                            }
                                            else if (ImageSync.HasTarget && repository.Error is null)
                                            {
                                                <span class="badge text-bg-warning ms-1">missing</span>
                                            }
                                        </label>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_confirming)
            {
                <div class="alert alert-info" role="alertdialog" aria-label="Confirm image synchronization">
                    <p class="mb-2">Copy @SelectedCount image(s) from <code>@ImageSyncService.SourceLoginServer</code> to <code>@ImageSync.TargetLoginServer</code>? Existing tags with the same name are overwritten.</p>
                    <ul class="mb-2">
                        @foreach (var item in SelectedImages)
                        {
                            <li><code>@item.Repository.Name:@item.Tag</code> &rarr; <code>@item.Repository.TargetName:@item.Tag</code></li>
                        }
                    </ul>
                    <button type="button" class="btn btn-primary me-2" @onclick="SynchronizeAsync">Synchronize</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _confirming = false">Cancel</button>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary me-2" disabled="@(_busy || !ImageSync.HasTarget)" @onclick="SelectMissing">Select missing or changed</button>
                <button type="button" class="btn btn-primary me-2" disabled="@(_busy || !CanSynchronize)" @onclick="() => _confirming = true">
                    Synchronize selected (@SelectedCount)
                </button>
                @if (_busy && _cancellation is not null)
                {
                    <button type="button" class="btn btn-outline-danger" @onclick="() => _cancellation.Cancel()">Cancel</button>
                }
            }
        </div>
    </div>
}

@if (_log.Count > 0)
{
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <span class="fw-semibold">Activity</span>
        </div>
        <div class="card-body">
            <ul class="list-unstyled small mb-0" aria-live="polite">
                @foreach (var line in _log)
                {
                    <li>@line</li>
                }
            </ul>
        </div>
    </div>
}
</details>

@code {
    private readonly List<RepositoryState> _repositories = new();
    private readonly List<string> _log = new();
    private CancellationTokenSource? _cancellation;
    private string? _error;
    private bool _busy;
    private bool _confirming;
    private bool _updatingCompanion;
    private bool _restartReady;
    private bool _restarting;

    private string CompanionTag => $"v{Constants.VERSION}";
    private RepositoryState? CompanionRepository => _repositories.FirstOrDefault(repository =>
        string.Equals(repository.Name, "companionapp", StringComparison.Ordinal));
    private bool CompanionUpdateAvailable => ImageSync.HasTarget
        && CompanionRepository is { Error: null } repository
        && string.Equals(repository.TargetName, "companionapp", StringComparison.Ordinal)
        && repository.SourceDigests.TryGetValue(CompanionTag, out var sourceDigest)
        && (!repository.TargetDigests.TryGetValue(CompanionTag, out var targetDigest)
            || !string.Equals(sourceDigest, targetDigest, StringComparison.Ordinal));
    private bool CompanionImageMatches => ImageSync.HasTarget
        && CompanionRepository is { Error: null } repository
        && string.Equals(repository.TargetName, "companionapp", StringComparison.Ordinal)
        && repository.SourceDigests.TryGetValue(CompanionTag, out var sourceDigest)
        && repository.TargetDigests.TryGetValue(CompanionTag, out var targetDigest)
        && string.Equals(sourceDigest, targetDigest, StringComparison.Ordinal);
    private bool CanRestart => !string.IsNullOrWhiteSpace(
        Environment.GetEnvironmentVariable("CONTAINER_APP_NAME"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ImageSync.HasTarget)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task UpdateCompanionAsync()
    {
        if (_busy || _restarting || !CompanionUpdateAvailable
            || CompanionRepository is not { } companionRepository)
        {
            return;
        }
        foreach (var repository in _repositories)
        {
            repository.Selected.Clear();
        }
        companionRepository.Selected.Add(CompanionTag);
        _updatingCompanion = true;
        try
        {
            await SynchronizeAsync();
        }
        finally
        {
            _updatingCompanion = false;
        }
    }

    private async Task RestartAsync()
    {
        if (_busy || _restarting || !_restartReady || !CompanionImageMatches || !CanRestart)
        {
            return;
        }
        _restarting = true;
        await Task.Delay(TimeSpan.FromSeconds(1));
        Logger.LogWarning("Restart requested from Image Synchronization after a CompanionApp image copy. Exiting this instance; ACA is responsible for restarting it. Other apps and replicas are not restarted.");
        ApplicationLifetime.StopApplication();
    }

    private IEnumerable<(RepositoryState Repository, string Tag)> SelectedImages =>
        _repositories.SelectMany(repository => repository.SourceTags
            .Where(repository.Selected.Contains)
            .Select(tag => (repository, tag)));

    private int SelectedCount => SelectedImages.Count();

    private bool CanSynchronize => ImageSync.HasTarget && SelectedCount > 0 &&
        _repositories.Where(repository => repository.Selected.Count > 0).All(repository => ImageSyncService.IsValidRepositoryName(repository.TargetName));

    private async Task LoadAsync()
    {
        using var cancellation = StartOperation();
        _repositories.Clear();
        try
        {
            foreach (var name in await ImageSync.GetSourceRepositoriesAsync(cancellation.Token))
            {
                var repository = new RepositoryState(name);
                _repositories.Add(repository);
                await LoadTagsAsync(repository, cancellation.Token);
                StateHasChanged();
            }
            if (_repositories.Count == 0)
            {
                _error = $"No repositories were found in {ImageSyncService.SourceLoginServer}.";
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = $"Unable to list repositories in {ImageSyncService.SourceLoginServer}: {ex.Message}";
        }
        catch (OperationCanceledException)
        {
            AddLog("Cancelled.");
        }
        finally
        {
            EndOperation();
        }
    }

    private async Task LoadTagsAsync(RepositoryState repository, CancellationToken cancellationToken)
    {
        repository.Error = null;
        try
        {
                repository.SourceDigests = await ImageSync.GetSourceTagDigestsAsync(repository.Name, cancellationToken);
                repository.SourceTags = repository.SourceDigests.Keys.ToArray();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            repository.Error = $"Unable to list public tags: {ex.Message}";
            return;
        }
        await LoadTargetTagsAsync(repository, cancellationToken);
    }

    private async Task LoadTargetTagsAsync(RepositoryState repository, CancellationToken cancellationToken)
    {
        repository.Error = null;
        repository.TargetDigests = new Dictionary<string, string>(StringComparer.Ordinal);
        if (!ImageSync.HasTarget || !ImageSyncService.IsValidRepositoryName(repository.TargetName))
        {
            return;
        }
        try
        {
            repository.TargetDigests = new Dictionary<string, string>(
                await ImageSync.GetTargetTagDigestsAsync(repository.TargetName, cancellationToken),
                StringComparer.Ordinal);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            repository.Error = $"Unable to list tags in {ImageSync.TargetLoginServer}: {ex.Message}";
        }
    }

    private async Task ChangeTargetAsync(RepositoryState repository, string? targetName)
    {
        repository.TargetName = (targetName ?? string.Empty).Trim();
        using var cancellation = StartOperation();
        try
        {
            await LoadTargetTagsAsync(repository, cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            AddLog("Cancelled.");
        }
        finally
        {
            EndOperation();
        }
    }

    private static void ToggleTag(RepositoryState repository, string tag, bool selected)
    {
        if (selected)
        {
            repository.Selected.Add(tag);
        }
        else
        {
            repository.Selected.Remove(tag);
        }
    }

    private void SelectMissing()
    {
        foreach (var repository in _repositories)
        {
            repository.Selected.Clear();
            if (repository.Error is null)
            {
                repository.Selected.UnionWith(repository.SourceTags.Where(tag =>
                    !repository.TargetDigests.TryGetValue(tag, out var targetDigest)
                    || !repository.SourceDigests.TryGetValue(tag, out var sourceDigest)
                    || !string.Equals(sourceDigest, targetDigest, StringComparison.Ordinal)));
            }
        }
    }

    private async Task SynchronizeAsync()
    {
        _confirming = false;
        var images = SelectedImages.ToList();
        using var cancellation = StartOperation();
        var progress = new Progress<string>(message =>
        {
            AddLog(message);
            _ = InvokeAsync(StateHasChanged);
        });
        var completed = 0;
        try
        {
            foreach (var (repository, tag) in images)
            {
                AddLog($"Copying {ImageSyncService.SourceLoginServer}/{repository.Name}:{tag} to {ImageSync.TargetLoginServer}/{repository.TargetName}:{tag}");
                StateHasChanged();
                try
                {
                    await ImageSync.CopyImageAsync(repository.Name, tag, repository.TargetName, progress, cancellation.Token);
                    await LoadTargetTagsAsync(repository, cancellation.Token);
                    if (repository.Error is not null)
                    {
                        throw new InvalidOperationException(repository.Error);
                    }
                    if (!repository.SourceDigests.TryGetValue(tag, out var sourceDigest)
                        || !repository.TargetDigests.TryGetValue(tag, out var targetDigest)
                        || !string.Equals(sourceDigest, targetDigest, StringComparison.Ordinal))
                    {
                        throw new InvalidOperationException("The copied image could not be verified in the deployment registry. Check for updates again before restarting.");
                    }
                    if (string.Equals(repository.Name, "companionapp", StringComparison.Ordinal)
                        && string.Equals(repository.TargetName, "companionapp", StringComparison.Ordinal)
                        && string.Equals(tag, CompanionTag, StringComparison.Ordinal))
                    {
                        _restartReady = true;
                    }
                    repository.Selected.Remove(tag);
                    completed++;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    _error = $"Unable to update {repository.Name}:{tag}: {ex.Message}";
                    Logger.LogError(ex, "Image update failed for {Repository}:{Tag}.", repository.Name, tag);
                    AddLog($"Failed {repository.Name}:{tag}: {ex.Message}");
                }
                StateHasChanged();
            }
            AddLog($"Synchronized {completed} of {images.Count} image(s).");
        }
        catch (OperationCanceledException)
        {
            AddLog($"Cancelled after {completed} of {images.Count} image(s).");
        }
        finally
        {
            EndOperation();
        }
    }

    private CancellationTokenSource StartOperation()
    {
        _error = null;
        _busy = true;
        _cancellation = new CancellationTokenSource();
        return _cancellation;
    }

    private void EndOperation()
    {
        _busy = false;
        _cancellation = null;
    }

    private void AddLog(string message) =>
        _log.Add($"{DateTimeOffset.Now:HH:mm:ss} {message}");

    public void Dispose() => _cancellation?.Cancel();

    private sealed class RepositoryState(string name)
    {
        public string Name { get; } = name;
        public string TargetName { get; set; } = name;
        public IReadOnlyList<string> SourceTags { get; set; } = Array.Empty<string>();
        public IReadOnlyDictionary<string, string> SourceDigests { get; set; } = new Dictionary<string, string>(StringComparer.Ordinal);
        public Dictionary<string, string> TargetDigests { get; set; } = new(StringComparer.Ordinal);
        public HashSet<string> Selected { get; } = new(StringComparer.Ordinal);
        public string? Error { get; set; }
    }
}
