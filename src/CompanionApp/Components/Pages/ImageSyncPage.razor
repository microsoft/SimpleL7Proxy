@page "/admin/updates"
@namespace CompanionApp.Components.Pages
@rendermode InteractiveServer
@implements IDisposable
@using CompanionApp.Components.Shared
@inject ImageSyncService ImageSync
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime ApplicationLifetime
@inject ILogger<ImageSyncPage> Logger
@inject IConfiguration Configuration

<PageTitle>Updates</PageTitle>

<SectionContent SectionName="page-heading">
    <h1 class="h4 mb-0">Updates</h1>
</SectionContent>

<div class="card shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3" aria-live="polite" aria-busy="@(_busy ? "true" : "false")">
        <div>
            @if (_error is not null)
            {
                <h2 class="h5 mb-1 text-danger">Update check failed</h2>
                <p class="mb-1">Unable to retrieve available versions. Try again.</p>
            }
            else if (_lastChecked is null)
            {
                <h2 class="h5 mb-1">Check for available versions</h2>
                <p class="mb-0">Choose which component versions to synchronize. Nothing is copied until you select components and synchronize.</p>
            }
            else if (_busy)
            {
                <h2 class="h5 mb-1">Checking for updates...</h2>
            }
            else if (NewerComponentCount > 0)
            {
                <h2 class="h5 mb-1">Newer versions are available</h2>
                <p class="mb-1">@NewerComponentCount of @_components.Count components have newer versions available. Select the version you want to synchronize.</p>
            }
            else
            {
                <h2 class="h5 mb-1">All components are current.</h2>
                <p class="mb-1">Historical versions remain available for intentional rollback.</p>
            }
            @if (_lastChecked is { } checkedAt)
            {
                <p class="small text-muted mb-0">Last checked: @checkedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</p>
            }
        </div>
        <button type="button" class="btn btn-outline-primary" disabled="@(_busy || _restarting || !RendererInfo.IsInteractive)" @onclick="LoadAsync">
            Check for updates
        </button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
@if (!ImageSync.HasTarget)
{
    <div class="alert alert-warning" role="alert">Image synchronization is not configured for this deployment.</div>
}
@if (_restarting)
{
    <div class="alert alert-info" role="status">Restarting CompanionApp. Reload this page in a moment.</div>
}

<div class="card shadow-sm mb-3">
    <div class="card-header">
        <h2 class="h5 mb-0">Components</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" aria-label="Select component"></th>
                    <th scope="col">Component</th>
                    <th scope="col">Current version</th>
                    <th scope="col">Available version</th>
                    <th scope="col">Selected version</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var component in _components)
                {
                    <tr @key="component.RepositoryName">
                        <td>
                            <input class="form-check-input" type="checkbox"
                                   aria-label="@($"Select {component.Name} for synchronization")"
                                   checked="@component.SelectedForSynchronization"
                                   disabled="@(_busy || component.AvailableVersions.Count == 0)"
                                   @onchange="@(args => ToggleSynchronization(component, args.Value is true))" />
                        </td>
                        <th scope="row">@component.Name</th>
                        <td>@(component.CurrentVersion.Length == 0 ? "Not checked" : component.CurrentVersion)</td>
                        <td>
                            <select class="form-select form-select-sm"
                                    aria-label="@($"Available versions for {component.Name}")"
                                    value="@component.SelectedVersion"
                                    disabled="@(_busy || component.AvailableVersions.Count == 0 || component.Error is not null)"
                                    @onchange="@(args => SelectVersion(component, args.Value?.ToString()))">
                                @if (component.AvailableVersions.Count == 0)
                                {
                                    <option value="">No versions loaded</option>
                                }
                                @foreach (var version in component.AvailableVersions)
                                {
                                    <option value="@version">@VersionOptionLabel(component, version)</option>
                                }
                            </select>
                        </td>
                        <td>@(component.SelectedVersion ?? "—")</td>
                        <td>
                            @if (component.Error is not null)
                            {
                                <span class="text-danger" title="@component.Error">@(component.SynchronizationStatus ?? "Unable to check versions")</span>
                            }
                            else if (component.SynchronizationStatus is not null)
                            {
                                <span>@component.SynchronizationStatus</span>
                            }
                            else if (component.SelectedVersion is null)
                            {
                                <span class="text-muted">Check for updates</span>
                            }
                            else if (!component.NeedsSynchronization)
                            {
                                <span class="badge text-bg-success">Current</span>
                            }
                            else if (ImageSyncComponentState.IsNewerVersion(component.SelectedVersion, component.CurrentVersion))
                            {
                                <span class="badge text-bg-warning">Newer version available</span>
                            }
                            else if (!ImageSyncComponentState.VersionsMatch(component.SelectedVersion, component.CurrentVersion))
                            {
                                <span class="badge text-bg-info">Version selected</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Image changed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-primary" disabled="@(!CanSynchronize)" @onclick="SynchronizeAsync">
            @if (_busy && _cancellation is not null)
            {
                <span>Synchronizing...</span>
            }
            else
            {
                <span>Synchronize selected (@SelectedCount)</span>
            }
        </button>
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy"
                aria-expanded="@(_showRestartDetails ? "true" : "false")"
                @onclick="() => _showRestartDetails = !_showRestartDetails">
            Restart applications
        </button>
        <span class="small text-muted ms-lg-auto">Synchronization copies selected images to the deployment registry. Restart is a separate step required for changes to take effect.</span>
    </div>
</div>

@if (_showRestartDetails)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header"><h2 class="h6 mb-0">Restart applications</h2></div>
        <div class="card-body">
            <p>Restart applications only after their deployment is configured to use the synchronized image.</p>
            <ul>
                <li>Restart Proxy, MetricsServer, and a separately deployed HealthProbe through the Azure Portal or your deployment workflow.</li>
                <li>A HealthProbe sidecar restarts with its Proxy application.</li>
            </ul>
            @if (_restartReady && CanRestart)
            {
                <button type="button" class="btn btn-outline-primary" disabled="@_busy" @onclick="RestartAsync">Restart CompanionApp</button>
            }
            else if (_restartReady)
            {
                <p class="small mb-0">Restart CompanionApp by stopping and starting the app in your hosting environment.</p>
            }
        </div>
    </div>
}

<details class="card shadow-sm">
    <summary class="card-header">Activity</summary>
    <div class="card-body p-0">
        @if (_activity.Count == 0)
        {
            <p class="text-muted p-3 mb-0">No activity yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr><th scope="col">Time</th><th scope="col">Component</th><th scope="col">Message</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _activity.AsEnumerable().Reverse())
                        {
                            <tr>
                                <td>@entry.Time.ToLocalTime().ToString("M/d/yyyy h:mm:ss tt")</td>
                                <td>@entry.Component</td>
                                <td>@entry.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</details>

@code {
    private readonly List<ImageSyncComponentState> _components =
    [
        new("CompanionApp", "companionapp"),
        new("HealthProbe", "healthprobe"),
        new("MetricsServer", "metricsserver"),
        new("SimpleL7Proxy", "simplel7proxy")
    ];
    private readonly List<ActivityEntry> _activity = new();
    private CancellationTokenSource? _cancellation;
    private DateTimeOffset? _lastChecked;
    private string? _error;
    private bool _busy;
    private bool _restartReady;
    private bool _restarting;
    private bool _showRestartDetails;

    private int NewerComponentCount => _components.Count(component =>
        component.Error is null && component.AvailableVersions.Any(version =>
            ImageSyncComponentState.IsNewerVersion(version, component.CurrentVersion)));

    private IEnumerable<(ImageSyncComponentState Component, string Version)> SelectedImages
    {
        get
        {
            foreach (var component in _components)
            {
                if (component.GetSynchronizationVersion() is { } version)
                {
                    yield return (component, version);
                }
            }
        }
    }

    private int SelectedCount => SelectedImages.Count();

    private bool CanSynchronize =>
        ImageSync.HasTarget && !_busy && SelectedCount > 0 &&
        SelectedImages.All(image => image.Component.Error is null
            || image.Component.SynchronizationStatus == "Synchronization failed");

    private bool CanRestart => !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable("CONTAINER_APP_NAME"));

    private static string VersionOptionLabel(ImageSyncComponentState component, string version)
    {
        var labels = new List<string>();
        if (component.AvailableVersions.FirstOrDefault() == version)
        {
            labels.Add("latest");
        }
        if (ImageSyncComponentState.VersionsMatch(component.CurrentVersion, version))
        {
            labels.Add("current");
        }
        return labels.Count == 0 ? version : $"{version} ({string.Join(", ", labels)})";
    }

    private static void SelectVersion(ImageSyncComponentState component, string? version)
    {
        component.SelectedVersion = version;
        component.SynchronizationStatus = null;
        component.Error = null;
    }

    private static void ToggleSynchronization(ImageSyncComponentState component, bool selected)
    {
        component.SelectedForSynchronization = selected;
        if (selected)
        {
            component.Error = null;
            if (component.SynchronizationStatus == "Synchronization failed")
            {
                component.SynchronizationStatus = null;
            }
            if (component.SynchronizationStatus == "Unable to check versions")
            {
                component.SynchronizationStatus = null;
            }
        }
    }

    private async Task LoadAsync()
    {
        using var cancellation = StartOperation();
        try
        {
            _error = null;
            var repositories = new HashSet<string>(
                await ImageSync.GetSourceRepositoriesAsync(cancellation.Token),
                StringComparer.Ordinal);
            var configuredVersions = GetConfiguredCurrentVersions();

            foreach (var component in _components)
            {
                if (!repositories.Contains(component.RepositoryName))
                {
                    component.Error = $"No source image was found for {component.Name}.";
                    AddActivity(component.Name, "No source image was found.");
                    continue;
                }

                try
                {
                    var currentVersion = configuredVersions.TryGetValue(component.Name, out var value) ? value : null;
                    await LoadTagsAsync(component, currentVersion, cancellation.Token);
                    if (component.SynchronizationStatus == "Synchronization failed")
                    {
                        component.SynchronizationStatus = null;
                    }
                    if (component.SelectionWasReset)
                    {
                        AddActivity(component.Name, $"The previously selected version is no longer available. Selected {component.SelectedVersion ?? "no version"} instead.");
                    }

                    var newerVersion = component.AvailableVersions.FirstOrDefault(version =>
                        ImageSyncComponentState.IsNewerVersion(version, component.CurrentVersion));
                    AddActivity(component.Name, newerVersion is null
                        ? $"No newer version found. Current version: {component.CurrentVersion}"
                        : $"Available version {newerVersion} found. Current version: {component.CurrentVersion}");
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    component.Error = ex.Message;
                    component.SynchronizationStatus = "Unable to check versions";
                    AddActivity(component.Name, $"Unable to check versions: {ex.Message}");
                }
            }

            _lastChecked = DateTimeOffset.UtcNow;
            AddActivity("System", "Update check completed.");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _error = ex.Message;
            AddActivity("System", $"Unable to check for updates: {ex.Message}");
        }
        catch (OperationCanceledException)
        {
            AddActivity("System", "Update check cancelled.");
        }
        finally
        {
            EndOperation();
        }
    }

    private async Task LoadTagsAsync(
        ImageSyncComponentState component,
        string? currentVersion,
        CancellationToken cancellationToken)
    {
        var sourceDigests = await ImageSync.GetSourceTagDigestsAsync(component.RepositoryName, cancellationToken);
        IReadOnlyDictionary<string, string> targetDigests = new Dictionary<string, string>(StringComparer.Ordinal);
        var targetInformationAvailable = false;
        if (ImageSync.HasTarget)
        {
            try
            {
                targetDigests = await ImageSync.GetTargetTagDigestsAsync(component.RepositoryName, cancellationToken);
                targetInformationAvailable = true;
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                AddActivity(component.Name, $"Unable to read synchronized image details: {ex.Message}");
            }
        }
        component.Refresh(sourceDigests, targetDigests, currentVersion, targetInformationAvailable);
    }

    private IReadOnlyDictionary<string, string> GetConfiguredCurrentVersions()
    {
        var versions = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var entry in ImageSyncComponentState.ParseCurrentVersions(
                     Configuration["CurrentVersions"] ?? Environment.GetEnvironmentVariable("CurrentVersions")))
        {
            versions[CanonicalComponentName(entry.Key)] = entry.Value;
        }
        foreach (var entry in Configuration.GetSection("CurrentVersions").GetChildren())
        {
            if (!string.IsNullOrWhiteSpace(entry.Value))
            {
                versions[CanonicalComponentName(entry.Key)] = entry.Value;
            }
        }
        return versions;
    }

    private static string CanonicalComponentName(string name) => name.ToLowerInvariant() switch
    {
        "proxy" or "simplel7proxy" => "SimpleL7Proxy",
        "metrics" or "metricsserver" => "MetricsServer",
        "healthprobe" => "HealthProbe",
        "companionapp" => "CompanionApp",
        _ => name
    };

    private async Task RestartAsync()
    {
        if (_busy || _restarting || !_restartReady || !CanRestart)
        {
            return;
        }

        _restarting = true;
        await Task.Delay(TimeSpan.FromSeconds(1));
        Logger.LogWarning("Restart requested from Image Synchronization after a CompanionApp image copy. Exiting this instance; ACA is responsible for restarting it. Other apps and replicas are not restarted.");
        ApplicationLifetime.StopApplication();
    }

    private async Task SynchronizeAsync()
    {
        var images = SelectedImages.ToList();
        using var cancellation = StartOperation();
        var completed = 0;
        try
        {
            foreach (var (component, version) in images)
            {
                component.Error = null;
                component.SynchronizationStatus = "Synchronizing...";
                AddActivity(component.Name, $"Synchronizing selected version {version}.");
                StateHasChanged();
                try
                {
                    var progress = new Progress<string>(message => AddActivity(component.Name, message));
                    await ImageSync.CopyImageAsync(
                        component.RepositoryName,
                        version,
                        component.RepositoryName,
                        progress,
                        cancellation.Token);
                    var targetDigests = await ImageSync.GetTargetTagDigestsAsync(component.RepositoryName, cancellation.Token);
                    if (!component.SourceDigests.TryGetValue(version, out var sourceDigest)
                        || !targetDigests.TryGetValue(version, out var targetDigest)
                        || !string.Equals(sourceDigest, targetDigest, StringComparison.Ordinal))
                    {
                        throw new InvalidOperationException("The synchronized image could not be verified.");
                    }

                    component.Refresh(component.SourceDigests, targetDigests, component.CurrentVersion);
                    component.SelectedForSynchronization = false;
                    component.SynchronizationStatus = "Synchronized — restart required";
                    if (string.Equals(component.Name, "CompanionApp", StringComparison.Ordinal))
                    {
                        _restartReady = true;
                    }
                    AddActivity(component.Name, $"{version} synchronized successfully. Restart required.");
                    completed++;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    component.Error = ex.Message;
                    component.SynchronizationStatus = "Synchronization failed";
                    Logger.LogError(ex, "Image synchronization failed for {Component}:{Version}.", component.Name, version);
                    AddActivity(component.Name, $"Synchronization failed for {version}: {ex.Message}");
                }

                StateHasChanged();
            }

            AddActivity("System", $"Synchronized {completed} of {images.Count} selected image(s).");
        }
        catch (OperationCanceledException)
        {
            AddActivity("System", $"Synchronization cancelled after {completed} of {images.Count} image(s).");
        }
        finally
        {
            EndOperation();
        }
    }

    private CancellationTokenSource StartOperation()
    {
        _busy = true;
        _cancellation = new CancellationTokenSource();
        return _cancellation;
    }

    private void EndOperation()
    {
        _busy = false;
        _cancellation = null;
    }

    private void AddActivity(string component, string message) =>
        _activity.Add(new ActivityEntry(DateTimeOffset.Now, component, message));

    public void Dispose() => _cancellation?.Cancel();

    private sealed record ActivityEntry(DateTimeOffset Time, string Component, string Message);
}
