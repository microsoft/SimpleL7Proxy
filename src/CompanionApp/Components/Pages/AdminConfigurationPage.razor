@page "/admin/configuration"
@namespace CompanionApp.Components.Pages
@rendermode InteractiveServer
@implements IDisposable
@inject AppConfigurationScaffoldService AppConfiguration
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject IJSRuntime JS
@inject NavigationManager Navigation
@using Azure
@using Azure.Identity
@using CompanionApp.Components.Shared
@using CompanionApp.Components.Widgets.AppConfiguration
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop

<PageTitle>Proxy Configuration</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
</HeadContent>
<NavigationLock ConfirmExternalNavigation="@HasPendingChanges" OnBeforeInternalNavigation="BeforeNavigationAsync" />

<SectionContent SectionName="page-heading">
    <div class="d-flex align-items-center gap-2">
        <h1 class="h4 mb-0">Proxy Configuration</h1>
    </div>
</SectionContent>

<div class="app-configuration-page">
<div class="config-admin-shell @(!_editingLabel ? "config-selection-shell" : string.Empty)">
    @if (IsLoading || HasLoadError)
    {
        <div class="config-load-banner" role="status" aria-live="polite" aria-atomic="true">
            @if (IsLoading)
            {
                <span class="spinner-border config-load-spinner" aria-hidden="true"></span>
                <div>
                    <strong>@(StatusMessage.StartsWith("Updating", StringComparison.Ordinal) ? "Updating configuration..." : "Loading configuration...")</strong>
                    <p>@StatusMessage</p>
                </div>
            }
            else
            {
                <span class="bi @(HasLoadError ? "bi-exclamation-triangle" : "bi-check-circle") config-load-indicator" aria-hidden="true"></span>
                <div>
                    <strong>@(HasLoadError ? "Configuration could not be refreshed" : "Configuration ready")</strong>
                    <p>@(HasLoadError ? StatusMessage : $"Configure {LabelDisplay(Label)} using the sections below.")</p>
                </div>
            }
        </div>
    }
    <div class="config-details-surface @(IsLoading ? "is-loading" : string.Empty)"
         aria-busy="@(IsLoading ? "true" : "false")" inert="@(IsLoading ? string.Empty : null)">
    @if (_editingLabel)
    {
        <div class="config-label-toolbar">
            <h2 class="config-details-heading">Configuration Details</h2>
            <button class="btn btn-outline-secondary" type="button" disabled="@IsLoading" @onclick="BackToLabelsAsync">
                <span class="bi bi-chevron-left me-1" aria-hidden="true"></span>Back to Configurations
            </button>
            <span class="config-current-label text-break">@LabelDisplay(Label)</span>
            @if (HasPendingChanges)
            {
                <span class="badge text-bg-warning">Unsaved Changes</span>
            }
            @if (_newLabelDraft)
            {
                <span class="badge text-bg-secondary">New Label</span>
            }
            <div class="config-connection-actions ms-auto">
                <span class="config-connection-caption">App Config:</span>
                <button class="btn btn-outline-secondary config-icon-button" type="button" title="App Configuration settings" aria-label="App Configuration settings"
                        aria-expanded="@(_showEndpointSettings ? "true" : "false")" aria-controls="config-connection-form"
                        disabled="@IsLoading" @onclick="() => _showEndpointSettings = !_showEndpointSettings">
                    <span class="bi bi-gear" aria-hidden="true"></span>
                </button>
                <button class="btn btn-outline-secondary config-icon-button" type="button"
                        title="@(HasPendingChanges ? "Save or discard local changes before refreshing." : "Refresh the current configuration.")" aria-label="Refresh current configuration"
                        disabled="@(IsLoading || HasPendingChanges)" @onclick="LoadSettingsAsync">
                    <span class="bi bi-arrow-clockwise" aria-hidden="true"></span>
                </button>
                @if (IsLoading || Settings.Count > 0)
                {
                    <button class="btn btn-outline-warning text-nowrap" type="button" disabled="@IsLoading" @onclick="ResetToDefaultsAsync">
                        <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Reset to defaults
                    </button>
                }
            </div>
        </div>
    }
    <div class="config-header-bar @(!_editingLabel && LabelsReady && !_showEndpointSettings ? "config-header-collapsed" : string.Empty)">
        @if (LabelsReady && !_editingLabel)
        {
            <div class="config-connection-actions">
                <span class="config-connection-caption">App Config:</span>
                <button class="btn btn-outline-secondary config-icon-button" type="button" title="App Configuration settings" aria-label="App Configuration settings"
                        aria-expanded="@(_showEndpointSettings ? "true" : "false")" aria-controls="config-connection-form"
                        disabled="@IsLoading" @onclick="() => _showEndpointSettings = !_showEndpointSettings">
                    <span class="bi bi-gear" aria-hidden="true"></span>
                </button>
                <button class="btn btn-outline-secondary config-icon-button" type="button" title="Refresh configurations" aria-label="Refresh configurations"
                    disabled="@(IsLoading || _editingLabel)" @onclick="LoadSettingsAsync">
                    <span class="bi bi-arrow-clockwise" aria-hidden="true"></span>
                </button>
            </div>
        }
        @if ((!LabelsReady && !_editingLabel) || _showEndpointSettings)
        {
        <div id="config-connection-form" class="config-header-row">
        <div class="config-header-endpoint">
            <label class="form-label small mb-1" for="config-endpoint">App Configuration URL</label>
            <ConfigurationHelp Section="General" Topic="App Configuration URL" />
            <input id="config-endpoint" class="form-control form-control-sm" type="url"
                     disabled="@(_editingLabel || IsLoading)"
                   placeholder="https://&lt;store&gt;.azconfig.io" @bind="Endpoint" @bind:event="oninput" />
        </div>
        @if (!_editingLabel && !LabelsReady)
        {
            <button class="btn btn-outline-secondary config-header-load align-self-end" type="button" disabled="@IsLoading" @onclick="LoadSettingsAsync">
                <span class="bi bi-arrow-clockwise me-1" aria-hidden="true"></span>@(IsLoading ? "Refreshing..." : "Refresh")
            </button>
        }
        @if (IsLoading || (_editingLabel && _elapsed > TimeSpan.Zero))
        {
            <span class="badge config-header-timer @(IsLoading ? "text-bg-info" : "text-bg-light")">@_elapsed.TotalSeconds.ToString("0.0") s</span>
        }
        </div>
        }
        @if (_editingLabel || !LabelsReady || IsLoading || HasLoadError)
        {
        <div class="config-header-row">
        <span class="small config-header-status @(HasLoadError ? "text-danger" : "text-muted")" role="status">
            @if (_editingLabel && IsLoading)
            {
                <text>Sentinel: @(Settings.FirstOrDefault(setting => string.Equals(setting.Name, "Sentinel", StringComparison.OrdinalIgnoreCase))?.LoadedValue ?? "Loading...")</text>
            }
            else if (_editingLabel && !HasLoadError && Settings.Count > 0)
            {
                @if (!string.IsNullOrEmpty(StatusMessage))
                {
                    <text>@StatusMessage · </text>
                }
                <text>Sentinel: @(Settings.FirstOrDefault(setting => string.Equals(setting.Name, "Sentinel", StringComparison.OrdinalIgnoreCase))?.LoadedValue ?? "(not found)")</text>
                <ConfigurationHelp Section="General" Topic="Sentinel" />
            }
            else
            {
                @StatusMessage
            }
        </span>
        @if (_editingLabel && !IsLoading && Settings.Count > 0)
        {
            @if (!Settings.Any(setting => string.Equals(setting.Section, "Hosts", StringComparison.OrdinalIgnoreCase)))
            {
                <button class="btn btn-outline-secondary" type="button" @onclick='() => SelectSection("Hosts")'><span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Add Host</button>
            }
        }
        @if (_editingLabel && _lastLoadedAtUtc is { } loadedAt)
        {
            <span class="config-last-loaded">Last loaded: @loadedAt.ToString("MMM d, yyyy HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) UTC</span>
        }
        else if (_editingLabel)
        {
            <span class="config-last-loaded">Last loaded: --</span>
        }
        @if (_editingLabel && HasPendingChanges)
        {
            <div class="d-flex align-items-center gap-2 ms-auto">
                <button class="btn btn-sm btn-warning text-nowrap" type="button"
                        disabled="@IsLoading" @onclick='() => SelectSection("Local change review")'>
                    <span class="bi bi-list-check me-1" aria-hidden="true"></span>@ChangedCount @(ChangedCount == 1 ? "setting changed" : "settings changed")
                </button>
                <button class="btn btn-primary btn-sm text-nowrap" type="button" disabled="@IsLoading" @onclick="UpdateSettingsAsync">
                    <span class="bi bi-cloud-upload me-1" aria-hidden="true"></span>Update
                </button>
            </div>
        }
        </div>
        }
    </div>

    @if (!_editingLabel && LabelsReady && !_showEndpointSettings)
    {
        <section class="config-selection" aria-labelledby="config-label-heading">
            <div class="config-selection-heading">
                <div>
                    <h2 id="config-label-heading">Configurations</h2>
                    @if (AvailableLabels.Count == 0)
                    {
                        <p class="text-muted mb-0 mt-2">No configurations found. Select New to create one, or refresh to check App Configuration again.</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0 mt-2">
                            @AvailableLabels.Count @(AvailableLabels.Count == 1 ? "configuration" : "configurations") loaded. Select Update to edit one, Duplicate to use one as a starting point, or New to create one.
                        </p>
                    }
                </div>
            </div>
            <div class="config-action-picker" role="group" aria-label="Configuration action">
                <button type="button" class="btn btn-outline-secondary" disabled="@IsLoading" @onclick="async () => { _configurationAction = null; await OpenLabelDialogAsync(null); }">
                    <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>New
                </button>
                <button type="button" class="btn @(_configurationAction == "Update" ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(_configurationAction == "Update" ? "true" : "false")" disabled="@(IsLoading || AvailableLabels.Count == 0)" @onclick='() => _configurationAction = "Update"'>
                    <span class="bi bi-pencil me-1" aria-hidden="true"></span>Update
                </button>
                <button type="button" class="btn @(_configurationAction == "Duplicate" ? "btn-primary" : "btn-outline-secondary")" aria-pressed="@(_configurationAction == "Duplicate" ? "true" : "false")" disabled="@(IsLoading || AvailableLabels.Count == 0)" @onclick='() => _configurationAction = "Duplicate"'>
                    <span class="bi bi-copy me-1" aria-hidden="true"></span>Duplicate
                </button>
            </div>
            @if (_configurationAction is not null)
            {
            <div class="config-selection-row">
                <div class="config-selection-field">
                    <label class="form-label" for="config-label">Starting configuration (label)</label>
                    <select id="config-label" class="form-select" @bind="Label" disabled="@(!LabelsReady || IsLoading || AvailableLabels.Count == 0)">
                        @if (AvailableLabels.Count == 0 || !AvailableLabels.Contains(Label, StringComparer.Ordinal))
                        {
                            <option value="@Label" disabled>@(LabelsReady && AvailableLabels.Count == 0 ? "No labels found" : "Select a label")</option>
                        }
                        @foreach (var item in AvailableLabels.OrderBy(value => value, StringComparer.Ordinal))
                        {
                            <option value="@item">@LabelDisplay(item)</option>
                        }
                    </select>
                </div>
                <div class="config-selection-actions">
                    <button type="button" class="btn btn-primary" disabled="@(IsLoading || !AvailableLabels.Contains(Label, StringComparer.Ordinal))" @onclick='async () => { if (_configurationAction == "Update") { OpenLabel(Label); } else { await OpenLabelDialogAsync(Label); } }'>Continue<span class="bi bi-arrow-right" aria-hidden="true"></span></button>
                </div>
            </div>
            @if (LabelsReady && AvailableLabels.Contains(Label, StringComparer.Ordinal))
            {
                var lastEdited = _allSettings.Where(setting => string.Equals(setting.Label, Label, StringComparison.Ordinal)).Max(setting => setting.LastModified);
                <div class="config-selection-metadata" role="status">
                    Last edited:
                    @if (lastEdited is { } timestamp)
                    {
                        <time datetime="@timestamp.ToString("O")">@timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</time>
                    }
                    else
                    {
                        <span>Unavailable</span>
                    }
                </div>
            }
            }
        </section>
    }

    @if (_editingLabel && IsLoading && Settings.Count == 0)
    {
        <div class="config-section-grid" aria-label="Configuration sections loading">
            @foreach (var section in new[] {
                (Name: "Async", Icon: "bi-gear-fill"), (Name: "CircuitBreaker", Icon: "bi-shield-fill"),
                (Name: "Backend Resilience", Icon: "bi-shield-fill-check"),
                (Name: "HealthProbe", Icon: "bi-activity"), (Name: "Hosts", Icon: "bi-database-fill"),
                (Name: "Header Policy", Icon: "bi-card-checklist"),
                (Name: "Identity & Access", Icon: "bi-shield-check"), (Name: "LoadBalancing", Icon: "bi-diagram-3-fill"),
                (Name: "Logging", Icon: "bi-file-earmark-text-fill"), (Name: "Request", Icon: "bi-arrow-left-right"),
                (Name: "Request Processing", Icon: "bi-cpu-fill"),
                (Name: "Response", Icon: "bi-arrow-return-left"), (Name: "Server", Icon: "bi-hdd-stack-fill")
            })
            {
                <AppConfigurationSectionWidget Section="@(section.Name)" Icon="@(section.Icon)" IsLoading="true">
                    <SummaryContent>
                        <span class="config-skeleton-line" aria-hidden="true"></span>
                        <span class="config-skeleton-line config-skeleton-short" aria-hidden="true"></span>
                    </SummaryContent>
                </AppConfigurationSectionWidget>
            }
        </div>
        <section class="config-tokenomics-page tokenomics-configuration" aria-labelledby="tokenomics-configuration-heading">
            <h2 id="tokenomics-configuration-heading" class="h5">Tokenomics</h2>
            <div class="tokenomics-summary-grid" aria-label="Tokenomics settings loading">
                @foreach (var name in new[] { "Limits & Budgets", "Request Priority", "Capacity & Queues", "Model Routing", "Model Costs" })
                {
                    <button type="button" class="tokenomics-summary-card @(name is "Model Routing" or "Model Costs" ? "tokenomics-summary-wide" : null)" disabled
                            aria-label="@($"{name} settings loading")">
                        <span class="tokenomics-summary-heading">@name</span>
                        <span class="config-skeleton-line" aria-hidden="true"></span>
                        <span class="config-skeleton-line config-skeleton-short" aria-hidden="true"></span>
                    </button>
                }
            </div>
        </section>
    }
    @if (_editingLabel && Settings.Count > 0)
    {
        <AppConfigurationSectionsWidget Groups="VisibleGroups" IsLoading="IsLoading" OnSelected="SelectSection" />

        <div class="tokenomics-configuration">
            <section class="config-tokenomics-page tokenomics-configuration" aria-label="Tokenomics configuration" aria-busy="@(IsLoading ? "true" : "false")">
                <CascadingValue TValue="bool" Name="ShowConfigurationDetails" Value="_showConfigurationDetails">
                    <fieldset class="config-tokenomics-fields" disabled="@IsLoading">
                        <ConfigurationExplanation Section="Tokenomics" />
                        <TokenomicsEditor Settings="@(Settings.Where(setting => IsTokenomicsSectionName(setting.Section)).ToList())"
                            OnChanged="StateHasChanged" @key="Settings" />
                    </fieldset>
                </CascadingValue>
            </section>
            <div class="config-tokenomics-save-bar">
                <div class="config-tokenomics-save-status" role="status">
                    <span class="bi @(HasPendingChanges ? "bi-pencil-square" : "bi-check-circle-fill")" aria-hidden="true"></span>
                    <span>@(HasPendingChanges ? $"{ChangedCount} unsaved configuration changes" : "No unsaved configuration changes")</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(IsLoading || !HasPendingChanges)"
                            title="Discard all local changes for this configuration" @onclick="ResetAll">Discard</button>
                    <button type="button" class="btn btn-primary" disabled="@(IsLoading || !HasPendingChanges)" @onclick="UpdateSettingsAsync">Save changes</button>
                </div>
            </div>
        </div>

        @if (SelectedSection is not null)
        {
            <CascadingValue TValue="bool" Name="ShowConfigurationDetails" Value="_showConfigurationDetails">
            <AppConfigurationSectionWidget Section="@SelectedSection" IsExpanded="true" OnClose="CloseSection">
                <HeaderContent>
                        <div>
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                @if (IsRequestProcessingSection)
                                {
                                    <span class="bi bi-arrow-left-right fs-4 text-primary" aria-hidden="true"></span>
                                }
                                <h2 class="h5 mb-0">@SelectedSection</h2>
                                @if (SelectedSection != "Local change review")
                                {
                                    <ConfigurationHelp Section="@(IsRequestProcessingSection ? "Request" : SelectedSection)" />
                                }
                                @if (string.Equals(SelectedSection, "Logging", StringComparison.OrdinalIgnoreCase)
                                    || (SelectedSection.ToLowerInvariant() is "identity & access" or "request" or "response" or "server"
                                        && SelectedSettings.Any(setting => RequiresRestart(setting.Mode))))
                                {
                                    <span class='badge @(SelectedSettings.Any(setting => setting.IsChanged && RequiresRestart(setting.Mode)) ? "text-bg-warning" : "text-bg-light")'
                                          role="status">Restart required</span>
                                }
                            </div>
                            @if (SelectedSection == "Local change review")
                            {
                                <span class="small text-muted">@ChangedCount @(ChangedCount == 1 ? "setting changed" : "settings changed")</span>
                            }
                            else if (IsHealthProbeSection)
                            {
                                <span class="small text-muted">@(HealthProbeSetting is { } probe && HealthProbeEditor.IsEnabled(probe) ? "Enabled" : "Disabled")</span>
                            }
                            else if (IsCircuitBreakerSection)
                            {
                                <span class="small text-muted">@CircuitBreakerEditor.Summary(SelectedSettings)</span>
                            }
                            else if (IsLoadBalancingSection)
                            {
                                <span class="small text-muted">@LoadBalancingEditor.Summary(SelectedSettings)</span>
                            }
                            else if (IsRequestProcessingSection)
                            {
                                <span class="small text-muted">Configure timeouts, headers, and request prioritization.</span>
                            }
                            else if (IsPlaceholderSection)
                            {
                                <span class="small text-muted">Dummy value</span>
                            }
                            else if (!string.Equals(SelectedSection, "Logging", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="small text-muted">@SelectedSettings.Count settings</span>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (SelectedSection != "Local change review")
                            {
                                <label class="d-flex align-items-center gap-2 small text-nowrap">
                                    <input class="form-check-input m-0" type="checkbox" disabled="@(!_configurationHelpLoaded)"
                                           @bind="_showConfigurationDetails" @bind:after='async () =>
                                           {
                                               try
                                               {
                                                   await JS.InvokeVoidAsync("sessionStorage.setItem", "chat-tester.configuration.help", _showConfigurationDetails ? "true" : "false");
                                               }
                                               catch (Exception ex) when (ex is JSException or JSDisconnectedException)
                                               {
                                                   Console.Error.WriteLine($"Unable to save configuration Help preference: {ex.Message}");
                                               }
                                           }' />
                                    Help
                                </label>
                            }
                            @if (SelectedSection == "Local change review")
                            {
                                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" disabled="@(ChangedCount == 0)" @onclick="ResetAll">
                                    <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Reset all
                                </button>
                            }
                            <button type="button" class="btn-close" aria-label="Close" data-dialog-cancel @onclick="CloseSection"></button>
                        </div>
                </HeaderContent>
                <EditorContent>
                        @if (!string.Equals(SelectedSection, "Identity & Access", StringComparison.OrdinalIgnoreCase)
                            && !IsRequestProcessingSection)
                        {
                            <ConfigurationExplanation Section="@SelectedSection" />
                        }
                        @if (SelectedSection == "Local change review")
                        {
                            @if (ChangedCount == 0)
                            {
                                <p class="text-muted mb-0">No local changes.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead><tr><th>Key</th><th>Current</th><th>Draft</th></tr></thead>
                                        <tbody>
                                            @foreach (var setting in ChangedSettings)
                                            {
                                                <tr>
                                                    <td class="font-monospace text-break">
                                                        @setting.Key
                                                        <ConfigurationHelp Section='@(setting.Key.Contains(":Security:", StringComparison.OrdinalIgnoreCase) ? "Security" : setting.Section)' Topic="@setting.Name" />
                                                    </td>
                                                    <td class="font-monospace text-break">@DisplayLoadedValue(setting.LoadedValue)</td>
                                                    <td class="font-monospace text-break">@DisplayLoadedValue(setting.DraftValue)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else if (IsHostSection)
                        {
                            <HostSectionEditor Hosts="SelectedSettings" Settings="Settings" Label="@Label" OnHostCreated="AddCreatedHost" />
                        }
                        else if (IsHealthProbeSection)
                        {
                            @if (HealthProbeSetting is { } probe)
                            {
                                <HealthProbeEditor Setting="probe" OnChanged="StateHasChanged" />
                            }
                        }
                        else if (IsCircuitBreakerSection)
                        {
                            <CircuitBreakerEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (IsLoadBalancingSection)
                        {
                            <LoadBalancingEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (string.Equals(SelectedSection, "Logging", StringComparison.OrdinalIgnoreCase))
                        {
                            <LoggingEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (string.Equals(SelectedSection, "Identity & Access", StringComparison.OrdinalIgnoreCase))
                        {
                            <IdentityAccessEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (string.Equals(SelectedSection, "Request", StringComparison.OrdinalIgnoreCase))
                        {
                            <RequestEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (IsRequestProcessingSection)
                        {
                            <RequestProcessingEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (string.Equals(SelectedSection, "Response", StringComparison.OrdinalIgnoreCase))
                        {
                            <ResponseEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (string.Equals(SelectedSection, "Server", StringComparison.OrdinalIgnoreCase))
                        {
                            <ServerEditor Settings="SelectedSettings" OnChanged="StateHasChanged" />
                        }
                        else if (IsPlaceholderSection)
                        {
                            <p class="mb-0">Dummy value</p>
                        }
                        else
                        {
                            <table class="table table-sm align-middle config-table mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Setting</th>
                                    <th scope="col">Restart required</th>
                                    <th scope="col">Local value</th>
                                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var setting in SelectedSettings)
                                {
                                    <tr class="@(setting.IsChanged ? "config-row-changed" : string.Empty)">
                                        <th scope="row">
                                            <div class="fw-semibold">@setting.Name <ConfigurationHelp Section="@setting.Section" Topic="@setting.Name" /></div>
                                            <div class="small text-muted font-monospace text-break">@setting.Key</div>
                                            <ConfigurationExplanation Section="@setting.Section" Topic="@setting.Name" />
                                        </th>
                                        <td>
                                            <input class="form-check-input" type="checkbox" checked="@RequiresRestart(setting.Mode)" disabled
                                                   title="@(RequiresRestart(setting.Mode) ? "Cold setting: restart required to apply" : "Warm setting: applied without restart")" />
                                        </td>
                                        <td>
                                            @if (IsBoolean(setting.LoadedValue))
                                            {
                                                <select class="form-select form-select-sm"
                                                        @bind:get="setting.DraftValue" @bind:set="@(value => SetDraftValue(setting, value))">
                                                    <option value="true">true</option>
                                                    <option value="false">false</option>
                                                </select>
                                            }
                                            else if (IsMultiline(setting.LoadedValue))
                                            {
                                                <textarea class="form-control form-control-sm font-monospace" rows="2"
                                                          @bind:get="setting.DraftValue" @bind:set="@(value => SetDraftValue(setting, value))"></textarea>
                                            }
                                            else
                                            {
                                                <input class="form-control form-control-sm font-monospace" type="@InputType(setting.LoadedValue)"
                                                       @bind:get="setting.DraftValue" @bind:set="@(value => SetDraftValue(setting, value))" />
                                            }
                                            @if (setting.IsChanged)
                                            {
                                                <div class="small text-muted text-break mt-1">Current: @DisplayLoadedValue(setting.LoadedValue)</div>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (setting.IsChanged)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary text-nowrap" type="button" title="Discard this edit and restore the current loaded value"
                                                        aria-label="@($"Revert {setting.Name} to its loaded value")"
                                                        @onclick="() => Reset(setting)">
                                                    <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Revert
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        }
                </EditorContent>
            </AppConfigurationSectionWidget>
            </CascadingValue>
        }
    }
    </div>
</div>

<dialog @ref="_labelDialog" class="config-label-dialog" aria-labelledby="label-dialog-title">
    <form @onsubmit="CreateLabelDraftAsync" @onsubmit:preventDefault="true">
        <h2 id="label-dialog-title" class="h5">@(_duplicateSource is null ? "New Label" : "Duplicate Label")</h2>
        @if (_duplicateSource is not null)
        {
            <p class="small text-muted text-break">Source: @LabelDisplay(_duplicateSource)</p>
        }
        <label for="new-config-label" class="form-label">Label name</label>
        <input id="new-config-label" class="form-control" autofocus autocomplete="off" maxlength="256"
               @bind="_draftLabelName" @bind:event="oninput" aria-describedby="label-name-error" aria-invalid="@(!string.IsNullOrEmpty(LabelNameError))" />
        <div id="label-name-error" class="text-danger small mt-2" role="status">@LabelNameError</div>
        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-outline-secondary" data-dialog-cancel @onclick="CancelLabelDialogAsync">Cancel</button>
            <button type="submit" class="btn btn-primary" disabled="@(!string.IsNullOrEmpty(LabelNameError) || string.IsNullOrWhiteSpace(_draftLabelName))">@(_duplicateSource is null ? "Create Draft" : "Duplicate Draft")</button>
        </div>
    </form>
</dialog>

<dialog @ref="_leaveDialog" class="config-label-dialog" aria-labelledby="leave-dialog-title">
    <h2 id="leave-dialog-title" class="h5">Save changes to @LabelDisplay(Label)?</h2>
    <p>Your changes have not been saved.</p>
    @if (HasLoadError)
    {
        <p class="text-danger small" role="alert">@StatusMessage</p>
    }
    <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-outline-secondary" data-dialog-cancel disabled="@IsLoading" @onclick="CancelLeaveAsync">Cancel</button>
        <button type="button" class="btn btn-outline-danger" disabled="@IsLoading" @onclick="DiscardAndLeaveAsync">Discard Changes</button>
        <button type="button" class="btn btn-primary" disabled="@IsLoading" @onclick="SaveAndLeaveAsync">@(IsLoading ? "Saving..." : "Save Changes")</button>
    </div>
</dialog>



</div>

@code {
    private string Endpoint { get; set; } = string.Empty;
    private string Label { get; set; } = string.Empty;
    private List<string> AvailableLabels { get; set; } = new();
    private string StatusMessage { get; set; } = "Enter an App Configuration endpoint, then load its published proxy settings.";
    private bool IsLoading { get; set; }
    private bool HasLoadError { get; set; }
    private List<AppConfigurationScaffoldSetting> Settings { get; set; } = new();
    private List<AppConfigurationScaffoldSetting> _allSettings = new();
    private string? SelectedSection { get; set; }
    private bool _showConfigurationDetails;
    private bool _configurationHelpLoaded;
    private DateTime? _dataReadyAtUtc;
    private DateTime? _lastLoadedAtUtc;
    private System.Timers.Timer? _uiTimer;
    private CancellationTokenSource? _statusClearCancellation;
    private TimeSpan _elapsed;
    private bool _editingLabel;
    private string? _configurationAction;
    private bool _showEndpointSettings;
    private bool _newLabelDraft;
    private string? _loadedEndpoint;
    private string _draftLabelName = string.Empty;
    private string? _duplicateSource;
    private IReadOnlyList<AppConfigurationScaffoldSetting> _selectedSettings = Array.Empty<AppConfigurationScaffoldSetting>();
    private ElementReference _labelDialog;
    private ElementReference _leaveDialog;
    private IJSObjectReference? _dialogModule;
    private bool _disposed;
    private DotNetObjectReference<AdminConfigurationPage>? _pageReference;
    private Func<Task>? _pendingLeave;
    private bool LabelsReady => _dialogModule is not null && string.Equals(_loadedEndpoint, Endpoint.Trim(), StringComparison.OrdinalIgnoreCase);
    private bool HasPendingChanges => _editingLabel && (_newLabelDraft || ChangedCount > 0);
    private string? LabelNameError => string.IsNullOrWhiteSpace(_draftLabelName) ? null
        : _draftLabelName.Trim().IndexOfAny(['*', ',', '\\', '\0']) >= 0 ? "Names cannot contain *, comma, backslash, or null characters."
        : AvailableLabels.Contains(_draftLabelName.Trim(), StringComparer.Ordinal) ? "A label with this name already exists."
        : null;

    private IEnumerable<IGrouping<string, AppConfigurationScaffoldSetting>> VisibleGroups => Settings
        .Where(setting => !string.Equals(setting.Name, "Sentinel", StringComparison.OrdinalIgnoreCase))
        .GroupBy(setting => string.Equals(setting.Section, "Profiles", StringComparison.OrdinalIgnoreCase)
            ? "Identity & Access"
            : RequestProcessingEditor.IsRequestProcessingSetting(setting)
                ? "Request Processing"
            : setting.Section, StringComparer.OrdinalIgnoreCase)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<AppConfigurationScaffoldSetting> ChangedSettings => Settings
        .Where(setting => setting.IsChanged)
        .ToList();

    private int ChangedCount => Settings.Count(setting => setting.IsChanged);

    protected override void OnInitialized()
    {
        Endpoint = AppConfiguration.DefaultEndpoint;
        Label = AppConfiguration.DefaultLabel;
        _editingLabel = !string.IsNullOrWhiteSpace(Endpoint);
        IsLoading = _editingLabel;
        StatusMessage = string.IsNullOrWhiteSpace(Endpoint)
            ? "Configure an App Configuration endpoint, then refresh to load its configurations."
            : $"Loading the configured default label {LabelDisplay(Label)}...";
    }

    private async Task LoadSettingsAsync()
    {
        CancelStatusClear();
        IsLoading = true;
        HasLoadError = false;
        StatusMessage = "Loading settings with DefaultAzureCredential...";

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        StartTimer(stopwatch);
        try
        {
            _allSettings = (await AppConfiguration.LoadAsync(Endpoint.Trim())).ToList();
            if (_disposed) return;
            AvailableLabels = AppConfiguration.CachedLabels?.ToList() ?? new List<string>();
            _loadedEndpoint = Endpoint.Trim();
            _lastLoadedAtUtc = DateTime.UtcNow;
            if (_editingLabel)
            {
                if (!AvailableLabels.Contains(Label, StringComparer.Ordinal))
                {
                    var missingLabel = Label;
                    ShowLabels();
                    HasLoadError = true;
                    StatusMessage = $"Configuration {LabelDisplay(missingLabel)} was not found. Select an existing configuration or explicitly create a new one.";
                    return;
                }
                OpenLabel(Label);
            }
            if (!AvailableLabels.Contains(Label, StringComparer.Ordinal))
            {
                Label = AvailableLabels.Contains(AppConfiguration.DefaultLabel, StringComparer.Ordinal)
                    ? AppConfiguration.DefaultLabel
                    : AvailableLabels.FirstOrDefault() ?? string.Empty;
            }
            _loadedEndpoint = Endpoint.Trim();
            _showEndpointSettings = false;
            if (!_editingLabel) Settings.Clear();

            var totalMs = stopwatch.ElapsedMilliseconds;
            var source = AppConfiguration.LastLoadFromDisk ? "disk cache · " : string.Empty;
            var timing = $"{source}connect {AppConfiguration.LastConnectMs} ms · download {AppConfiguration.LastDownloadMs} ms · total {totalMs} ms";
            StatusMessage = $"Loaded {AvailableLabels.Count} labels and {_allSettings.Count} proxy settings. {timing}.";

            _dataReadyAtUtc = DateTime.UtcNow;
            StateHasChanged();
        }
        catch (AuthenticationFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"Authentication failed: {ex.Message}";
        }
        catch (RequestFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"App Configuration returned {ex.Status}: {ex.Message}";
        }
        catch (Exception ex)
        {
            HasLoadError = true;
            StatusMessage = ex.Message;
        }
        finally
        {
            if (HasLoadError && _lastLoadedAtUtc is null)
            {
                _editingLabel = false;
            }
            stopwatch.Stop();
            _elapsed = stopwatch.Elapsed;
            IsLoading = false;
            StopTimer();
        }
    }

    private async Task UpdateSettingsAsync()
    {
        CancelStatusClear();
        IsLoading = true;
        HasLoadError = false;
        StatusMessage = $"Updating {ChangedCount} setting(s) and Warm:Sentinel...";

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        StartTimer(stopwatch);
        try
        {
            var result = await AppConfiguration.UpdateAsync(Endpoint.Trim(), Label, Settings, createLabel: _newLabelDraft);
            _allSettings = result.Settings.ToList();
            _lastLoadedAtUtc = DateTime.UtcNow;
            _newLabelDraft = false;
            AvailableLabels = AppConfiguration.CachedLabels?.ToList() ?? new List<string>();
            ApplyLabelFilter();

            StatusMessage = $"Updated and verified {result.UpdatedCount} setting(s); Warm:Sentinel {result.PreviousSentinel} → {result.NewSentinel}; re-downloaded {_allSettings.Count} settings in {stopwatch.ElapsedMilliseconds} ms.";
            _dataReadyAtUtc = DateTime.UtcNow;
            StateHasChanged();
        }
        catch (AuthenticationFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"Authentication failed: {ex.Message}";
        }
        catch (RequestFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"App Configuration returned {ex.Status}: {ex.Message}";
        }
        catch (Exception ex)
        {
            HasLoadError = true;
            StatusMessage = ex.Message;
        }
        finally
        {
            if (HasLoadError)
            {
                StatusMessage += " Some writes may have completed. Reload the label list to inspect saved values before retrying.";
            }
            stopwatch.Stop();
            _elapsed = stopwatch.Elapsed;
            IsLoading = false;
            StopTimer();
        }
    }

    private void StartTimer(System.Diagnostics.Stopwatch stopwatch)
    {
        _elapsed = TimeSpan.Zero;
        _uiTimer?.Dispose();
        _uiTimer = new System.Timers.Timer(100) { AutoReset = true };
        _uiTimer.Elapsed += (_, _) =>
        {
            _elapsed = stopwatch.Elapsed;
            InvokeAsync(StateHasChanged);
        };
        _uiTimer.Start();
    }

    private void StopTimer()
    {
        _uiTimer?.Stop();
        _uiTimer?.Dispose();
        _uiTimer = null;
    }

    private void CancelStatusClear()
    {
        _statusClearCancellation?.Cancel();
        _statusClearCancellation?.Dispose();
        _statusClearCancellation = null;
    }

    private async Task ClearStatusAfterDelayAsync()
    {
        CancelStatusClear();
        _statusClearCancellation = new CancellationTokenSource();
        var cancellationToken = _statusClearCancellation.Token;
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), cancellationToken);
            StatusMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _uiTimer?.Dispose();
        CancelStatusClear();
        _ = DisposeDialogModuleAsync();
    }

    private async Task DisposeDialogModuleAsync()
    {
        var dialogModule = _dialogModule;
        var pageReference = _pageReference;
        _dialogModule = null;
        _pageReference = null;
        try
        {
            if (dialogModule is not null)
            {
                try
                {
                    await dialogModule.InvokeVoidAsync("detachNavigationGuard");
                }
                finally
                {
                    await dialogModule.DisposeAsync();
                }
            }
        }
        catch (JSDisconnectedException) { }
        finally { pageReference?.Dispose(); }
    }

    private void SelectSection(string section)
    {
        SelectedSection = section;
        RefreshSelectedSettings();
    }

    private void CloseSection()
    {
        SelectedSection = null;
        _selectedSettings = Array.Empty<AppConfigurationScaffoldSetting>();
    }

    private void AddCreatedHost(AppConfigurationScaffoldSetting host)
    {
        Settings.Insert(0, host);
        RefreshSelectedSettings();
    }

    private IReadOnlyList<AppConfigurationScaffoldSetting> SelectedSettings => _selectedSettings;

    private void RefreshSelectedSettings()
    {
        _selectedSettings = SelectedSection is null
            ? Array.Empty<AppConfigurationScaffoldSetting>()
            : string.Equals(SelectedSection, "Identity & Access", StringComparison.OrdinalIgnoreCase)
                ? Settings.Where(setting => string.Equals(setting.Section, "Profiles", StringComparison.OrdinalIgnoreCase)).ToList()
                : IsRequestProcessingSection
                    ? Settings.Where(RequestProcessingEditor.IsRequestProcessingSetting).ToList()
                    : Settings.Where(setting => string.Equals(setting.Section, SelectedSection, StringComparison.OrdinalIgnoreCase)
                        && (!string.Equals(SelectedSection, "Request", StringComparison.OrdinalIgnoreCase)
                            || !RequestProcessingEditor.IsRequestProcessingSetting(setting))).ToList();
    }

    private bool IsHostSection => string.Equals(SelectedSection, "Hosts", StringComparison.OrdinalIgnoreCase);

    private bool IsRequestProcessingSection =>
        string.Equals(SelectedSection, "Request Processing", StringComparison.OrdinalIgnoreCase);

    private bool IsPlaceholderSection => SelectedSection?.ToLowerInvariant() is
        "header policy" or "backend resilience";

    private static bool IsHealthProbeSectionName(string section) =>
        string.Equals(section, "HealthProbe", StringComparison.OrdinalIgnoreCase);

    private bool IsHealthProbeSection => IsHealthProbeSectionName(SelectedSection ?? string.Empty);

    private static bool IsTokenomicsSectionName(string section) =>
        string.Equals(section, "Tokenomics", StringComparison.OrdinalIgnoreCase);

    private static bool IsCircuitBreakerSectionName(string section) =>
        string.Equals(section, "CircuitBreaker", StringComparison.OrdinalIgnoreCase);

    private bool IsCircuitBreakerSection => IsCircuitBreakerSectionName(SelectedSection ?? string.Empty);

    private static bool IsLoadBalancingSectionName(string section) =>
        string.Equals(section, "LoadBalancing", StringComparison.OrdinalIgnoreCase);

    private bool IsLoadBalancingSection => IsLoadBalancingSectionName(SelectedSection ?? string.Empty);

    private AppConfigurationScaffoldSetting? HealthProbeSetting => SelectedSettings.FirstOrDefault();

    private static bool RequiresRestart(string mode) => string.Equals(mode, "Cold", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<string> LabelOptions
    {
        get
        {
            var options = new List<string>();
            void Add(string value)
            {
                if (!options.Contains(value, StringComparer.OrdinalIgnoreCase))
                {
                    options.Add(value);
                }
            }

            Add(Label ?? string.Empty);
            foreach (var label in AvailableLabels)
            {
                Add(label);
            }
            if (!string.IsNullOrEmpty(AppConfiguration.DefaultLabel))
            {
                Add(AppConfiguration.DefaultLabel);
            }

            return options;
        }
    }

    private static string LabelDisplay(string label) => string.IsNullOrEmpty(label) ? "(No label)" : label;

    // Filters the single cached download by the selected label — no extra service call.
    private void ApplyLabelFilter()
    {
        AppConfiguration.CachedLabel = Label;
        CloseSection();
        Settings = _allSettings
            .Where(setting => string.Equals(setting.Label, Label ?? string.Empty, StringComparison.Ordinal))
            .Select(setting => setting with { DraftValue = setting.LoadedValue, IsNew = false })
            .ToList();
        // Older labels predate Tokenomics, so stage only its missing keys for the normal Update flow.
        var existingKeys = Settings
            .Select(setting => setting.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        Settings.AddRange(AppConfiguration.CreateLabelDraft(Label)
            .Where(setting => IsTokenomicsSectionName(setting.Section) && existingKeys.Add(setting.Key)));
    }

    private void OpenLabel(string label)
    {
        CancelStatusClear();
        Label = label;
        ApplyLabelFilter();
        _editingLabel = true;
        _newLabelDraft = false;
        HasLoadError = false;
        StatusMessage = Settings.Count == 0 ? "No proxy settings are defined for this label." : string.Empty;
    }

    private async Task OpenLabelDialogAsync(string? source)
    {
        _duplicateSource = source;
        _draftLabelName = string.Empty;
        await _dialogModule!.InvokeVoidAsync("open", _labelDialog);
    }

    private async Task CancelLabelDialogAsync() => await _dialogModule!.InvokeVoidAsync("close", _labelDialog);

    private async Task CreateLabelDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftLabelName) || LabelNameError is not null)
        {
            return;
        }
        var source = _duplicateSource is null ? null : _allSettings.Where(setting => string.Equals(setting.Label, _duplicateSource, StringComparison.Ordinal)).ToList();
        Settings = AppConfiguration.CreateLabelDraft(_draftLabelName.Trim(), source).ToList();
        Label = _draftLabelName.Trim();
        _newLabelDraft = true;
        _editingLabel = true;
        CloseSection();
        CancelStatusClear();
        _dataReadyAtUtc = null;
        HasLoadError = false;
        StatusMessage = string.Empty;
        await CancelLabelDialogAsync();
    }

    private async Task BackToLabelsAsync()
    {
        if (HasPendingChanges)
        {
            _pendingLeave = () => { ShowLabels(); return Task.CompletedTask; };
            await _dialogModule!.InvokeVoidAsync("open", _leaveDialog);
            return;
        }
        ShowLabels();
    }

    private void ShowLabels()
    {
        CancelStatusClear();
        _dataReadyAtUtc = null;
        _editingLabel = false;
        _configurationAction = null;
        _newLabelDraft = false;
        Settings.Clear();
        CloseSection();
        StatusMessage = string.Empty;
        HasLoadError = false;
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (!HasPendingChanges && !IsLoading) return;
        context.PreventNavigation();
        await RequestLeaveAsync(context.TargetLocation);
    }

    /// <summary>Guards enhanced navigation links while local edits are pending.</summary>
    [JSInvokable]
    public async Task RequestLeaveAsync(string targetLocation)
    {
        if (IsLoading) return;
        _pendingLeave = async () =>
        {
            ShowLabels();
            await _dialogModule!.InvokeVoidAsync("detachNavigationGuard");
            Navigation.NavigateTo(targetLocation);
        };
        await _dialogModule!.InvokeVoidAsync("open", _leaveDialog);
    }

    private async Task CancelLeaveAsync()
    {
        if (IsLoading) return;
        _pendingLeave = null;
        await _dialogModule!.InvokeVoidAsync("close", _leaveDialog);
    }

    private async Task DiscardAndLeaveAsync()
    {
        var leave = _pendingLeave;
        await CancelLeaveAsync();
        if (leave is not null) await leave();
    }

    private async Task SaveAndLeaveAsync()
    {
        await UpdateSettingsAsync();
        if (!HasLoadError) await DiscardAndLeaveAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _dialogModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/AdminConfigurationPage.razor.js");
            if (_disposed)
            {
                await DisposeDialogModuleAsync();
                return;
            }
            _pageReference = DotNetObjectReference.Create(this);
            try
            {
                var savedHelp = await JS.InvokeAsync<string?>("sessionStorage.getItem", "chat-tester.configuration.help");
                _showConfigurationDetails = bool.TryParse(savedHelp, out var helpEnabled) && helpEnabled;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                Console.Error.WriteLine($"Unable to restore configuration Help preference: {ex.Message}");
            }
            if (_disposed) return;
            _configurationHelpLoaded = true;
            if (!string.IsNullOrWhiteSpace(Endpoint))
            {
                await LoadSettingsAsync();
                if (_disposed) return;
                if (!HasLoadError)
                {
                    if (AvailableLabels.Contains(AppConfiguration.DefaultLabel, StringComparer.Ordinal))
                    {
                        OpenLabel(AppConfiguration.DefaultLabel);
                    }
                    else
                    {
                        HasLoadError = true;
                        _dataReadyAtUtc = null;
                        StatusMessage = $"Configured default label {LabelDisplay(AppConfiguration.DefaultLabel)} was not found. Select an existing configuration or explicitly create a new one.";
                    }
                }
            }
            if (_disposed) return;
            StateHasChanged();
        }

        if (_dialogModule is not null)
        {
            await _dialogModule.InvokeVoidAsync("setNavigationGuard", _pageReference, HasPendingChanges, IsLoading);
        }

        if (_disposed) return;
        // Measures the gap between data being ready and the browser actually painting it.
        if (_dataReadyAtUtc is { } readyAt)
        {
            var renderLagMs = (long)(DateTime.UtcNow - readyAt).TotalMilliseconds;
            _dataReadyAtUtc = null;
            StatusMessage += $" · render +{renderLagMs} ms";
            StateHasChanged();
            _ = ClearStatusAfterDelayAsync();
        }
    }

    private static bool IsBoolean(string value) => bool.TryParse(value, out _);

    private static bool IsMultiline(string value) => value.Length > 100 || value.Contains(',');

    private static string InputType(string value) => decimal.TryParse(value, out _) ? "number" : "text";

    private static string DisplayLoadedValue(string value) => string.IsNullOrEmpty(value) ? "(empty)" : value;

    private static void SetDraftValue(AppConfigurationScaffoldSetting setting, string? value) =>
        setting.DraftValue = value ?? string.Empty;

    private static void Reset(AppConfigurationScaffoldSetting setting) => setting.RevertDraft();

    private void ResetAll()
    {
        foreach (var setting in Settings)
        {
            Reset(setting);
        }
        // Recreate persistent editors to discard buffered invalid input as well as saved drafts.
        Settings = Settings.ToList();
    }

    private Task ResetToDefaultsAsync()
    {
        CancelStatusClear();
        _dataReadyAtUtc = null;
        try
        {
            var changedCount = AppConfiguration.ApplyProxyDefaults(Settings);
            HasLoadError = false;
            StatusMessage = changedCount == 0
                ? "All non-host settings already match ProxyConfig defaults."
                : $"Staged {changedCount} non-host default setting(s). Changes have not been saved.";
        }
        catch (Exception ex)
        {
            HasLoadError = true;
            StatusMessage = ex.Message;
        }

        return Task.CompletedTask;
    }
}