@page "/tokenomics"
@namespace CompanionApp.Components.Pages
@rendermode InteractiveServer
@inject CompanionApp.Components.Shared.TokenomicsDashboardStore Store
@implements IDisposable

<PageTitle>Tokenomics</PageTitle>

<div class="tokenomics-page">
    <header class="tokenomics-header">
        <div>
            <h1>Tokenomics</h1>
            <p>Usage, cost, policy and performance insights for your AI workloads</p>
            @if (_snapshot.IsSampleData)
            {
                <span class="sample-data-label">Sample data · not connected to a service</span>
            }
        </div>
        <div class="tokenomics-filters" aria-label="Dashboard filters">
            <label><span class="visually-hidden">Time period</span><select aria-label="Time period">@foreach (var period in _snapshot.TimePeriods) { <option>@period</option> }</select></label>
            <label><span class="visually-hidden">Tenant</span><select aria-label="Tenant">@foreach (var tenant in _snapshot.Tenants) { <option>@tenant</option> }</select></label>
            <label><span class="visually-hidden">User</span><select aria-label="User">@foreach (var user in _snapshot.UserFilters) { <option>@user</option> }</select></label>
            <label><span class="visually-hidden">Model</span><select aria-label="Model">@foreach (var model in _snapshot.ModelFilters) { <option>@model</option> }</select></label>
            <span class="updated-label">@_snapshot.SnapshotLabel</span>
        </div>
    </header>

    <div class="tokenomics-layout">
        <main class="tokenomics-dashboard">
            <section class="tokenomics-kpis" aria-label="Summary metrics">
                @foreach (var metric in _snapshot.Metrics)
                {
                    <article class="tokenomics-card kpi-card">
                        <div class="kpi-heading">
                            <h2>@metric.Name</h2>
                            <span class="kpi-icon @metric.Tone" aria-hidden="true">@metric.Icon</span>
                        </div>
                        <p class="kpi-value">@metric.Value</p>
                        @if (!string.IsNullOrEmpty(metric.Change))
                        {
                            <p class="kpi-change @metric.ChangeTone">@metric.Change <span>vs. previous period</span></p>
                        }
                    </article>
                }
            </section>

            <section class="tokenomics-section">
                <div class="section-heading">
                    <div>
                        <h2>Quota and Budget Utilization</h2>
                        <p>Token usage and spend across your organization</p>
                    </div>
                    <div class="section-tabs" aria-label="Dashboard view">
                        <span class="selected">Overview</span><span>Tokens</span><span>Spend</span><span>Limits</span><span>At Risk</span>
                    </div>
                </div>
                <article class="tokenomics-card trend-card">
                    <h3>@(_snapshot.SpendAxisTicks.IsEmpty ? "Token Usage Trend" : "Token Usage and Spend Trend")</h3>
                    <div class="trend-plot" role="img" aria-label="@_snapshot.TrendDescription">
                        <div class="trend-y-label">Tokens</div>
                        <div class="trend-grid">
                            <div class="trend-y-ticks" aria-hidden="true">@foreach (var tick in _snapshot.TokenAxisTicks) { <span>@tick</span> }</div>
                            <div class="trend-bars">
                                @foreach (var point in _snapshot.Trend)
                                {
                                    <div class="trend-day">
                                        <div class="bar-area">
                                            <div class="trend-bar">
                                                <span class="bar-input" style="height: @((point.InputNet / _snapshot.TokenAxisMaximum * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                <span class="bar-cached" style="height: @((point.Cached / _snapshot.TokenAxisMaximum * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                                <span class="bar-output" style="height: @((point.Output / _snapshot.TokenAxisMaximum * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                            </div>
                                        </div>
                                        <span class="trend-date">@point.Date</span>
                                    </div>
                                }
                                <svg class="trend-line" viewBox="0 0 800 160" preserveAspectRatio="none" aria-hidden="true">
                                    <polyline points="@string.Join(" ", _snapshot.SpendLine.Select(point => $"{point.X},{point.Y}"))" />
                                    @foreach (var point in _snapshot.SpendLine)
                                    {
                                        <circle cx="@point.X" cy="@point.Y" r="3" />
                                    }
                                </svg>
                            </div>
                            <div class="trend-right-ticks" aria-hidden="true">@foreach (var tick in _snapshot.SpendAxisTicks) { <span>@tick</span> }</div>
                        </div>
                        @if (!_snapshot.SpendAxisTicks.IsEmpty)
                        {
                            <div class="trend-x-label">Spend (USD)</div>
                        }
                    </div>
                    <div class="trend-legend">
                        <span><i class="legend-input"></i>Input tokens (excl. cached)</span>
                        <span><i class="legend-output"></i>Output tokens</span>
                        <span><i class="legend-cached"></i>Cached input tokens</span>
                        @if (!_snapshot.SpendAxisTicks.IsEmpty)
                        {
                            <span><i class="legend-spend"></i>Spend (USD)</span>
                        }
                    </div>
                </article>

                <div class="tokenomics-insight-grid">
                    <article class="tokenomics-card insight-card model-card">
                        <h3>Token Usage by Model</h3>
                        <div class="model-breakdown">
                            <div class="model-donut" role="img" aria-label="@_snapshot.ModelDescription" style="--model-distribution: @_snapshot.ModelGradient">
                                <div><strong>@_snapshot.TotalTokens</strong><span>Total Tokens</span></div>
                            </div>
                            <ul class="model-legend">
                                @foreach (var model in _snapshot.Models)
                                {
                                    <li><i class="@model.Color"></i><span>@model.Name</span><strong>@model.Tokens <small>(@model.Share)</small></strong></li>
                                }
                            </ul>
                        </div>
                    </article>

                    <article class="tokenomics-card insight-card">
                        <h3>Spend by Tenant</h3>
                        @if (_snapshot.TenantSpend.IsEmpty)
                        {
                            <p>Spend unavailable: no price data.</p>
                        }
                        <ul class="horizontal-bars spend-bars">
                            @foreach (var tenant in _snapshot.TenantSpend)
                            {
                                <li><span>@tenant.Name</span><div class="horizontal-track"><i class="@tenant.Color" style="width: @tenant.Width"></i></div><strong>@tenant.Amount</strong></li>
                            }
                        </ul>
                    </article>

                    <article class="tokenomics-card insight-card">
                        <h3>Quota Utilization</h3>
                        @if (_snapshot.Quotas.IsEmpty)
                        {
                            <p>Quota data unavailable.</p>
                        }
                        <ul class="horizontal-bars quota-bars">
                            @foreach (var tenant in _snapshot.Quotas)
                            {
                                <li><span>@tenant.Name</span><div class="horizontal-track"><i class="@tenant.Color" style="width: @tenant.Width"></i></div><strong>@tenant.Amount</strong></li>
                            }
                        </ul>
                    </article>
                </div>

                <article class="tokenomics-card users-card">
                    <div class="users-heading">
                        <h3>Top Users by Token Usage</h3>
                        <div class="section-tabs compact-tabs" aria-label="Table grouping">
                            <span class="selected">Users</span><span>Tenants</span><span>Models</span>
                        </div>
                        <button class="export-button" type="button" disabled title="Export is a placeholder">↓ Export</button>
                    </div>
                    <div class="users-table-wrap">
                        <table class="users-table">
                            <thead><tr><th>#</th><th>User</th><th>Tenant</th><th>Total Tokens</th><th>Input Tokens</th><th>Output Tokens</th><th>Cached Tokens</th><th>Spend (USD)</th><th>Quota Used</th><th>Trend</th></tr></thead>
                            <tbody>
                                @foreach (var user in _snapshot.Users)
                                {
                                    <tr>
                                        <td>@user.Rank</td><td><i class="user-dot @user.Color"></i>@user.Name</td><td>@user.Tenant</td><td>@user.Total</td><td>@user.Input</td><td>@user.Output</td><td>@user.Cached</td><td>@user.Spend</td>
                                        <td><div class="quota-cell">@if (user.Quota.EndsWith('%')) { <span class="quota-track"><i class="@user.QuotaColor" style="width: @user.Quota"></i></span> }<span>@user.Quota</span></div></td>
                                        <td>@if (!string.IsNullOrEmpty(user.Sparkline)) { <svg class="sparkline" viewBox="0 0 68 20" aria-label="Usage trend"><polyline points="@user.Sparkline" /></svg> } else { <span>Unavailable</span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </article>
            </section>
        </main>

        <aside class="tokenomics-reports" aria-label="Tokenomics reports">
            <h2><span aria-hidden="true">▥</span> Tokenomics Reports</h2>
            <p>Select a report to explore detailed insights</p>
            @foreach (var report in _snapshot.Reports)
            {
                <button type="button" class="report-card" disabled title="Report navigation is a placeholder">
                    <span class="report-icon" aria-hidden="true">@report.Icon</span>
                    <span><strong>@report.Name</strong><small>@report.Description</small></span>
                    <span class="report-arrow" aria-hidden="true">›</span>
                </button>
            }
        </aside>
    </div>
</div>

@code {
    private CompanionApp.Components.Shared.TokenomicsDashboardSnapshot _snapshot = new();
    private bool _disposed;

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        _snapshot = Store.GetSnapshot();
    }

    private void OnStoreChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _snapshot = Store.GetSnapshot();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        _disposed = true;
        Store.Changed -= OnStoreChanged;
    }
}
