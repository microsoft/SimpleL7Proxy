@page "/insights"
@namespace CompanionApp.Components.Pages
@rendermode InteractiveServer
@implements IAsyncDisposable
@using CompanionApp.Components.Shared
@using CompanionApp.Components.Shared.EventHub
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.Json
@using System.Text.RegularExpressions
@using CompanionApp.Observability
@using static CompanionApp.Observability.ObservabilityRequestProjection
@using static CompanionApp.Observability.InsightsProjection
@inject ObservabilityDashboardStore Store
@inject IOptions<EventHubMonitorOptions> MonitorOptions
@inject IJSRuntime JS
@inject UserPreferencesService Preferences

<PageTitle>Insights</PageTitle>

<InspectorPageShell Title="Insights"
                    Tagline="@Tagline"
                    MetadataLine1="@HeaderMetadataLine1"
                    MetadataLine2="@HeaderMetadataLine2"
                    HideControls="true"
                    HistoryEntries="@ScopeHistoryEntries"
                    SelectedHistoryEntryId="@SelectedScopeId"
                    HistorySource="Insights">
    <div class="eventhub-toprow">
        <div class="eventhub-toprow-filters">
            <div class="card shadow-sm eventhub-card eventhub-filters-card">
                <div class="card-header eventhub-filters-header">
                    <span class="fw-semibold eventhub-filters-header-label">Filters</span>
                    <button type="button"
                            class="btn btn-link p-0 eventhub-filters-header-trigger"
                            @onclick="OpenFilterDialog"
                            aria-haspopup="dialog"
                            aria-expanded="@_isFilterDialogOpen"
                            aria-controls="eventhub-filters-dialog">
                        Filters
                    </button>
                </div>
                <div class="card-body eventhub-card-body">
                    <EventHubTopFilters EnvironmentOptions="@EnvironmentFilterOptions"
                                        SelectedEnvironment="@SelectedEnvironmentFilter"
                                        SelectedEnvironmentChanged="OnEnvironmentUiChanged"
                                        ShowUserFilter="@_snapshot.HasUserInfo"
                                        UserOptions="@UserFilterOptions"
                                        SelectedUser="@SelectedUserFilter"
                                        SelectedUserChanged="OnUserUiChanged"
                                        ShowModelFilter="@_snapshot.HasModelInfo"
                                        ModelOptions="@ModelFilterOptions"
                                        SelectedModel="@SelectedModelFilter"
                                        SelectedModelChanged="OnModelUiChanged" />
                </div>
            </div>
        </div>
    </div>

    @if (_isFilterDialogOpen)
    {
        <div class="eventhub-filter-dialog-backdrop" @onclick="CloseFilterDialog"></div>
        <div id="eventhub-filters-dialog"
             class="eventhub-filter-dialog"
             role="dialog"
             aria-modal="true"
             aria-label="Filters"
             @onclick:stopPropagation="true">
            <div class="eventhub-filter-dialog-header">
                <span class="fw-semibold">Filters</span>
                <button type="button" class="btn-close" aria-label="Close filters" @onclick="CloseFilterDialog"></button>
            </div>
            <div class="eventhub-filter-dialog-body">
                <EventHubTopFilters EnvironmentOptions="@EnvironmentFilterOptions"
                                    SelectedEnvironment="@SelectedEnvironmentFilter"
                                    SelectedEnvironmentChanged="OnEnvironmentUiChanged"
                                    ShowUserFilter="@_snapshot.HasUserInfo"
                                    UserOptions="@UserFilterOptions"
                                    SelectedUser="@SelectedUserFilter"
                                    SelectedUserChanged="OnUserUiChanged"
                                    ShowModelFilter="@_snapshot.HasModelInfo"
                                    ModelOptions="@ModelFilterOptions"
                                    SelectedModel="@SelectedModelFilter"
                                    SelectedModelChanged="OnModelUiChanged" />
            </div>
        </div>
    }

    <div class="row g-4 eventhub-workspace">

        @* ── Backends column ── *@
        <div class="col-12 col-lg-3 eventhub-config-col order-3">
            <div class="card shadow-sm eventhub-card eventhub-backends-card">
                <div class="@GetHeaderCssClass(BackendsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Backends</span>
                        <span class="text-white-50 small">@BackendSubtitle</span>
                        @if (!string.IsNullOrWhiteSpace(BackendsHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@BackendsHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-form-content">
                        @if (Backends.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm eventhub-backend-table mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Backend</th>
                                            <th scope="col">Status</th>
                                            <th scope="col" class="text-end">Lat</th>
                                            <th scope="col" class="text-end">Succ</th>
                                            <th scope="col" class="text-end">Calls</th>
                                            <th scope="col" class="text-end">Fail</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var backend in Backends)
                                        {
                                            <tr>
                                                <td title="@backend.Url">@backend.Name</td>
                                                <td title="@GetBackendCircuitBreakerTitle(backend)">
                                                    @backend.Status
                                                    <span class="eventhub-cb-indicator @GetBackendCircuitBreakerCss(backend) ms-1" aria-hidden="true">@GetBackendCircuitBreakerGlyph(backend)</span>
                                                </td>
                                                <td class="text-end">@backend.LatencyText</td>
                                                <td class="text-end" title="Probe OK/Fail: @backend.ProbeSuccesses/@backend.ProbeFailures">@backend.SuccessRate%</td>
                                                <td class="text-end">@backend.RequestCalls</td>
                                                <td class="text-end">@backend.RequestFailures</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No backend health received yet.</div>
                        }

                        <div class="eventhub-catalog-groups">
                            @foreach (var group in ProxyMetricGroups)
                            {
                                <section class="eventhub-catalog-group">
                                    <h6 class="eventhub-catalog-group-title">@group.Name</h6>
                                    <dl class="eventhub-catalog-metrics">
                                        @foreach (var metric in group.Metrics)
                                        {
                                            <div class="eventhub-catalog-row" title="@metric.Description">
                                                <dt>@metric.Name</dt>
                                                <dd>@metric.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="eventhub-row-resizer" role="separator" aria-orientation="horizontal" aria-label="Resize Backends and Endpoints heights">
                <span class="eventhub-row-resizer-grip" aria-hidden="true">===</span>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-endpoints-card">
                <div class="@GetHeaderCssClass(EndpointsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Endpoints</span>
                        @if (!string.IsNullOrWhiteSpace(EndpointsHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@EndpointsHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (EndpointTiles.Count == 0)
                    {
                        <div class="text-muted small">No endpoint backend-call records received yet.</div>
                    }
                    else
                    {
                        <div class="eventhub-model-list">
                            @foreach (var endpoint in EndpointTiles)
                            {
                                <div class="eventhub-model-card @endpoint.Css">
                                    <div class="eventhub-model-head">
                                        <span class="eventhub-model-name">@endpoint.Path</span>
                                        <span class="eventhub-model-status">@endpoint.Status</span>
                                    </div>
                                    <div class="eventhub-model-summary">
                                        <span>Calls <strong>@endpoint.Calls</strong></span>
                                        <span>Failed attempts <strong>@endpoint.Failures</strong></span>
                                        <span>Throttled <strong>@endpoint.ThrottledEvents</strong></span>
                                        <span>Endpoints <strong>@endpoint.EndpointCount</strong></span>
                                        <span>P1 <strong>@endpoint.Priority1Count</strong></span>
                                        <span>P2 <strong>@endpoint.Priority2Count</strong></span>
                                        <span>P3 <strong>@endpoint.Priority3Count</strong></span>
                                    </div>

                                    @if (endpoint.EndpointUsages.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm eventhub-model-table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Label</th>
                                                        <th scope="col" class="text-end">Calls</th>
                                                        <th scope="col" class="text-end">Failed attempts</th>
                                                        <th scope="col" class="text-end">Throttled</th>
                                                        <th scope="col" class="text-end">P1</th>
                                                        <th scope="col" class="text-end">P2</th>
                                                        <th scope="col" class="text-end">P3</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var usage in endpoint.EndpointUsages)
                                                    {
                                                        <tr>
                                                            <td title="@usage.TargetUrl">@usage.TargetName</td>
                                                            <td class="text-end">@usage.Calls</td>
                                                            <td class="text-end">@usage.Failures</td>
                                                            <td class="text-end">@usage.ThrottledEvents</td>
                                                            <td class="text-end">@usage.Priority1Count</td>
                                                            <td class="text-end">@usage.Priority2Count</td>
                                                            <td class="text-end">@usage.Priority3Count</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Server column (runtime stats + endpoints + paths + users) ── *@
        <div class="col-12 col-lg-5 eventhub-endpoints-col order-2">
            <div class="card shadow-sm eventhub-card eventhub-runtime-card">
                <div class="@($"{GetHeaderCssClass(RuntimeHeaderTone)} eventhub-header-with-resize")">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Runtime Stats</span>
                        @if (!string.IsNullOrWhiteSpace(RuntimeHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@RuntimeHeaderReason</span>
                        }
                    </div>
                    <button type="button"
                            class="eventhub-col-resizer-grip eventhub-col-handle-mr"
                            aria-label="Resize Runtime Stats and Backends columns"></button>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-stats-grid">
                        @foreach (var tile in StatTiles)
                        {
                            <div class="eventhub-stat-tile @tile.Css">
                                <div class="eventhub-tile-head">
                                    <div class="eventhub-tile-head-main">
                                        <span class="eventhub-tile-title">@tile.Title</span>
                                        <span class="eventhub-tile-primary">@tile.Primary</span>
                                        @if (!string.IsNullOrWhiteSpace(tile.PrimaryDetail))
                                        {
                                            <span class="eventhub-tile-primary-detail">@tile.PrimaryDetail</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(tile.CornerStatus))
                                    {
                                        <div class="eventhub-tile-corner" title="@tile.CornerHoverDetails" aria-label="Circuit breaker @tile.CornerStatus">
                                            <span class="eventhub-cb-indicator @tile.CornerCss" aria-hidden="true">@(tile.CornerCss == "closed" ? "👍" : "✕")</span>
                                        </div>
                                    }
                                </div>
                                @if (tile.Metrics.Count > 0)
                                {
                                    <div class="eventhub-tile-metrics">
                                        @foreach (var metric in tile.Metrics)
                                        {
                                            <div class="eventhub-tile-metric">
                                                <span class="eventhub-tile-metric-label">@metric.Label</span>
                                                <span class="eventhub-tile-metric-value">@metric.Value</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-chargeback-card">
                <div class="@GetHeaderCssClass(UsersHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Usage and Chargeback Trend</span>
                        <span class="text-white-50 small">historical calls and token trend</span>
                        @if (!string.IsNullOrWhiteSpace(UsersHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@UsersHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (UserShares.Count == 0)
                    {
                        <div class="text-muted small">No user request records received yet.</div>
                    }
                    else
                    {
                        <div class="eventhub-trend-metric-selector">
                            <label class="visually-hidden" for="trend-metrics">Add a metric</label>
                            <select id="trend-metrics"
                                    class="form-select form-select-sm eventhub-trend-metric-select @(_isTrendMetricPickerExpanded ? "is-expanded" : string.Empty)"
                                    value="@_trendMetricSelectionKey"
                                    @onfocus="() => _isTrendMetricPickerExpanded = true"
                                    @onblur="() => _isTrendMetricPickerExpanded = false"
                                    @onchange="OnTrendMetricSelected">
                                <option value="">Metrics</option>
                                @foreach (var metric in TrendMetricOptions)
                                {
                                    <option value="@metric.Key" disabled="@IsTrendMetricSelected(metric.Key)">@metric.Label</option>
                                }
                            </select>
                            <div class="eventhub-trend-selected-list" aria-label="Selected metrics">
                                @foreach (var series in SelectedTrendMetrics)
                                {
                                    <label class="eventhub-trend-selected-item" title="@series.Label">
                                        <input type="checkbox"
                                               checked="@IsTrendMetricSelected(series.Key)"
                                               aria-label="Remove @series.Label"
                                               @onchange="args => OnTrendMetricSelectionChanged(series.Key, args)" />
                                        <span class="eventhub-user-color-dot" style="background-color:@series.Color"></span>
                                        @series.Label
                                    </label>
                                }
                            </div>
                        </div>

                        @if (UsageTrendPoints.Count == 0)
                        {
                            <div class="text-muted small">No historical trend points available yet.</div>
                        }
                        else if (SelectedTrendMetrics.Count == 0)
                        {
                            <div class="text-muted small">Select at least one metric to display the usage trend.</div>
                        }
                        else
                        {
                            <div class="eventhub-trend-chart" aria-label="Historical usage trend for the selected metrics">
                                @{
                                    var trendSlots = UsageTrendSlots;
                                    var trendMetrics = SelectedTrendMetrics;
                                    var bucketCount = trendSlots.Count;
                                    long yAxisMax = 1;
                                    foreach (var series in trendMetrics)
                                    {
                                        yAxisMax = Math.Max(yAxisMax, series.Values.Max());
                                    }

                                    const double chartWidth = 1000d;
                                    const double chartHeight = 300d;
                                    const double leftPadding = 56d;
                                    const double rightPadding = 24d;
                                    const double topPadding = 16d;
                                    const double bottomPadding = 44d;
                                    var drawableWidth = chartWidth - leftPadding - rightPadding;
                                    var drawableHeight = chartHeight - topPadding - bottomPadding;
                                    var bucketWidth = drawableWidth / bucketCount;
                                    var metricBarWidth = Math.Max(8d, Math.Min(80d, (bucketWidth * 0.72d) / trendMetrics.Count));
                                    var metricGroupWidth = metricBarWidth * trendMetrics.Count;

                                    double ComputeXForIndex(int index)
                                    {
                                        return leftPadding + ((index + 0.5d) * bucketWidth);
                                    }

                                    double ComputeYForValue(long value)
                                    {
                                        return topPadding + ((1d - (value / (double)yAxisMax)) * drawableHeight);
                                    }

                                    var yTicks = new[]
                                    {
                                        yAxisMax,
                                        (long)Math.Ceiling(yAxisMax / 2d),
                                        0L,
                                    }
                                    .Distinct()
                                    .OrderByDescending(value => value)
                                    .ToArray();

                                    var xTickCount = bucketCount;
                                }
                                <svg viewBox="0 0 1000 300" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                                    @foreach (var tick in yTicks)
                                    {
                                        var y = ComputeYForValue(tick);
                                        <line class="eventhub-trend-gridline" x1="@leftPadding" y1="@y" x2="@(chartWidth - rightPadding)" y2="@y" />
                                        <svg:text class="eventhub-trend-axis-label y" x="@(leftPadding - 8)" y="@(y + 4)">@tick</svg:text>
                                    }

                                    @for (var i = 0; i < xTickCount; i++)
                                    {
                                        var bucketIndex = i;
                                        var x = ComputeXForIndex(bucketIndex);
                                        var time = GetTrendSlotAxisLabel(bucketIndex);
                                        var isLastRepeatedLabel = bucketIndex == xTickCount - 1
                                            || !string.Equals(time, GetTrendSlotAxisLabel(bucketIndex + 1), StringComparison.Ordinal);
                                        <line class="eventhub-trend-gridline vertical" x1="@x" y1="@topPadding" x2="@x" y2="@(chartHeight - bottomPadding)" />
                                        @if (isLastRepeatedLabel)
                                        {
                                            <svg:text class="eventhub-trend-axis-label x" x="@x" y="@(chartHeight - 14)">@time</svg:text>
                                        }
                                    }

                                    <line class="eventhub-trend-axis" x1="@leftPadding" y1="@topPadding" x2="@leftPadding" y2="@(chartHeight - bottomPadding)" />
                                    <line class="eventhub-trend-axis" x1="@leftPadding" y1="@(chartHeight - bottomPadding)" x2="@(chartWidth - rightPadding)" y2="@(chartHeight - bottomPadding)" />

                                    @for (var bucketIndex = 0; bucketIndex < bucketCount; bucketIndex++)
                                    {
                                        var slot = trendSlots[bucketIndex];
                                        var slotRequests = GetCircuitTrendSlotRequests(slot);
                                        for (var metricIndex = 0; metricIndex < trendMetrics.Count; metricIndex++)
                                        {
                                            var series = trendMetrics[metricIndex];
                                            var totalValue = series.Values[bucketIndex];
                                            if (totalValue <= 0)
                                            {
                                                continue;
                                            }

                                            var x = ComputeXForIndex(bucketIndex) - (metricGroupWidth / 2d) + (metricIndex * metricBarWidth);
                                            var y = ComputeYForValue(totalValue);
                                            var height = ComputeYForValue(0) - y;
                                            long stackedValue = 0;
                                            foreach (var segment in series.Segments[bucketIndex])
                                            {
                                                var segmentY = ComputeYForValue(stackedValue + segment.Value);
                                                var segmentHeight = ComputeYForValue(stackedValue) - segmentY;
                                                <rect class="eventhub-trend-stack-segment" x="@x" y="@segmentY" width="@metricBarWidth" height="@segmentHeight" style="fill:@segment.Color" />
                                                @if (segmentHeight >= 13d)
                                                {
                                                    <svg:text class="eventhub-trend-stack-label" x="@(x + (metricBarWidth / 2d))" y="@(segmentY + (segmentHeight / 2d) + 3d)">@segment.Value</svg:text>
                                                }

                                                stackedValue += segment.Value;
                                            }

                                            <rect class="eventhub-trend-metric-outline" x="@x" y="@y" width="@metricBarWidth" height="@height" style="stroke:@series.Color" />
                                        }

                                        @if (slotRequests.Count > 0)
                                        {
                                            <rect class="eventhub-trend-slot-target has-requests"
                                                  x="@(leftPadding + (bucketIndex * bucketWidth))"
                                                  y="@topPadding"
                                                  width="@bucketWidth"
                                                  height="@drawableHeight"
                                                  tabindex="0"
                                                  role="button"
                                                  aria-label="Show requests for @GetTrendSlotLabel(slot)"
                                                  @onclick="() => OpenTrendSlot(slot, slotRequests)" />
                                        }
                                        else
                                        {
                                            <rect class="eventhub-trend-slot-target"
                                                  x="@(leftPadding + (bucketIndex * bucketWidth))"
                                                  y="@topPadding"
                                                  width="@bucketWidth"
                                                  height="@drawableHeight" />
                                        }
                                    }
                                </svg>
                                @if (_openTrendSlot is not null)
                                {
                                    <div class="eventhub-trend-request-panel" style="left:50%">
                                        <div class="eventhub-trend-request-panel-header">
                                            <div class="eventhub-trend-request-panel-title">@GetTrendSlotLabel(_openTrendSlot)</div>
                                            <button type="button" class="eventhub-trend-request-panel-close" aria-label="Close request list" @onclick="CloseTrendSlot">&times;</button>
                                        </div>
                                        @if (_openTrendSlotRequests.Count == 0)
                                        {
                                            <div class="eventhub-trend-request-empty">No requests in this slot.</div>
                                        }
                                        else
                                        {
                                            <div class="eventhub-trend-request-list">
                                                @foreach (var request in _openTrendSlotRequests)
                                                {
                                                    <button type="button" class="eventhub-trend-request-row" @onclick="() => OpenTrendRequest(request)">
                                                        <span class="eventhub-trend-request-number">@GetTrendRequestLabel(request)</span>
                                                        <span class="eventhub-trend-request-status @(request.StatusCode is >= 400 ? "failed" : "success")">@(request.StatusCode?.ToString() ?? request.Status)</span>
                                                        <span class="eventhub-trend-request-duration">@FormatTrendRequestDuration(request)</span>
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="eventhub-trend-footnote text-muted small">
                                @TrendWindowLabel
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-chargeback-table-card">
                <div class="@GetHeaderCssClass(UsersHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Users</span>
                        <span class="text-white-50 small">calls and share</span>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (UserShares.Count == 0)
                    {
                        <div class="text-muted small">No user request records received yet.</div>
                    }
                    else
                    {
                        <div class="eventhub-trend-metric-selector">
                            <label class="visually-hidden" for="user-share-metric">Share calculation column</label>
                            <select id="user-share-metric"
                                    class="form-select form-select-sm eventhub-trend-metric-select"
                                    value="@_selectedUserShareMetricKey"
                                    @onchange="OnUserShareMetricChanged">
                                @foreach (var metric in UserShareMetricOptions)
                                {
                                    <option value="@metric.Key">Share by: @metric.Label</option>
                                }
                            </select>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm eventhub-chargeback-table mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">User</th>
                                        <th scope="col" class="text-end">Calls</th>
                                        <th scope="col" class="text-end">Share (@SelectedUserShareMetric.Label)</th>
                                        @foreach (var metric in UsageTableMetrics)
                                        {
                                            <th scope="col" class="text-end">@metric.Label</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var share in UserShares)
                                    {
                                        <tr>
                                            <td title="@share.User">
                                                <span class="eventhub-user-color-dot" style="background-color:@GetUserColor(share.User)"></span>
                                                @share.User
                                            </td>
                                            <td class="text-end">@share.Calls</td>
                                            <td class="text-end">@share.Percent.ToString("0.#", CultureInfo.InvariantCulture)%</td>
                                            @foreach (var metric in UsageTableMetrics)
                                            {
                                                <td class="text-end">@(share.UsageMetrics.TryGetValue(metric.Key, out var value) ? value.ToString("N0", CultureInfo.InvariantCulture) : "-")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @{
                // Shared success/failed two-column markup for both the Paths and Users cards
                // (used by the always-present wide cards and, at <=860px viewport height, by the
                // merged tabbed card below) so the list rendering isn't duplicated per card.
                RenderFragment<(IReadOnlyList<LabeledCount> Success, IReadOnlyList<LabeledCount> Failed, string SuccessEmptyText, string FailedEmptyText)> groupsTemplate = ctx =>
                    @<div class="eventhub-path-groups">
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title success">Success</div>
                            @if (ctx.Success.Count == 0)
                            {
                                <div class="text-muted small">@ctx.SuccessEmptyText</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var item in ctx.Success)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@item.Label">@item.Label</dt>
                                            <dd>@item.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title failed">Failed</div>
                            @if (ctx.Failed.Count == 0)
                            {
                                <div class="text-muted small">@ctx.FailedEmptyText</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var item in ctx.Failed)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@item.Label">@item.Label</dt>
                                            <dd>@item.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                    </div>;
            }

            <div class="card shadow-sm eventhub-card eventhub-paths-card">
                <div class="@GetHeaderCssClass(PathsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Paths</span>
                        <span class="text-white-50 small">success vs failed</span>
                        @if (!string.IsNullOrWhiteSpace(PathsHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@PathsHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @groupsTemplate((SuccessfulPathsLabeled, FailedPathsLabeled, "No successful paths yet.", "No failed paths yet."))
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-paths-card eventhub-users-card">
                <div class="@GetHeaderCssClass(UsersHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Users</span>
                        <span class="text-white-50 small">success vs failed</span>
                        @if (!string.IsNullOrWhiteSpace(UsersHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@UsersHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @groupsTemplate((SuccessfulUsersLabeled, FailedUsersLabeled, "No successful users yet.", "No failed users yet."))
                </div>
            </div>

            @* ── Merged Paths/Users card: shown instead of the two cards above when the
               viewport height is 860px or less, so both stay reachable via tabs. ── *@
            <div class="card shadow-sm eventhub-card eventhub-paths-users-tabbed">
                <div class="@GetHeaderCssClass(_pathsUsersTab == "users" ? UsersHeaderTone : PathsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Paths &amp; Users</span>
                        <span class="text-white-50 small">success vs failed</span>
                        @{
                            var tabbedHeaderReason = _pathsUsersTab == "users" ? UsersHeaderReason : PathsHeaderReason;
                        }
                        @if (!string.IsNullOrWhiteSpace(tabbedHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@tabbedHeaderReason</span>
                        }
                    </div>
                    <div class="eventhub-paths-users-tabs" role="tablist" aria-label="Paths and users">
                        <button type="button"
                                class="eventhub-tab-button @(_pathsUsersTab == "paths" ? "active" : string.Empty)"
                                role="tab"
                                aria-selected="@(_pathsUsersTab == "paths" ? "true" : "false")"
                                @onclick='() => SelectPathsUsersTab("paths")'>
                            Paths
                        </button>
                        <button type="button"
                                class="eventhub-tab-button @(_pathsUsersTab == "users" ? "active" : string.Empty)"
                                role="tab"
                                aria-selected="@(_pathsUsersTab == "users" ? "true" : "false")"
                                @onclick='() => SelectPathsUsersTab("users")'>
                            Users
                        </button>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (_pathsUsersTab == "users")
                    {
                        @groupsTemplate((SuccessfulUsersLabeled, FailedUsersLabeled, "No successful users yet.", "No failed users yet."))
                    }
                    else
                    {
                        @groupsTemplate((SuccessfulPathsLabeled, FailedPathsLabeled, "No successful paths yet.", "No failed paths yet."))
                    }
                </div>
            </div>
        </div>

        @* ── Request column (request status) ── *@
        <div class="col-12 col-lg-4 eventhub-monitor-col order-1">
            <div class="eventhub-history-shell eventhub-request-stats-compact">
                <EventHubRequestStatus Items="@HistoryItems" HeaderTone="@RequestHeaderTone" OpenRequest="@_trendRequestToOpen" />
            </div>
        </div>

    </div>
</InspectorPageShell>

@if (!Preferences.IsOnboardingStep("complete"))
{
    <aside class="onboarding-steps" aria-label="Getting started steps">
        <h2>Getting started</h2>
        <ol>
            <li>Click on Send queries</li>
            <li>Confirm the server URL and authorization</li>
            <li>Click on the Model tab</li>
            <li>Pick the GPT-4o model</li>
            <li>Make sure that the path is correct</li>
            <li>Type in the prompt</li>
            <li>Expand API parameters</li>
            <li>Click on include_usage</li>
            <li>Click on Send</li>
            <li>Explore the raw exchange</li>
            <li>Open EventHub Monitor</li>
            <li class="@(Preferences.IsOnboardingStep("insights") ? "is-active" : string.Empty)">
                @if (Preferences.IsOnboardingStep("insights"))
                {
                    <span class="onboarding-step-pointer" aria-hidden="true">&#128073;</span>
                }
                Open Insights
            </li>
        </ol>
        <button class="btn btn-sm btn-outline-secondary mt-2" type="button" @onclick="CompleteOnboardingAsync">I'm done</button>
    </aside>
}

