    private static bool IsBackendCircuitBreakerClosed(BackendHealthSnapshot backend)
    {
        return string.Equals(backend.Css, "healthy", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetBackendCircuitBreakerCss(BackendHealthSnapshot backend)
    {
        return IsBackendCircuitBreakerClosed(backend) ? "closed" : "open";
    }

