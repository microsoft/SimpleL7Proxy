    private bool IsTrendMetricSelected(string key)
    {
        return _selectedTrendMetricKeys.Contains(key);
    }

    private string GetUserColor(string user) => UserColors.TryGetValue(user, out var color) ? color : "#64748b";

    private void OnTrendMetricSelected(ChangeEventArgs args)
    {
        var key = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(key))
        {
            _selectedTrendMetricKeys.Add(key);
        }

        _trendMetricSelectionKey = string.Empty;
        _isTrendMetricPickerExpanded = false;
        RefreshProjection();
    }

    private void OnTrendMetricSelectionChanged(string key, ChangeEventArgs args)
    {
        var isSelected = args.Value switch
        {
            bool value => value,
            string value when bool.TryParse(value, out var parsedValue) => parsedValue,
            _ => false,
        };

        if (isSelected)
        {
            _selectedTrendMetricKeys.Add(key);
        }
        else
        {
            _selectedTrendMetricKeys.Remove(key);
        }

        RefreshProjection();
    }

    private void OnUserShareMetricChanged(ChangeEventArgs args)
    {
        _selectedUserShareMetricKey = args.Value?.ToString() ?? "__calls";
        RefreshProjection();
    }

    private IReadOnlyList<MultiRequestStatusItem> GetCircuitTrendSlotRequests(TrendSlot slot) =>
        _trendSlotRequestRows.TryGetValue(slot, out var requests) ? requests : Array.Empty<MultiRequestStatusItem>();

    private void OpenTrendSlot(TrendSlot slot, IReadOnlyList<MultiRequestStatusItem> slotRequests)
    {
        if (slotRequests.Count == 0)
        {
            _openTrendSlot = null;
            _openTrendSlotRequests = Array.Empty<MultiRequestStatusItem>();
            return;
        }

        _openTrendSlot = slot;
        _openTrendSlotRequests = slotRequests;
        var slotIndex = UsageTrendSlots.ToList().FindIndex(candidate => candidate == slot);
        _openTrendSlotPanelLeft = GetTrendSlotPanelLeft(slotIndex);
    }

    private void CloseTrendSlot()
    {
        _openTrendSlot = null;
        _openTrendSlotRequests = Array.Empty<MultiRequestStatusItem>();
    }

    private static string GetTrendSlotLabel(TrendSlot slot)
    {
        var start = slot.StartUtc.ToLocalTime();
        var end = slot.EndExclusiveUtc.AddMinutes(-1).ToLocalTime();
        return start == end ? $"Requests at {start:HH:mm}" : $"Requests from {start:HH:mm} to {end:HH:mm}";
    }

    private string GetTrendSlotAxisLabel(int slotIndex)
    {
        var slots = UsageTrendSlots;
        if (slotIndex < 0 || slotIndex >= slots.Count)
        {
            return string.Empty;
        }

        var minutesAgo = (int)Math.Max(0, Math.Round((DateTimeOffset.UtcNow - slots[slotIndex].EndExclusiveUtc).TotalMinutes));
        return minutesAgo <= 0 ? "now" : $"{minutesAgo}m";
    }

    private string GetTrendSlotPanelLeft(int slotIndex)
    {
        var slots = UsageTrendSlots;
        var percent = slots.Count <= 1 ? 50d : ((slotIndex + 0.5d) / slots.Count) * 100d;
        percent = Math.Clamp(percent, 18d, 82d);
        return percent.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private void OpenTrendRequest(MultiRequestStatusItem request)
    {
        _trendRequestToOpen = null;
        _trendRequestToOpen = request;
        _openTrendSlot = null;
        _openTrendSlotRequests = Array.Empty<MultiRequestStatusItem>();
    }

    private static string FormatTrendRequestDuration(MultiRequestStatusItem request)
    {
        return request.Duration is { } duration
            ? $"{duration.TotalMilliseconds:0} ms"
            : request.Status;
    }

    private static string GetTrendRequestLabel(MultiRequestStatusItem request)
    {
        var sevenPId = request.Phases?.SevenPId;
        if (!string.IsNullOrWhiteSpace(sevenPId))
        {
            var separatorIndex = Math.Max(sevenPId.LastIndexOf('_'), sevenPId.LastIndexOf('-'));
            if (separatorIndex >= 0 && separatorIndex < sevenPId.Length - 1)
            {
                return sevenPId[(separatorIndex + 1)..];
            }
        }

        return request.RequestNumber.ToString(CultureInfo.InvariantCulture);
    }

    private void RefreshScopeState()
    {
        _scopeOptions = _publication?.Scopes.ToArray() ?? Array.Empty<ProxyMetricsCatalog.ScopeOption>();
        _scopeHistoryEntries = BuildScopeHistoryEntries(_scopeOptions);
    }

    private string ResolveEffectiveScopeId()
    {
        if (!string.IsNullOrWhiteSpace(SelectedScopeId) && _publication?.IsKnownScope(SelectedScopeId) == true)
        {
            return SelectedScopeId;
        }

        return "all";
    }

    private static IReadOnlyList<ChatHistoryEntry> BuildScopeHistoryEntries(IReadOnlyList<ProxyMetricsCatalog.ScopeOption> scopeOptions)
    {
        return scopeOptions.Select(option => new ChatHistoryEntry
        {
            Id = option.Id,
            Source = "EventHub monitor",
            CreatedAt = DateTimeOffset.UtcNow,
            Metrics = new ChatHistoryMetrics
            {
                Status = option.Label,
            },
        }).ToArray();
    }
