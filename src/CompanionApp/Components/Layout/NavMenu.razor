@namespace CompanionApp.Components.Layout
@rendermode InteractiveServer
@inject CompanionApp.Components.Shared.UserPreferencesService Preferences
@inject IJSRuntime JS
@implements IAsyncDisposable
@{
    var stateClass = collapsed ? "collapsed" : "expanded";
}

<div class="nav-menu @stateClass">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <button type="button" class="nav-toggler" title="@(collapsed ? "Expand navigation menu" : "Collapse navigation menu")"
                    aria-label="Toggle navigation menu" aria-expanded="@(collapsed ? "false" : "true")" aria-controls="primary-navigation"
                    disabled="@(!RendererInfo.IsInteractive)" @onclick="ToggleMenu"></button>
            <a class="navbar-brand" href="">CompanionApp</a>
        </div>
    </div>

    <div class="nav-scrollable" id="primary-navigation">
        <nav class="nav flex-column h-100" aria-label="Main navigation">
            <div class="nav-item nav-home px-3">
                <NavLink class="nav-link nav-section-link" href="" Match="NavLinkMatch.All" title="Home">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">Home</span>
                </NavLink>
            </div>

            <div class="nav-group" role="group" aria-label="Admin">
                <div class="nav-item nav-section-item px-3">
                    <NavLink class="nav-link nav-section-link" href="admin" title="Admin">
                        <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">Admin</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="admin/configuration" title="Proxy Configuration">
                        <span class="nav-text">Proxy Configuration</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="admin/deployment" title="Deployment Setup">
                        <span class="nav-text">Deployment Setup</span>
                    </NavLink>
                </div>
            </div>

            <div class="nav-group" role="group" aria-label="Test">
                <div class="nav-item nav-section-item px-3">
                    <NavLink class="nav-link nav-section-link" href="test" title="Test">
                        <span class="bi bi-speedometer2-nav-menu" aria-hidden="true"></span> <span class="nav-text">Test</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="url-tester" title="URL test">
                        <span class="nav-text">URL test</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="stress-test" title="Stress test">
                        <span class="nav-text">Stress test</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="abort-test" title="Abort test">
                        <span class="nav-text">Abort test</span>
                    </NavLink>
                </div>
            </div>

            <div class="nav-group" role="group" aria-label="Explore">
                <div class="nav-item nav-section-item px-3">
                    <NavLink class="nav-link nav-section-link" href="explore" title="Explore">
                        <span class="bi bi-search-nav-menu" aria-hidden="true"></span> <span class="nav-text">Explore</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="investigator" title="Investigator">
                        <span class="nav-text">Investigator</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="chat" title="Chat">
                        <span class="nav-text">Chat</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <span class="onboarding-target @(IsOnboardingStep("eventhub") ? "is-active" : string.Empty)">
                        @if (IsOnboardingStep("eventhub"))
                        {
                            <span class="onboarding-orb" aria-hidden="true"></span>
                        }
                        <NavLink class="nav-link" href="eventhub" title="EventHub Monitor" @onclick="OpenEventHubMonitorAsync">
                            <span class="nav-text">EventHub Monitor</span>
                        </NavLink>
                    </span>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <span class="onboarding-target @(IsOnboardingStep("insights") ? "is-active" : string.Empty)">
                        @if (IsOnboardingStep("insights"))
                        {
                            <span class="onboarding-orb" aria-hidden="true"></span>
                        }
                        <NavLink class="nav-link" href="insights" title="Insights" @onclick="OpenInsightsAsync">
                            <span class="nav-text">Insights</span>
                        </NavLink>
                    </span>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="history" title="History">
                        <span class="nav-text">History</span>
                    </NavLink>
                </div>
                <div class="nav-item nav-child-item px-3">
                    <NavLink class="nav-link" href="user-preferences" title="User Preferences">
                        <span class="nav-text">User Preferences</span>
                    </NavLink>
                </div>
            </div>
        </nav>
    </div>
</div>

@code {
    private bool collapsed = true;
    private string _onboardingStep = "home";
    private DotNetObjectReference<NavMenu>? _onboardingReference;

    private void ToggleMenu() => collapsed = !collapsed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Preferences.LoadAsync();
        _onboardingStep = Preferences.Preferences.Onboarding?.CurrentStep ?? "home";
        _onboardingReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("userPreferences.subscribeOnboarding", _onboardingReference);
        StateHasChanged();
    }

    [JSInvokable]
    public Task OnOnboardingStepChanged(string step)
    {
        _onboardingStep = step;
        return InvokeAsync(StateHasChanged);
    }

    private bool IsOnboardingStep(string step) => string.Equals(_onboardingStep, step, StringComparison.Ordinal);

    private Task OpenEventHubMonitorAsync() => Preferences.IsOnboardingStep("eventhub")
        ? Preferences.SetOnboardingStepAsync("insights")
        : Task.CompletedTask;

    private Task OpenInsightsAsync() => Preferences.IsOnboardingStep("insights")
        ? Preferences.SetOnboardingStepAsync("complete")
        : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (_onboardingReference is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("userPreferences.unsubscribeOnboarding");
        }
        catch (JSDisconnectedException)
        {
        }

        _onboardingReference?.Dispose();
    }
}

