{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CompanionAppUI": {
    "PopupHelp": {
      "Async": {
        "top": [
          "Configure asynchronous request processing, response storage, and notifications. Callers can retrieve results without keeping the original connection open.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/timeouts.md#async-requests"
        ]
      },
      "CircuitBreaker": {
        "top": [
          "Set the failure and recovery thresholds and observation window. These determine when unhealthy backends stop receiving traffic and when they can rejoin.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/circuit-breaker.md"
        ]
      },
      "HealthProbe": {
        "top": [
          "Enable or disable the health-probe sidecar and set its URL. The sidecar answers health checks using updates from the proxy.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/health-endpoints.md#2-sidecar-mode-high-performance"
        ],
        "url": [
          "Set the sidecar address used for health updates. Include the scheme, host, and port.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/health-endpoints.md#2-sidecar-mode-high-performance"
        ]
      },
      "Hosts": {
        "top": [
          "Add or edit backend hosts. Configure each host's address, routing mode, priorities, and authentication.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/backend-hosts.md"
        ],
        "Name": [
          "Set the host's configuration name. Routes and gateway references use this name to identify the backend.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/backend-hosts.md#named-routes"
        ],
        "Hostname": [
          "Set the backend hostname or address. Optionally add an IP override in brackets to bypass DNS resolution.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/backend-hosts.md#reference--connection-string-keys"
        ],
        "Authentication": [
          "Choose token or API-key authentication for this host. Only the selected authentication mode's fields are saved.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/backend-hosts.md#per-host-auth-behavior"
        ]
      },
      "LoadBalancing": {
        "top": [
          "Choose how eligible backends are selected. Set the iteration mode and attempt limit to control retries across backends.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/load-balancing.md"
        ]
      },
      "Logging": {
        "top": [
          "Capture evidence to explain request failures and routing decisions while limiting log volume and avoiding the collection of sensitive headers.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/configuration.md#logging"
        ],
        "Destinations": [
          "Pick the destinations where you want to send the diagnostic events.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/concepts/observability.md#telemetry-channels"
        ],
        "Event Hub": [
          "The Event Hub can be used to relay the metrics to secondary services.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/concepts/observability.md#built-in-backends"
        ],
        "Headers": [
          "Enable / Disable header capture. Optionally limit which headers are captured.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/configuration.md#request-telemetry"
        ],
        "Options": [
          "Limit the specific log types to capture here."
        ]
      },
      "Identity & Access": {
        "top": [
          "Authenticate callers and control user and application access.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/how-to/configure-security.md"
        ],
        "Authentication": [
          "Require an API key, a signed OAuth token, or either method. Configure the accepted credentials and request header.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/configuration.md#inbound-key-and-oauth-authentication"
        ],
        "Application Access": [
          "Validate caller application IDs against an approved source before requests enter the queue.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/how-to/configure-security.md#scenario-4-block-unknown-entra-app-ids"
        ],
        "User Profiles": [
          "Enable or disable user profiles and set their configuration source. Choose the fields and headers used to identify callers.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/user-profiles.md#configuration"
        ],
        "Suspended Users": [
          "Set the configuration source for suspended users. Listed callers are blocked before backend processing.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/user-profiles.md#user-suspension"
        ]
      },
      "Request": {
        "top": [
          "Configure request timeouts, TTL, header rules, and priorities. Enable or disable model detection here."
        ],
        "Timeouts": [
          "Set the default TTL and backend timeout. TTL covers queue wait and retries; the backend timeout limits each attempt.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/timeouts.md"
        ],
        "Headers": [
          "Set request control headers, required headers, and validation rules. Choose which headers are disallowed or removed before forwarding.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/configuration.md#request-header-policy"
        ],
        "Priorities": [
          "Map priority keys to values and set the default priority. Configure worker allocation and the per-user queue-share threshold."
        ],
        "Processing": [
          "Enable or disable detection of the model targeted by incoming requests."
        ]
      },
      "Response": {
        "top": [
          "Choose which backend status codes are not counted as errors. Set the headers to remove before returning responses to callers."
        ]
      },
      "Server": {
        "top": [
          "Configure workers, queue capacity, polling, shutdown, and extensions. Cold settings require a proxy restart to take effect."
        ],
        "Runtime and capacity": [
          "Set worker count, queue capacity, server port, and runtime intervals. Configure the time allowed for graceful shutdown."
        ],
        "Polling": [
          "Set how often backend health is checked and how long each check can wait for a response.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/reference/backend-hosts.md#health-polling"
        ],
        "Shared iterators": [
          "Set retention and cleanup intervals for shared backend-selection iterators."
        ],
        "Extensions": [
          "Register authentication providers, environment plugins, and request preprocessors."
        ],
        "Security": [
          "Control backend TLS certificate validation. Keep validation enabled in production; bypass it only for local or test scenarios.",
          "https://github.com/microsoft/SimpleL7Proxy/blob/main/docs/how-to/common-scenarios.md#scenario-8-local-development"
        ]
      }
    },
