@namespace chat_tester.Components.Shared

<div class="probe-summary-panel">
    <div class="probe-summary-url">
        <code>@Result.Url</code>
    </div>
    <div class="probe-summary-metrics">
        <div class="psm-row">
            <span>Status</span>
            <span class="@StatusClass">@Result.StatusCode @Result.Outcome</span>
        </div>
        @if (Result.TimeToFirstByte > TimeSpan.Zero)
        {
            <div class="psm-row">
                <span>TTFB</span>
                <span>@FormatMs(Result.TimeToFirstByte)</span>
            </div>
        }
        @if (Result.Duration > TimeSpan.Zero)
        {
            <div class="psm-row">
                <span>Duration</span>
                <span>@FormatMs(Result.Duration)</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Result.ContentType))
        {
            <div class="psm-row">
                <span>Content-Type</span>
                <span>@Result.ContentType</span>
            </div>
        }
        @if (Result.Bytes > 0)
        {
            <div class="psm-row">
                <span>Bytes</span>
                <span>@Result.Bytes</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Result.ResponseHeaders))
    {
        <div class="probe-summary-section">
            <div class="probe-summary-label">Response headers</div>
            <pre class="probe-summary-pre">@Result.ResponseHeaders</pre>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Result.ResponseBody))
    {
        <div class="probe-summary-section">
            <div class="probe-summary-label">Response body</div>
            <pre class="probe-summary-pre">@TruncateBody(Result.ResponseBody)</pre>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ProbeResult Result { get; set; } = default!;

    private string StatusClass =>
        Result.StatusCode >= 200 && Result.StatusCode < 300 ? "prs-ok" :
        Result.StatusCode >= 400 || Result.StatusCode == 0 ? "prs-err" :
        string.Empty;

    private static string FormatMs(TimeSpan ts) =>
        ts.TotalMilliseconds >= 1000
            ? $"{ts.TotalSeconds:F2} s"
            : $"{ts.TotalMilliseconds:F0} ms";

    private static string TruncateBody(string body, int max = 600) =>
        body.Length <= max ? body : body[..max] + "\n…(truncated)";
}
