@namespace chat_tester.Components.Shared

@if (Result.DenseCaptions.Count == 0)
{
    <div class="empty-result">No dense captions were returned.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle vision-result-table mb-0">
            <thead class="table-light">
                <tr><th>Caption</th><th class="text-end">Confidence</th><th>Bounding box</th></tr>
            </thead>
            <tbody>
                @foreach (var caption in Result.DenseCaptions)
                {
                    <tr>
                        <td>@caption.Text</td>
                        <td class="text-end confidence-cell">@VisionResultFormatter.Confidence(caption.Confidence)</td>
                        <td class="text-nowrap">@caption.Box.DisplayText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public VisionResultView Result { get; set; } = new();
}