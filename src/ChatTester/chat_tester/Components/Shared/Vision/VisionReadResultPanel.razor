@namespace chat_tester.Components.Shared

@if (Result.ReadLines.Count == 0)
{
    <div class="empty-result">No OCR text blocks were returned.</div>
}
else
{
    <ol class="read-lines mb-0">
        @foreach (var line in Result.ReadLines)
        {
            <li>@line</li>
        }
    </ol>
}

@code {
    [Parameter]
    public VisionResultView Result { get; set; } = new();
}