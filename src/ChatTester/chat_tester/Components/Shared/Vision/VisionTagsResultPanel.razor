@namespace chat_tester.Components.Shared

@if (Result.Tags.Count == 0)
{
    <div class="empty-result">No tags were returned.</div>
}
else
{
    <div class="tag-list">
        @foreach (var tag in Result.Tags)
        {
            <div class="tag-row">
                <span class="fw-semibold">@tag.Name</span>
                <div class="tag-confidence">
                    <div class="tag-confidence-fill" style="width: @VisionResultFormatter.ConfidencePercent(tag.Confidence);"></div>
                </div>
                <span class="confidence-cell">@VisionResultFormatter.Confidence(tag.Confidence)</span>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public VisionResultView Result { get; set; } = new();
}