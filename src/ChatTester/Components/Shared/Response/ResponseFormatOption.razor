@namespace chat_tester.Components.Shared

<div class="form-check form-check-inline mb-0">
    <input class="form-check-input" type="checkbox" id="@ResolvedId" checked="@IsSelected" @onchange="SelectFormatAsync" />
    <label class="form-check-label" for="@ResolvedId">@ResolvedLabel</label>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public ResponseDisplayFormat Format { get; set; }

    [Parameter]
    public ResponseDisplayFormat CurrentFormat { get; set; }

    [Parameter]
    public EventCallback<ResponseDisplayFormat> CurrentFormatChanged { get; set; }

    private bool IsSelected => CurrentFormat == Format;

    private string ResolvedId => string.IsNullOrWhiteSpace(Id) ? $"responseFormat{Format}" : Id;

    private string ResolvedLabel => string.IsNullOrWhiteSpace(Label) ? Format.ToString() : Label;

    private Task SelectFormatAsync(ChangeEventArgs args) => CurrentFormatChanged.InvokeAsync(Format);
}