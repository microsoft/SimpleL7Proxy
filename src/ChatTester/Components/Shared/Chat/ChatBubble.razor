@namespace chat_tester.Components.Shared

<div class="chat-bubble @BubbleClass" tabindex="@TabIndex">
    <div class="bubble-label @(ShowDetails ? "response-label" : string.Empty)">
        <span>@Role @if (!string.IsNullOrWhiteSpace(Status)) { <span class="bubble-status">@Status</span> }</span>
        @if (ShowDetails)
        {
            <span class="response-tools">
                <span class="response-detail-host metrics-host">
                    <button class="response-tool metrics-tool" type="button">Metrics</button>
                    <span class="turn-metrics-panel detail-popover small" role="tooltip">
                        <span class="metric-row"><span>Status</span><strong>@Metrics!.Status</strong></span>
                        <span class="metric-row"><span>Content-Type</span><strong title="@Metrics!.ContentType">@FormatContentType(Metrics!.ContentType)</strong></span>
                        <span class="metric-row"><span>TTFB</span><strong>@FormatDuration(Metrics!.TimeToFirstByte)</strong></span>
                        <span class="metric-row"><span>Duration</span><strong>@FormatDuration(Metrics!.Duration)</strong></span>
                        <span class="metric-row"><span>Chunks</span><strong>@Metrics!.Chunks</strong></span>
                        <span class="metric-row"><span>Bytes</span><strong>@Metrics!.TotalBytes</strong></span>
                    </span>
                </span>
                @if (ShowRawExchangeAction)
                {
                    <button class="response-tool raw-tool" type="button" @onclick="RaiseRawExchangeRequestedAsync">Raw exchange</button>
                }
            </span>
        }
    </div>
    <div class="bubble-text">@Message</div>
</div>

@code {
    [Parameter]
    public string Role { get; set; } = string.Empty;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public MultiStepChatMetrics? Metrics { get; set; }

    [Parameter]
    public string RequestHeadersText { get; set; } = "No request headers.";

    [Parameter]
    public string ResponseHeadersText { get; set; } = "No response headers.";

    [Parameter]
    public string RawResponseText { get; set; } = string.Empty;

    [Parameter]
    public bool ShowRawExchangeAction { get; set; } = true;

    [Parameter]
    public EventCallback RawExchangeRequested { get; set; }

    private bool IsAssistant => string.Equals(Role, "Assistant", StringComparison.OrdinalIgnoreCase);

    private bool ShowDetails => IsAssistant && Metrics is not null;

    private string BubbleClass => IsAssistant ? "assistant-bubble" : "user-bubble";

    private int? TabIndex => IsAssistant ? 0 : null;

    private Task RaiseRawExchangeRequestedAsync() => RawExchangeRequested.InvokeAsync();

    private static string FormatDuration(TimeSpan? value) =>
        value is null ? "-" : $"{value.Value.TotalMilliseconds:0} ms";

    private static string FormatContentType(string contentType)
    {
        if (string.IsNullOrWhiteSpace(contentType) || contentType == "-")
        {
            return "-";
        }

        if (contentType.Contains("event-stream", StringComparison.OrdinalIgnoreCase))
        {
            return "event-stream";
        }

        if (contentType.Contains("json", StringComparison.OrdinalIgnoreCase))
        {
            return "json";
        }

        if (contentType.Contains("html", StringComparison.OrdinalIgnoreCase))
        {
            return "html";
        }

        if (contentType.Contains("markdown", StringComparison.OrdinalIgnoreCase))
        {
            return "markdown";
        }

        if (contentType.Contains("text", StringComparison.OrdinalIgnoreCase))
        {
            return "text";
        }

        return contentType.Split(';', 2)[0];
    }
}