@namespace chat_tester.Components.Shared

@if (Result.People.Count == 0)
{
    <div class="empty-result">No people were returned.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle vision-result-table mb-0">
            <thead class="table-light">
                <tr><th>Person</th><th class="text-end">Confidence</th><th>Bounding box</th></tr>
            </thead>
            <tbody>
                @for (var index = 0; index < Result.People.Count; index++)
                {
                    var person = Result.People[index];
                    <tr>
                        <td>Person @(index + 1)</td>
                        <td class="text-end confidence-cell">@VisionResultFormatter.Confidence(person.Confidence)</td>
                        <td class="text-nowrap">@person.Box.DisplayText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public VisionResultView Result { get; set; } = new();
}