@namespace chat_tester.Components.Shared
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject UserPreferencesService Preferences

<div class="user-panel rounded border p-3 mb-3">
    <div class="mb-3">
        <label class="form-label">User header name</label>
        <InputText class="form-control" @bind-Value="Settings.HeaderName" @bind-Value:after="Preferences.SaveAsync" />
        <div class="form-text">Default comes from configuration (e.g. x-user-id).</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Priority header name</label>
        <InputText class="form-control" @bind-Value="Settings.PriorityHeaderName" @bind-Value:after="Preferences.SaveAsync" />
        <div class="form-text">Proxy priority key header (e.g. S7PPriorityKey). Sent per user when a priority is set.</div>
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Users</label>
        <div class="d-flex flex-wrap gap-3">
            <div class="form-check">
                <input class="form-check-input" type="radio" id="userselect-none"
                       checked="@(Settings.SelectionMode.Equals("None", StringComparison.OrdinalIgnoreCase))"
                       @onchange="@(() => SetSelectionModeAsync("None"))" />
                <label class="form-check-label" for="userselect-none">No user</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="userselect-selected"
                       checked="@(Settings.SelectionMode.Equals("Selected", StringComparison.OrdinalIgnoreCase))"
                       @onchange="@(() => SetSelectionModeAsync("Selected"))" />
                <label class="form-check-label" for="userselect-selected">Selected user</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="userselect-random"
                       checked="@(Settings.SelectionMode.Equals("Random", StringComparison.OrdinalIgnoreCase))"
                       @onchange="@(() => SetSelectionModeAsync("Random"))" />
                <label class="form-check-label" for="userselect-random">Random user</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" id="userselect-rotating"
                       checked="@(Settings.SelectionMode.Equals("Rotating", StringComparison.OrdinalIgnoreCase))"
                       @onchange="@(() => SetSelectionModeAsync("Rotating"))" />
                <label class="form-check-label" for="userselect-rotating">Rotating user</label>
            </div>
        </div>
    </div>

    @if (Settings.SelectionMode.Equals("Selected", StringComparison.OrdinalIgnoreCase))
    {
        <div class="mb-3">
            <label class="form-label">Selected user</label>
            <InputSelect class="form-select" @bind-Value="Settings.SelectedUser" @bind-Value:after="Preferences.SaveAsync">
                <option value="">(choose a user)</option>
                @foreach (var user in Settings.GetUsers())
                {
                    <option value="@user.Name">@(string.IsNullOrWhiteSpace(user.Priority) ? user.Name : $"{user.Name} (priority {user.Priority})")</option>
                }
            </InputSelect>
        </div>
    }

    <div class="border-top pt-2">
        <button class="btn btn-link p-0 text-decoration-none" type="button" @onclick="() => isEditingList = !isEditingList">
            <span class="me-1">Edit user list</span>
            <span aria-hidden="true">@(isEditingList ? "▾" : "▸")</span>
        </button>
        @if (isEditingList)
        {
            <div class="mt-2 mb-0">
                <label class="form-label">User names (one per line)</label>
                <InputTextArea class="form-control font-monospace" rows="5" @bind-Value="Settings.UserListText" @bind-Value:after="Preferences.SaveAsync" />
                <div class="form-text">Optional priority key after a comma, e.g. <code>alice, 12345</code>.</div>
            </div>
        }
    </div>
</div>

<style>
    .user-panel {
        background-color: #eafbf0;
        border-color: #bfe6cd !important;
    }
</style>

@code {
    [Parameter]
    public UserSettings Settings { get; set; } = new();

    private bool isEditingList;

    private async Task SetSelectionModeAsync(string mode)
    {
        Settings.SelectionMode = mode;
        await Preferences.SaveAsync();
    }

    /// <summary>Resolves the user name to send for the given request index.</summary>
    public string ResolveUserName(int requestIndex) => Settings.ResolveUserName(requestIndex);

    /// <summary>Applies the configured user header to the request when enabled.</summary>
    public void ApplyUser(HttpRequestMessage request, int requestIndex) => Settings.ApplyUser(request, requestIndex);
}
