@namespace chat_tester.Components.Shared
@using System.Linq

@if (Fields.Count > 0)
{
    <details class="mb-3">
        <summary class="fw-semibold mb-3" @onclick="ParametersOpened">
            <span class="onboarding-target @(HighlightParameters ? "is-active" : string.Empty)">
                @if (HighlightParameters)
                {
                    <span class="onboarding-orb" aria-hidden="true"></span>
                }
                @Label
            </span>
        </summary>
        <div class="row g-3 mt-3">
            @if (FieldsForDisplay.Any(field => IsBooleanValue(field.Value)))
            {
                <div class="col-12">
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var field in FieldsForDisplay.Where(field => IsBooleanValue(field.Value)))
                        {
                            <div class="form-check mb-0 onboarding-target @(HighlightIncludeUsage && string.Equals(field.Key, "include_usage", StringComparison.OrdinalIgnoreCase) ? "is-active" : string.Empty)">
                                @if (HighlightIncludeUsage && string.Equals(field.Key, "include_usage", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="onboarding-orb" aria-hidden="true"></span>
                                }
                                <input class="form-check-input" type="checkbox" id="@GetFieldId(field.Key)"
                                       checked="@IsBooleanSelected(field.Value)" @onchange="args => RaiseBooleanFieldChanged(field.Key, args.Value)" />
                                <label class="form-check-label" for="@GetFieldId(field.Key)">@field.Key</label>
                            </div>
                        }
                    </div>
                </div>
            }
            @foreach (var field in FieldsForDisplay.Where(field => !IsBooleanValue(field.Value)))
            {
                @if (IsFeaturesField(field.Key))
                {
                    <div class="col-12">
                        <div class="vision-features-row">
                            <span class="form-label mb-0">features</span>
                            <div class="vision-feature-checks">
                                @foreach (var feature in FeatureOptions)
                                {
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" id="@GetFeatureId(feature.Value)"
                                               checked="@IsFeatureSelected(feature.Value)" @onchange="args => RaiseFeatureChanged(feature.Value, args.Value is bool selected && selected)" />
                                        <label class="form-check-label" for="@GetFeatureId(feature.Value)">@feature.Label</label>
                                    </div>
                                }
                            </div>
                            <div class="vision-feature-extra">
                                <label class="form-label" for="@GetFieldId("featuresExtra")">Additional</label>
                                <input class="form-control" id="@GetFieldId("featuresExtra")" value="@AdditionalFeaturesText" @onchange="RaiseAdditionalFeaturesChanged" />
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <label class="form-label" for="@GetFieldId(field.Key)">@field.Key</label>
                        <input class="form-control" id="@GetFieldId(field.Key)" value="@field.Value" @oninput="args => RaiseFieldChanged(field.Key, args.Value?.ToString() ?? string.Empty)" />
                    </div>
                }
            }
        </div>
    </details>
}

@code {
    /// <summary>Section label shown in the parameters summary.</summary>
    [Parameter] public string Label { get; set; } = "Parameters";

    /// <summary>The specific model these parameters belong to (used to scope element ids).</summary>
    [Parameter] public string ModelId { get; set; } = string.Empty;

    /// <summary>The model/API-appropriate field values to display.</summary>
    [Parameter] public IReadOnlyDictionary<string, string> Fields { get; set; } = new Dictionary<string, string>();

    /// <summary>Raised when a scalar field value changes.</summary>
    [Parameter] public EventCallback<(string Name, string Value)> FieldChanged { get; set; }

    /// <summary>Whether the API parameters summary is the active onboarding target.</summary>
    [Parameter] public bool HighlightParameters { get; set; }

    /// <summary>Whether the include_usage checkbox is the active onboarding target.</summary>
    [Parameter] public bool HighlightIncludeUsage { get; set; }

    /// <summary>Raised when the API parameters summary is selected.</summary>
    [Parameter] public EventCallback ParametersOpened { get; set; }

    /// <summary>Raised when the include_usage checkbox is selected.</summary>
    [Parameter] public EventCallback IncludeUsageSelected { get; set; }
    private async Task RaiseBooleanFieldChanged(string name, object? value)
    {
        await RaiseFieldChanged(name, value is bool selected && selected ? "true" : "false");
        if (string.Equals(name, "include_usage", StringComparison.OrdinalIgnoreCase))
        {
            await IncludeUsageSelected.InvokeAsync();
        }
    }

    /// <summary>Raised when a known feature checkbox is toggled.</summary>
    [Parameter] public EventCallback<(string Feature, bool Selected)> FeatureChanged { get; set; }

    /// <summary>Raised when the free-text additional features input changes.</summary>
    [Parameter] public EventCallback<string> AdditionalFeaturesChanged { get; set; }

    private static readonly (string Value, string Label)[] FeatureOptions =
    {
        ("caption", "Caption"),
        ("denseCaptions", "Dense captions"),
        ("read", "Read"),
        ("tags", "Tags"),
        ("objects", "Objects"),
        ("people", "People")
    };

    private IEnumerable<KeyValuePair<string, string>> FieldsForDisplay => Fields
        .OrderByDescending(entry => IsBooleanValue(entry.Value))
        .ThenBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase);

    private static bool IsFeaturesField(string name) => string.Equals(name, "features", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<string> CurrentFeatures =>
        Fields.TryGetValue("features", out var value)
            ? value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            : Enumerable.Empty<string>();

    private bool IsFeatureSelected(string feature) => CurrentFeatures.Contains(feature, StringComparer.OrdinalIgnoreCase);

    private static bool IsKnownFeature(string feature) => FeatureOptions.Any(option => string.Equals(option.Value, feature, StringComparison.OrdinalIgnoreCase));

    private string AdditionalFeaturesText => string.Join(", ", CurrentFeatures.Where(feature => !IsKnownFeature(feature)));

    private string GetFeatureId(string feature) => GetFieldId("feature_" + feature);

    private string GetFieldId(string fieldName) =>
        "param_" + string.Concat((ModelId ?? string.Empty).Where(char.IsLetterOrDigit)) + "_" + string.Concat(fieldName.Where(char.IsLetterOrDigit));

    private static bool IsBooleanValue(string value) => bool.TryParse(value, out _);

    private static bool IsBooleanSelected(string value) => bool.TryParse(value, out var boolValue) && boolValue;

    private Task RaiseFieldChanged(string name, string value) => FieldChanged.InvokeAsync((name, value));

    private Task RaiseFeatureChanged(string feature, bool selected) => FeatureChanged.InvokeAsync((feature, selected));

    private Task RaiseAdditionalFeaturesChanged(ChangeEventArgs args) => AdditionalFeaturesChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
}
