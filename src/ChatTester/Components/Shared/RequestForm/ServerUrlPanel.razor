@namespace chat_tester.Components.Shared
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@inject UserPreferencesService Preferences

<div class="proxy-panel rounded border p-3 mb-3">
    <div class="mb-3">
        <label class="form-label" for="serverBaseUrl">Step 1: Server base URL</label>
        <div class="form-text mb-2">Enter the proxy or backend URL that will receive the request.</div>
        <div class="onboarding-target @(HighlightServerBaseUrl ? "is-active" : string.Empty)">
            @if (HighlightServerBaseUrl)
            {
                <span class="onboarding-orb" aria-hidden="true"></span>
            }
                 <input id="serverBaseUrl"
                     class="form-control"
                     value="@Settings.ServerBaseUrl"
                     @oninput="HandleServerUrlInputAsync"
                     @onblur="HandleServerUrlBlurAsync" />
        </div>
    </div>

    <AuthPanel @ref="AuthPanel" Settings="Settings" />
</div>

<style>
    .proxy-panel {
        background-color: #fff4e6;
        border-color: #f5d9b0 !important;
    }
</style>

@code {
    [Parameter]
    public AuthTokenSettings Settings { get; set; } = new();

    [Parameter]
    public string? InitialServerBaseUrl { get; set; }

    [Parameter]
    public bool HighlightServerBaseUrl { get; set; }

    [Parameter]
    public EventCallback ServerUrlChanged { get; set; }

    public string ServerBaseUrl => Settings.ServerBaseUrl;
    private AuthPanel? AuthPanel { get; set; }

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Settings.ServerBaseUrl) && !string.IsNullOrWhiteSpace(InitialServerBaseUrl))
        {
            Settings.ServerBaseUrl = InitialServerBaseUrl;
        }
    }

    /// <summary>Resolves the configured authorization header value (empty when authorization is disabled).</summary>
    public Task<string> ResolveHeaderValueAsync()
        => AuthPanel?.ResolveHeaderValueAsync() ?? Task.FromResult(string.Empty);

    public void LoadServerBaseUrl(string serverBaseUrl)
    {
        if (!string.IsNullOrWhiteSpace(serverBaseUrl))
        {
            Settings.ServerBaseUrl = serverBaseUrl;
        }
    }

    private async Task SaveServerUrlAsync()
    {
        await Preferences.SaveAsync();
        await ServerUrlChanged.InvokeAsync();
    }

    private async Task HandleServerUrlInputAsync(ChangeEventArgs args)
    {
        Settings.ServerBaseUrl = args.Value?.ToString() ?? string.Empty;
        await SaveServerUrlAsync();
    }

    private Task HandleServerUrlBlurAsync() => SaveServerUrlAsync();

    /// <summary>Applies the configured authorization header to the request when enabled.</summary>
    public Task ApplyAuthorizationAsync(HttpRequestMessage request)
        => AuthPanel?.ApplyAuthorizationAsync(request) ?? Task.CompletedTask;
}
