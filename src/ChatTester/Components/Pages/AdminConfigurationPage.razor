@code {
    private string Endpoint { get; set; } = string.Empty;
    private string Label { get; set; } = string.Empty;
    private List<string> AvailableLabels { get; set; } = new();
    private string StatusMessage { get; set; } = "Enter an App Configuration endpoint, then load its published proxy settings.";
    private bool IsLoading { get; set; }
    private bool HasLoadError { get; set; }
    private List<AppConfigurationScaffoldSetting> Settings { get; set; } = new();
    private List<AppConfigurationScaffoldSetting> _allSettings = new();
    private string? SelectedSection { get; set; }
    private bool _showConfigurationDetails;
    private bool _configurationHelpLoaded;
    private DateTime? _dataReadyAtUtc;
    private System.Timers.Timer? _uiTimer;
    private TimeSpan _elapsed;

    private IEnumerable<IGrouping<string, AppConfigurationScaffoldSetting>> VisibleGroups => Settings
        .Where(setting => !string.Equals(setting.Name, "Sentinel", StringComparison.OrdinalIgnoreCase))
        .GroupBy(setting => setting.Section, StringComparer.OrdinalIgnoreCase)
        .OrderBy(group => group.Key, StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<AppConfigurationScaffoldSetting> ChangedSettings => Settings
        .Where(setting => setting.IsChanged)
        .ToList();

    private int ChangedCount => Settings.Count(setting => setting.IsChanged);

    protected override void OnInitialized()
    {
        Endpoint = AppConfiguration.CachedEndpoint ?? AppConfiguration.DefaultEndpoint;
        Label = AppConfiguration.CachedLabel ?? AppConfiguration.DefaultLabel;
        AvailableLabels = AppConfiguration.CachedLabels?.ToList() ?? new List<string>();

        if (AppConfiguration.CachedSettings != null
            && string.Equals(AppConfiguration.CachedEndpoint, Endpoint, StringComparison.OrdinalIgnoreCase))
        {
            _allSettings = AppConfiguration.CachedSettings.ToList();
            ApplyLabelFilter();
            StatusMessage = Settings.Count == 0
                ? $"No settings for label '{LabelDisplay(Label)}' (cached)."
                : $"Loaded {Settings.Count} settings across {Settings.Select(setting => setting.Section).Distinct(StringComparer.OrdinalIgnoreCase).Count()} sections (cached).";
        }
    }

    private async Task LoadSettingsAsync()
    {
        IsLoading = true;
        HasLoadError = false;
        StatusMessage = "Loading settings with DefaultAzureCredential...";

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        StartTimer(stopwatch);
        try
        {
            _allSettings = (await AppConfiguration.LoadAsync(Endpoint.Trim())).ToList();
            AvailableLabels = AppConfiguration.CachedLabels?.ToList() ?? new List<string>();
            if (!AvailableLabels.Contains(Label, StringComparer.OrdinalIgnoreCase))
            {
                Label = AvailableLabels.Contains(AppConfiguration.DefaultLabel, StringComparer.OrdinalIgnoreCase)
                    ? AppConfiguration.DefaultLabel
                    : AvailableLabels.FirstOrDefault() ?? string.Empty;
            }
            ApplyLabelFilter();

            var totalMs = stopwatch.ElapsedMilliseconds;
            var source = AppConfiguration.LastLoadFromDisk ? "disk cache · " : string.Empty;
            var timing = $"{source}connect {AppConfiguration.LastConnectMs} ms · download {AppConfiguration.LastDownloadMs} ms · total {totalMs} ms";
            StatusMessage = Settings.Count == 0
                ? $"No Warm: or Cold: settings were found for label '{LabelDisplay(Label)}'. ({timing})"
                : $"Loaded {Settings.Count} settings across {Settings.Select(setting => setting.Section).Distinct(StringComparer.OrdinalIgnoreCase).Count()} sections — {timing}.";

            _dataReadyAtUtc = DateTime.UtcNow;
            StateHasChanged();
        }
        catch (AuthenticationFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"Authentication failed: {ex.Message}";
        }
        catch (RequestFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"App Configuration returned {ex.Status}: {ex.Message}";
        }
        catch (Exception ex)
        {
            HasLoadError = true;
            StatusMessage = ex.Message;
        }
        finally
        {
            stopwatch.Stop();
            _elapsed = stopwatch.Elapsed;
            IsLoading = false;
            StopTimer();
        }
    }

    private async Task UpdateSettingsAsync()
    {
        IsLoading = true;
        HasLoadError = false;
        StatusMessage = $"Updating {ChangedCount} setting(s) and Warm:Sentinel...";

        var stopwatch = System.Diagnostics.Stopwatch.StartNew();
        StartTimer(stopwatch);
        try
        {
            var result = await AppConfiguration.UpdateAsync(Endpoint.Trim(), Label, Settings);
            _allSettings = result.Settings.ToList();
            AvailableLabels = AppConfiguration.CachedLabels?.ToList() ?? new List<string>();
            ApplyLabelFilter();

            StatusMessage = $"Updated and verified {result.UpdatedCount} setting(s); Warm:Sentinel {result.PreviousSentinel} → {result.NewSentinel}; re-downloaded {_allSettings.Count} settings in {stopwatch.ElapsedMilliseconds} ms.";
            _dataReadyAtUtc = DateTime.UtcNow;
            StateHasChanged();
        }
        catch (AuthenticationFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"Authentication failed: {ex.Message}";
        }
        catch (RequestFailedException ex)
        {
            HasLoadError = true;
            StatusMessage = $"App Configuration returned {ex.Status}: {ex.Message}";
        }
        catch (Exception ex)
        {
            HasLoadError = true;
            StatusMessage = ex.Message;
        }
        finally
        {
            stopwatch.Stop();
            _elapsed = stopwatch.Elapsed;
            IsLoading = false;
            StopTimer();
        }
    }

    private void StartTimer(System.Diagnostics.Stopwatch stopwatch)
    {
        _elapsed = TimeSpan.Zero;
        _uiTimer?.Dispose();
        _uiTimer = new System.Timers.Timer(100) { AutoReset = true };
        _uiTimer.Elapsed += (_, _) =>
        {
            _elapsed = stopwatch.Elapsed;
            InvokeAsync(StateHasChanged);
        };
        _uiTimer.Start();
    }

    private void StopTimer()
    {
        _uiTimer?.Stop();
        _uiTimer?.Dispose();
        _uiTimer = null;
    }

    public void Dispose() => _uiTimer?.Dispose();

    private void SelectSection(string section) => SelectedSection = section;

    private void CloseSection() => SelectedSection = null;

    private void AddCreatedHost(AppConfigurationScaffoldSetting host)
    {
        _allSettings.Insert(0, host);
        Settings.Insert(0, host);
    }

    private IReadOnlyList<AppConfigurationScaffoldSetting> SelectedSettings =>
        SelectedSection is null
            ? Array.Empty<AppConfigurationScaffoldSetting>()
            : Settings.Where(setting => string.Equals(setting.Section, SelectedSection, StringComparison.OrdinalIgnoreCase)).ToList();

    private bool IsHostSection => string.Equals(SelectedSection, "Hosts", StringComparison.OrdinalIgnoreCase);

    private static bool IsHealthProbeSectionName(string section) =>
        string.Equals(section, "HealthProbe", StringComparison.OrdinalIgnoreCase);

    private bool IsHealthProbeSection => IsHealthProbeSectionName(SelectedSection ?? string.Empty);

    private static bool IsCircuitBreakerSectionName(string section) =>
        string.Equals(section, "CircuitBreaker", StringComparison.OrdinalIgnoreCase);

    private bool IsCircuitBreakerSection => IsCircuitBreakerSectionName(SelectedSection ?? string.Empty);

    private static bool IsLoadBalancingSectionName(string section) =>
        string.Equals(section, "LoadBalancing", StringComparison.OrdinalIgnoreCase);

    private bool IsLoadBalancingSection => IsLoadBalancingSectionName(SelectedSection ?? string.Empty);

    private AppConfigurationScaffoldSetting? HealthProbeSetting => SelectedSettings.FirstOrDefault();

    private static bool RequiresRestart(string mode) => string.Equals(mode, "Cold", StringComparison.OrdinalIgnoreCase);

    private IEnumerable<string> LabelOptions
    {
        get
        {
            var options = new List<string>();
            void Add(string value)
            {
                if (!options.Contains(value, StringComparer.OrdinalIgnoreCase))
                {
                    options.Add(value);
                }
            }

            Add(Label ?? string.Empty);
            foreach (var label in AvailableLabels)
            {
                Add(label);
            }
            if (!string.IsNullOrEmpty(AppConfiguration.DefaultLabel))
            {
                Add(AppConfiguration.DefaultLabel);
            }

            return options;
        }
    }

    private static string LabelDisplay(string label) => string.IsNullOrEmpty(label) ? "(No label)" : label;

    // Filters the single cached download by the selected label — no extra service call.
    private void ApplyLabelFilter()
    {
        AppConfiguration.CachedLabel = Label;
        SelectedSection = null;
        Settings = _allSettings
            .Where(setting => string.Equals(setting.Label, Label ?? string.Empty, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedHelp = await JS.InvokeAsync<string?>("sessionStorage.getItem", "chat-tester.configuration.help");
                _showConfigurationDetails = bool.TryParse(savedHelp, out var helpEnabled) && helpEnabled;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                Console.Error.WriteLine($"Unable to restore configuration Help preference: {ex.Message}");
            }
            _configurationHelpLoaded = true;
            StateHasChanged();
        }

        // Measures the gap between data being ready and the browser actually painting it.
        if (_dataReadyAtUtc is { } readyAt)
        {
            var renderLagMs = (long)(DateTime.UtcNow - readyAt).TotalMilliseconds;
            _dataReadyAtUtc = null;
            StatusMessage += $" · render +{renderLagMs} ms";
            StateHasChanged();
        }
    }

    private static bool IsBoolean(string value) => bool.TryParse(value, out _);

    private static bool IsMultiline(string value) => value.Length > 100 || value.Contains(',');

    private static string InputType(string value) => decimal.TryParse(value, out _) ? "number" : "text";

    private static string DisplayLoadedValue(string value) => string.IsNullOrEmpty(value) ? "(empty)" : value;

    private static void SetDraftValue(AppConfigurationScaffoldSetting setting, ChangeEventArgs args) =>
        setting.DraftValue = args.Value?.ToString() ?? string.Empty;

    private static void Reset(AppConfigurationScaffoldSetting setting) => setting.DraftValue = setting.LoadedValue;

    private void ResetAll()
    {
        foreach (var setting in Settings)
        {
            Reset(setting);
        }
    }
}