        CancelStatusClear();
        Label = label;
        ApplyLabelFilter();
        _editingLabel = true;
        _newLabelDraft = false;
        HasLoadError = false;
        StatusMessage = Settings.Count == 0 ? "No proxy settings are defined for this label." : string.Empty;
    }

    private async Task OpenLabelDialogAsync(string? source)
    {
        _duplicateSource = source;
        _draftLabelName = string.Empty;
        await _dialogModule!.InvokeVoidAsync("open", _labelDialog);
    }

    private async Task CancelLabelDialogAsync() => await _dialogModule!.InvokeVoidAsync("close", _labelDialog);

    private async Task CreateLabelDraftAsync()
    {
        if (string.IsNullOrWhiteSpace(_draftLabelName) || LabelNameError is not null)
        {
            return;
        }
        var source = _duplicateSource is null ? null : _allSettings.Where(setting => string.Equals(setting.Label, _duplicateSource, StringComparison.Ordinal)).ToList();
        Settings = AppConfiguration.CreateLabelDraft(_draftLabelName.Trim(), source).ToList();
        Label = _draftLabelName.Trim();
        _newLabelDraft = true;
        _editingLabel = true;
        SelectedSection = null;
        CancelStatusClear();
        _dataReadyAtUtc = null;
        HasLoadError = false;
        StatusMessage = string.Empty;
        await CancelLabelDialogAsync();
    }

    private async Task BackToLabelsAsync()
    {
        if (HasPendingChanges)
        {
            _pendingLeave = () => { ShowLabels(); return Task.CompletedTask; };
            await _dialogModule!.InvokeVoidAsync("open", _leaveDialog);
            return;
        }
        ShowLabels();
    }

    private void ShowLabels()
    {
        CancelStatusClear();
        _dataReadyAtUtc = null;
        _editingLabel = false;
        _configurationAction = null;
        _newLabelDraft = false;
        Settings.Clear();
        SelectedSection = null;
        StatusMessage = string.Empty;
        HasLoadError = false;
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (!HasPendingChanges && !IsLoading) return;
        context.PreventNavigation();
        await RequestLeaveAsync(context.TargetLocation);
    }

    /// <summary>Guards enhanced navigation links while local edits are pending.</summary>
    [JSInvokable]
    public async Task RequestLeaveAsync(string targetLocation)
    {
        if (IsLoading) return;
        _pendingLeave = async () =>
        {
            ShowLabels();
            await _dialogModule!.InvokeVoidAsync("detachNavigationGuard");
            Navigation.NavigateTo(targetLocation);
        };
        await _dialogModule!.InvokeVoidAsync("open", _leaveDialog);
    }

    private async Task CancelLeaveAsync()
    {
        if (IsLoading) return;
        _pendingLeave = null;
        await _dialogModule!.InvokeVoidAsync("close", _leaveDialog);
    }

    private async Task DiscardAndLeaveAsync()
    {
        var leave = _pendingLeave;
        await CancelLeaveAsync();
        if (leave is not null) await leave();
    }

    private async Task SaveAndLeaveAsync()
    {
        await UpdateSettingsAsync();
        if (!HasLoadError) await DiscardAndLeaveAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _dialogModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/AdminConfigurationPage.razor.js");
            if (_disposed)
            {
                await DisposeDialogModuleAsync();
                return;
            }
            _pageReference = DotNetObjectReference.Create(this);
            try
            {
                var savedHelp = await JS.InvokeAsync<string?>("sessionStorage.getItem", "chat-tester.configuration.help");
                _showConfigurationDetails = bool.TryParse(savedHelp, out var helpEnabled) && helpEnabled;
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                Console.Error.WriteLine($"Unable to restore configuration Help preference: {ex.Message}");
            }
            if (_disposed) return;
            _configurationHelpLoaded = true;
            if (_loadedEndpoint is null && !string.IsNullOrWhiteSpace(Endpoint))
            {
                await LoadSettingsAsync();
            }
            if (_disposed) return;
            StateHasChanged();
        }

        if (_dialogModule is not null)
        {
            await _dialogModule.InvokeVoidAsync("setNavigationGuard", _pageReference, HasPendingChanges, IsLoading);
        }

        if (_disposed) return;
        // Measures the gap between data being ready and the browser actually painting it.
        if (_dataReadyAtUtc is { } readyAt)
        {
            var renderLagMs = (long)(DateTime.UtcNow - readyAt).TotalMilliseconds;
            _dataReadyAtUtc = null;
            StatusMessage += $" · render +{renderLagMs} ms";
            StateHasChanged();
            _ = ClearStatusAfterDelayAsync();
        }
    }

    private static bool IsBoolean(string value) => bool.TryParse(value, out _);

    private static bool IsMultiline(string value) => value.Length > 100 || value.Contains(',');

    private static string InputType(string value) => decimal.TryParse(value, out _) ? "number" : "text";

    private static string DisplayLoadedValue(string value) => string.IsNullOrEmpty(value) ? "(empty)" : value;

    private static void SetDraftValue(AppConfigurationScaffoldSetting setting, ChangeEventArgs args) =>
        setting.DraftValue = args.Value?.ToString() ?? string.Empty;

    private static void Reset(AppConfigurationScaffoldSetting setting) => setting.DraftValue = setting.LoadedValue;

    private void ResetAll()
    {
        foreach (var setting in Settings)
        {
            Reset(setting);
        }
    }

    private Task ResetToDefaultsAsync()
    {
        CancelStatusClear();
        _dataReadyAtUtc = null;
        try
        {
            var changedCount = AppConfiguration.ApplyProxyDefaults(Settings);
            HasLoadError = false;
            StatusMessage = changedCount == 0
                ? "All non-host settings already match ProxyConfig defaults."
                : $"Staged {changedCount} non-host default setting(s). Changes have not been saved.";
        }
        catch (Exception ex)
        {
            HasLoadError = true;
            StatusMessage = ex.Message;
        }

        return Task.CompletedTask;
    }
}