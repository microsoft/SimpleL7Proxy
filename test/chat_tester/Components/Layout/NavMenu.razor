@rendermode InteractiveServer
@{
    var stateClass = collapsed ? "collapsed" : "expanded";
}

<div class="nav-menu @stateClass">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            <button type="button" class="nav-toggler" title="@(collapsed ? "Expand navigation menu" : "Collapse navigation menu")"
                    aria-label="Toggle navigation menu" aria-expanded="@(!collapsed)" @onclick="ToggleMenu"></button>
            <a class="navbar-brand" href="">chat-tester</a>
        </div>
    </div>

    <div class="nav-scrollable">
        <nav class="nav flex-column">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Home">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">Home</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link fw-bold" href="chat-test" title="Chat test">
                    <span class="bi bi-chat-dots-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">Chat test</span>
                </NavLink>
            </div>

            <div class="nav-item px-3 mt-3">
                <span class="nav-section-label text-uppercase small text-white-50 fw-semibold">fail-test</span>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="rapid-disconnect" title="Rapid disconnect">
                    <span class="bi bi-plug-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">Rapid disconnect</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="authorization-probe" title="Authorization probe">
                    <span class="bi bi-shield-lock-fill-nav-menu" aria-hidden="true"></span> <span class="nav-text">Authorization probe</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="burst-test" title="Burst test">
                    <span class="bi bi-speedometer2-nav-menu" aria-hidden="true"></span> <span class="nav-text">Burst test</span>
                </NavLink>
            </div>
        </nav>
    </div>
</div>

@code {
    private bool collapsed = true;

    private void ToggleMenu() => collapsed = !collapsed;
}

