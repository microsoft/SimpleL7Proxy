@namespace chat_tester.Components.Shared

<div class="panel-nav-bar" role="radiogroup" aria-label="Page panels">
    @foreach (var panel in Panels)
    {
        var inputId = $"{GroupName}-{panel.Id}";
        <input class="btn-check" type="radio" name="@GroupName" id="@inputId" checked="@IsSelected(panel.Id)" @onchange="() => SelectPanelAsync(panel.Id)" />
        <label class="panel-nav-button @StateClass(panel.State)" for="@inputId" title="@StateTitle(panel.State)">
            <span class="panel-nav-state" aria-hidden="true"></span>
            <span>@panel.Label</span>
        </label>
    }
</div>

<style>
    .panel-nav-bar {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        background: #fff;
    }

    .panel-nav-button {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: 0;
        border-radius: 0.25rem;
        background: transparent;
        color: #495057;
        padding: 0.35rem 0.65rem;
        font-size: 0.88rem;
        font-weight: 600;
        line-height: 1.2;
        cursor: pointer;
        user-select: none;
    }

    .panel-nav-button:hover,
    .panel-nav-button:focus {
        background: #e9ecef;
        color: #212529;
    }

    .btn-check:checked + .panel-nav-button {
        background: #0d6efd;
        color: #fff;
    }

    .panel-nav-state {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
        border: 1px solid currentColor;
        background: transparent;
    }

    .panel-nav-button.panel-visible .panel-nav-state {
        background: #198754;
        border-color: #198754;
    }

    .btn-check:checked + .panel-nav-button .panel-nav-state {
        background: #fff;
        border-color: #fff;
    }

    .panel-nav-button.panel-minimized {
        color: #6c757d;
    }
</style>

@code {
    private readonly string GroupName = $"panel-nav-{Guid.NewGuid():N}";

    [Parameter]
    public string ActivePanel { get; set; } = PanelDisplayStateCoordinator.RequestPanel;

    [Parameter]
    public PanelDisplayState RequestState { get; set; } = PanelDisplayState.Expanded;

    [Parameter]
    public PanelDisplayState ResultState { get; set; } = PanelDisplayState.Minimized;

    [Parameter]
    public PanelDisplayState RawState { get; set; } = PanelDisplayState.Minimized;

    [Parameter]
    public EventCallback<string> PanelSelected { get; set; }

    private IEnumerable<PanelNavItem> Panels
    {
        get
        {
            yield return new PanelNavItem(PanelDisplayStateCoordinator.RequestPanel, "Request", RequestState);
            yield return new PanelNavItem(PanelDisplayStateCoordinator.ResultPanel, "Result", ResultState);
            yield return new PanelNavItem(PanelDisplayStateCoordinator.RawPanel, "Raw", RawState);
        }
    }

    private string SelectedPanel => PanelDisplayStateCoordinator.Normalize(
        RequestState,
        ResultState,
        RawState,
        ActivePanel).ActivePanel;

    private bool IsSelected(string panel) => string.Equals(SelectedPanel, panel, StringComparison.Ordinal);

    private static string StateClass(PanelDisplayState state) => state == PanelDisplayState.Minimized ? "panel-minimized" : "panel-visible";

    private static string StateTitle(PanelDisplayState state) => state == PanelDisplayState.Minimized ? "Hidden" : "Visible";

    private Task SelectPanelAsync(string panel) => PanelSelected.InvokeAsync(panel);

    private readonly record struct PanelNavItem(string Id, string Label, PanelDisplayState State);
}