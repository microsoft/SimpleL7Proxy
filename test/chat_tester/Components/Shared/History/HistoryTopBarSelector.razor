@namespace chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components
@using System.Globalization
@using System.Linq

@{
    var entries = FilteredEntries;
}

<form class="history-top-selector" method="get" action="@CurrentPath">
    <label class="history-top-label" for="@SelectId">Filters</label>
    <select class="form-select form-select-sm history-top-select"
            id="@SelectId"
            name="historyEntryId"
            disabled="@(entries.Count == 0)"
            onchange="this.form.submit()">
        <option value="" selected="@string.IsNullOrWhiteSpace(SelectedEntryId)">@(entries.Count == 0 ? "No history yet" : "Current view")</option>
        @foreach (var entry in entries)
        {
            <option value="@entry.Id" selected="@IsSelected(entry.Id)">@FormatEntry(entry)</option>
        }
    </select>
</form>

<style>
    .history-top-selector {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.2rem;
    }

    .history-top-label {
        color: #495057;
        font-size: 0.85rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .history-top-select {
        width: min(30rem, 100%);
        min-width: 0;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .history-top-selector {
            width: 100%;
        }

        .history-top-select {
            width: 100%;
            min-width: 0;
        }
    }
</style>

@code {
    private readonly string SelectId = $"history-top-{Guid.NewGuid():N}";

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Parameter]
    public IReadOnlyList<ChatHistoryEntry> Entries { get; set; } = Array.Empty<ChatHistoryEntry>();

    [Parameter]
    public string? SelectedEntryId { get; set; }

    [Parameter]
    public string SourceFilter { get; set; } = string.Empty;

    private IReadOnlyList<ChatHistoryEntry> FilteredEntries => Entries
        .Where(MatchesSource)
        .OrderByDescending(entry => entry.CreatedAt)
        .Take(50)
        .ToArray();

    private string CurrentPath => Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath;

    private bool MatchesSource(ChatHistoryEntry entry) => string.IsNullOrWhiteSpace(SourceFilter)
        || string.Equals(entry.Source, SourceFilter, StringComparison.OrdinalIgnoreCase);

    private bool IsSelected(string entryId) => string.Equals(SelectedEntryId, entryId, StringComparison.Ordinal);

    private static string FormatEntry(ChatHistoryEntry entry)
    {
        if (string.Equals(entry.Source, "EventHub monitor", StringComparison.OrdinalIgnoreCase))
        {
            return FormatStatus(entry);
        }

        var status = FormatStatus(entry);
        return $"{entry.CreatedAt.LocalDateTime.ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture)} - {status}";
    }

    private static string FormatStatus(ChatHistoryEntry entry)
    {
        if (string.IsNullOrWhiteSpace(entry.Metrics.Status))
        {
            return "-";
        }

        var status = entry.Metrics.Status.Trim();
        var token = status.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return int.TryParse(token, NumberStyles.Integer, CultureInfo.InvariantCulture, out var statusCode)
            ? statusCode.ToString(CultureInfo.InvariantCulture)
            : status;
    }
}