@namespace chat_tester.Components.Shared
@using chat_tester.Components.Shared
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

@if (Items.Count > 0)
{
    <div class="multi-request-stats card shadow-sm">
        <div class="card-header bg-dark text-white">
            <span class="fw-semibold">Statistics</span>
        </div>
        <div class="card-body">
        <div class="multi-request-stats-thermometer">
            @foreach (var segment in OutcomeSegments)
            {
                <div class="multi-request-stats-segment @segment.Css" style="flex-grow: @segment.Count;" title="@segment.Label">
                    <span class="multi-request-stats-segment-label">@segment.Label</span>
                </div>
            }
        </div>
        <table class="multi-request-stats-table">
            <thead>
                <tr>
                    <th scope="col">Status</th>
                    <th scope="col">Total</th>
                    <th scope="col">TTFB</th>
                    <th scope="col">Avg</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in StatusGroups)
                {
                    <tr class="multi-request-stats-row @GetGroupClass(group.StatusCode) @(SelectedStatusFilter == group.StatusCode ? "active" : string.Empty)"
                        @onclick="() => FilterByStatus(group.StatusCode)">
                        <th scope="row" class="multi-request-stats-code">@group.StatusCode</th>
                        <td>@group.Count</td>
                        <td>@group.TtfbText</td>
                        <td>@group.AvgText</td>
                    </tr>
                }
                <tr class="multi-request-stats-row all @(SelectedStatusFilter is null ? "active" : string.Empty)"
                    @onclick="ClearStatusFilter">
                    <th scope="row" class="multi-request-stats-code">ALL</th>
                    <td>@Items.Count</td>
                    <td>@OverallTtfbText</td>
                    <td>@OverallAvgText</td>
                </tr>
            </tbody>
        </table>
        @if (StatisticsFooter is not null)
        {
            <div class="multi-request-stats-footer">
                @StatisticsFooter
            </div>
        }
        </div>
    </div>
}

<div class="multi-request-status card shadow-sm">
    <div class="card-header bg-dark text-white">
        <div class="d-flex flex-wrap align-items-baseline gap-2">
            <span class="fw-semibold">Request status</span>
            <span class="text-white-50 small ms-auto">@CompletedCount/@Items.Count complete</span>
        </div>
    </div>

    <div class="card-body">
    <div class="multi-request-status-list" role="list">
        @foreach (var item in FilteredItems)
        {
            <button class="multi-request-row" type="button" role="listitem"
                    @key="item"
                    @onclick="() => SelectItem(item)"
                    @onmouseenter="args => ShowMetrics(item, args)"
                    @onmousemove="MoveMetrics"
                    @onmouseleave="HideMetrics">
                <div class="multi-request-label">@item.RequestNumber</div>
                <div class="multi-request-thermometer @GetThermometerClass(item)">
                    <div class="multi-request-fill" style="width: @GetFillWidth(item);"></div>
                    <span class="multi-request-duration">@FormatDuration(item.Duration)</span>
                </div>
                <div class="multi-request-status-code @GetStatusClass(item)">@FormatStatus(item)</div>
            </button>
        }
    </div>
    </div>
</div>

@if (HoveredItem is not null)
{
    <div class="multi-request-hover-metrics" style="left: @HoverLeft; top: @HoverTop;">
        <ResponseMetricsPanel Status="@HoveredItem.Status"
                              ContentType="@HoveredItem.ContentType"
                              TimeToFirstByte="@HoveredItem.TimeToFirstByte"
                              Duration="@HoveredItem.Duration"
                              Chunks="@HoveredItem.Chunks"
                              TotalBytes="@HoveredItem.TotalBytes" />
    </div>
}

@if (SelectedItem is not null)
{
    <div class="multi-request-detail-backdrop" @onclick="CloseDetail"></div>
    <div class="multi-request-detail" role="dialog" aria-modal="true" aria-label="Request @SelectedItem.RequestNumber result" @onclick:stopPropagation="true">
        <div class="multi-request-detail-header">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Request @SelectedItem.RequestNumber</div>
                <div class="fw-semibold">@FormatStatus(SelectedItem) @FormatDuration(SelectedItem.Duration)</div>
            </div>
            <div class="btn-group btn-group-sm" role="group" aria-label="Result view">
                <button type="button" class="btn @GetDetailModeButtonClass(DetailMode.VisionResult)" @onclick="() => SetDetailMode(DetailMode.VisionResult)">Vision result</button>
                <button type="button" class="btn @GetDetailModeButtonClass(DetailMode.RawResult)" @onclick="() => SetDetailMode(DetailMode.RawResult)">Raw result</button>
            </div>
            <button class="btn-close" type="button" aria-label="Close request detail" @onclick="CloseDetail"></button>
        </div>
        <div class="multi-request-detail-body">
            @if (SelectedDetailMode == DetailMode.VisionResult)
            {
                @if (SelectedItem.VisionResult is not null)
                {
                    <VisionResultPanel Result="@SelectedItem.VisionResult"
                                       StatusMessage="@GetSelectedStatusMessage()"
                                       ActiveTab="@SelectedVisionTab"
                                       ActiveTabChanged="SetSelectedVisionTabAsync"
                                       DisplayState="@SelectedVisionDisplayState"
                                       DisplayStateChanged="SetSelectedVisionDisplayStateAsync"
                                       Status="@SelectedItem.Status"
                                       ContentType="@SelectedItem.ContentType"
                                       TimeToFirstByte="@SelectedItem.TimeToFirstByte"
                                       Duration="@SelectedItem.Duration"
                                       Chunks="@SelectedItem.Chunks"
                                       TotalBytes="@SelectedItem.TotalBytes" />
                }
                else
                {
                    <div class="empty-result">No parsed vision result is available for this request.</div>
                }
            }
            else
            {
                <RawResponsePanel Title="Raw exchange"
                                  StatusMessage="@GetSelectedStatusMessage()"
                                  ActiveTab="@SelectedRawTab"
                                  ActiveTabChanged="SetSelectedRawTabAsync"
                                  DisplayState="@SelectedRawDisplayState"
                                  DisplayStateChanged="SetSelectedRawDisplayStateAsync"
                                  RequestHeadersText="@SelectedItem.RequestHeadersText"
                                  ResponseHeadersText="@SelectedItem.ResponseHeadersText"
                                  RequestBodyDisplay="@SelectedItem.RequestBodyDisplay"
                                  ObservedResponse="@SelectedItem.ResponseBody"
                                  HasProxyError="@SelectedItem.IsFailed" />
            }
        </div>
    </div>
}

<style>
    .multi-request-status > .card-body {
        padding: 0.75rem;
    }

    .multi-request-status-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.5rem;
    }

    .multi-request-status-list {
        display: grid;
        gap: 0.45rem;
        align-content: start;
        max-height: min(58vh, 34rem);
        overflow-y: auto;
        padding-right: 0.25rem;
    }

    .multi-request-row {
        display: grid;
        grid-template-columns: 2.5rem minmax(8rem, 1fr) 5.5rem;
        align-items: center;
        gap: 0.65rem;
        width: 100%;
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        text-align: left;
    }

    .multi-request-row:hover .multi-request-thermometer,
    .multi-request-row:focus-visible .multi-request-thermometer {
        outline: 2px solid rgba(13, 110, 253, 0.45);
        outline-offset: 1px;
    }

    .multi-request-label {
        color: #6c757d;
        font-size: 0.72rem;
        font-weight: 700;
        text-align: right;
    }

    .multi-request-thermometer {
        position: relative;
        height: 1.35rem;
        overflow: hidden;
        border: 1px solid #adb5bd;
        background: #f8f9fa;
    }

    .multi-request-thermometer.success {
        border-color: #79ad69;
        background: #d8ecd3;
    }

    .multi-request-thermometer.failed {
        border-color: #d66a6a;
        background: #f4c7c7;
    }

    .multi-request-thermometer.running {
        border-color: #6ea8fe;
        background: #e7f1ff;
    }

    .multi-request-fill {
        position: absolute;
        inset: 0 auto 0 0;
        background: rgba(13, 110, 253, 0.18);
    }

    .multi-request-duration {
        position: relative;
        z-index: 1;
        display: block;
        padding: 0.05rem 0.5rem;
        color: #111;
        font-size: 0.8rem;
        font-variant-numeric: tabular-nums;
        font-weight: 700;
        text-align: right;
    }

    .multi-request-status-code {
        color: #495057;
        font-size: 0.8rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .multi-request-status-code.success {
        color: #146c43;
    }

    .multi-request-status-code.failed {
        color: #b02a37;
    }

    .multi-request-status-code.running {
        color: #0d6efd;
    }

    .multi-request-hover-metrics {
        position: fixed;
        z-index: 1100;
        width: 14rem;
        pointer-events: none;
        filter: drop-shadow(0 0.75rem 1rem rgba(0, 0, 0, 0.22));
    }

    .multi-request-stats {
        margin-top: 0;
        flex: 0 0 auto;
    }

    .multi-request-stats-title {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 0.75rem;
    }

    .multi-request-stats-overview {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 1.5rem 2.5rem;
    }

    .multi-request-stats-primary {
        flex: 1 1 28rem;
        min-width: 20rem;
    }

    .multi-request-stats-thermometer {
        display: flex;
        width: 100%;
        height: 2.5rem;
        overflow: hidden;
        border-radius: 0.35rem;
        border: 1px solid #adb5bd;
    }

    .multi-request-stats-segment {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        flex-basis: 0;
    }

    .multi-request-stats-segment.success {
        background: #2f9e44;
    }

    .multi-request-stats-segment.transient {
        background: #f59f00;
    }

    .multi-request-stats-segment.permanent {
        background: #e03131;
    }

    .multi-request-stats-segment.pending {
        background: #adb5bd;
    }

    .multi-request-stats-segment-label {
        padding: 0 0.5rem;
        color: #fff;
        font-weight: 700;
        font-size: 1.15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-shadow: 0 1px 1px rgba(0, 0, 0, 0.25);
    }

    .multi-request-stats-table {
        width: 100%;
        margin-top: 0.85rem;
        border-collapse: collapse;
        font-size: 0.85rem;
        color: #212529;
    }

    .multi-request-stats-table thead th {
        text-align: right;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #6c757d;
        font-weight: 600;
        padding: 0.25rem 0.6rem;
        border-bottom: 1px solid #dee2e6;
    }

    .multi-request-stats-table thead th:first-child {
        text-align: left;
    }

    .multi-request-stats-footer {
        margin-top: 0.85rem;
        padding-top: 0.75rem;
        border-top: 1px solid #dee2e6;
    }

    .multi-request-stats-row {
        cursor: pointer;
    }

    .multi-request-stats-row td,
    .multi-request-stats-row > .multi-request-stats-code {
        padding: 0.3rem 0.6rem;
        border-bottom: 1px solid #f1f3f5;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .multi-request-stats-row > .multi-request-stats-code {
        text-align: left;
        font-weight: 700;
        border-left: 4px solid transparent;
    }

    .multi-request-stats-row:hover {
        background: #f8f9fa;
    }

    .multi-request-stats-row.active {
        background: rgba(13, 110, 253, 0.1);
    }

    .multi-request-stats-row.success > .multi-request-stats-code {
        border-left-color: #2f9e44;
    }

    .multi-request-stats-row.transient > .multi-request-stats-code {
        border-left-color: #f59f00;
    }

    .multi-request-stats-row.permanent > .multi-request-stats-code {
        border-left-color: #e03131;
    }

    .multi-request-stats-row.all > .multi-request-stats-code {
        border-left-color: #495057;
    }

    .multi-request-stats-totals {
        flex: 0 0 auto;
        color: #212529;
        font-size: 0.95rem;
        line-height: 1.5;
        white-space: nowrap;
    }

    .multi-request-detail-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1110;
        background: rgba(15, 23, 42, 0.35);
    }

    .multi-request-detail {
        position: fixed;
        top: 4vh;
        left: 50%;
        z-index: 1111;
        width: min(96rem, calc(100vw - 3rem));
        height: 92vh;
        max-height: 92vh;
        display: flex;
        flex-direction: column;
        transform: translateX(-50%);
        border: 1px solid rgba(0, 0, 0, 0.16);
        border-radius: 0.5rem;
        background: #fff;
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.28);
    }

    .multi-request-detail-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.8rem 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .multi-request-detail-header .btn-group {
        margin-left: auto;
    }

    .multi-request-detail-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        padding: 1rem;
    }

    .multi-request-detail-body .vision-response-card,
    .multi-request-detail-body .raw-card {
        min-height: 100%;
        margin-top: 0 !important;
    }

    .multi-request-detail-body .vision-response-card .card-body,
    .multi-request-detail-body .raw-card .card-body {
        min-height: 0;
        overflow: auto;
        display: flex;
        flex-direction: column;
    }

    .multi-request-detail-body .raw-card .card-body > div {
        flex: 1 1 auto;
        min-height: 0;
        max-height: none !important;
    }
</style>

@code {
    private enum DetailMode
    {
        VisionResult,
        RawResult
    }

    [Parameter]
    public IReadOnlyList<MultiRequestStatusItem> Items { get; set; } = [];

    [Parameter]
    public RenderFragment? StatisticsFooter { get; set; }

    private MultiRequestStatusItem? HoveredItem { get; set; }

    private MultiRequestStatusItem? SelectedItem { get; set; }

    private DetailMode SelectedDetailMode { get; set; } = DetailMode.VisionResult;

    private string SelectedVisionTab { get; set; } = "summary";

    private PanelDisplayState SelectedVisionDisplayState { get; set; } = PanelDisplayState.Expanded;

    private string SelectedRawTab { get; set; } = "response-body";

    private PanelDisplayState SelectedRawDisplayState { get; set; } = PanelDisplayState.Expanded;

    private string HoverLeft { get; set; } = "0px";

    private string HoverTop { get; set; } = "0px";

    private int CompletedCount => _completedCount;

    private double MaxDurationMilliseconds => _maxDurationMilliseconds;

    private int CompleteCount => _completedCount;

    private int IncompleteCount => Items.Count - _completedCount;

    private string OverallTtfbText => _overallTtfbText;

    private string OverallAvgText => _overallAvgText;

    private sealed record StatusGroup(
        int StatusCode,
        int Count,
        string TtfbText,
        string AvgText);

    private IReadOnlyList<StatusGroup> StatusGroups => _statusGroups;

    private int? SelectedStatusFilter { get; set; }

    private IReadOnlyList<MultiRequestStatusItem> FilteredItems => _filteredItems;

    // Cached aggregates. These are recomputed only when the parent supplies new data
    // (via OnParametersSet) or the status filter changes, not on every internal render
    // (hover, tooltip movement, detail open). This keeps high-frequency stat updates
    // cheap and avoids the O(n^2) MaxDuration lookup that previously ran per rendered row.
    private double _maxDurationMilliseconds;
    private int _completedCount;
    private string _overallTtfbText = "-";
    private string _overallAvgText = "-";
    private IReadOnlyList<StatusGroup> _statusGroups = Array.Empty<StatusGroup>();
    private IReadOnlyList<OutcomeSegment> _outcomeSegments = Array.Empty<OutcomeSegment>();
    private IReadOnlyList<MultiRequestStatusItem> _filteredItems = Array.Empty<MultiRequestStatusItem>();

    private void RecomputeAggregates()
    {
        double maxDuration = 0;
        var completed = 0;
        double ttfbSum = 0;
        var ttfbCount = 0;
        double durationSum = 0;
        var durationCount = 0;

        var statusAcc = new Dictionary<int, StatusAccumulator>();
        var outcomeCounts = new Dictionary<Outcome, int>();

        foreach (var item in Items)
        {
            var durationMs = item.Duration?.TotalMilliseconds;
            if (durationMs is { } d)
            {
                if (d > maxDuration)
                {
                    maxDuration = d;
                }

                durationSum += d;
                durationCount++;
            }

            var ttfbMs = item.TimeToFirstByte?.TotalMilliseconds;
            if (ttfbMs is { } t)
            {
                ttfbSum += t;
                ttfbCount++;
            }

            if (item.IsComplete)
            {
                completed++;
            }

            var outcome = GetOutcome(item);
            outcomeCounts[outcome] = outcomeCounts.GetValueOrDefault(outcome) + 1;

            if (item.StatusCode is { } code)
            {
                var acc = statusAcc.GetValueOrDefault(code);
                acc.Count++;
                if (ttfbMs is { } t2)
                {
                    acc.TtfbSum += t2;
                    acc.TtfbCount++;
                }

                if (durationMs is { } d2)
                {
                    acc.DurationSum += d2;
                    acc.DurationCount++;
                }

                statusAcc[code] = acc;
            }
        }

        _maxDurationMilliseconds = maxDuration;
        _completedCount = completed;
        _overallTtfbText = FormatMilliseconds(ttfbCount == 0 ? null : ttfbSum / ttfbCount);
        _overallAvgText = FormatMilliseconds(durationCount == 0 ? null : durationSum / durationCount);

        _statusGroups = statusAcc
            .OrderBy(pair => pair.Key)
            .Select(pair => new StatusGroup(
                pair.Key,
                pair.Value.Count,
                FormatMilliseconds(pair.Value.TtfbCount == 0 ? null : pair.Value.TtfbSum / pair.Value.TtfbCount),
                FormatMilliseconds(pair.Value.DurationCount == 0 ? null : pair.Value.DurationSum / pair.Value.DurationCount)))
            .ToList();

        var segments = new List<OutcomeSegment>();
        AddSegment(segments, outcomeCounts, Outcome.Success, "success", "Success");
        AddSegment(segments, outcomeCounts, Outcome.Transient, "transient", "Transient");
        AddSegment(segments, outcomeCounts, Outcome.Permanent, "permanent", "Permanent");
        AddSegment(segments, outcomeCounts, Outcome.Pending, "pending", "Pending");
        _outcomeSegments = segments;

        RebuildFilteredItems();
    }

    private void RebuildFilteredItems()
    {
        _filteredItems = SelectedStatusFilter is { } code
            ? Items.Where(item => item.StatusCode == code).ToList()
            : Items;
    }

    private struct StatusAccumulator
    {
        public int Count;
        public double TtfbSum;
        public int TtfbCount;
        public double DurationSum;
        public int DurationCount;
    }

    private enum Outcome
    {
        Success,
        Transient,
        Permanent,
        Pending
    }

    private sealed record OutcomeSegment(string Css, int Count, string Label);

    private IReadOnlyList<OutcomeSegment> OutcomeSegments => _outcomeSegments;

    private static void AddSegment(List<OutcomeSegment> segments, IReadOnlyDictionary<Outcome, int> counts, Outcome outcome, string css, string label)
    {
        if (counts.TryGetValue(outcome, out var count) && count > 0)
        {
            segments.Add(new OutcomeSegment(css, count, $"{label}: {count}"));
        }
    }

    private static Outcome GetOutcome(MultiRequestStatusItem item)
    {
        if (item.StatusCode is { } code)
        {
            return GetOutcomeForCode(code);
        }

        return item.IsFailed ? Outcome.Permanent : Outcome.Pending;
    }

    private static Outcome GetOutcomeForCode(int code)
    {
        if (code is >= 200 and < 300)
        {
            return Outcome.Success;
        }

        return IsTransientStatusCode(code) ? Outcome.Transient : Outcome.Permanent;
    }

    private static bool IsTransientStatusCode(int code) =>
        code is 408 or 409 or 412 or 425 or 429 or 500 or 502 or 503 or 504;

    private static string GetGroupClass(int statusCode) => GetOutcomeForCode(statusCode) switch
    {
        Outcome.Success => "success",
        Outcome.Transient => "transient",
        _ => "permanent"
    };

    private void FilterByStatus(int statusCode)
    {
        SelectedStatusFilter = SelectedStatusFilter == statusCode ? null : statusCode;
        RebuildFilteredItems();
    }

    private void ClearStatusFilter()
    {
        SelectedStatusFilter = null;
        RebuildFilteredItems();
    }

    private static double? AverageMilliseconds(IEnumerable<TimeSpan?> values)
    {
        var samples = values
            .Where(value => value.HasValue)
            .Select(value => value!.Value.TotalMilliseconds)
            .ToList();

        return samples.Count == 0 ? null : samples.Average();
    }

    private static string FormatMilliseconds(double? value) =>
        value is null
            ? "-"
            : value.Value.ToString("0", CultureInfo.InvariantCulture) + "ms";

    protected override void OnParametersSet()
    {
        RecomputeAggregates();

        if (HoveredItem is not null && !Items.Contains(HoveredItem))
        {
            HoveredItem = null;
        }

        if (SelectedItem is not null && !Items.Contains(SelectedItem))
        {
            SelectedItem = null;
        }
    }

    private void SelectItem(MultiRequestStatusItem item)
    {
        SelectedItem = item;
        SelectedDetailMode = DetailMode.VisionResult;
        SelectedVisionTab = "summary";
        SelectedVisionDisplayState = PanelDisplayState.Expanded;
        SelectedRawTab = "response-body";
        SelectedRawDisplayState = PanelDisplayState.Expanded;
    }

    private void CloseDetail()
    {
        SelectedItem = null;
    }

    private void SetDetailMode(DetailMode mode)
    {
        SelectedDetailMode = mode;
    }

    private Task SetSelectedVisionTabAsync(string tab)
    {
        SelectedVisionTab = tab;
        return Task.CompletedTask;
    }

    private Task SetSelectedVisionDisplayStateAsync(PanelDisplayState state)
    {
        SelectedVisionDisplayState = state;
        return Task.CompletedTask;
    }

    private Task SetSelectedRawTabAsync(string tab)
    {
        SelectedRawTab = tab;
        return Task.CompletedTask;
    }

    private Task SetSelectedRawDisplayStateAsync(PanelDisplayState state)
    {
        SelectedRawDisplayState = state;
        return Task.CompletedTask;
    }

    private void ShowMetrics(MultiRequestStatusItem item, MouseEventArgs args)
    {
        HoveredItem = item;
        MoveMetrics(args);
    }

    private void MoveMetrics(MouseEventArgs args)
    {
        HoverLeft = (args.ClientX + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
        HoverTop = (args.ClientY + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
    }

    private void HideMetrics()
    {
        HoveredItem = null;
    }

    private string GetDetailModeButtonClass(DetailMode mode) =>
        SelectedDetailMode == mode ? "btn-primary" : "btn-outline-primary";

    private string GetSelectedStatusMessage()
    {
        if (SelectedItem is null)
        {
            return string.Empty;
        }

        return string.IsNullOrWhiteSpace(SelectedItem.StatusMessage)
            ? $"Request {SelectedItem.RequestNumber} {FormatStatus(SelectedItem)} {FormatDuration(SelectedItem.Duration)}".Trim()
            : SelectedItem.StatusMessage;
    }

    private string GetFillWidth(MultiRequestStatusItem item)
    {
        var durationMilliseconds = item.Duration?.TotalMilliseconds ?? 0;
        if (durationMilliseconds <= 0 || MaxDurationMilliseconds <= 0)
        {
            return item.IsRunning ? "8%" : "0%";
        }

        var width = Math.Clamp(durationMilliseconds / MaxDurationMilliseconds * 100, 3, 100);
        return width.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static string GetThermometerClass(MultiRequestStatusItem item)
    {
        if (item.IsFailed)
        {
            return "failed";
        }

        if (item.IsComplete)
        {
            return "success";
        }

        return item.IsRunning ? "running" : string.Empty;
    }

    private static string GetStatusClass(MultiRequestStatusItem item)
    {
        if (item.IsFailed)
        {
            return "failed";
        }

        if (item.IsComplete)
        {
            return "success";
        }

        return item.IsRunning ? "running" : string.Empty;
    }

    private static string FormatDuration(TimeSpan? duration) =>
        duration is null ? string.Empty : $"{duration.Value.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture)} ms";

    private static string FormatStatus(MultiRequestStatusItem item)
    {
        if (item.StatusCode.HasValue)
        {
            return item.StatusCode.Value.ToString(CultureInfo.InvariantCulture);
        }

        if (item.IsFailed)
        {
            return "Failed";
        }

        return item.IsRunning ? "..." : "-";
    }
}