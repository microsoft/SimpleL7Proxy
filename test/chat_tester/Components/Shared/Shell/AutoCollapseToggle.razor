@namespace chat_tester.Components.Shared

<div class="form-check form-switch mb-0">
    <input class="form-check-input" type="checkbox" role="switch" id="@Id" checked="@Value" @onchange="SetValueAsync" />
    <label class="form-check-label" for="@Id">@Label</label>
</div>

@code {
    [Parameter]
    public string Id { get; set; } = "autoCollapseSwitch";

    [Parameter]
    public string Label { get; set; } = "Auto collapse";

    [Parameter]
    public bool Value { get; set; } = true;

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    private async Task SetValueAsync(ChangeEventArgs args)
    {
        var value = args.Value switch
        {
            bool enabled => enabled,
            string text when bool.TryParse(text, out var enabled) => enabled,
            _ => !Value
        };

        await ValueChanged.InvokeAsync(value);
    }
}