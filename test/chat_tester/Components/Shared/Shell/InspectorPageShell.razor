@namespace chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Sections

<SectionContent SectionName="page-heading">
    <div class="inspector-page-heading">
        <div class="inspector-page-title">
            <h1 class="h4 mb-0">@Title</h1>
            <span class="text-muted small mb-0">@Tagline</span>
        </div>
    </div>
</SectionContent>

<div class="inspector-page-shell">
    <div class="inspector-page-controls">
        <div class="inspector-page-control-row">
            <HistoryTopBarSelector Entries="HistoryEntries"
                                   SelectedEntryId="@SelectedHistoryEntryId"
                                   SourceFilter="@HistorySource" />
            <div class="inspector-collapse-controls">
                <div class="inspector-panel-toggles" aria-label="Visible panels">
                    <label class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" checked="@ShowRequestPanel" @onchange="RequestPanelVisibleChanged" />
                        <span class="form-check-label">Request</span>
                    </label>
                    <label class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" checked="@ShowResultPanel" @onchange="ResultPanelVisibleChanged" />
                        <span class="form-check-label">@ResultLabel</span>
                    </label>
                    <label class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" checked="@ShowRawPanel" @onchange="RawPanelVisibleChanged" />
                        <span class="form-check-label">Raw</span>
                    </label>
                </div>
                <AutoCollapseToggle Value="@AutoCollapse" ValueChanged="AutoCollapseChanged" />
            </div>
        </div>
    </div>

    <div class="inspector-page-content">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Tagline { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ChatHistoryEntry> HistoryEntries { get; set; } = Array.Empty<ChatHistoryEntry>();

    [Parameter]
    public string? SelectedHistoryEntryId { get; set; }

    [Parameter]
    public string HistorySource { get; set; } = string.Empty;

    [Parameter]
    public bool AutoCollapse { get; set; }

    [Parameter]
    public EventCallback<bool> AutoCollapseChanged { get; set; }

    [Parameter]
    public bool ShowRequestPanel { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> RequestPanelVisibleChanged { get; set; }

    [Parameter]
    public bool ShowResultPanel { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> ResultPanelVisibleChanged { get; set; }

    [Parameter]
    public string ResultLabel { get; set; } = "Result";

    [Parameter]
    public bool ShowRawPanel { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> RawPanelVisibleChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
