@namespace chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components

<div class="eventhub-top-filters">
    <div class="eventhub-top-filter-field">
        <select id="@EnvironmentSelectId"
                class="form-select form-select-sm eventhub-top-filter-select"
                aria-label="Environment"
                value="@SelectedEnvironment"
                @onchange="HandleEnvironmentChanged">
            @foreach (var option in EnvironmentOptions)
            {
                <option value="@option">@option</option>
            }
        </select>
    </div>

    @if (ShowUserFilter)
    {
        <div class="eventhub-top-filter-field">
            <select id="@UserSelectId"
                    class="form-select form-select-sm eventhub-top-filter-select"
                    aria-label="User"
                    value="@SelectedUser"
                    @onchange="HandleUserChanged">
                @foreach (var option in UserOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
    }

    @if (ShowModelFilter)
    {
        <div class="eventhub-top-filter-field">
            <label class="eventhub-top-filter-label" for="@ModelSelectId">Model</label>
            <select id="@ModelSelectId"
                    class="form-select form-select-sm eventhub-top-filter-select"
                    value="@SelectedModel"
                    @onchange="HandleModelChanged">
                @foreach (var option in ModelOptions)
                {
                    <option value="@option">@option</option>
                }
            </select>
        </div>
    }
</div>

<style>
    .eventhub-top-filters {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem;
        width: 100%;
    }

    .eventhub-top-filter-field {
        display: flex;
        flex-direction: column;
        gap: 0.08rem;
        min-width: 0;
    }

    .eventhub-top-filter-label {
        color: #495057;
        font-size: 0.68rem;
        font-weight: 700;
        white-space: nowrap;
        line-height: 1.1;
    }

    .eventhub-top-filter-select {
        min-width: 0;
        width: 100%;
        font-weight: 600;
        font-size: 0.66rem;
        min-height: 1.62rem;
        padding-top: 0.08rem;
        padding-bottom: 0.08rem;
    }

    @@media (max-width: 900px) {
        .eventhub-top-filters {
            gap: 0.35rem;
        }

        .eventhub-top-filter-select {
            font-size: 0.64rem;
        }
    }

    @@media (max-width: 560px) {
        .eventhub-top-filters {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private readonly string EnvironmentSelectId = $"eventhub-env-{Guid.NewGuid():N}";
    private readonly string UserSelectId = $"eventhub-user-{Guid.NewGuid():N}";
    private readonly string ModelSelectId = $"eventhub-model-{Guid.NewGuid():N}";

    [Parameter]
    public IReadOnlyList<string> EnvironmentOptions { get; set; } = Array.Empty<string>();

    [Parameter]
    public string SelectedEnvironment { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedEnvironmentChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> UserOptions { get; set; } = Array.Empty<string>();

    [Parameter]
    public bool ShowUserFilter { get; set; } = true;

    [Parameter]
    public string SelectedUser { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedUserChanged { get; set; }

    [Parameter]
    public IReadOnlyList<string> ModelOptions { get; set; } = Array.Empty<string>();

    [Parameter]
    public bool ShowModelFilter { get; set; } = true;

    [Parameter]
    public string SelectedModel { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedModelChanged { get; set; }

    private Task HandleEnvironmentChanged(ChangeEventArgs args)
    {
        return SelectedEnvironmentChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleUserChanged(ChangeEventArgs args)
    {
        return SelectedUserChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task HandleModelChanged(ChangeEventArgs args)
    {
        return SelectedModelChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }
}
