@code {
    [Parameter]
    public IReadOnlyList<MultiRequestStatusItem> Items { get; set; } = [];

    private MultiRequestStatusItem? HoveredItem { get; set; }
    private MultiRequestStatusItem? SelectedItem { get; set; }
    private string SelectedPhaseTab { get; set; } = string.Empty;
    private string? BackendLogModalValue { get; set; }

    private string HoverLeft { get; set; } = "0px";
    private string HoverTop { get; set; } = "0px";

    private int CompletedCount => _completedCount;
    private double MaxDurationMilliseconds => _maxDurationMilliseconds;
    private string OverallTtfbText => _overallTtfbText;
    private string OverallAvgText => _overallAvgText;

    private string HoverSevenPId => HoveredItem?.Phases?.SevenPId is { Length: > 0 } id ? id : "(request)";
    private string SelectedSevenPId => SelectedItem?.Phases?.SevenPId is { Length: > 0 } id ? id : "(request)";

    private sealed record StatusGroup(int StatusCode, int Count, string TtfbText, string AvgText);
    private sealed record OutcomeSegment(string Css, int Count, string Label);
    private sealed record PhaseTab(string Id, string Label);

    private IReadOnlyList<StatusGroup> StatusGroups => _statusGroups;
    private IReadOnlyList<OutcomeSegment> OutcomeSegments => _outcomeSegments;
    private IReadOnlyList<MultiRequestStatusItem> FilteredItems => _filteredItems;
    private int? SelectedStatusFilter { get; set; }

    private double _maxDurationMilliseconds;
    private int _completedCount;
    private string _overallTtfbText = "-";
    private string _overallAvgText = "-";
    private IReadOnlyList<StatusGroup> _statusGroups = Array.Empty<StatusGroup>();
    private IReadOnlyList<OutcomeSegment> _outcomeSegments = Array.Empty<OutcomeSegment>();
    private IReadOnlyList<MultiRequestStatusItem> _filteredItems = Array.Empty<MultiRequestStatusItem>();

    protected override void OnParametersSet()
    {
        RecomputeAggregates();

        if (HoveredItem is not null && !Items.Contains(HoveredItem))
        {
            HoveredItem = null;
        }

        if (SelectedItem is not null && !Items.Contains(SelectedItem))
        {
            SelectedItem = null;
            BackendLogModalValue = null;
        }
    }

    private void RecomputeAggregates()
    {
        double maxDuration = 0;
        var completed = 0;
        double ttfbSum = 0;
        var ttfbCount = 0;
        double durationSum = 0;
        var durationCount = 0;

        var statusAcc = new Dictionary<int, StatusAccumulator>();
        var outcomeCounts = new Dictionary<Outcome, int>();

        foreach (var item in Items)
        {
            var durationMs = item.Duration?.TotalMilliseconds;
            if (durationMs is { } d)
            {
                if (d > maxDuration)
                {
                    maxDuration = d;
                }

                durationSum += d;
                durationCount++;
            }

            var ttfbMs = item.TimeToFirstByte?.TotalMilliseconds;
            if (ttfbMs is { } t)
            {
                ttfbSum += t;
                ttfbCount++;
            }

            if (item.IsComplete)
            {
                completed++;
            }

            var outcome = GetOutcome(item);
            outcomeCounts[outcome] = outcomeCounts.GetValueOrDefault(outcome) + 1;

            if (item.StatusCode is { } code)
            {
                var acc = statusAcc.GetValueOrDefault(code);
                acc.Count++;
                if (ttfbMs is { } t2)
                {
                    acc.TtfbSum += t2;
                    acc.TtfbCount++;
                }

                if (durationMs is { } d2)
                {
                    acc.DurationSum += d2;
                    acc.DurationCount++;
                }

                statusAcc[code] = acc;
            }
        }

        _maxDurationMilliseconds = maxDuration;
        _completedCount = completed;
        _overallTtfbText = FormatMilliseconds(ttfbCount == 0 ? null : ttfbSum / ttfbCount);
        _overallAvgText = FormatMilliseconds(durationCount == 0 ? null : durationSum / durationCount);

        _statusGroups = statusAcc
            .OrderBy(pair => pair.Key)
            .Select(pair => new StatusGroup(
                pair.Key,
                pair.Value.Count,
                FormatMilliseconds(pair.Value.TtfbCount == 0 ? null : pair.Value.TtfbSum / pair.Value.TtfbCount),
                FormatMilliseconds(pair.Value.DurationCount == 0 ? null : pair.Value.DurationSum / pair.Value.DurationCount)))
            .ToList();

        var segments = new List<OutcomeSegment>();
        AddSegment(segments, outcomeCounts, Outcome.Success, "success", "Success");
        AddSegment(segments, outcomeCounts, Outcome.Transient, "transient", "Transient");
        AddSegment(segments, outcomeCounts, Outcome.Permanent, "permanent", "Permanent");
        AddSegment(segments, outcomeCounts, Outcome.Pending, "pending", "Pending");
        _outcomeSegments = segments;

        RebuildFilteredItems();
    }

    private void RebuildFilteredItems()
    {
        _filteredItems = SelectedStatusFilter is { } code
            ? Items.Where(item => item.StatusCode == code).ToList()
            : Items;
    }

    private struct StatusAccumulator
    {
        public int Count;
        public double TtfbSum;
        public int TtfbCount;
        public double DurationSum;
        public int DurationCount;
    }

    private enum Outcome { Success, Transient, Permanent, Pending }

    private static void AddSegment(List<OutcomeSegment> segments, IReadOnlyDictionary<Outcome, int> counts, Outcome outcome, string css, string label)
    {
        if (counts.TryGetValue(outcome, out var count) && count > 0)
        {
            segments.Add(new OutcomeSegment(css, count, $"{label}: {count}"));
        }
    }

    private static Outcome GetOutcome(MultiRequestStatusItem item)
    {
        if (item.StatusCode is { } code)
        {
            return GetOutcomeForCode(code);
        }

        return item.IsFailed ? Outcome.Permanent : Outcome.Pending;
    }

    private static Outcome GetOutcomeForCode(int code)
    {
        if (code is >= 200 and < 300)
        {
            return Outcome.Success;
        }

        return IsTransientStatusCode(code) ? Outcome.Transient : Outcome.Permanent;
    }

    private static bool IsTransientStatusCode(int code) =>
        code is 408 or 409 or 412 or 425 or 429 or 500 or 502 or 503 or 504;

    private static string GetGroupClass(int statusCode) => GetOutcomeForCode(statusCode) switch
    {
        Outcome.Success => "success",
        Outcome.Transient => "transient",
        _ => "permanent"
    };

    private void FilterByStatus(int statusCode)
    {
        SelectedStatusFilter = SelectedStatusFilter == statusCode ? null : statusCode;
        RebuildFilteredItems();
    }

    private void ClearStatusFilter()
    {
        SelectedStatusFilter = null;
        RebuildFilteredItems();
    }

    private static string FormatMilliseconds(double? value) =>
        value is null ? "-" : value.Value.ToString("0", CultureInfo.InvariantCulture) + "ms";

    private void SelectItem(MultiRequestStatusItem item)
    {
        SelectedItem = item;
        BackendLogModalValue = null;
        SelectedPhaseTab = PhaseTabs.FirstOrDefault()?.Id ?? string.Empty;
    }

    private void CloseDetail()
    {
        SelectedItem = null;
        BackendLogModalValue = null;
    }

    private void OpenBackendLog(string value)
    {
        BackendLogModalValue = value;
    }

    private void CloseBackendLog()
    {
        BackendLogModalValue = null;
    }

    private void ShowMetrics(MultiRequestStatusItem item, MouseEventArgs args)
    {
        HoveredItem = item;
        MoveMetrics(args);
    }

    private void MoveMetrics(MouseEventArgs args)
    {
        HoverLeft = (args.ClientX + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
        HoverTop = (args.ClientY + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
    }

    private void HideMetrics()
    {
        HoveredItem = null;
    }

    private IReadOnlyList<PhaseTab> PhaseTabs
    {
        get
        {
            var tabs = new List<PhaseTab>();
            var phases = SelectedItem?.Phases;
            if (phases is null)
            {
                return tabs;
            }

            if (phases.Enqueue is { Count: > 0 })
            {
                tabs.Add(new PhaseTab("enqueue", "Enqueue"));
            }

            for (var index = 0; index < phases.Attempts.Count; index++)
            {
                tabs.Add(new PhaseTab($"attempt-{index}", $"Attempt {index + 1}"));
            }

            if (phases.Final is { Count: > 0 })
            {
                tabs.Add(new PhaseTab("final", "Final"));
            }

            return tabs;
        }
    }

    private IReadOnlyList<KeyValuePair<string, string>>? ActivePhaseFields
    {
        get
        {
            var phases = SelectedItem?.Phases;
            if (phases is null || string.IsNullOrEmpty(SelectedPhaseTab))
            {
                return null;
            }

            if (SelectedPhaseTab == "enqueue")
            {
                return phases.Enqueue;
            }

            if (SelectedPhaseTab == "final")
            {
                return phases.Final;
            }

            if (SelectedPhaseTab.StartsWith("attempt-", StringComparison.Ordinal)
                && int.TryParse(SelectedPhaseTab.AsSpan("attempt-".Length), out var index)
                && index >= 0 && index < phases.Attempts.Count)
            {
                return phases.Attempts[index];
            }

            return null;
        }
    }

    private static bool IsBackendLogField(string key) =>
        key.EndsWith("backendLog", StringComparison.OrdinalIgnoreCase);

    private static string BackendLogSummary(string backendLog)
    {
        var steps = ParseBackendLog(backendLog);
        return steps.Count == 0 ? "(empty)" : steps[^1];
    }

    private static IReadOnlyList<string> ParseBackendLog(string backendLog)
    {
        if (string.IsNullOrWhiteSpace(backendLog))
        {
            return Array.Empty<string>();
        }

        return backendLog
            .Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();
    }

    // Mirrors the backend-log severity colouring used by RawResponsePanel so the drill-down
    // renders in the same green/amber/red convention as the rest of the system.
    private static string ClassifyBackendLogPart(string part)
    {
        var beginSeverity = ClassifyBeginLog(part);
        if (!string.IsNullOrEmpty(beginSeverity))
        {
            return beginSeverity;
        }

        if (part.Contains("THROTTLED: (none)", StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (part.Contains("TIMEOUT", StringComparison.OrdinalIgnoreCase) ||
            part.Contains("INCOMPLETE", StringComparison.OrdinalIgnoreCase) ||
            part.Contains("exhausted", StringComparison.OrdinalIgnoreCase))
        {
            return "error";
        }

        if (part.Contains("THROTTLED", StringComparison.OrdinalIgnoreCase) ||
            part.Contains("RETRIES", StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return string.Empty;
    }

    private static string ClassifyBeginLog(string part)
    {
        if (!part.Contains("Begin", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var secondsSuffix = part.IndexOf('s');
        if (secondsSuffix <= 0 || !double.TryParse(part[..secondsSuffix].Trim(), out var seconds))
        {
            return string.Empty;
        }

        if (seconds < 0.1)
        {
            return "success";
        }

        if (seconds < 1)
        {
            return "warning";
        }

        return "error";
    }

    private IReadOnlyList<KeyValuePair<string, string>> HoverStats(MultiRequestStatusItem item)
    {
        var stats = new List<KeyValuePair<string, string>>();
        var phases = item.Phases;

        var path = FirstPhaseValue(phases, "Path");
        if (!string.IsNullOrWhiteSpace(path))
        {
            stats.Add(new("Path", path));
        }

        var user = FirstPhaseValue(phases, "UserID");
        if (!string.IsNullOrWhiteSpace(user))
        {
            stats.Add(new("User", user));
        }

        var model = FirstPhaseValue(phases, "model")
            ?? FirstPhaseValue(phases, "Model")
            ?? FirstPhaseValue(phases, "ModelName")
            ?? FirstPhaseValue(phases, "ModelDisplayName")
            ?? FirstPhaseValue(phases, "ModelId")
            ?? FirstPhaseValue(phases, "ModelKey")
            ?? FirstPhaseValue(phases, "x-model")
            ?? FirstPhaseValue(phases, "x-model-name")
            ?? FirstPhaseValue(phases, "x-model-id")
            ?? FirstPhaseValue(phases, "Deployment")
            ?? FirstPhaseValue(phases, "DeploymentName")
            ?? FirstPhaseValue(phases, "ModelDeployment")
            ?? FirstPhaseValue(phases, "AOAIModel");
        if (!string.IsNullOrWhiteSpace(model))
        {
            stats.Add(new("Model", model));
        }

        var backendLabel = FirstPhaseValue(phases, "x-backend-label");
        if (!string.IsNullOrWhiteSpace(backendLabel))
        {
            stats.Add(new("Backend label", backendLabel));
        }

        if (item.StatusCode is { } code)
        {
            stats.Add(new("Status", code.ToString(CultureInfo.InvariantCulture)));
        }

        stats.Add(new("Duration", FormatDuration(item.Duration)));

        if (item.TimeToFirstByte is { } queue)
        {
            stats.Add(new("Queue", $"{queue.TotalMilliseconds:0} ms"));
        }

        stats.Add(new("Attempts", (phases?.Attempts.Count ?? 0).ToString(CultureInfo.InvariantCulture)));

        var priority = FirstPhaseValue(phases, "Priority");
        if (!string.IsNullOrWhiteSpace(priority))
        {
            stats.Add(new("Priority", priority));
        }

        return stats;
    }

    private static string? FirstPhaseValue(RequestPhaseView? phases, string key)
    {
        if (phases is null)
        {
            return null;
        }

        return Lookup(phases.Final, key)
            ?? Lookup(phases.Enqueue, key)
            ?? phases.Attempts.Select(attempt => Lookup(attempt, key)).FirstOrDefault(value => value is not null);
    }

    private static string? Lookup(IReadOnlyList<KeyValuePair<string, string>>? fields, string key)
    {
        if (fields is null)
        {
            return null;
        }

        foreach (var pair in fields)
        {
            if (string.Equals(pair.Key, key, StringComparison.OrdinalIgnoreCase))
            {
                return pair.Value;
            }
        }

        return null;
    }

    private string GetFillWidth(MultiRequestStatusItem item)
    {
        var durationMilliseconds = item.Duration?.TotalMilliseconds ?? 0;
        if (durationMilliseconds <= 0 || MaxDurationMilliseconds <= 0)
        {
            return item.IsRunning ? "8%" : "0%";
        }

        var width = Math.Clamp(durationMilliseconds / MaxDurationMilliseconds * 100, 3, 100);
        return width.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static string GetThermometerClass(MultiRequestStatusItem item) => GetStatusClass(item);

    private static string GetStatusClass(MultiRequestStatusItem item)
    {
        if (item.IsFailed)
        {
            return "failed";
        }

        if (item.IsComplete)
        {
            return "success";
        }

        return item.IsRunning ? "running" : string.Empty;
    }

    private static string FormatDuration(TimeSpan? duration) =>
        duration is null ? string.Empty : $"{duration.Value.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture)} ms";

    private static string FormatStatus(MultiRequestStatusItem item)
    {
        if (item.StatusCode.HasValue)
        {
            return item.StatusCode.Value.ToString(CultureInfo.InvariantCulture);
        }

        if (item.IsFailed)
        {
            return "Failed";
        }

        return item.IsRunning ? "..." : "-";
    }
}
