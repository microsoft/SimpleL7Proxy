@namespace chat_tester.Components.Shared
@using chat_tester.Components.Shared
@using chat_tester.Components.Shared.EventHub
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

@* EventHub-specific request status panel. Not shared with other pages: the popup is a tabbed
   per-phase (enqueue / attempt / final) view keyed by S7P-ID, with a backendLog drill-down modal. *@

@if (Items.Count > 0)
{
    <div class="multi-request-stats card shadow-sm">
        <div class="card-header bg-dark text-white">
            <span class="fw-semibold">Statistics</span>
        </div>
        <div class="card-body">
            <div class="multi-request-stats-thermometer">
                @foreach (var segment in OutcomeSegments)
                {
                    <div class="multi-request-stats-segment @segment.Css" style="flex-grow: @segment.Count;" title="@segment.Label">
                        <span class="multi-request-stats-segment-label">@segment.Label</span>
                    </div>
                }
            </div>
            <table class="multi-request-stats-table">
                <thead>
                    <tr>
                        <th scope="col">Status</th>
                        <th scope="col">Total</th>
                        <th scope="col">TTFB</th>
                        <th scope="col">Avg</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in StatusGroups)
                    {
                        <tr class="multi-request-stats-row @GetGroupClass(group.StatusCode) @(SelectedStatusFilter == group.StatusCode ? "active" : string.Empty)"
                            @onclick="() => FilterByStatus(group.StatusCode)">
                            <th scope="row" class="multi-request-stats-code">@group.StatusCode</th>
                            <td>@group.Count</td>
                            <td>@group.TtfbText</td>
                            <td>@group.AvgText</td>
                        </tr>
                    }
                    <tr class="multi-request-stats-row all @(SelectedStatusFilter is null ? "active" : string.Empty)"
                        @onclick="ClearStatusFilter">
                        <th scope="row" class="multi-request-stats-code">ALL</th>
                        <td>@Items.Count</td>
                        <td>@OverallTtfbText</td>
                        <td>@OverallAvgText</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}

<div class="multi-request-status card shadow-sm">
    <div class="card-header bg-dark text-white">
        <div class="d-flex flex-wrap align-items-baseline gap-2">
            <span class="fw-semibold">Request status</span>
            <span class="text-white-50 small ms-auto">@CompletedCount/@Items.Count complete</span>
        </div>
    </div>

    <div class="card-body">
    <div class="multi-request-status-list" role="list">
        @foreach (var item in FilteredItems)
        {
            <button class="multi-request-row" type="button" role="listitem"
                    @key="item"
                    @onclick="() => SelectItem(item)"
                    @onmouseenter="args => ShowMetrics(item, args)"
                    @onmousemove="MoveMetrics"
                    @onmouseleave="HideMetrics">
                <div class="multi-request-label">@item.RequestNumber</div>
                <div class="multi-request-thermometer @GetThermometerClass(item)">
                    <div class="multi-request-fill" style="width: @GetFillWidth(item);"></div>
                    <span class="multi-request-duration">@FormatDuration(item.Duration)</span>
                </div>
                <div class="multi-request-status-code @GetStatusClass(item)">@FormatStatus(item)</div>
            </button>
        }
    </div>
    </div>
</div>

@* ── Hover: S7P-ID + high-level stats ── *@
@if (HoveredItem is not null)
{
    <div class="eh-req-hover" style="left: @HoverLeft; top: @HoverTop;">
        <div class="eh-req-hover-head">
            <span class="eh-req-hover-id">@HoverSevenPId</span>
            <span class="eh-req-hover-status @GetStatusClass(HoveredItem)">@FormatStatus(HoveredItem)</span>
        </div>
        <dl class="eh-req-hover-metrics">
            @foreach (var metric in HoverStats(HoveredItem))
            {
                <div class="eh-req-hover-metric">
                    <dt>@metric.Key</dt>
                    <dd>@metric.Value</dd>
                </div>
            }
        </dl>
    </div>
}

@* ── Click: tabbed per-phase detail modal ── *@
@if (SelectedItem is not null)
{
    <div class="eh-req-backdrop" @onclick="CloseDetail"></div>
    <div class="eh-req-modal" role="dialog" aria-modal="true" aria-label="Request @SelectedSevenPId detail" @onclick:stopPropagation="true">
        <div class="eh-req-modal-header">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Request</div>
                <div class="fw-semibold">@SelectedSevenPId</div>
            </div>
            <div class="eh-req-modal-status @GetStatusClass(SelectedItem)">@FormatStatus(SelectedItem) · @FormatDuration(SelectedItem.Duration)</div>
            <button class="btn-close" type="button" aria-label="Close request detail" @onclick="CloseDetail"></button>
        </div>
        <div class="eh-req-tabs">
            @foreach (var tab in PhaseTabs)
            {
                <button type="button"
                        class="eh-req-tab @(SelectedPhaseTab == tab.Id ? "active" : string.Empty)"
                        @onclick="() => SelectedPhaseTab = tab.Id">@tab.Label</button>
            }
        </div>
        <div class="eh-req-modal-body">
            @{
                var activeFields = ActivePhaseFields;
            }
            @if (activeFields is null || activeFields.Count == 0)
            {
                <div class="text-muted small">No fields captured for this phase.</div>
            }
            else
            {
                <dl class="eh-req-fields">
                    @foreach (var field in activeFields)
                    {
                        <div class="eh-req-field">
                            <dt title="@field.Key">@field.Key</dt>
                            <dd>
                                @if (IsBackendLogField(field.Key))
                                {
                                    <button type="button" class="eh-req-backendlog-link"
                                            title="@BackendLogSummary(field.Value)"
                                            @onclick="() => OpenBackendLog(field.Value)">
                                        @BackendLogSummary(field.Value)
                                        <span class="eh-req-backendlog-more">details ▸</span>
                                    </button>
                                }
                                else
                                {
                                    @field.Value
                                }
                            </dd>
                        </div>
                    }
                </dl>
            }
        </div>
    </div>
}

@* ── backendLog drill-down modal ── *@
@if (BackendLogModalValue is not null)
{
    <div class="eh-req-backdrop eh-req-backdrop-top" @onclick="CloseBackendLog"></div>
    <div class="eh-req-log-modal" role="dialog" aria-modal="true" aria-label="Backend log detail" @onclick:stopPropagation="true">
        <div class="eh-req-modal-header">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Backend log</div>
                <div class="fw-semibold">@SelectedSevenPId</div>
            </div>
            <button class="btn-close" type="button" aria-label="Close backend log" @onclick="CloseBackendLog"></button>
        </div>
        <div class="eh-req-modal-body">
            <div class="eh-req-log-view">
                <div class="eh-req-log-title">Backend log header</div>
                @foreach (var step in ParseBackendLog(BackendLogModalValue))
                {
                    <div class="eh-req-log-item @ClassifyBackendLogPart(step)">@step</div>
                }
            </div>
        </div>
    </div>
}

