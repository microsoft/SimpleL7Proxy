@namespace chat_tester.Components.Shared
@using System.Globalization
@inherits ModelComponentBase

@if (SimpleMode)
{
    <div class="mb-3">
        <label class="form-label">messageContent (input)</label>
        <textarea class="form-control" rows="4" value="@Message" @oninput="OnMessageInput"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">instructions</label>
        <input type="text" class="form-control" placeholder="optional system instructions"
               value="@Instructions" @onchange="OnInstructionsChanged" />
    </div>
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-4">
            <label class="form-label">temperature</label>
            <input type="number" step="0.1" min="0" max="2" class="form-control" placeholder="default"
                   value="@Temperature?.ToString(CultureInfo.InvariantCulture)" @onchange="OnTemperatureChanged" />
        </div>
        <div class="col-6 col-lg-4">
            <label class="form-label">top_p</label>
            <input type="number" step="0.05" min="0" max="1" class="form-control" placeholder="default"
                   value="@TopP?.ToString(CultureInfo.InvariantCulture)" @onchange="OnTopPChanged" />
        </div>
        <div class="col-6 col-lg-4">
            <label class="form-label">max_output_tokens</label>
            <input type="number" min="1" class="form-control" placeholder="default"
                   value="@MaxOutputTokens?.ToString(CultureInfo.InvariantCulture)" @onchange="OnMaxOutputTokensChanged" />
        </div>
    </div>
    <div class="row g-3 mb-0">
        <div class="col-12 col-lg-6">
            <label class="form-label">ContentType</label>
            <select class="form-select" value="@ContentType" @onchange="OnContentTypeSelected">
                @foreach (var contentType in ContentTypeOptions)
                {
                    <option value="@contentType">@contentType</option>
                }
            </select>
        </div>
    </div>
}
else
{
    <AdvancedModelPane Rows="Rows"
                       EndpointPath="EndpointPath" EndpointPathChanged="OnEndpointPathChanged"
                       ContentType="ContentType" ContentTypeChanged="OnContentTypeChangedAsync"
                       RequestBody="RequestBody" RequestBodyChanged="OnRequestBodyChanged" />
}

@code {
    // OpenAI Responses API request shape.
    private string? Instructions;
    private double? Temperature;
    private double? TopP;
    private int? MaxOutputTokens;

    protected override object BuildPayload(string message, int maxTokens)
    {
        var payload = new Dictionary<string, object?>
        {
            ["model"] = Template.ModelId,
            ["input"] = message
        };

        if (IsStreaming)
        {
            payload["stream"] = true;
        }

        if (!string.IsNullOrWhiteSpace(Instructions)) payload["instructions"] = Instructions;
        if (Temperature is not null) payload["temperature"] = Temperature;
        if (TopP is not null) payload["top_p"] = TopP;
        if (MaxOutputTokens is not null) payload["max_output_tokens"] = MaxOutputTokens;

        return payload;
    }

    private void OnInstructionsChanged(ChangeEventArgs e) { Instructions = e.Value?.ToString(); RebuildRequest(); }
    private void OnTemperatureChanged(ChangeEventArgs e) { Temperature = ParseNullableDouble(e.Value); RebuildRequest(); }
    private void OnTopPChanged(ChangeEventArgs e) { TopP = ParseNullableDouble(e.Value); RebuildRequest(); }
    private void OnMaxOutputTokensChanged(ChangeEventArgs e) { MaxOutputTokens = ParseNullableInt(e.Value); RebuildRequest(); }
}
