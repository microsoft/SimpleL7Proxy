@namespace chat_tester.Components.Shared
@using System.Net
@using System.Text
@using System.Text.Json
@inject IJSRuntime JS

<div class="card shadow-sm mt-3 raw-card search-host @CardStateCss">
    <div class="card-header bg-secondary text-white @(IsMinimized ? string.Empty : "pb-0")">
        <div class="d-flex flex-wrap align-items-baseline gap-2 pt-1 pb-2">
            <span class="fw-semibold">@Title</span>
            <span class="text-white-50 small">@StatusMessage</span>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 ms-auto">
                @HeaderActions
                <PanelDisplayToggle State="@DisplayState" StateChanged="SetDisplayStateAsync" AriaLabel="@($"Toggle {Title} full screen")" />
            </div>
        </div>
        @if (!IsMinimized)
        {
            <ul class="nav nav-tabs card-header-tabs raw-tabs mb-0" role="tablist">
                <li class="nav-item">
                    <button class="nav-link @(IsActiveTab("request-headers") ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTabAsync("request-headers")'>Request headers</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(IsActiveTab("response-headers") ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTabAsync("response-headers")'>Response headers</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(IsActiveTab("request-body") ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTabAsync("request-body")'>Request body</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(IsActiveTab("response-body") ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTabAsync("response-body")'>Response body</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(IsActiveTab("backend-log") ? "active" : string.Empty)" type="button" disabled="@(!HasBackendLog)" @onclick='() => SetActiveTabAsync("backend-log")'>Backend Log</button>
                </li>
            </ul>
        }
    </div>
    @if (!IsMinimized)
    {
        <div class="card-body @(IsFullscreen ? "overflow-auto" : string.Empty)">
            <div class="border rounded p-3 bg-light" style="@(IsFullscreen ? "max-height: calc(100vh - 180px);" : "max-height: 320px;") overflow-y: auto;" @ref="RawResponseRef">
                @if (IsActiveTab("request-headers"))
                {
                    <pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">@RequestHeadersText</pre>
                }
                else if (IsActiveTab("response-headers"))
                {
                    <pre class="mb-0" style="white-space: pre-wrap; word-break: break-all;">@ResponseHeadersText</pre>
                }
                else if (IsActiveTab("request-body"))
                {
                    <pre class="mb-0" style="white-space: pre-wrap; word-break: break-word;">@RequestBodyDisplay</pre>
                }
                else if (IsActiveTab("backend-log"))
                {
                    <div class="backend-log-view">@((MarkupString)RenderBackendLogPanel())</div>
                }
                else
                {
                    <pre class="mb-0" style="white-space: pre-wrap; word-break: break-word;">@ObservedResponse</pre>
                }
            </div>
        </div>
    }
</div>

<style>
    .raw-card.fs-overlay {
        position: fixed;
        inset: 0;
        z-index: 1080;
        margin: 0 !important;
        border-radius: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .raw-card.fs-overlay .card-body {
        flex: 1 1 auto;
    }

    .raw-card.panel-minimized {
        flex: 0 0 auto !important;
        min-height: 0 !important;
    }

    .search-host {
        position: relative;
    }

    .response-search-popup {
        position: absolute;
        top: 3.25rem;
        right: 1rem;
        z-index: 25;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.35rem;
        border: 1px solid rgba(0, 0, 0, 0.2);
        border-radius: 0.375rem;
        background: #fff;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.18);
    }

    .response-search-popup input {
        width: 14rem;
        color: #212529;
    }

    .response-search-status {
        min-width: 3.5rem;
        text-align: center;
        color: #6c757d;
        font-size: 0.8rem;
    }

    .response-search-match {
        background: #ffe08a;
        color: #111;
        padding: 0 0.05rem;
    }

    .response-search-match.active {
        background: #ffb703;
        color: #111;
        outline: 2px solid #0d6efd;
    }

    .raw-tabs .nav-link {
        color: rgba(255, 255, 255, 0.85);
        border-color: transparent;
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
    }

    .raw-tabs .nav-link:hover {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
    }

    .raw-tabs .nav-link.active {
        color: #495057;
        background-color: #fff;
        border-color: #fff #fff #fff;
    }

    .backend-log-view .proxy-message {
        font-weight: 600;
        color: #842029;
        margin-bottom: 0.75rem;
    }

    .backend-log-view .proxy-json {
        background: #1f2328;
        color: #f8f9fa;
        border-radius: 0.375rem;
        padding: 0.75rem;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .backend-log-view .json-key {
        color: #9cdcfe;
    }

    .backend-log-view .json-string {
        color: #ce9178;
    }

    .backend-log-view .json-number {
        color: #b5cea8;
    }

    .backend-log-view .json-literal {
        color: #569cd6;
    }

    .backend-log-view .backend-log-item {
        border-left: 4px solid #6c757d;
        background: #fff;
        padding: 0.45rem 0.65rem;
        margin-bottom: 0.4rem;
    }

    .backend-log-view .backend-log-item.warning {
        border-left-color: #ffc107;
        background: #fff8e1;
    }

    .backend-log-view .backend-log-item.error {
        border-left-color: #dc3545;
        background: #f8d7da;
    }

    .backend-log-view .backend-log-item.success {
        border-left-color: #198754;
        background: #d1e7dd;
    }
</style>

@code {
    private ElementReference RawResponseRef;

    [Parameter]
    public string Title { get; set; } = "Raw response";

    [Parameter]
    public string StatusMessage { get; set; } = string.Empty;

    [Parameter]
    public string ActiveTab { get; set; } = "response-body";

    [Parameter]
    public EventCallback<string> ActiveTabChanged { get; set; }

    [Parameter]
    public PanelDisplayState DisplayState { get; set; } = PanelDisplayState.Minimized;

    [Parameter]
    public EventCallback<PanelDisplayState> DisplayStateChanged { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    [Parameter]
    public string RequestHeadersText { get; set; } = "No request has been sent yet.";

    [Parameter]
    public string ResponseHeadersText { get; set; } = "No response has been received yet.";

    [Parameter]
    public string RequestBodyDisplay { get; set; } = "No request body yet.";

    [Parameter]
    public string ObservedResponse { get; set; } = "No response yet.";

    [Parameter]
    public bool HasProxyError { get; set; }

    private bool HasBackendLog => HasProxyError || BackendLogDetector.HasBackendLog(ResponseHeadersText, ObservedResponse);

    private bool IsMinimized => DisplayState == PanelDisplayState.Minimized;

    private bool IsFullscreen => DisplayState == PanelDisplayState.Fullscreen;

    private string CardStateCss => DisplayState switch
    {
        PanelDisplayState.Minimized => "panel-minimized",
        PanelDisplayState.Fullscreen => "fs-overlay",
        _ => string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (IsMinimized)
            {
                return;
            }

            await JS.InvokeVoidAsync("responseSearch.register", RawResponseRef);
            await JS.InvokeVoidAsync("responseSearch.refresh");
        }
        catch (JSException)
        {
            // Ignore interop errors during prerender or disconnect.
        }
    }

    private bool IsActiveTab(string tab) =>
        string.Equals(ActiveTab, tab, StringComparison.Ordinal);

    private async Task SetActiveTabAsync(string tab)
    {
        await ActiveTabChanged.InvokeAsync(tab);
    }

    private async Task SetDisplayStateAsync(PanelDisplayState state)
    {
        DisplayState = state;
        await DisplayStateChanged.InvokeAsync(state);
    }

    private string RenderBackendLogPanel()
    {
        var headerLogs = BackendLogDetector.ExtractFromHeaders(ResponseHeadersText);
        var bodyLogs = BackendLogDetector.ExtractFromBody(ObservedResponse);
        if (!HasProxyError && headerLogs.Count == 0 && bodyLogs.Count == 0)
        {
            return "<div class=\"text-muted\">No backend log detected.</div>";
        }

        var builder = new StringBuilder();
        if (headerLogs.Count > 0)
        {
            builder.Append(RenderBackendLogEntries(headerLogs, "Backend log header"));
        }

        if (bodyLogs.Count > 0)
        {
            builder.Append(RenderBackendLogEntries(bodyLogs, "Backend log highlights"));
        }

        if (!HasProxyError)
        {
            return builder.ToString();
        }

        var (message, json) = SplitProxyError(ObservedResponse);
        if (builder.Length > 0)
        {
            builder.AppendLine("<div class=\"fw-semibold mt-3 mb-2\">Proxy error</div>");
        }

        builder.Append("<div class=\"proxy-message\">").Append(WebUtility.HtmlEncode(message)).AppendLine("</div>");

        if (TryParseProxyJson(json, out var document))
        {
            using (document)
            {
                builder.Append("<div class=\"fw-semibold mt-3 mb-2\">Formatted JSON</div>");
                builder.Append("<pre class=\"proxy-json mb-0\">").Append(ColorJson(JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true }))).AppendLine("</pre>");
            }
        }
        else
        {
            builder.Append("<pre class=\"proxy-json mb-0\">").Append(WebUtility.HtmlEncode(ObservedResponse)).AppendLine("</pre>");
        }

        return builder.ToString();
    }

    private static (string Message, string Json) SplitProxyError(string response)
    {
        var jsonStart = response.IndexOf('{');
        if (jsonStart < 0)
        {
            return (response.Trim(), string.Empty);
        }

        var message = response[..jsonStart].Replace("Request Summary:", string.Empty, StringComparison.OrdinalIgnoreCase).Trim();
        return (message, response[jsonStart..].Trim());
    }

    private static bool TryParseProxyJson(string json, out JsonDocument document)
    {
        try
        {
            document = JsonDocument.Parse(json);
            return true;
        }
        catch
        {
            document = null!;
            return false;
        }
    }

    private static string RenderBackendLogEntries(IEnumerable<string> logs, string title)
    {
        var builder = new StringBuilder();
        var logList = logs.Where(log => !string.IsNullOrWhiteSpace(log)).ToList();
        if (logList.Count == 0)
        {
            return string.Empty;
        }

        builder.Append("<div class=\"fw-semibold mb-2\">").Append(WebUtility.HtmlEncode(title)).AppendLine("</div>");
        foreach (var log in logList)
        {
            foreach (var part in log.Split('|', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
            {
                var severity = ClassifyBackendLogPart(part);
                builder.Append("<div class=\"backend-log-item ").Append(severity).Append("\">")
                    .Append(WebUtility.HtmlEncode(part.Trim()))
                    .AppendLine("</div>");
            }
        }

        return builder.ToString();
    }

    private static string ClassifyBackendLogPart(string part)
    {
        var beginSeverity = ClassifyBeginLog(part);
        if (!string.IsNullOrEmpty(beginSeverity))
        {
            return beginSeverity;
        }

        if (part.Contains("THROTTLED: (none)", StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        if (part.Contains("TIMEOUT", StringComparison.OrdinalIgnoreCase) ||
            part.Contains("INCOMPLETE", StringComparison.OrdinalIgnoreCase) ||
            part.Contains("exhausted", StringComparison.OrdinalIgnoreCase))
        {
            return "error";
        }

        if (part.Contains("THROTTLED", StringComparison.OrdinalIgnoreCase) ||
            part.Contains("RETRIES", StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        return string.Empty;
    }

    private static string ClassifyBeginLog(string part)
    {
        if (!part.Contains("Begin", StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        var secondsSuffix = part.IndexOf('s');
        if (secondsSuffix <= 0 || !double.TryParse(part[..secondsSuffix].Trim(), out var seconds))
        {
            return string.Empty;
        }

        if (seconds < 0.1)
        {
            return "success";
        }

        if (seconds < 1)
        {
            return "warning";
        }

        return "error";
    }

    private static string ColorJson(string json)
    {
        var encoded = WebUtility.HtmlEncode(json);
        var builder = new StringBuilder();
        for (var index = 0; index < encoded.Length;)
        {
            if (encoded[index] == '&' && encoded[index..].StartsWith("&quot;", StringComparison.Ordinal))
            {
                var end = encoded.IndexOf("&quot;", index + 6, StringComparison.Ordinal);
                if (end < 0)
                {
                    builder.Append(encoded[index..]);
                    break;
                }

                var token = encoded[index..(end + 6)];
                var after = end + 6;
                var isKey = after < encoded.Length && encoded[after..].TrimStart().StartsWith(':');
                builder.Append("<span class=\"").Append(isKey ? "json-key" : "json-string").Append("\">").Append(token).Append("</span>");
                index = after;
            }
            else if (char.IsDigit(encoded[index]) || encoded[index] == '-')
            {
                var start = index;
                while (index < encoded.Length && (char.IsDigit(encoded[index]) || encoded[index] is '-' or '.' or 'E' or 'e' or '+'))
                {
                    index++;
                }
                builder.Append("<span class=\"json-number\">").Append(encoded[start..index]).Append("</span>");
            }
            else if (encoded[index..].StartsWith("true", StringComparison.Ordinal) || encoded[index..].StartsWith("false", StringComparison.Ordinal) || encoded[index..].StartsWith("null", StringComparison.Ordinal))
            {
                var literal = encoded[index..].StartsWith("true", StringComparison.Ordinal) ? "true" : encoded[index..].StartsWith("false", StringComparison.Ordinal) ? "false" : "null";
                builder.Append("<span class=\"json-literal\">").Append(literal).Append("</span>");
                index += literal.Length;
            }
            else
            {
                builder.Append(encoded[index]);
                index++;
            }
        }

        return builder.ToString();
    }
}