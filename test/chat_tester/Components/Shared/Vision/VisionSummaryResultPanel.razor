@namespace chat_tester.Components.Shared
@using System.Linq

    <div class="vision-summary">
    @if (Result.Caption is not null)
    {
        <div class="result-callout mb-3">
            <div class="text-muted small text-uppercase fw-semibold">Caption</div>
            <div class="fs-6 fw-semibold">@Result.Caption.Text</div>
            <div class="small text-muted">Confidence @VisionResultFormatter.Confidence(Result.Caption.Confidence)</div>
        </div>
    }
    else
    {
        <pre class="vision-text-pre mb-3">@Result.SummaryText</pre>
    }

    @if (!IsChat)
    {
    <div class="result-stat-grid mb-3">
        <div><span>Dense captions</span><strong>@Result.DenseCaptions.Count</strong></div>
        <div><span>Tags</span><strong>@Result.Tags.Count</strong></div>
        <div><span>Objects</span><strong>@Result.Objects.Count</strong></div>
        <div><span>People</span><strong>@Result.People.Count</strong></div>
        <div><span>Read lines</span><strong>@Result.ReadLines.Count</strong></div>
    </div>

    @if (Result.Tags.Count > 0)
    {
        <div class="mb-3">
            <div class="text-muted small text-uppercase fw-semibold mb-2">Top tags</div>
            <div class="tag-cloud">
                @foreach (var tag in Result.Tags.Take(12))
                {
                    <span class="vision-tag">@tag.Name <span>@VisionResultFormatter.Confidence(tag.Confidence)</span></span>
                }
            </div>
        </div>
    }

    <div class="metadata-grid">
        @if (!string.IsNullOrWhiteSpace(Result.ModelVersion))
        {
            <div><span>Model version</span><strong>@Result.ModelVersion</strong></div>
        }
        @if (Result.Metadata.HasDimensions)
        {
            <div><span>Image size</span><strong>@Result.Metadata.Width x @Result.Metadata.Height</strong></div>
        }
    </div>
    }
</div>

@code {
    [Parameter]
    public VisionResultView Result { get; set; } = new();

    [Parameter]
    public bool IsChat { get; set; }
}