@namespace chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Text.Json
@using System.Linq

@{
    var historyEntries = VisibleEntries;
}

@if (!IsMinimized)
{
    <div class="card shadow-sm history-card @HistoryCardStateCss" tabindex="0" @onmouseenter="ShowDefaultHistoryPreview" @onmouseleave="OnHistoryPanelMouseLeave" @onkeydown="OnHistoryKeyDown" @onclick="CancelPendingDelete">
        <div class="card-header d-flex flex-wrap align-items-baseline gap-2">
            <span class="fw-semibold">Request history</span>
            <span class="history-count">@FormatHistoryCount(historyEntries.Count)</span>
            <div class="history-type-filter btn-group btn-group-sm" role="group" aria-label="History type filter">
                <button class="btn @(ActiveFilter == HistoryEntryType.Request ? "btn-light" : "btn-outline-light")" type="button" @onclick="() => SetHistoryType(HistoryEntryType.Request)">Request</button>
                <button class="btn @(ActiveFilter == HistoryEntryType.Chat ? "btn-light" : "btn-outline-light")" type="button" @onclick="() => SetHistoryType(HistoryEntryType.Chat)">Chat</button>
            </div>
            <span class="history-status small">Hover to expand history.</span>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 ms-auto">
                @HeaderActions
                <PanelDisplayToggle State="@DisplayState" StateChanged="SetDisplayStateAsync" AriaLabel="Toggle request history full screen" />
            </div>
        </div>
        <div class="card-body history-panel-body py-3">
            @if (historyEntries.Count == 0)
            {
                <div class="text-muted small">@EmptyHistoryText</div>
            }
            else
            {
                <div class="history-buttons" role="list" aria-label="Request history">
                    @foreach (var entry in historyEntries)
                    {
                        <div class="history-item @GetHistoryStatusClass(entry) @(IsHistoryPreviewEntry(entry) ? "preview-active" : string.Empty) @(entry.Id == SelectedEntryId ? "active" : string.Empty)" role="listitem" @onmouseenter="() => ShowHistoryPreview(entry)" @onfocusin="() => ShowHistoryPreview(entry)">
                            <button class="history-button" type="button" @onclick="() => SelectHistoryEntryAsync(entry)">
                                <span class="history-line">
                                    <span class="history-date">@FormatHistoryDate(entry.CreatedAt)</span>
                                    <span class="history-status-code">@FormatHistoryStatus(entry)</span>
                                </span>
                                <span class="history-age">@(entry.Id == SelectedEntryId ? "Showing" : FormatHistoryAge(entry.CreatedAt))</span>
                            </button>
                            <button class="history-delete @(entry.Id == PendingDeleteEntryId ? "confirm" : string.Empty)" type="button" title="Delete history item" aria-label="Delete history item from @FormatHistoryDate(entry.CreatedAt)" @onclick="() => DeleteHistoryEntryAsync(entry)" @onclick:stopPropagation="true">
                                @if (entry.Id == PendingDeleteEntryId)
                                {
                                    <span>Confirm</span>
                                }
                                else
                                {
                                    <svg class="history-trash-icon" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
                                        <path d="M9 3h6l1 2h4v2H4V5h4l1-2Zm1 6v9h2V9h-2Zm4 0v9h2V9h-2ZM7 9h2v9c0 1.1.9 2 2 2h2c1.1 0 2-.9 2-2V9h2v9c0 2.2-1.8 4-4 4h-2c-2.2 0-4-1.8-4-4V9Z" />
                                    </svg>
                                }
                            </button>

                            @if (IsHistoryPreviewEntry(entry))
                            {
                                var summary = GetHistoryRequestSummary(entry);

                                <div class="history-request-summary" aria-hidden="true">
                                    <div class="history-summary-grid">
                                        <span>Model</span>
                                        <strong>@summary.Model</strong>
                                        <span>API</span>
                                        <strong>@summary.Api</strong>
                                        <span>Stream</span>
                                        <strong>@summary.Stream</strong>
                                    </div>
                                    <div class="history-summary-prompt">@summary.Prompt</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    :global(body) {
        padding-bottom: 3.25rem;
    }

    .history-card {
        position: fixed;
        left: 3.25rem;
        right: 1rem;
        bottom: 0;
        z-index: 1030;
        max-height: 3rem;
        margin: 0;
        overflow: hidden;
        border-color: #0d6efd;
        transition: max-height 0.18s ease, box-shadow 0.18s ease;
    }

    .history-card:hover,
    .history-card:focus-within,
    .history-card.panel-expanded {
        max-height: 13rem;
        overflow: visible;
        box-shadow: 0 -0.5rem 1.25rem rgba(0, 0, 0, 0.18) !important;
    }

    .history-card.fs-overlay {
        top: 3.5rem;
        right: 1rem;
        bottom: 1rem;
        max-height: none;
        overflow: visible;
    }

    .history-card.fs-overlay .history-buttons {
        max-height: none;
        overflow-y: auto;
    }

    .history-card .card-header {
        min-height: 2.75rem;
        background: #0d6efd;
        color: #fff;
        border-color: #0d6efd;
    }

    .history-status {
        color: rgba(255, 255, 255, 0.78);
    }

    .history-count {
        display: inline-flex;
        align-items: center;
        min-height: 1.35rem;
        padding: 0 0.45rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
        color: #fff;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .history-type-filter .btn {
        min-width: 4.2rem;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1.2;
    }

    .history-type-filter .btn-outline-light {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.62);
    }

    .history-type-filter .btn-outline-light:hover,
    .history-type-filter .btn-outline-light:focus {
        color: #0d6efd;
        background: #fff;
        border-color: #fff;
    }

    .history-panel-body {
        position: relative;
        background: #fff;
        border-top: 1px solid rgba(0, 0, 0, 0.075);
    }

    .history-buttons {
        display: flex;
        flex-wrap: wrap;
        align-content: flex-start;
        gap: 0.35rem;
        max-height: 8.75rem;
        overflow: visible;
    }

    .history-item {
        position: relative;
        width: 9.25rem;
        min-height: 2.8rem;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        background: #fff;
        color: #212529;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        overflow: visible;
    }

    .history-item:hover,
    .history-item:focus-within {
        z-index: 2;
    }

    .history-item:hover {
        border-color: #0d6efd;
        background: #f8fbff;
    }

    .history-item.history-success {
        border-color: #75b798;
        background: #d1e7dd;
    }

    .history-item.history-failed {
        border-color: #ea868f;
        background: #f8d7da;
    }

    .history-item.history-rate-limited {
        border-color: #ffda6a;
        background: #fff3cd;
    }

    .history-item.active {
        border-color: #0d6efd;
        box-shadow: inset 0 0 0 2px #0d6efd;
    }

    .history-item.preview-active:not(.active) {
        border-color: #0d6efd;
        box-shadow: inset 0 0 0 1px #0d6efd;
    }

    .history-button,
    .history-delete {
        border: 0;
        background: transparent;
    }

    .history-button {
        position: relative;
        min-width: 0;
        text-align: left;
        padding: 0.35rem 0.45rem;
        color: inherit;
    }

    .history-delete {
        width: 2.15rem;
        border-left: 1px solid rgba(0, 0, 0, 0.1);
        color: #842029;
        font-size: 0.72rem;
        font-weight: 600;
    }

    .history-delete:hover,
    .history-delete:focus {
        background: #f8d7da;
        color: #58151c;
    }

    .history-delete.confirm {
        width: 3.8rem;
        background: #dc3545;
        color: #fff;
    }

    .history-delete.confirm:hover,
    .history-delete.confirm:focus {
        background: #bb2d3b;
        color: #fff;
    }

    .history-trash-icon {
        width: 1rem;
        height: 1rem;
        fill: currentColor;
        vertical-align: middle;
    }

    .history-line,
    .history-date,
    .history-age {
        display: block;
        line-height: 1.25;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .history-line {
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

    .history-date {
        font-weight: 600;
        font-size: 0.78rem;
        min-width: 0;
        flex: 1 1 auto;
    }

    .history-age {
        color: rgba(33, 37, 41, 0.72);
        font-size: 0.7rem;
        margin-top: 0.05rem;
    }

    .history-status-code {
        flex: 0 0 auto;
        border-radius: 999px;
        padding: 0.05rem 0.3rem;
        background: rgba(255, 255, 255, 0.72);
        color: #212529;
        font-size: 0.68rem;
        font-weight: 700;
    }

    .history-request-summary {
        position: absolute;
        left: 0;
        bottom: calc(100% + 0.35rem);
        z-index: 4;
        width: min(20rem, calc(100vw - 2rem));
        padding: 0.55rem 0.65rem;
        border: 1px solid rgba(33, 37, 41, 0.16);
        border-radius: 0.375rem;
        background: #212529;
        color: #fff;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.22);
        font-size: 0.74rem;
        line-height: 1.25;
        pointer-events: none;
    }

    .history-summary-grid {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: 0.15rem 0.55rem;
        margin-bottom: 0.35rem;
    }

    .history-summary-grid span {
        color: rgba(255, 255, 255, 0.64);
        font-weight: 600;
    }

    .history-summary-grid strong {
        min-width: 0;
        overflow: hidden;
        color: #fff;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .history-summary-prompt {
        display: -webkit-box;
        overflow: hidden;
        color: rgba(255, 255, 255, 0.92);
        white-space: pre-wrap;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }
</style>

@code {
    private sealed record HistoryRequestSummary(string Model, string Api, string Stream, string Prompt);

    private enum HistoryEntryType
    {
        Request,
        Chat
    }

    private HistoryEntryType ActiveFilter { get; set; } = HistoryEntryType.Request;
    private string? LastSelectedEntryId { get; set; }
    private string? PendingDeleteEntryId { get; set; }
    private string? PreviewEntryId { get; set; }
    private bool IsPreviewOpen { get; set; }
    private IReadOnlyList<ChatHistoryEntry> VisibleEntries => Entries
        .Where(entry => GetHistoryEntryType(entry) == ActiveFilter)
        .ToArray();
    private ChatHistoryEntry? ActivePreviewEntry => IsPreviewOpen
        ? VisibleEntries.FirstOrDefault(entry => string.Equals(entry.Id, PreviewEntryId, StringComparison.Ordinal)) ?? VisibleEntries.LastOrDefault()
        : null;
    private string EmptyHistoryText => ActiveFilter == HistoryEntryType.Request
        ? "No saved request inspector entries yet."
        : "No saved chat entries yet.";

    [Parameter]
    public IReadOnlyList<ChatHistoryEntry> Entries { get; set; } = Array.Empty<ChatHistoryEntry>();

    [Parameter]
    public string? SelectedEntryId { get; set; }

    [Parameter]
    public EventCallback<ChatHistoryEntry> OnEntrySelected { get; set; }

    [Parameter]
    public EventCallback<ChatHistoryEntry> OnEntryDeleted { get; set; }

    [Parameter]
    public PanelDisplayState DisplayState { get; set; } = PanelDisplayState.Expanded;

    [Parameter]
    public EventCallback<PanelDisplayState> DisplayStateChanged { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    private bool IsMinimized => DisplayState == PanelDisplayState.Minimized;

    private string HistoryCardStateCss => DisplayState switch
    {
        PanelDisplayState.Expanded => "panel-expanded",
        PanelDisplayState.Fullscreen => "fs-overlay",
        _ => string.Empty
    };

    protected override void OnParametersSet()
    {
        if (!string.Equals(SelectedEntryId, LastSelectedEntryId, StringComparison.Ordinal))
        {
            LastSelectedEntryId = SelectedEntryId;
            var selectedEntry = Entries.FirstOrDefault(entry => string.Equals(entry.Id, SelectedEntryId, StringComparison.Ordinal));
            if (selectedEntry is not null)
            {
                ActiveFilter = GetHistoryEntryType(selectedEntry);
            }
        }

        var visibleEntries = VisibleEntries;
        if (visibleEntries.Count == 0)
        {
            PreviewEntryId = null;
            PendingDeleteEntryId = null;
            return;
        }

        if (!visibleEntries.Any(entry => string.Equals(entry.Id, PreviewEntryId, StringComparison.Ordinal)))
        {
            PreviewEntryId = visibleEntries.LastOrDefault()?.Id;
        }

        if (!visibleEntries.Any(entry => string.Equals(entry.Id, PendingDeleteEntryId, StringComparison.Ordinal)))
        {
            PendingDeleteEntryId = null;
        }
    }

    private void SetHistoryType(HistoryEntryType historyType)
    {
        ActiveFilter = historyType;
        PendingDeleteEntryId = null;
        PreviewEntryId = VisibleEntries.LastOrDefault()?.Id;
    }

    private async Task SetDisplayStateAsync(PanelDisplayState state)
    {
        DisplayState = state;
        await DisplayStateChanged.InvokeAsync(state);
    }

    private async Task SelectHistoryEntryAsync(ChatHistoryEntry entry)
    {
        PendingDeleteEntryId = null;
        ShowHistoryPreview(entry);
        await OnEntrySelected.InvokeAsync(entry);
    }

    private void ShowDefaultHistoryPreview()
    {
        IsPreviewOpen = true;
        var visibleEntries = VisibleEntries;
        if (visibleEntries.Count == 0)
        {
            PreviewEntryId = null;
            return;
        }

        if (string.IsNullOrWhiteSpace(PreviewEntryId) || !visibleEntries.Any(entry => string.Equals(entry.Id, PreviewEntryId, StringComparison.Ordinal)))
        {
            PreviewEntryId = visibleEntries.LastOrDefault()?.Id;
        }
    }

    private void ShowHistoryPreview(ChatHistoryEntry entry)
    {
        IsPreviewOpen = true;
        PreviewEntryId = entry.Id;
    }

    private bool IsHistoryPreviewEntry(ChatHistoryEntry entry) =>
        IsPreviewOpen && string.Equals(entry.Id, ActivePreviewEntry?.Id, StringComparison.Ordinal);

    private async Task DeleteHistoryEntryAsync(ChatHistoryEntry entry)
    {
        if (!string.Equals(PendingDeleteEntryId, entry.Id, StringComparison.Ordinal))
        {
            PendingDeleteEntryId = entry.Id;
            return;
        }

        PendingDeleteEntryId = null;
        await OnEntryDeleted.InvokeAsync(entry);

        if (string.Equals(PreviewEntryId, entry.Id, StringComparison.Ordinal))
        {
            PreviewEntryId = VisibleEntries.Where(candidate => !string.Equals(candidate.Id, entry.Id, StringComparison.Ordinal)).LastOrDefault()?.Id;
        }
    }

    private void OnHistoryPanelMouseLeave()
    {
        CancelPendingDelete();
        IsPreviewOpen = false;
    }

    private void CancelPendingDelete()
    {
        PendingDeleteEntryId = null;
    }

    private void OnHistoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key.Equals("Escape", StringComparison.OrdinalIgnoreCase))
        {
            CancelPendingDelete();
            IsPreviewOpen = false;
        }
    }

    private static HistoryEntryType GetHistoryEntryType(ChatHistoryEntry entry) =>
        string.Equals(entry.Source, "Chat", StringComparison.OrdinalIgnoreCase)
            ? HistoryEntryType.Chat
            : HistoryEntryType.Request;

    private string FormatHistoryCount(int count)
    {
        var label = ActiveFilter == HistoryEntryType.Request ? "request" : "chat";
        return count == 1 ? $"1 {label} item" : $"{count} {label} items";
    }

    private static string FormatHistoryDate(DateTimeOffset value) =>
        value.LocalDateTime.ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture);

    private static string FormatHistoryStatus(ChatHistoryEntry entry)
    {
        var statusCode = GetHistoryStatusCode(entry);
        if (statusCode is not null)
        {
            return statusCode.Value.ToString(CultureInfo.InvariantCulture);
        }

        return string.IsNullOrWhiteSpace(entry.Metrics.Status) ? "-" : entry.Metrics.Status;
    }

    private static HistoryRequestSummary GetHistoryRequestSummary(ChatHistoryEntry entry)
    {
        var model = ExtractModelFromEndpoint(entry.EndpointPath);
        var stream = InferStreamFromEndpoint(entry.EndpointPath);

        if (!string.IsNullOrWhiteSpace(entry.RequestBody))
        {
            try
            {
                using var document = JsonDocument.Parse(entry.RequestBody);
                var root = document.RootElement;

                if (TryGetProperty(root, "model", out var modelElement))
                {
                    var modelValue = ExtractJsonContent(modelElement);
                    if (!string.IsNullOrWhiteSpace(modelValue))
                    {
                        model = modelValue;
                    }
                }

                if (TryGetProperty(root, "stream", out var streamElement))
                {
                    stream = FormatJsonBoolean(streamElement);
                }
            }
            catch (JsonException)
            {
            }
        }

        return new HistoryRequestSummary(
            string.IsNullOrWhiteSpace(model) ? "-" : model,
            FormatHistoryApi(entry.EndpointPath),
            stream,
            FormatHistoryPromptPreview(entry));
    }

    private static string FormatHistoryPromptPreview(ChatHistoryEntry entry)
    {
        var requestBody = entry.RequestBody;
        if (string.IsNullOrWhiteSpace(requestBody))
        {
            return "No prompt captured.";
        }

        try
        {
            using var document = JsonDocument.Parse(requestBody);
            if (TryExtractPromptPreview(document.RootElement, out var promptPreview))
            {
                return TakePreviewLines(promptPreview);
            }
        }
        catch (JsonException)
        {
        }

        return TakePreviewLines(requestBody);
    }

    private static string FormatHistoryApi(string endpointPath)
    {
        if (string.IsNullOrWhiteSpace(endpointPath))
        {
            return "-";
        }

        var endpoint = endpointPath.Split('?', 2)[0];
        if (endpoint.Contains("chat/completions", StringComparison.OrdinalIgnoreCase))
        {
            return "chat/completions";
        }

        if (endpoint.Contains("responses", StringComparison.OrdinalIgnoreCase))
        {
            return "responses";
        }

        if (endpoint.Contains("messages", StringComparison.OrdinalIgnoreCase))
        {
            return "messages";
        }

        if (endpoint.Contains("streamGenerateContent", StringComparison.OrdinalIgnoreCase))
        {
            return "streamGenerateContent";
        }

        if (endpoint.Contains("generateContent", StringComparison.OrdinalIgnoreCase))
        {
            return "generateContent";
        }

        return endpoint;
    }

    private static string InferStreamFromEndpoint(string endpointPath) =>
        endpointPath.Contains("stream", StringComparison.OrdinalIgnoreCase) ? "true" : "-";

    private static string ExtractModelFromEndpoint(string endpointPath)
    {
        if (string.IsNullOrWhiteSpace(endpointPath))
        {
            return string.Empty;
        }

        const string marker = "/models/";
        var markerIndex = endpointPath.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (markerIndex < 0)
        {
            return string.Empty;
        }

        var start = markerIndex + marker.Length;
        var end = endpointPath.IndexOfAny(new[] { '/', ':', '?' }, start);
        return end < 0 ? endpointPath[start..] : endpointPath[start..end];
    }

    private static string FormatJsonBoolean(JsonElement element) => element.ValueKind switch
    {
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        JsonValueKind.String when bool.TryParse(element.GetString(), out var value) => value ? "true" : "false",
        _ => "-"
    };

    private static bool TryExtractPromptPreview(JsonElement root, out string promptPreview)
    {
        if (TryGetProperty(root, "messages", out var messages) && messages.ValueKind == JsonValueKind.Array)
        {
            var fallbackMessage = string.Empty;
            foreach (var message in messages.EnumerateArray())
            {
                var content = TryGetProperty(message, "content", out var contentElement)
                    ? ExtractJsonContent(contentElement)
                    : string.Empty;

                if (string.IsNullOrWhiteSpace(content))
                {
                    continue;
                }

                fallbackMessage = content;
                if (TryGetProperty(message, "role", out var roleElement)
                    && string.Equals(roleElement.GetString(), "user", StringComparison.OrdinalIgnoreCase))
                {
                    promptPreview = content;
                    return true;
                }
            }

            if (!string.IsNullOrWhiteSpace(fallbackMessage))
            {
                promptPreview = fallbackMessage;
                return true;
            }
        }

        foreach (var propertyName in new[] { "prompt", "input", "query" })
        {
            if (TryGetProperty(root, propertyName, out var propertyValue))
            {
                var value = ExtractJsonContent(propertyValue);
                if (!string.IsNullOrWhiteSpace(value))
                {
                    promptPreview = value;
                    return true;
                }
            }
        }

        promptPreview = string.Empty;
        return false;
    }

    private static string ExtractJsonContent(JsonElement element)
    {
        if (element.ValueKind == JsonValueKind.String)
        {
            return element.GetString() ?? string.Empty;
        }

        if (element.ValueKind == JsonValueKind.Array)
        {
            return string.Join(Environment.NewLine, element.EnumerateArray()
                .Select(ExtractJsonContent)
                .Where(content => !string.IsNullOrWhiteSpace(content)));
        }

        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var propertyName in new[] { "text", "content", "value" })
            {
                if (TryGetProperty(element, propertyName, out var propertyValue))
                {
                    var value = ExtractJsonContent(propertyValue);
                    if (!string.IsNullOrWhiteSpace(value))
                    {
                        return value;
                    }
                }
            }
        }

        return string.Empty;
    }

    private static bool TryGetProperty(JsonElement element, string name, out JsonElement value)
    {
        if (element.ValueKind == JsonValueKind.Object)
        {
            foreach (var property in element.EnumerateObject())
            {
                if (string.Equals(property.Name, name, StringComparison.OrdinalIgnoreCase))
                {
                    value = property.Value;
                    return true;
                }
            }
        }

        value = default;
        return false;
    }

    private static string TakePreviewLines(string value)
    {
        var lines = value.Replace("\r", string.Empty)
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .ToArray();

        var preview = lines.Length == 0 ? value.Trim() : string.Join(Environment.NewLine, lines);
        const int maximumLength = 220;
        return preview.Length <= maximumLength ? preview : $"{preview[..maximumLength]}...";
    }

    private static string GetHistoryStatusClass(ChatHistoryEntry entry)
    {
        var statusCode = GetHistoryStatusCode(entry);
        if (statusCode == 429)
        {
            return "history-rate-limited";
        }

        if (statusCode is >= 200 and < 400)
        {
            return "history-success";
        }

        if (statusCode is >= 400 || string.Equals(entry.Metrics.Status, "Failed", StringComparison.OrdinalIgnoreCase))
        {
            return "history-failed";
        }

        return string.Empty;
    }

    private static int? GetHistoryStatusCode(ChatHistoryEntry entry)
    {
        var status = entry.Metrics.Status;
        if (string.IsNullOrWhiteSpace(status))
        {
            return null;
        }

        var token = status.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return int.TryParse(token, NumberStyles.Integer, CultureInfo.InvariantCulture, out var statusCode)
            ? statusCode
            : null;
    }

    private static string FormatHistoryAge(DateTimeOffset value)
    {
        var age = DateTimeOffset.Now - value;
        if (age.TotalMinutes < 1)
        {
            return "Just now";
        }

        if (age.TotalHours < 1)
        {
            var minutes = Math.Max(1, (int)age.TotalMinutes);
            return minutes == 1 ? "1 minute ago" : $"{minutes} minutes ago";
        }

        if (age.TotalHours < 24)
        {
            var hours = Math.Max(1, (int)age.TotalHours);
            return hours == 1 ? "1 hour ago" : $"{hours} hours ago";
        }

        return value.LocalDateTime.ToString("MMM d, yyyy", CultureInfo.InvariantCulture);
    }
}