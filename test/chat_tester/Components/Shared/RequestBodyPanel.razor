@namespace chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components
@using chat_tester.Components.Shared

<div class="chat-body-panel rounded border p-3 mb-3">
    <ModelPanel @ref="Panel"
                @bind-SelectedModel="SelectedModel"
                @bind-SelectedApi="SelectedApi"
                @bind-SimpleMode="SimpleMode"
                AllowModeToggle="AllowModeToggle"
                ShowPrompt="ShowPrompt"
                @bind-Message="SharedMessage"
                @bind-ContentType="SharedContentType"
                Rows="Rows" />
</div>

<style>
    .chat-body-panel {
        background-color: #eef4ff;
        border-color: #cdddf7 !important;
    }
</style>

@code {
    [Parameter]
    public int Rows { get; set; } = 12;

    [Parameter]
    public string? InitialBody { get; set; }

    [Parameter]
    public string? InitialEndpointPath { get; set; }

    [Parameter]
    public string? InitialContentType { get; set; }

    [Parameter]
    public bool AllowModeToggle { get; set; } = true;

    [Parameter]
    public bool ShowPrompt { get; set; } = true;

    private ModelPanel? Panel { get; set; }

    private bool SimpleMode { get; set; } = true;
    private string SelectedModel { get; set; } = string.Empty;
    private string SelectedApi { get; set; } = string.Empty;
    private string SharedMessage { get; set; } = "tell me about the history of jokes";
    private string SharedContentType { get; set; } = ChatTesterHttp.JsonContentType;

    /// <summary>The request the parent page should send, built by the model panel.</summary>
    public ModelRequest CurrentRequest => Panel is not null
        ? new ModelRequest(Panel.EndpointPath, Panel.RequestBody, ContentType)
        : new ModelRequest(InitialEndpointPath ?? string.Empty, InitialBody ?? string.Empty, ContentType);

    public string RequestBody => CurrentRequest.Body;

    public string EndpointPath => CurrentRequest.EndpointPath;

    public string ContentType => Panel?.ContentType ?? SharedContentType;

    public async Task LoadRequestAsync(ChatHistoryEntry entry)
    {
        InitialEndpointPath = entry.EndpointPath;
        InitialBody = entry.RequestBody;
        SharedContentType = string.IsNullOrWhiteSpace(entry.ContentType)
            ? ChatTesterHttp.JsonContentType
            : entry.ContentType;

        if (Panel is not null)
        {
            await Panel.LoadRequestAsync(new ModelRequest(entry.EndpointPath, entry.RequestBody, SharedContentType));
        }
    }

    protected override void OnInitialized()
    {
        SharedContentType = !string.IsNullOrWhiteSpace(InitialContentType)
            ? InitialContentType!
            : ChatTesterHttp.JsonContentType;

        if (string.IsNullOrWhiteSpace(InitialBody))
        {
            return;
        }

        var template = ModelCatalog.FindByKey(ModelRequestParser.DetectModelKey(InitialBody));
        if (template is not null)
        {
            SelectedModel = template.ModelId;
            SelectedApi = ResolveApiId(template, InitialEndpointPath);
        }

        var message = ModelRequestParser.ExtractUserMessage(InitialBody);
        if (!string.IsNullOrWhiteSpace(message))
        {
            SharedMessage = message;
        }
    }

    private static string ResolveApiId(ModelTemplate template, string? endpointPath)
    {
        var endpoint = !string.IsNullOrWhiteSpace(endpointPath)
            ? endpointPath!
            : ModelCatalog.ResolveEndpointPath(template);

        if (endpoint.Contains("/responses", StringComparison.OrdinalIgnoreCase))
        {
            return "openai-responses";
        }

        if (endpoint.Contains("/messages", StringComparison.OrdinalIgnoreCase))
        {
            return "anthropic-messages";
        }

        if (endpoint.Contains("generateContent", StringComparison.OrdinalIgnoreCase))
        {
            return "gemini-generate-content";
        }

        if (endpoint.Contains("/v2/chat", StringComparison.OrdinalIgnoreCase))
        {
            return "cohere-v2-chat";
        }

        if (endpoint.Contains("/compatibility/", StringComparison.OrdinalIgnoreCase))
        {
            return "cohere-openai-chat";
        }

        if (template.Provider == "Google Gemini")
        {
            return "gemini-openai-chat";
        }

        if (template.Provider == "Cohere")
        {
            return endpoint.Contains("/v1/chat", StringComparison.OrdinalIgnoreCase)
                ? "cohere-v1-chat"
                : "cohere-openai-chat";
        }

        return "openai-chat";
    }
}
