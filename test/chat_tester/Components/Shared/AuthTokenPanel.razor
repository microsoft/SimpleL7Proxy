@namespace chat_tester.Components.Shared
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers

<div class="card border-light-subtle mb-3">
    <div class="card-body py-3">
        <div class="d-flex align-items-center justify-content-between">
            <div class="form-check">
                <InputCheckbox class="form-check-input" @bind-Value="UseAuthorization" />
                <label class="form-check-label">Send with authorization</label>
            </div>
            <button class="btn btn-link p-0 text-decoration-none" type="button" @onclick="ToggleExpanded">
                <span class="me-1">Authorization</span>
                <span aria-hidden="true">@ChevronText</span>
            </button>
        </div>

        @if (IsExpanded)
        {
            <div class="mt-3">
                <div class="row g-3 mb-3 align-items-start">
                    <div class="col-md-7">
                        <label class="form-label">Header name</label>
                        <InputText class="form-control" @bind-Value="Settings.HeaderName" />
                        <div class="form-text">Examples: Authorization, x-api-key, X-API-Key</div>
                    </div>

                    <div class="col-md-5">
                        <label class="form-label d-block">Auth mode</label>
                        <div class="d-flex gap-3 pt-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="authmode-key"
                                       checked="@(Settings.AuthMode.Equals("Key", StringComparison.OrdinalIgnoreCase))"
                                       @onchange="@(() => Settings.AuthMode = "Key")" />
                                <label class="form-check-label" for="authmode-key">API key</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="authmode-oauth"
                                       checked="@(Settings.AuthMode.Equals("OAuth", StringComparison.OrdinalIgnoreCase))"
                                       @onchange="@(() => Settings.AuthMode = "OAuth")" />
                                <label class="form-check-label" for="authmode-oauth">OAuth2</label>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Settings.AuthMode.Equals("OAuth", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="mb-3">
                        <label class="form-label">Header value prefix</label>
                        <InputText class="form-control" @bind-Value="Settings.HeaderValuePrefix" />
                        <div class="form-text">Leave empty for raw values or use Bearer for Authorization.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Token value</label>
                        <InputTextArea class="form-control font-monospace" rows="4" @bind-Value="Settings.TokenValue" />
                    </div>

                    <details class="mb-3">
                        <summary class="fw-semibold mb-3">Fetch token</summary>

                        <div class="mt-3 mb-3">
                            <label class="form-label">Token source</label>
                            <InputSelect class="form-select" @bind-Value="Settings.TokenSource">
                                <option value="Manual">Manual token</option>
                                <option value="Fetch">Fetch token from URL</option>
                            </InputSelect>
                        </div>

                        @if (Settings.TokenSource == "Manual")
                        {
                            <div class="mb-3">
                                <label class="form-label">Upload token file</label>
                                <InputFile class="form-control" OnChange="HandleTokenFileSelected" />
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Token fetch URL</label>
                                <InputText class="form-control" @bind-Value="Settings.TokenFetchUrl" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Token fetch method</label>
                                <InputSelect class="form-select" @bind-Value="Settings.TokenFetchMethod">
                                    <option value="GET">GET</option>
                                    <option value="POST">POST</option>
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Token fetch body</label>
                                <InputTextArea class="form-control font-monospace" rows="3" @bind-Value="Settings.TokenFetchBody" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Response property name</label>
                                <InputText class="form-control" @bind-Value="Settings.TokenResponseProperty" />
                                <div class="form-text">Defaults to access_token when empty.</div>
                            </div>
                        }
                    </details>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Key value</label>
                        <InputTextArea class="form-control font-monospace" rows="4" @bind-Value="Settings.KeyValue" />
                        <div class="form-text">This value is remembered for the current server session.</div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public AuthTokenSettings Settings { get; set; } = new();

    private bool useAuthorization;
    private bool IsExpanded { get; set; }

    private bool UseAuthorization
    {
        get => useAuthorization;
        set
        {
            useAuthorization = value;
            IsExpanded = value || IsExpanded;
            if (!value)
            {
                IsExpanded = false;
            }
        }
    }

    private string ChevronText => IsExpanded ? "▾" : "▸";

    public async Task<string> ResolveHeaderValueAsync()
    {
        if (!UseAuthorization)
        {
            return string.Empty;
        }

        if (Settings.AuthMode.Equals("Key", StringComparison.OrdinalIgnoreCase))
        {
            return Settings.KeyValue;
        }

        var token = await ResolveTokenAsync();
        return BuildHeaderValue(token);
    }

    public async Task ApplyAuthorizationAsync(HttpRequestMessage request)
    {
        if (request is null || !UseAuthorization)
        {
            return;
        }

        var headerValue = await ResolveHeaderValueAsync();
        if (string.IsNullOrWhiteSpace(Settings.HeaderName) || string.IsNullOrWhiteSpace(headerValue))
        {
            return;
        }

        request.Headers.Remove(Settings.HeaderName);
        request.Headers.TryAddWithoutValidation(Settings.HeaderName, headerValue);
    }

    public async Task<string> ResolveTokenAsync()
    {
        if (Settings.TokenSource == "Fetch")
        {
            using var client = new HttpClient();
            var request = new HttpRequestMessage(
                Settings.TokenFetchMethod.Equals("POST", StringComparison.OrdinalIgnoreCase) ? HttpMethod.Post : HttpMethod.Get,
                Settings.TokenFetchUrl);

            if (!string.IsNullOrWhiteSpace(Settings.TokenFetchBody))
            {
                request.Content = new StringContent(Settings.TokenFetchBody, System.Text.Encoding.UTF8, new MediaTypeHeaderValue("application/json"));
            }

            using var response = await client.SendAsync(request);
            var content = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode)
            {
                throw new InvalidOperationException($"Token fetch returned {(int)response.StatusCode}: {content}");
            }

            if (string.IsNullOrWhiteSpace(content))
            {
                return string.Empty;
            }

            try
            {
                using var document = System.Text.Json.JsonDocument.Parse(content);
                var propertyName = string.IsNullOrWhiteSpace(Settings.TokenResponseProperty) ? "access_token" : Settings.TokenResponseProperty;
                if (document.RootElement.ValueKind == System.Text.Json.JsonValueKind.Object && document.RootElement.TryGetProperty(propertyName, out var prop))
                {
                    return prop.GetString() ?? string.Empty;
                }
            }
            catch
            {
                // Fall back to the raw response body if the payload is not JSON.
            }

            return content.Trim('"').Trim();
        }

        return Settings.TokenValue;
    }

    public string BuildHeaderValue(string token)
    {
        if (string.IsNullOrWhiteSpace(Settings.HeaderValuePrefix))
        {
            return token;
        }

        return Settings.HeaderValuePrefix.EndsWith(" ", StringComparison.Ordinal) ? $"{Settings.HeaderValuePrefix}{token}" : $"{Settings.HeaderValuePrefix} {token}";
    }

    private void ToggleExpanded()
    {
        IsExpanded = !IsExpanded;
    }

    private async Task HandleTokenFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            return;
        }

        using var stream = file.OpenReadStream(1024 * 1024);
        using var reader = new StreamReader(stream);
        Settings.TokenValue = await reader.ReadToEndAsync();
        Settings.TokenSource = "Manual";
        StateHasChanged();
    }
}
