@namespace chat_tester.Components.Shared
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Forms

<div class="card shadow-sm request-card @CardStateCss">
    <div class="card-header bg-success text-white @(IsMinimized ? string.Empty : "pb-0")">
        <div class="d-flex flex-wrap align-items-baseline gap-2 pt-1 pb-2">
            <span class="fw-semibold">Request</span>
            @if (!string.IsNullOrWhiteSpace(HeaderSubtitle))
            {
                <span class="text-white-50 small">@HeaderSubtitle</span>
            }
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 ms-auto">
                @HeaderActions
                <PanelDisplayToggle State="@DisplayState" StateChanged="SetDisplayStateAsync" AriaLabel="Toggle request full screen" />
            </div>
        </div>
        @if (!IsMinimized)
        {
            <ul class="nav nav-tabs card-header-tabs request-tabs mb-0">
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "server" ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTab("server")'>Server</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "user" ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTab("user")'>User</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "headers" ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTab("headers")'>Headers</button>
                </li>
                <li class="nav-item">
                    <button class="nav-link @(ActiveTab == "prompt" ? "active" : string.Empty)" type="button" @onclick='() => SetActiveTab("prompt")'>@PromptTabLabel</button>
                </li>
            </ul>
        }
    </div>
    <div class="card-body @CardBodyCss">
        @if (!string.IsNullOrWhiteSpace(CardTitle))
        {
            <h5 class="card-title">@CardTitle</h5>
        }
        <EditForm class="request-form" Model="this" OnValidSubmit="HandleSubmitAsync">
            <div class="request-form-content">
                <div class="@(ActiveTab == "server" ? string.Empty : "d-none")">
                    <ServerUrlPanel @ref="ServerUrlPanel" Settings="Settings" InitialServerBaseUrl="@InitialServerBaseUrl" />
                </div>
                <div class="@(ActiveTab == "user" ? string.Empty : "d-none")">
                    <UserPanel @ref="UserPanel" Settings="UserSettings" />
                </div>
                <div class="@(ActiveTab == "headers" ? string.Empty : "d-none")">
                    <HeaderPanel @ref="HeaderPanel" Settings="HeaderSettings" />
                </div>
                <div class="@(ActiveTab == "prompt" ? string.Empty : "d-none")">
                    @PromptContent
                </div>
            </div>

            @if (ShowSubmitButton)
            {
                <div class="request-form-actions">
                    <button class="btn @SubmitButtonClass" type="submit" disabled="@IsBusy">
                        @(IsBusy ? BusyLabel : SubmitLabel)
                    </button>
                </div>
            }
        </EditForm>
    </div>
</div>

<style>
    .request-card.panel-minimized {
        height: auto !important;
        flex: 0 0 auto !important;
        min-height: 0 !important;
    }

    .request-card.fs-overlay {
        position: fixed;
        inset: 0;
        z-index: 1080;
        margin: 0 !important;
        border-radius: 0;
        height: 100vh !important;
        display: flex;
        flex-direction: column;
    }

    .request-card.fs-overlay .card-body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
    }
</style>

@code {
    [Parameter]
    public AuthTokenSettings Settings { get; set; } = new();

    [Parameter]
    public UserSettings UserSettings { get; set; } = new();

    [Parameter]
    public HeaderSettings HeaderSettings { get; set; } = new();

    [Parameter]
    public string? InitialServerBaseUrl { get; set; }

    [Parameter]
    public string HeaderSubtitle { get; set; } = "Send a chat request.";

    [Parameter]
    public string PromptTabLabel { get; set; } = "AI Model";

    [Parameter]
    public string? CardTitle { get; set; }

    [Parameter]
    public string SubmitLabel { get; set; } = "Send";

    [Parameter]
    public string BusyLabel { get; set; } = "Sending...";

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string SubmitButtonClass { get; set; } = "btn-success";

    [Parameter]
    public bool ShowSubmitButton { get; set; } = true;

    [Parameter]
    public PanelDisplayState DisplayState { get; set; } = PanelDisplayState.Expanded;

    [Parameter]
    public EventCallback<PanelDisplayState> DisplayStateChanged { get; set; }

    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [Parameter]
    public RenderFragment? PromptContent { get; set; }

    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    private ServerUrlPanel? ServerUrlPanel { get; set; }
    private UserPanel? UserPanel { get; set; }
    private HeaderPanel? HeaderPanel { get; set; }

    public string ActiveTab { get; private set; } = "prompt";

    private bool IsMinimized => DisplayState == PanelDisplayState.Minimized;

    private bool IsFullscreen => DisplayState == PanelDisplayState.Fullscreen;

    private string CardStateCss => DisplayState switch
    {
        PanelDisplayState.Minimized => "panel-minimized",
        PanelDisplayState.Fullscreen => "fs-overlay",
        _ => "h-100"
    };

    private string CardBodyCss => string.Join(' ', new[]
    {
        IsFullscreen ? "overflow-auto" : string.Empty,
        IsMinimized ? "d-none" : string.Empty
    }.Where(cssClass => !string.IsNullOrWhiteSpace(cssClass)));

    /// <summary>The server base URL entered in the Server tab.</summary>
    public string ServerBaseUrl => ServerUrlPanel?.ServerBaseUrl ?? string.Empty;

    /// <summary>Resolves the configured authorization header value (empty when authorization is disabled).</summary>
    public Task<string> ResolveHeaderValueAsync()
        => ServerUrlPanel?.ResolveHeaderValueAsync() ?? Task.FromResult(string.Empty);

    /// <summary>Applies the configured authorization header to the request when enabled.</summary>
    public Task ApplyAuthorizationAsync(HttpRequestMessage request)
        => ServerUrlPanel?.ApplyAuthorizationAsync(request) ?? Task.CompletedTask;

    /// <summary>Applies the configured user identity header for the given request index.</summary>
    public void ApplyUser(HttpRequestMessage request, int requestIndex)
        => UserSettings.ApplyUser(request, requestIndex);

    /// <summary>Applies the configured custom headers for the given request index.</summary>
    public void ApplyHeaders(HttpRequestMessage request, int requestIndex)
        => HeaderSettings.ApplyHeaders(request, requestIndex);

    public void LoadServerBaseUrl(string serverBaseUrl) => ServerUrlPanel?.LoadServerBaseUrl(serverBaseUrl);

    private void SetActiveTab(string tab) => ActiveTab = tab;

    private async Task SetDisplayStateAsync(PanelDisplayState state)
    {
        DisplayState = state;
        await DisplayStateChanged.InvokeAsync(state);
    }

    private Task HandleSubmitAsync() => OnSubmit.InvokeAsync();
}
