@namespace chat_tester.Components.Shared

<ResponseFormatOption Id="responseFormatText"
                      Label="Text"
                      Format="ResponseDisplayFormat.Text"
                      CurrentFormat="@CurrentFormat"
                      CurrentFormatChanged="@CurrentFormatChanged" />

@code {
    [Parameter]
    public ResponseDisplayFormat CurrentFormat { get; set; }

    [Parameter]
    public EventCallback<ResponseDisplayFormat> CurrentFormatChanged { get; set; }
}