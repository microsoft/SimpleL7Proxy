@namespace chat_tester.Components.Shared
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web

<div class="card shadow-sm error-result-card @CardStateCss">
    <div class="card-header bg-danger text-white @(IsMinimized ? string.Empty : "pb-2")">
        <div class="d-flex flex-wrap align-items-baseline gap-2 pt-1 pb-2">
            <span class="fw-semibold">@Title</span>
            <span class="text-white-50 small">@HeaderStatusMessage</span>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 ms-auto">
                <PanelDisplayToggle State="@DisplayState" StateChanged="SetDisplayStateAsync" AriaLabel="Toggle error panel full screen" />
            </div>
        </div>
    </div>
    @if (!IsMinimized)
    {
        <div class="card-body error-result-body @(IsFullscreen ? "d-flex flex-column overflow-hidden" : string.Empty)">
            <div class="alert @CurrentAlertCss d-flex flex-column gap-1 mb-3" role="alert">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge @CurrentBadgeCss fs-6">@CurrentStatusText</span>
                    <span class="fw-semibold text-truncate">@CurrentPrimaryText</span>
                    @if (CurrentHasBackendLogHeader)
                    {
                        <span class="badge text-bg-light border text-danger-emphasis">Backend log header</span>
                    }
                    @if (CurrentTime is not null)
                    {
                        <span class="ms-auto small">@CurrentTime.Value.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture)</span>
                    }
                </div>
                <div class="error-duration-row">
                    <span class="small text-muted">Failure duration</span>
                    <div class="error-duration-thermometer current @CurrentSeverityCss">
                        <div class="error-duration-fill" style="width: @CurrentDurationWidth;"></div>
                        <span class="error-duration-label">@FormatDuration(CurrentDuration)</span>
                    </div>
                </div>
                <div class="error-current-message font-monospace small">@CurrentMessageText</div>
            </div>

            <div class="row g-4 @(IsFullscreen ? "flex-grow-1 min-h-0" : string.Empty)">
                <div class="col-12 col-xl-5 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                        <h6 class="mb-0">Error trend</h6>
                        <div class="d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm error-trend-window" value="@WindowSelectValue" @onchange="OnWindowChanged">
                                <option value="auto">Auto</option>
                                <option value="5">5m</option>
                                <option value="10">10m</option>
                                <option value="30">30m</option>
                                <option value="60">1h</option>
                                <option value="360">6h</option>
                                <option value="1440">24h</option>
                            </select>
                            <span class="small text-muted">@TotalErrorCount errors · @BucketMinutesLabel</span>
                        </div>
                    </div>

                    @if (Buckets.Count == 0 || TotalErrorCount == 0)
                    {
                        <div class="text-muted small">No prior errors recorded.</div>
                    }
                    else
                    {
                        <div class="error-trend-scroll">
                            <div class="error-trend-chart" style="--error-grid-columns: @Buckets.Count;" role="img" aria-label="Column graph of error counts over time">
                                @foreach (var bucket in Buckets)
                                {
                                    var height = MaxBucketCount == 0 ? 0 : (int)Math.Round(bucket.Count * 100.0 / MaxBucketCount);
                                    <div class="error-trend-column" title="@bucket.Tooltip">
                                        <div class="error-trend-count">@(bucket.Count > 0 ? bucket.Count.ToString(CultureInfo.InvariantCulture) : string.Empty)</div>
                                        <div class="error-trend-bar-stack" style="height: @(height)% ;">
                                            @foreach (var segment in bucket.Segments)
                                            {
                                                <div class="error-trend-seg @segment.Css" style="height: @(segment.Percent)%;"></div>
                                            }
                                        </div>
                                        <div class="error-trend-label">@bucket.Label</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="col-12 col-xl-7 d-flex flex-column min-h-0">
                    <div class="d-flex align-items-baseline justify-content-between mb-2">
                        <h6 class="mb-0">Recent errors</h6>
                        <span class="small text-muted">@Errors.Count total</span>
                    </div>

                    @if (Errors.Count == 0)
                    {
                        <div class="text-muted small">No errors in history.</div>
                    }
                    else
                    {
                        <div class="error-history-list @(IsFullscreen ? "fill" : string.Empty)">
                            @foreach (var entry in RecentErrors)
                            {
                                <button type="button"
                                        class="error-history-item @SeverityCss(entry)"
                                        @onclick="() => OpenErrorDetail(entry)"
                                        @onmouseenter="args => ShowErrorDetails(entry, args)"
                                        @onmousemove="MoveErrorDetails"
                                        @onmouseleave="HideErrorDetails">
                                    <span class="badge @BadgeCssForCode(CodeOf(entry)) error-history-badge">@FormatEntryStatus(entry)</span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="d-flex align-items-baseline gap-2">
                                            <span class="small fw-semibold text-truncate">@FormatEntrySummary(entry)</span>
                                            <span class="ms-auto x-small text-muted text-nowrap">@entry.CreatedAt.ToLocalTime().ToString("HH:mm:ss", CultureInfo.InvariantCulture) · @FormatAge(entry.CreatedAt)</span>
                                        </div>
                                        <div class="text-muted x-small error-endpoint">@entry.Method @entry.EndpointPath</div>
                                        <div class="error-history-meta-row">
                                            <div class="error-duration-thermometer @SeverityCss(entry)">
                                                <div class="error-duration-fill" style="width: @DurationWidth(entry.Metrics.Duration);"></div>
                                                <span class="error-duration-label">@FormatDuration(entry.Metrics.Duration)</span>
                                            </div>
                                            @if (HasBackendLogHeader(entry))
                                            {
                                                <span class="badge text-bg-light border text-danger-emphasis">Backend log header</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (HoveredError is not null)
{
    <div class="error-hover-metrics" style="left: @HoverLeft; top: @HoverTop;">
        <div class="error-hover-card">
            <div class="small fw-semibold mb-2">@HoveredError.Method @HoveredError.EndpointPath</div>
            <ResponseMetricsPanel Status="@HoveredError.Metrics.Status"
                                  ContentType="@HoveredError.Metrics.ContentType"
                                  TimeToFirstByte="@HoveredError.Metrics.TimeToFirstByte"
                                  Duration="@HoveredError.Metrics.Duration"
                                  Chunks="@HoveredError.Metrics.Chunks"
                                  TotalBytes="@HoveredError.Metrics.TotalBytes" />
            <div class="small text-muted mt-2">@HoverBackendLogText</div>
        </div>
    </div>
}

@if (SelectedError is not null)
{
    <div class="multi-request-detail-backdrop" @onclick="CloseErrorDetail"></div>
    <div class="multi-request-detail" role="dialog" aria-modal="true" aria-label="Error request detail" @onclick:stopPropagation="true">
        <div class="multi-request-detail-header">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Error request</div>
                <div class="fw-semibold">@SelectedError.Method @SelectedError.EndpointPath</div>
                <div class="small text-muted">@SelectedError.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) · @NormalizedEntryStatus(SelectedError)</div>
            </div>
            <button class="btn-close" type="button" aria-label="Close error detail" @onclick="CloseErrorDetail"></button>
        </div>
        <div class="multi-request-detail-body">
            <RawResponsePanel Title="Raw exchange"
                              StatusMessage="@FormatEntrySummary(SelectedError)"
                              ActiveTab="@SelectedErrorRawTab"
                              ActiveTabChanged="SetSelectedErrorRawTabAsync"
                              DisplayState="@SelectedErrorRawDisplayState"
                              DisplayStateChanged="SetSelectedErrorRawDisplayStateAsync"
                              RequestHeadersText="@SelectedError.RequestHeadersText"
                              ResponseHeadersText="@SelectedError.ResponseHeadersText"
                              RequestBodyDisplay="@SelectedError.RequestBody"
                              ObservedResponse="@SelectedError.ResponseBody"
                              HasProxyError="@SelectedError.HasProxyError" />
        </div>
    </div>
}

