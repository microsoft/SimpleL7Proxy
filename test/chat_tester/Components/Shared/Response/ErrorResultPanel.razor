@code {
    private const int BucketCount = 12;
    private const int MaxRecentErrors = 25;

    private sealed record ErrorSegment(string Css, int Count, int Percent);

    private sealed record ErrorBucket(string Label, int Danger, int Warning, int Info, int Secondary)
    {
        public int Count => Danger + Warning + Info + Secondary;

        public IReadOnlyList<ErrorSegment> Segments
        {
            get
            {
                var total = Count;
                if (total == 0)
                {
                    return Array.Empty<ErrorSegment>();
                }

                var categories = new[]
                {
                    ("sev-danger", Danger),
                    ("sev-warning", Warning),
                    ("sev-info", Info),
                    ("sev-secondary", Secondary)
                };

                return categories
                    .Where(category => category.Item2 > 0)
                    .Select(category => new ErrorSegment(category.Item1, category.Item2, (int)Math.Round(category.Item2 * 100.0 / total)))
                    .ToList();
            }
        }

        public string Tooltip
        {
            get
            {
                if (Count == 0)
                {
                    return $"{Label}: 0 errors";
                }

                var parts = new List<string>();
                if (Danger > 0)
                {
                    parts.Add($"{Danger} 5xx");
                }

                if (Warning > 0)
                {
                    parts.Add($"{Warning} 429");
                }

                if (Info > 0)
                {
                    parts.Add($"{Info} 4xx");
                }

                if (Secondary > 0)
                {
                    parts.Add($"{Secondary} other");
                }

                return $"{Label}: {string.Join(", ", parts)}";
            }
        }
    }

    [Parameter]
    public string Title { get; set; } = "Error";

    [Parameter]
    public string StatusMessage { get; set; } = string.Empty;

    [Parameter]
    public string CurrentStatus { get; set; } = string.Empty;

    [Parameter]
    public string CurrentMessage { get; set; } = string.Empty;

    [Parameter]
    public DateTimeOffset? CurrentTime { get; set; }

    [Parameter]
    public TimeSpan? CurrentDuration { get; set; }

    [Parameter]
    public string CurrentRequestUrl { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ChatHistoryEntry> Errors { get; set; } = Array.Empty<ChatHistoryEntry>();

    [Parameter]
    public PanelDisplayState DisplayState { get; set; } = PanelDisplayState.Expanded;

    [Parameter]
    public EventCallback<PanelDisplayState> DisplayStateChanged { get; set; }

    private ChatHistoryEntry? HoveredError { get; set; }

    private ChatHistoryEntry? SelectedError { get; set; }

    private string SelectedErrorRawTab { get; set; } = "response-body";

    private PanelDisplayState SelectedErrorRawDisplayState { get; set; } = PanelDisplayState.Expanded;

    private string HoverLeft { get; set; } = "0px";

    private string HoverTop { get; set; } = "0px";

    private static int? CodeOf(ChatHistoryEntry entry) => HistoryEntryFormatter.GetHistoryStatusCode(entry);

    private static int? ParseCode(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return null;
        }

        var token = status.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return int.TryParse(token, NumberStyles.Integer, CultureInfo.InvariantCulture, out var code) ? code : null;
    }

    private static string BadgeCssForCode(int? code) => code switch
    {
        429 => "text-bg-warning",
        >= 500 => "text-bg-danger",
        >= 400 => "text-bg-info",
        _ => "text-bg-secondary"
    };

    private static string SeverityCss(ChatHistoryEntry entry) => CodeOf(entry) switch
    {
        429 => "sev-warning",
        >= 500 => "sev-danger",
        >= 400 => "sev-info",
        _ => "sev-secondary"
    };

    private bool IsMinimized => DisplayState == PanelDisplayState.Minimized;

    private bool IsFullscreen => DisplayState == PanelDisplayState.Fullscreen;

    private string CardStateCss => DisplayState switch
    {
        PanelDisplayState.Minimized => "panel-minimized",
        PanelDisplayState.Fullscreen => "fs-overlay",
        _ => string.Empty
    };

    private string CurrentStatusText => string.IsNullOrWhiteSpace(CurrentStatus) ? "Failed" : CurrentStatus.Trim();

    private int? CurrentCode => ParseCode(CurrentStatus);

    private string CurrentBadgeCss => CurrentCode is null ? "text-bg-danger" : BadgeCssForCode(CurrentCode);

    private string CurrentSeverityCss => CurrentCode switch
    {
        429 => "sev-warning",
        >= 500 => "sev-danger",
        >= 400 => "sev-info",
        _ => "sev-secondary"
    };

    private string CurrentAlertCss => CurrentCode switch
    {
        429 => "alert-warning",
        >= 500 => "alert-danger",
        >= 400 => "alert-info",
        _ => "alert-danger"
    };

    private int TotalErrorCount => Buckets.Sum(bucket => bucket.Count);

    private string CurrentMessageText => string.IsNullOrWhiteSpace(CurrentMessage)
        ? "The request did not complete successfully."
        : CurrentMessage.Trim();

    private string HeaderStatusMessage => NormalizeStatusMessage(StatusMessage, CurrentStatus);

    private string CurrentPrimaryText => string.IsNullOrWhiteSpace(CurrentRequestUrl)
        ? NormalizeStatusMessage(StatusMessage, CurrentStatus)
        : CurrentRequestUrl.Trim();

    private bool CurrentHasBackendLogHeader => Errors.OrderByDescending(entry => entry.CreatedAt).FirstOrDefault() is { } entry && HasBackendLogHeader(entry);

    private string CurrentDurationWidth => DurationWidth(CurrentDuration);

    private string HoverBackendLogText => HoveredError is not null && HasBackendLogHeader(HoveredError)
        ? "Backend log header detected"
        : "No backend log header detected";

    private IReadOnlyList<ChatHistoryEntry> RecentErrors => Errors
        .OrderByDescending(entry => entry.CreatedAt)
        .Take(MaxRecentErrors)
        .ToList();

    private IReadOnlyList<ErrorBucket> Buckets => BuildBuckets();

    private int MaxBucketCount => Buckets.Count == 0 ? 0 : Buckets.Max(bucket => bucket.Count);

    private string BucketMinutesLabel { get; set; } = "recent activity";

    private int? WindowMinutesOverride { get; set; }

    private string WindowSelectValue => WindowMinutesOverride?.ToString(CultureInfo.InvariantCulture) ?? "auto";

    private void OnWindowChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        WindowMinutesOverride = int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var minutes)
            ? minutes
            : null;
    }

    private IReadOnlyList<ErrorBucket> BuildBuckets()
    {
        if (Errors.Count == 0)
        {
            BucketMinutesLabel = "recent activity";
            return Array.Empty<ErrorBucket>();
        }

        var now = DateTimeOffset.Now;

        var bucketCount = WindowMinutesOverride.HasValue ? 24 : BucketCount;
        double intervalMinutes;
        int windowMinutes;
        DateTimeOffset windowStart;
        if (WindowMinutesOverride is { } selectedWindow)
        {
            windowMinutes = selectedWindow;
            intervalMinutes = (double)selectedWindow / bucketCount;
            windowStart = now.AddMinutes(-selectedWindow);
        }
        else
        {
            var earliest = ResolveClusterStart(now);
            var spanMinutes = Math.Max(1.0, (now - earliest).TotalMinutes);
            var intervalInt = ChooseBucketIntervalMinutes(spanMinutes / bucketCount);
            intervalMinutes = intervalInt;
            windowMinutes = intervalInt * bucketCount;
            windowStart = now.AddMinutes(-windowMinutes);
        }

        var danger = new int[bucketCount];
        var warning = new int[bucketCount];
        var info = new int[bucketCount];
        var secondary = new int[bucketCount];
        foreach (var entry in Errors)
        {
            var offsetMinutes = (entry.CreatedAt - windowStart).TotalMinutes;
            if (offsetMinutes < 0)
            {
                continue; // older than the focused window (outlier) — excluded from the trend
            }

            var index = Math.Min((int)(offsetMinutes / intervalMinutes), bucketCount - 1);
            switch (CodeOf(entry))
            {
                case 429:
                    warning[index]++;
                    break;
                case >= 500:
                    danger[index]++;
                    break;
                case >= 400:
                    info[index]++;
                    break;
                default:
                    secondary[index]++;
                    break;
            }
        }

        BucketMinutesLabel = FormatWindowLabel(windowMinutes);
        var showDate = windowMinutes >= 1440;
        var showSeconds = intervalMinutes < 1;

        var buckets = new List<ErrorBucket>(bucketCount);
        for (var i = 0; i < bucketCount; i++)
        {
            var bucketStart = windowStart.AddMinutes(intervalMinutes * i).ToLocalTime();
            var label = showDate
                ? bucketStart.ToString("MM/dd HH:mm", CultureInfo.InvariantCulture)
                : showSeconds
                    ? bucketStart.ToString("HH:mm:ss", CultureInfo.InvariantCulture)
                    : bucketStart.ToString("HH:mm", CultureInfo.InvariantCulture);
            buckets.Add(new ErrorBucket(label, danger[i], warning[i], info[i], secondary[i]));
        }

        return buckets;
    }

    // Finds the start of the most recent contiguous cluster of errors, ignoring sparse old outliers
    // so a single days-old error cannot zoom the whole trend out and hide recent activity.
    private DateTimeOffset ResolveClusterStart(DateTimeOffset now)
    {
        var ordered = Errors.Select(entry => entry.CreatedAt).OrderByDescending(time => time).ToList();
        var newest = ordered[0];
        var clusterOldest = ordered[0];
        for (var i = 1; i < ordered.Count; i++)
        {
            var gapMinutes = (clusterOldest - ordered[i]).TotalMinutes;
            var clusterSpanMinutes = (newest - clusterOldest).TotalMinutes;
            var maxGapMinutes = Math.Max(30.0, clusterSpanMinutes * 4.0);
            if (gapMinutes > maxGapMinutes)
            {
                break;
            }

            clusterOldest = ordered[i];
        }

        return clusterOldest;
    }

    private static int ChooseBucketIntervalMinutes(double targetMinutes)
    {
        var niceIntervals = new[] { 1, 2, 5, 10, 15, 30, 60, 120, 180, 360, 720, 1440, 2880, 10080 };
        foreach (var interval in niceIntervals)
        {
            if (interval >= targetMinutes)
            {
                return interval;
            }
        }

        return niceIntervals[^1];
    }

    private static string FormatWindowLabel(int windowMinutes)
    {
        if (windowMinutes >= 1440)
        {
            return $"the last {windowMinutes / 1440.0:0.#} d";
        }

        if (windowMinutes >= 60)
        {
            return $"the last {windowMinutes / 60.0:0.#} h";
        }

        return $"the last {windowMinutes} min";
    }

    private static string FormatEntryStatus(ChatHistoryEntry entry)
    {
        var code = HistoryEntryFormatter.GetHistoryStatusCode(entry);
        return code?.ToString(CultureInfo.InvariantCulture) ?? (string.IsNullOrWhiteSpace(entry.Metrics.Status) ? "ERR" : entry.Metrics.Status);
    }

    private static string FormatEntrySummary(ChatHistoryEntry entry)
    {
        var normalized = NormalizeStatusMessage(entry.StatusMessage, entry.Metrics.Status);
        var tokens = normalized.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (tokens.Length >= 2 && int.TryParse(tokens[1], NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
        {
            return string.Join(' ', tokens.Skip(2));
        }

        if (tokens.Length >= 1 && int.TryParse(tokens[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
        {
            return string.Join(' ', tokens.Skip(1));
        }

        return normalized;
    }

    private static string FormatAge(DateTimeOffset value) => HistoryEntryFormatter.FormatHistoryAge(value);

    private static string FormatDuration(TimeSpan? value) =>
        value is null
            ? "No duration"
            : value.Value.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture) + " ms";

    private double MaxDurationMilliseconds => Errors
        .Select(entry => entry.Metrics.Duration?.TotalMilliseconds ?? 0)
        .Append(CurrentDuration?.TotalMilliseconds ?? 0)
        .DefaultIfEmpty(0)
        .Max();

    private string DurationWidth(TimeSpan? value)
    {
        var durationMilliseconds = value?.TotalMilliseconds ?? 0;
        if (durationMilliseconds <= 0 || MaxDurationMilliseconds <= 0)
        {
            return "0%";
        }

        var width = Math.Clamp(durationMilliseconds / MaxDurationMilliseconds * 100, 4, 100);
        return width.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static bool HasBackendLogHeader(ChatHistoryEntry entry) =>
        BackendLogDetector.ExtractFromHeaders(entry.ResponseHeadersText).Count > 0;

    private static string NormalizedEntryStatus(ChatHistoryEntry entry) =>
        NormalizeStatusMessage(entry.StatusMessage, entry.Metrics.Status);

    private static string NormalizeStatusMessage(string? statusMessage, string? fallbackStatus)
    {
        var candidate = string.IsNullOrWhiteSpace(statusMessage) ? fallbackStatus : statusMessage;
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return "Request failed";
        }

        var trimmed = candidate.Trim();
        if (trimmed.StartsWith("Completed with ", StringComparison.OrdinalIgnoreCase))
        {
            return "Status - " + trimmed[15..].Trim();
        }

        var completedWithIndex = trimmed.IndexOf(" completed with ", StringComparison.OrdinalIgnoreCase);
        if (completedWithIndex >= 0)
        {
            return "Status - " + trimmed[(completedWithIndex + 16)..].Trim();
        }

        if (trimmed.StartsWith("Status - ", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed;
        }

        return trimmed;
    }

    private void ShowErrorDetails(ChatHistoryEntry entry, MouseEventArgs args)
    {
        HoveredError = entry;
        MoveErrorDetails(args);
    }

    private void MoveErrorDetails(MouseEventArgs args)
    {
        HoverLeft = (args.ClientX + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
        HoverTop = (args.ClientY + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
    }

    private void HideErrorDetails()
    {
        HoveredError = null;
    }

    private void OpenErrorDetail(ChatHistoryEntry entry)
    {
        SelectedError = entry;
        SelectedErrorRawTab = HasBackendLogHeader(entry) ? "backend-log" : "response-body";
        SelectedErrorRawDisplayState = PanelDisplayState.Expanded;
    }

    private void CloseErrorDetail()
    {
        SelectedError = null;
    }

    private Task SetSelectedErrorRawTabAsync(string tab)
    {
        SelectedErrorRawTab = tab;
        return Task.CompletedTask;
    }

    private Task SetSelectedErrorRawDisplayStateAsync(PanelDisplayState state)
    {
        SelectedErrorRawDisplayState = state;
        return Task.CompletedTask;
    }

    private async Task SetDisplayStateAsync(PanelDisplayState state)
    {
        DisplayState = state;
        await DisplayStateChanged.InvokeAsync(state);
    }
}
