@namespace chat_tester.Components.Shared
@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json.Serialization
@inject IJSRuntime JS
@implements IDisposable

<div class="card shadow-sm error-result-card @CardStateCss">
    <div class="card-header bg-danger text-white @(IsMinimized ? string.Empty : "pb-2")">
        <div class="d-flex flex-wrap align-items-baseline gap-2 pt-1 pb-2">
            <span class="fw-semibold">@Title</span>
            <span class="text-white-50 small">@HeaderStatusMessage</span>
            <div class="d-flex flex-wrap align-items-center justify-content-end gap-2 ms-auto">
                <PanelDisplayToggle State="@DisplayState" StateChanged="SetDisplayStateAsync" AriaLabel="Toggle error panel full screen" />
            </div>
        </div>
    </div>
    @if (!IsMinimized)
    {
        <div class="card-body error-result-body @(IsFullscreen ? "d-flex flex-column overflow-hidden" : string.Empty)">
            <ErrorCurrentSummary AlertCss="@CurrentAlertCss"
                                 BadgeCss="@CurrentBadgeCss"
                                 BadgeText="@CurrentBadgeText"
                                 PrimaryText="@CurrentPrimaryText"
                                 StatusText="@HeaderStatusMessage"
                                 DurationText="@FormatDuration(CurrentDuration)"
                                 DurationWidth="@CurrentDurationWidth"
                                 SeverityCss="@CurrentSeverityCss"
                                 MessageText="@CurrentMessageText"
                                 HasBackendLogHeader="@CurrentHasBackendLogHeader"
                                 CurrentTime="@CurrentTime" />

            <div class="error-sections @(IsFullscreen ? "flex-grow-1 min-h-0" : string.Empty)">
                <ErrorTrendChart @ref="TrendChart"
                                 Buckets="@Buckets"
                                 MaxVisibleMiniCount="@MaxVisibleMiniCount"
                                 WindowSelectValue="@WindowSelectValue"
                                 WindowChanged="OnWindowChanged"
                                 TotalCountLabel="@($"{TotalErrorCount} {(ErrorsOnly ? "errors" : "calls")} · {BucketMinutesLabel}")"
                                 DisplayCount="@DisplayCount"
                                 ShowVisibleWindowOutline="@ShowVisibleWindowOutline"
                                 VisibleWindowLeft="@VisibleWindowLeft"
                                 VisibleWindowWidth="@VisibleWindowWidth" />

                <div class="error-recent-section d-flex flex-column min-h-0">
                    <div class="d-flex align-items-baseline justify-content-between mb-2">
                        <h6 class="mb-0">Recent Calls</h6>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="errorsOnlyToggle" checked="@ErrorsOnly" @onchange="OnErrorsOnlyChanged" />
                                <label class="form-check-label small" for="errorsOnlyToggle">Errors Only</label>
                            </div>
                            <span class="small text-muted">@DisplayCount total · click a row for raw exchange</span>
                        </div>
                    </div>

                    @if (DisplayCount == 0)
                    {
                        <div class="text-muted small">No entries in history.</div>
                    }
                    else
                    {
                        <div class="error-history-list fill" @ref="HistoryListRef" @onscroll="OnHistoryListScrolled">
                            @foreach (var entry in RecentErrors)
                            {
                                <button type="button"
                                        class="error-history-item @SeverityCss(entry)"
                                        @onclick="() => OpenErrorDetail(entry)"
                                        @onmouseenter="args => ShowErrorDetails(entry, args)"
                                        @onmousemove="MoveErrorDetails"
                                        @onmouseleave="HideErrorDetails">
                                    <span class="badge @BadgeCssForCode(CodeOf(entry)) error-history-badge">@FormatEntryStatus(entry)</span>
                                    <div class="flex-grow-1 min-w-0">
                                        <div class="error-row-line1">
                                            <span class="error-row-summary fw-semibold">@FormatEntrySummaryText(entry)</span>
                                            <span class="error-row-sep">|</span>
                                            <span class="error-row-url text-muted">@entry.Method @entry.EndpointPath</span>
                                            <span class="error-row-date text-muted">@FormatAlignedTimeText(entry.CreatedAt) · @FormatAlignedAgeText(entry.CreatedAt)</span>
                                        </div>
                                        <div class="error-history-meta-row compact">
                                            <div class="error-duration-thermometer @SeverityCss(entry)">
                                                <div class="error-duration-fill" style="width: @DurationWidth(entry.Metrics.Duration);"></div>
                                                <span class="error-duration-label">@DurationLabel(entry.Metrics.Duration)</span>
                                            </div>
                                            @if (HasBackendLogHeader(entry))
                                            {
                                                <span class="badge text-bg-light border text-danger-emphasis">Backend log</span>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (HoveredError is not null)
{
    <div class="error-hover-metrics" style="left: @HoverLeft; top: @HoverTop;">
        <div class="error-hover-card">
            <div class="small fw-semibold mb-2">@HoveredError.Method @HoveredError.EndpointPath</div>
            <ResponseMetricsPanel Status="@HoveredError.Metrics.Status"
                                  ContentType="@HoveredError.Metrics.ContentType"
                                  TimeToFirstByte="@HoveredError.Metrics.TimeToFirstByte"
                                  Duration="@HoveredError.Metrics.Duration"
                                  Chunks="@HoveredError.Metrics.Chunks"
                                  TotalBytes="@HoveredError.Metrics.TotalBytes" />
            <div class="small text-muted mt-2">@HoverBackendLogText</div>
        </div>
    </div>
}

@if (SelectedError is not null)
{
    <div class="multi-request-detail-backdrop" @onclick="CloseErrorDetail"></div>
    <div class="multi-request-detail" role="dialog" aria-modal="true" aria-label="Error request detail" @onclick:stopPropagation="true">
        <div class="multi-request-detail-header">
            <div>
                <div class="text-muted small text-uppercase fw-semibold">Error request</div>
                <div class="fw-semibold">@SelectedError.Method @SelectedError.EndpointPath</div>
                <div class="small text-muted">@SelectedError.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture) · @NormalizedEntryStatus(SelectedError)</div>
            </div>
            <button class="btn-close" type="button" aria-label="Close error detail" @onclick="CloseErrorDetail"></button>
        </div>
        <div class="multi-request-detail-body">
            <RawResponsePanel Title="Raw exchange"
                              StatusMessage="@FormatEntrySummaryText(SelectedError)"
                              ActiveTab="@SelectedErrorRawTab"
                              ActiveTabChanged="SetSelectedErrorRawTabAsync"
                              DisplayState="@SelectedErrorRawDisplayState"
                              DisplayStateChanged="SetSelectedErrorRawDisplayStateAsync"
                              RequestHeadersText="@SelectedError.RequestHeadersText"
                              ResponseHeadersText="@SelectedError.ResponseHeadersText"
                              RequestBodyDisplay="@SelectedError.RequestBody"
                              ObservedResponse="@SelectedError.ResponseBody"
                              HasProxyError="@SelectedError.HasProxyError" />
        </div>
    </div>
}

@code {
    private System.Threading.Timer? _autoScrollTimer;

    public void Dispose() => _autoScrollTimer?.Dispose();

    [Parameter]
    public string Title { get; set; } = "Error";

    [Parameter]
    public string StatusMessage { get; set; } = string.Empty;

    [Parameter]
    public string CurrentStatus { get; set; } = string.Empty;

    [Parameter]
    public string CurrentMessage { get; set; } = string.Empty;

    [Parameter]
    public DateTimeOffset? CurrentTime { get; set; }

    [Parameter]
    public TimeSpan? CurrentDuration { get; set; }

    [Parameter]
    public string CurrentRequestUrl { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ChatHistoryEntry> Errors { get; set; } = Array.Empty<ChatHistoryEntry>();

    [Parameter]
    public IReadOnlyList<ChatHistoryEntry> AllEntries { get; set; } = Array.Empty<ChatHistoryEntry>();

    [Parameter]
    public PanelDisplayState DisplayState { get; set; } = PanelDisplayState.Expanded;

    [Parameter]
    public EventCallback<PanelDisplayState> DisplayStateChanged { get; set; }

    private bool ErrorsOnly { get; set; } = true;

    private ChatHistoryEntry? HoveredError { get; set; }

    private ChatHistoryEntry? SelectedError { get; set; }

    private string SelectedErrorRawTab { get; set; } = "response-body";

    private PanelDisplayState SelectedErrorRawDisplayState { get; set; } = PanelDisplayState.Expanded;

    private string HoverLeft { get; set; } = "0px";

    private string HoverTop { get; set; } = "0px";

    private ElementReference HistoryListRef;

    private ErrorTrendChart? TrendChart;

    private bool NeedsVisibleWindowSync { get; set; } = true;

    private double VisibleWindowLeftPercent { get; set; }

    private double VisibleWindowWidthPercent { get; set; } = 100;

    private DateTimeOffset TrendWindowStart { get; set; }

    private DateTimeOffset TrendWindowEnd { get; set; }

    private sealed class ScrollMetrics
    {
        [JsonPropertyName("scrollTop")]
        public double ScrollTop { get; set; }

        [JsonPropertyName("clientHeight")]
        public double ClientHeight { get; set; }

        [JsonPropertyName("scrollHeight")]
        public double ScrollHeight { get; set; }
    }

    private static int? CodeOf(ChatHistoryEntry entry) => HistoryEntryFormatter.GetHistoryStatusCode(entry);

    private static int? ParseCode(string status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return null;
        }

        var token = status.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        return int.TryParse(token, NumberStyles.Integer, CultureInfo.InvariantCulture, out var code) ? code : null;
    }

    private static string BadgeCssForCode(int? code) => code switch
    {
        429 => "text-bg-warning",
        >= 500 => "text-bg-danger",
        >= 400 => "text-bg-info",
        >= 200 and < 300 => "text-bg-success",
        _ => "text-bg-secondary"
    };

    private static string SeverityCss(ChatHistoryEntry entry) => CodeOf(entry) switch
    {
        429 => "sev-warning",
        >= 500 => "sev-danger",
        >= 400 => "sev-info",
        >= 200 and < 300 => "sev-success",
        _ => "sev-secondary"
    };

    private bool IsMinimized => DisplayState == PanelDisplayState.Minimized;

    private bool IsFullscreen => DisplayState == PanelDisplayState.Fullscreen;

    private string CardStateCss => DisplayState switch
    {
        PanelDisplayState.Minimized => "panel-minimized",
        PanelDisplayState.Fullscreen => "fs-overlay",
        _ => string.Empty
    };

    private string CurrentStatusText => string.IsNullOrWhiteSpace(CurrentStatus) ? "Failed" : CurrentStatus.Trim();

    private int? CurrentCode => ParseCode(CurrentStatus);

    private string CurrentBadgeText => CurrentCode?.ToString(CultureInfo.InvariantCulture) ?? CurrentStatusText;

    private string CurrentBadgeCss => CurrentCode is null ? "text-bg-danger" : BadgeCssForCode(CurrentCode);

    private string CurrentSeverityCss => CurrentCode switch
    {
        429 => "sev-warning",
        >= 500 => "sev-danger",
        >= 400 => "sev-info",
        _ => "sev-secondary"
    };

    private string CurrentAlertCss => CurrentCode switch
    {
        429 => "alert-warning",
        >= 500 => "alert-danger",
        >= 400 => "alert-info",
        _ => "alert-danger"
    };

    private int TotalErrorCount => Buckets.Sum(bucket => bucket.Count);

    private int DisplayCount => DisplayEntries.Count;

    private string CurrentMessageText => string.IsNullOrWhiteSpace(CurrentMessage)
        ? "The request did not complete successfully."
        : CurrentMessage.Trim();

    private string HeaderStatusMessage => CompactStatusText(StatusMessage, CurrentStatus);

    private string CurrentPrimaryText => string.IsNullOrWhiteSpace(CurrentRequestUrl)
        ? CompactStatusText(StatusMessage, CurrentStatus)
        : CurrentRequestUrl.Trim();

    private bool CurrentHasBackendLogHeader => Errors.OrderByDescending(entry => entry.CreatedAt).FirstOrDefault() is { } entry && HasBackendLogHeader(entry);

    private string CurrentDurationWidth => DurationWidth(CurrentDuration);

    private string HoverBackendLogText => HoveredError is not null && HasBackendLogHeader(HoveredError)
        ? "Backend log header detected"
        : "No backend log header detected";

    private IReadOnlyList<ChatHistoryEntry> DisplayEntries =>
        ErrorsOnly
            ? Errors
            : (AllEntries.Count > 0 ? AllEntries : Errors);

    private IReadOnlyList<ChatHistoryEntry> RecentErrors => DisplayEntries
        .OrderByDescending(entry => entry.CreatedAt)
        .ToList();

    private ErrorTrendBuildResult Trend => ErrorTrendBuilder.Build(DisplayEntries, ErrorsOnly, WindowMinutesOverride, DateTimeOffset.Now);

    private IReadOnlyList<ErrorTrendBucket> Buckets => Trend.Buckets;

    private int MaxBucketCount => Buckets.Count == 0 ? 0 : Buckets.Max(bucket => bucket.Count);

    private int MaxVisibleMiniCount => Buckets.Count == 0
        ? 0
        : Buckets.SelectMany(bucket => bucket.Minis).DefaultIfEmpty().Max(mini => mini?.Count ?? 0);

    private bool ChartReversed => true;

    private bool ShowVisibleWindowOutline =>
        DisplayCount > 1 && TrendWindowEnd > TrendWindowStart;

    private string VisibleWindowLeft => VisibleWindowLeftPercent.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private string VisibleWindowWidth => VisibleWindowWidthPercent.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private string BucketMinutesLabel => Trend.WindowLabel;

    private double CurrentAlignmentSeconds => Trend.AlignmentSeconds;

    private int? WindowMinutesOverride { get; set; }

    private string WindowSelectValue => WindowMinutesOverride?.ToString(CultureInfo.InvariantCulture) ?? "auto";

    private void OnWindowChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        WindowMinutesOverride = int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var minutes)
            ? minutes
            : null;
        NeedsVisibleWindowSync = true;
    }

    private static string FormatEntryStatus(ChatHistoryEntry entry)
    {
        var code = HistoryEntryFormatter.GetHistoryStatusCode(entry);
        return code?.ToString(CultureInfo.InvariantCulture) ?? (string.IsNullOrWhiteSpace(entry.Metrics.Status) ? "ERR" : entry.Metrics.Status);
    }

    private static string FormatDuration(TimeSpan? value) =>
        value is null
            ? "No duration"
            : value.Value.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture) + " ms";

    private static string DurationLabel(TimeSpan? value) =>
        value is null
            ? string.Empty
            : value.Value.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture) + " ms";

    private double MaxDurationMilliseconds => DisplayEntries
        .Select(entry => entry.Metrics.Duration?.TotalMilliseconds ?? 0)
        .Append(CurrentDuration?.TotalMilliseconds ?? 0)
        .DefaultIfEmpty(0)
        .Max();

    private void OnErrorsOnlyChanged(ChangeEventArgs args)
    {
        ErrorsOnly = args.Value is bool flag && flag;
        NeedsVisibleWindowSync = true;
    }

    protected override void OnParametersSet()
    {
        NeedsVisibleWindowSync = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _autoScrollTimer = new System.Threading.Timer(
                _ => InvokeAsync(async () =>
                {
                    try
                    {
                        // Rebuild the chart with the current time so bars shift forward
                        NeedsVisibleWindowSync = true;
                        StateHasChanged();
                        await JS.InvokeVoidAsync("errorPanel.autoScrollToNewest", TrendChart?.ScrollContainerRef ?? default);
                    }
                    catch (JSException) { }
                }),
                null,
                TimeSpan.FromSeconds(10),
                TimeSpan.FromSeconds(10));
        }

        if (NeedsVisibleWindowSync)
        {
            await SyncVisibleWindowAsync();
        }
    }

    private async Task OnHistoryListScrolled()
    {
        await SyncVisibleWindowAsync();
    }

    private async Task SyncVisibleWindowAsync()
    {
        NeedsVisibleWindowSync = false;
        if (RecentErrors.Count <= 1)
        {
            VisibleWindowLeftPercent = 0;
            VisibleWindowWidthPercent = 100;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var metrics = await JS.InvokeAsync<ScrollMetrics?>("errorPanel.getScrollMetrics", HistoryListRef);
            if (metrics is null || metrics.ScrollHeight <= 0)
            {
                return;
            }

            UpdateVisibleWindowFromMetrics(metrics);
            await JS.InvokeVoidAsync("errorPanel.scrollOutlineIntoView", TrendChart?.ScrollContainerRef ?? default, VisibleWindowLeftPercent / 100.0, VisibleWindowWidthPercent / 100.0);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            // Ignore during prerender/disconnect.
        }
    }

    private string FormatEntrySummaryText(ChatHistoryEntry entry) =>
        ErrorTimelineFormatter.FormatEntrySummary(entry);

    private string FormatAlignedTimeText(DateTimeOffset value) =>
        ErrorTimelineFormatter.FormatAlignedTime(value, CurrentAlignmentSeconds);

    private string FormatAlignedAgeText(DateTimeOffset value) =>
        ErrorTimelineFormatter.FormatAlignedAge(value, CurrentAlignmentSeconds, DateTimeOffset.Now);

    private static string CompactStatusText(string? statusMessage, string? fallbackStatus) =>
        ErrorTimelineFormatter.CompactStatusText(statusMessage, fallbackStatus);

    private void UpdateVisibleWindowFromMetrics(ScrollMetrics metrics)
    {
        (VisibleWindowLeftPercent, VisibleWindowWidthPercent) = VisibleWindowCalculator.Calculate(
            RecentErrors.Count,
            metrics.ScrollTop,
            metrics.ClientHeight,
            metrics.ScrollHeight,
            RecentErrors,
            Trend.WindowStart,
            Trend.WindowEnd,
            newestFirst: true);
    }

    private string DurationWidth(TimeSpan? value)
    {
        var durationMilliseconds = value?.TotalMilliseconds ?? 0;
        if (durationMilliseconds <= 0 || MaxDurationMilliseconds <= 0)
        {
            return "0%";
        }

        var width = Math.Clamp(durationMilliseconds / MaxDurationMilliseconds * 100, 4, 100);
        return width.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static bool HasBackendLogHeader(ChatHistoryEntry entry) =>
        BackendLogDetector.ExtractFromHeaders(entry.ResponseHeadersText).Count > 0;

    private static string NormalizedEntryStatus(ChatHistoryEntry entry) =>
        CompactStatusText(entry.StatusMessage, entry.Metrics.Status);

    private void ShowErrorDetails(ChatHistoryEntry entry, MouseEventArgs args)
    {
        HoveredError = entry;
        MoveErrorDetails(args);
    }

    private void MoveErrorDetails(MouseEventArgs args)
    {
        HoverLeft = (args.ClientX + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
        HoverTop = (args.ClientY + 16).ToString("0", CultureInfo.InvariantCulture) + "px";
    }

    private void HideErrorDetails()
    {
        HoveredError = null;
    }

    private void OpenErrorDetail(ChatHistoryEntry entry)
    {
        SelectedError = entry;
        SelectedErrorRawTab = HasBackendLogHeader(entry) ? "backend-log" : "response-body";
        SelectedErrorRawDisplayState = PanelDisplayState.Expanded;
    }

    private void CloseErrorDetail()
    {
        SelectedError = null;
    }

    private Task SetSelectedErrorRawTabAsync(string tab)
    {
        SelectedErrorRawTab = tab;
        return Task.CompletedTask;
    }

    private Task SetSelectedErrorRawDisplayStateAsync(PanelDisplayState state)
    {
        SelectedErrorRawDisplayState = state;
        return Task.CompletedTask;
    }

    private async Task SetDisplayStateAsync(PanelDisplayState state)
    {
        DisplayState = state;
        await DisplayStateChanged.InvokeAsync(state);
    }
}
