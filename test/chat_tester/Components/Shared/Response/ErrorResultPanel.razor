    private string BucketMinutesLabel { get; set; } = "recent activity";

    private int? WindowMinutesOverride { get; set; }

    private string WindowSelectValue => WindowMinutesOverride?.ToString(CultureInfo.InvariantCulture) ?? "auto";

    private void OnWindowChanged(ChangeEventArgs args)
    {
        var value = args.Value?.ToString();
        WindowMinutesOverride = int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var minutes)
            ? minutes
            : null;
        NeedsVisibleWindowSync = true;
    }

    private IReadOnlyList<ErrorBucket> BuildBuckets()
    {
        if (DisplayEntries.Count == 0)
        {
            BucketMinutesLabel = "recent activity";
            return Array.Empty<ErrorBucket>();
        }

        var now = DateTimeOffset.Now;

        var bucketCount = WindowMinutesOverride.HasValue
            ? ChooseBucketCount(WindowMinutesOverride.Value)
            : BucketCount;
        double intervalMinutes;
        int windowMinutes;
        DateTimeOffset windowStart;
        if (WindowMinutesOverride is { } selectedWindow)
        {
            windowMinutes = selectedWindow;
            intervalMinutes = (double)selectedWindow / bucketCount;
            windowStart = now.AddMinutes(-selectedWindow);
        }
        else
        {
            var earliest = ErrorsOnly
                ? ResolveClusterStart(now)
                : DisplayEntries.Min(entry => entry.CreatedAt);
            var spanMinutes = Math.Max(1.0, (now - earliest).TotalMinutes);
            var intervalInt = ChooseBucketIntervalMinutes(spanMinutes / bucketCount);
            intervalMinutes = intervalInt;
            windowMinutes = intervalInt * bucketCount;
            windowStart = now.AddMinutes(-windowMinutes);
        }

        TrendWindowStart = windowStart;
        TrendWindowEnd = now;
        BucketMinutesLabel = FormatWindowLabel(windowMinutes);

        // Each slot is subdivided into SubBucketCount mini-buckets for finer resolution
        double subMinutes = intervalMinutes / SubBucketCount;
        int totalMinis = bucketCount * SubBucketCount;

        var danger   = new int[totalMinis];
        var warning  = new int[totalMinis];
        var info     = new int[totalMinis];
        var success  = new int[totalMinis];
        var secondary = new int[totalMinis];
        foreach (var entry in DisplayEntries)
        {
            var offsetMinutes = (entry.CreatedAt - windowStart).TotalMinutes;
            if (offsetMinutes < 0) continue;
            var idx = Math.Min((int)(offsetMinutes / subMinutes), totalMinis - 1);
            switch (CodeOf(entry))
            {
                case 429:             warning[idx]++;   break;
                case >= 500:          danger[idx]++;    break;
                case >= 400:          info[idx]++;      break;
                case >= 200 and < 300: success[idx]++;  break;
                default:              secondary[idx]++; break;
            }
        }

        var buckets = new List<ErrorBucket>(bucketCount);
        for (var s = 0; s < bucketCount; s++)
        {
            // Label: distance back from "now" (rendered newest-left so label reads as negative offset)
            var backMinutes = (bucketCount - 1 - s) * intervalMinutes;
            string label;
            if (s == bucketCount - 1)
                label = "now";
            else if (intervalMinutes < 1)
                label = $"-{(int)Math.Round(backMinutes * 60)}s";
            else if (intervalMinutes < 60)
                label = $"-{(int)Math.Round(backMinutes)}m";
            else if (intervalMinutes < 1440)
                label = $"-{(int)Math.Round(backMinutes / 60)}h";
            else
                label = $"-{(int)Math.Round(backMinutes / 1440)}d";

            var slotBase = s * SubBucketCount;
            var sd = 0; var sw = 0; var si = 0; var ss = 0; var sc = 0;
            var minis = new List<ErrorMini>(SubBucketCount);
            for (var m = 0; m < SubBucketCount; m++)
            {
                var mi = slotBase + m;
                sd += danger[mi]; sw += warning[mi]; si += info[mi]; ss += success[mi]; sc += secondary[mi];
                minis.Add(new ErrorMini(danger[mi], warning[mi], info[mi], success[mi], secondary[mi]));
            }
            buckets.Add(new ErrorBucket(label, sd, sw, si, ss, sc, minis));
        }

        return buckets;
    }

    // Finds the start of the most recent contiguous cluster of errors, ignoring sparse old outliers
    // so a single days-old error cannot zoom the whole trend out and hide recent activity.
    private DateTimeOffset ResolveClusterStart(DateTimeOffset now)
    {
        var ordered = DisplayEntries.Select(entry => entry.CreatedAt).OrderByDescending(time => time).ToList();
        var newest = ordered[0];
        var clusterOldest = ordered[0];
        for (var i = 1; i < ordered.Count; i++)
        {
            var gapMinutes = (clusterOldest - ordered[i]).TotalMinutes;
            var clusterSpanMinutes = (newest - clusterOldest).TotalMinutes;
            var maxGapMinutes = Math.Max(30.0, clusterSpanMinutes * 4.0);
            if (gapMinutes > maxGapMinutes)
            {
                break;
            }

            clusterOldest = ordered[i];
        }

        return clusterOldest;
    }

    private static int ChooseBucketCount(int windowMinutes) => windowMinutes switch
    {
        <= 5 => 12,
        <= 10 => 12,
        <= 30 => 12,
        <= 60 => 12,
        <= 360 => 12,
        <= 1440 => 24,   // 24h → 24 × 1h slots
        <= 10080 => 7,   // 7d → 7 × 1d slots
        _ => 30          // 30d → 30 × 1d slots
    };

    private static int ChooseBucketIntervalMinutes(double targetMinutes)
    {
        var niceIntervals = new[] { 1, 2, 5, 10, 15, 30, 60, 120, 180, 360, 720, 1440, 2880, 10080 };
        foreach (var interval in niceIntervals)
        {
            if (interval >= targetMinutes)
            {
                return interval;
            }
        }

        return niceIntervals[^1];
    }

    private static string FormatWindowLabel(int windowMinutes)
    {
        if (windowMinutes >= 43200) return $"the last {windowMinutes / 43200.0:0.#} mo";
        if (windowMinutes >= 1440)  return $"the last {windowMinutes / 1440.0:0.#} d";
        if (windowMinutes >= 60)    return $"the last {windowMinutes / 60.0:0.#} h";
        return $"the last {windowMinutes} min";
    }

    private static string FormatEntryStatus(ChatHistoryEntry entry)
    {
        var code = HistoryEntryFormatter.GetHistoryStatusCode(entry);
        return code?.ToString(CultureInfo.InvariantCulture) ?? (string.IsNullOrWhiteSpace(entry.Metrics.Status) ? "ERR" : entry.Metrics.Status);
    }

    private static string FormatEntrySummary(ChatHistoryEntry entry)
    {
        var normalized = CompactStatusText(entry.StatusMessage, entry.Metrics.Status);
        var tokens = normalized.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (tokens.Length >= 1 && int.TryParse(tokens[0], NumberStyles.Integer, CultureInfo.InvariantCulture, out _))
        {
            return string.Join(' ', tokens.Skip(1));
        }

        return normalized;
    }

    private static string FormatAge(DateTimeOffset value)
    {
        var age = DateTimeOffset.Now - value;
        if (age.TotalMinutes < 1)
        {
            return "now";
        }

        if (age.TotalHours < 1)
        {
            return $"{Math.Max(1, (int)Math.Floor(age.TotalMinutes))}m ago";
        }

        if (age.TotalDays < 1)
        {
            return $"{Math.Max(1, (int)Math.Floor(age.TotalHours))}h ago";
        }

        if (age.TotalDays < 30)
        {
            return $"{Math.Max(1, (int)Math.Floor(age.TotalDays))}d ago";
        }

        return $"{Math.Max(1, (int)Math.Floor(age.TotalDays / 30))}mo ago";
    }

    private static string FormatDuration(TimeSpan? value) =>
        value is null
            ? "No duration"
            : value.Value.TotalMilliseconds.ToString("0", CultureInfo.InvariantCulture) + " ms";

    private static string DurationLabel(TimeSpan? value) =>
