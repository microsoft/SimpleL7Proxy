    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _autoScrollTimer = new System.Threading.Timer(
                _ => InvokeAsync(async () =>
                {
                    try
                    {
                        // Rebuild the chart with the current time so bars shift forward
                        NeedsVisibleWindowSync = true;
                        StateHasChanged();
                        await JS.InvokeVoidAsync("errorPanel.autoScrollToNewest", TrendScrollRef);
                    }
                    catch (JSException) { }
                }),
                null,
                TimeSpan.FromSeconds(10),
                TimeSpan.FromSeconds(10));
        }

        if (NeedsVisibleWindowSync)
        {
            await SyncVisibleWindowAsync();
        }
    }

    private async Task OnHistoryListScrolled()
    {
        await SyncVisibleWindowAsync();
    }

    private async Task SyncVisibleWindowAsync()
    {
        NeedsVisibleWindowSync = false;
        if (RecentErrors.Count <= 1)
        {
            VisibleWindowLeftPercent = 0;
            VisibleWindowWidthPercent = 100;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var metrics = await JS.InvokeAsync<ScrollMetrics?>("errorPanel.getScrollMetrics", HistoryListRef);
            if (metrics is null || metrics.ScrollHeight <= 0)
            {
                return;
            }

            UpdateVisibleWindowFromMetrics(metrics);
            await JS.InvokeVoidAsync("errorPanel.scrollOutlineIntoView", TrendScrollRef, VisibleWindowLeftPercent / 100.0, VisibleWindowWidthPercent / 100.0);
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            // Ignore during prerender/disconnect.
        }
    }

    private void UpdateVisibleWindowFromMetrics(ScrollMetrics metrics)
    {
        var count = RecentErrors.Count;
        if (count <= 1)
        {
            VisibleWindowLeftPercent = 0;
            VisibleWindowWidthPercent = 100;
            return;
        }

        var maxScroll = Math.Max(1.0, metrics.ScrollHeight - metrics.ClientHeight);
        var topRatio = Math.Clamp(metrics.ScrollTop / maxScroll, 0, 1);
        var bottomRatio = Math.Clamp((metrics.ScrollTop + metrics.ClientHeight) / Math.Max(1.0, metrics.ScrollHeight), 0, 1);

        var newestIndex = Math.Clamp((int)Math.Floor(topRatio * (count - 1)), 0, count - 1);
        var oldestIndex = Math.Clamp((int)Math.Ceiling(bottomRatio * (count - 1)), newestIndex, count - 1);

        var newestVisible = RecentErrors[newestIndex].CreatedAt;
        var oldestVisible = RecentErrors[oldestIndex].CreatedAt;
        var span = (TrendWindowEnd - TrendWindowStart).TotalMilliseconds;
        if (span <= 0)
        {
            VisibleWindowLeftPercent = 0;
            VisibleWindowWidthPercent = 100;
            return;
        }

        var left  = Math.Clamp((oldestVisible  - TrendWindowStart).TotalMilliseconds / span, 0, 1);
        var right = Math.Clamp((newestVisible  - TrendWindowStart).TotalMilliseconds / span, 0, 1);

        var baseLeft  = Math.Min(left, right) * 100;
        var baseWidth = Math.Max(0.8, Math.Abs(right - left) * 100);

        // Chart renders newest-first (left), so invert the horizontal position:
        VisibleWindowLeftPercent  = 100.0 - (baseLeft + baseWidth);
        VisibleWindowWidthPercent = baseWidth;
    }

    private string DurationWidth(TimeSpan? value)
    {
        var durationMilliseconds = value?.TotalMilliseconds ?? 0;
        if (durationMilliseconds <= 0 || MaxDurationMilliseconds <= 0)
        {
            return "0%";
        }

        var width = Math.Clamp(durationMilliseconds / MaxDurationMilliseconds * 100, 4, 100);
        return width.ToString("0.##", CultureInfo.InvariantCulture) + "%";
    }

    private static bool HasBackendLogHeader(ChatHistoryEntry entry) =>
        BackendLogDetector.ExtractFromHeaders(entry.ResponseHeadersText).Count > 0;

    private static string NormalizedEntryStatus(ChatHistoryEntry entry) =>
        CompactStatusText(entry.StatusMessage, entry.Metrics.Status);

    private static string CompactStatusText(string? statusMessage, string? fallbackStatus)
    {
        var candidate = string.IsNullOrWhiteSpace(statusMessage) ? fallbackStatus : statusMessage;
        if (string.IsNullOrWhiteSpace(candidate))
        {
            return "Failed";
        }

        var trimmed = candidate.Trim();
        if (trimmed.StartsWith("Completed with ", StringComparison.OrdinalIgnoreCase))
        {
            return trimmed[15..].Trim();
        }

        var completedWithIndex = trimmed.IndexOf(" completed with ", StringComparison.OrdinalIgnoreCase);
        if (completedWithIndex >= 0)
        {
            return trimmed[(completedWithIndex + 16)..].Trim();
        }

        return trimmed;
    }

