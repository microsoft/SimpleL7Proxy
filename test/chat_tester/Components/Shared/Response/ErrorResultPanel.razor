@code {
    private const int BucketCount = 12;
    private const int SubBucketCount = 10;

    private System.Threading.Timer? _autoScrollTimer;

    public void Dispose() => _autoScrollTimer?.Dispose();

    private sealed record ErrorSegment(string Css, int Count, int Percent);

    private sealed record ErrorMini(int Danger, int Warning, int Info, int Success, int Secondary)
    {
        public int Count => Danger + Warning + Info + Success + Secondary;

        public IReadOnlyList<ErrorSegment> Segments
        {
            get
            {
                var total = Count;
                if (total == 0) return Array.Empty<ErrorSegment>();
                return new[] { ("sev-danger", Danger), ("sev-warning", Warning), ("sev-info", Info), ("sev-success", Success), ("sev-secondary", Secondary) }
                    .Where(c => c.Item2 > 0)
                    .Select(c => new ErrorSegment(c.Item1, c.Item2, (int)Math.Round(c.Item2 * 100.0 / total)))
                    .ToList();
            }
        }
    }

    private sealed record ErrorBucket(string Label, int Danger, int Warning, int Info, int Success, int Secondary, IReadOnlyList<ErrorMini> Minis)
    {
        public int Count => Danger + Warning + Info + Success + Secondary;
        public int MaxMiniCount => Minis.Count == 0 ? 0 : Minis.Max(m => m.Count);

        public IReadOnlyList<ErrorSegment> Segments
        {
            get
            {
                var total = Count;
                if (total == 0)
                {
                    return Array.Empty<ErrorSegment>();
                }

                var categories = new[]
                {
                    ("sev-danger", Danger),
                    ("sev-warning", Warning),
                    ("sev-info", Info),
                    ("sev-success", Success),
                    ("sev-secondary", Secondary)
                };

                return categories
                    .Where(category => category.Item2 > 0)
                    .Select(category => new ErrorSegment(category.Item1, category.Item2, (int)Math.Round(category.Item2 * 100.0 / total)))
                    .ToList();
            }
        }

        public string Tooltip
        {
            get
            {
                if (Count == 0)
                {
                    return $"{Label}: no activity";
                }

                var parts = new List<string>();
                if (Danger > 0) parts.Add($"{Danger} 5xx");
                if (Warning > 0) parts.Add($"{Warning} 429");
                if (Info > 0) parts.Add($"{Info} 4xx");
                if (Success > 0) parts.Add($"{Success} 2xx");
                if (Secondary > 0) parts.Add($"{Secondary} other");
                return $"{Label}: {string.Join(", ", parts)}";
            }
        }
    }

