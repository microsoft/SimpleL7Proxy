        {
            SetError(string.IsNullOrWhiteSpace(entry.Metrics.Status) ? "Failed" : entry.Metrics.Status,
                string.IsNullOrWhiteSpace(entry.DisplayResponse) ? entry.ResponseBody : entry.DisplayResponse);
            ErrorTimestamp = entry.CreatedAt;
        }
        else
        {
            HasError = false;
        }

        ActiveResultTab = SummaryResultTab;
        EnsureActiveResultTab();
        ShowResultPanelAfterResponse();

        return Task.CompletedTask;
    }

