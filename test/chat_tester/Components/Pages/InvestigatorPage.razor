    private void OnFeatureChanged(string feature, bool isSelected)
    {
        var features = GetCurrentFeatures().ToList();
        if (isSelected && !features.Contains(feature, StringComparer.OrdinalIgnoreCase))
        {
            features.Add(feature);
        }
        else if (!isSelected)
        {
            features.RemoveAll(item => string.Equals(item, feature, StringComparison.OrdinalIgnoreCase));
        }

        SetFeatures(features);
    }

    private void OnAdditionalFeaturesChanged(string text)
    {
        var selectedKnownFeatures = GetCurrentFeatures().Where(IsKnownFeature);
        var additionalFeatures = ParseFeatureList(text).Where(feature => !IsKnownFeature(feature));
        SetFeatures(selectedKnownFeatures.Concat(additionalFeatures));
    }

