    private bool ValidateImageInput()
    {
        if (UseCustomJson || IsChatApi)
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(EffectiveImageUrl))
        {
            StatusMessage = "Select an image before sending the request.";
            return false;
        }

        if (VisionCatalog.RequiresExternalImageUrl(SelectedApi) && EffectiveImageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            StatusMessage = "Azure AI Vision Image Analysis expects an externally reachable image URL.";
            return false;
        }

        if (VisionCatalog.RequiresBase64Image(SelectedApi) && string.IsNullOrWhiteSpace(ResolveImageBase64()))
        {
            StatusMessage = "This API expects an uploaded image or data URL image.";
            return false;
        }

        return true;
    }

    private async Task StreamResponseAsync(HttpResponseMessage response, Stopwatch stopwatch, CancellationToken cancellationToken)
    {
        var rawBuilder = new StringBuilder();
        var displayBuilder = new StringBuilder();
        SetVisionResultMessage(string.Empty);
        ObservedResponse = string.Empty;

        using var stream = await response.Content.ReadAsStreamAsync(cancellationToken);
        using var reader = new StreamReader(stream);
        while (await reader.ReadLineAsync(cancellationToken) is { } line)
        {
            ResponseMetrics.Chunks++;
            ResponseMetrics.TotalBytes += Encoding.UTF8.GetByteCount(line) + 1;
            rawBuilder.AppendLine(line);
            ObservedResponse = rawBuilder.ToString();

            var payload = ChatStreamParser.ExtractDataPayload(line);
            if (payload is not null)
            {
                var piece = ChatStreamParser.ExtractDeltaText(payload);
                if (!string.IsNullOrEmpty(piece))
                {
                    displayBuilder.Append(piece);
                    DisplayResponse = displayBuilder.ToString();
                    VisionResult = VisionResponseParser.BuildPlainVisionResult(DisplayResponse);
                    EnsureActiveResultTab();
                }
            }

            ResponseMetrics.Duration = stopwatch.Elapsed;
            await InvokeAsync(StateHasChanged);
        }

        if (rawBuilder.Length == 0)
        {
            ObservedResponse = "The server returned an empty response body.";
            SetVisionResultMessage("I did not receive any content from the server.");
        }
        else if (string.IsNullOrWhiteSpace(DisplayResponse))
        {
            SetVisionResultFromObserved(rawBuilder.ToString());
        }
    }

    private async Task ReadBufferedResponseAsync(HttpResponseMessage response, Stopwatch stopwatch, CancellationToken cancellationToken)
    {
        var body = await response.Content.ReadAsStringAsync(cancellationToken);
        ResponseMetrics.Chunks = string.IsNullOrEmpty(body) ? 0 : 1;
        ResponseMetrics.TotalBytes = Encoding.UTF8.GetByteCount(body);
        ResponseMetrics.Duration = stopwatch.Elapsed;
        ObservedResponse = string.IsNullOrWhiteSpace(body) ? "The server returned an empty response body." : body;
        SetVisionResultFromObserved(ObservedResponse);
    }

    private async Task RunMetricsTimerAsync(Stopwatch stopwatch, CancellationToken cancellationToken, VisionResponseMetrics metrics, MultiRequestStatusItem? statusItem = null)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            metrics.Duration = stopwatch.Elapsed;
            if (statusItem is not null)
            {
                statusItem.Duration = metrics.Duration;
                statusItem.TimeToFirstByte = metrics.TimeToFirstByte;
                statusItem.Chunks = metrics.Chunks;
                statusItem.TotalBytes = metrics.TotalBytes;
            }

            await InvokeAsync(StateHasChanged);
            await Task.Delay(100, cancellationToken);
        }
    }

    private string BuildGeneratedRequestBody()
    {
        if (IsChatApi)
        {
            return ChatCatalog.BuildRequestBody(new ChatRequestBuildContext
            {
                ApiId = SelectedApi,
                ModelId = SelectedModel,
                Prompt = Prompt,
                Fields = FieldValues
            });
        }

        return VisionCatalog.BuildRequestBody(new VisionRequestBuildContext
        {
            ApiId = SelectedApi,
            ModelId = SelectedModel,
            Prompt = Prompt,
            ImageUrl = EffectiveImageUrl,
            ImageBase64 = ResolveImageBase64(),
            ImageMimeType = ResolveImageMimeType(),
            Fields = FieldValues
        });
    }

    private string ResolveImageBase64()
    {
        if (!string.IsNullOrWhiteSpace(ImageBase64))
        {
            return ImageBase64;
        }

        return TryParseDataUrl(EffectiveImageUrl, out _, out var data) ? data : string.Empty;
    }

    private string ResolveImageMimeType()
    {
        if (TryParseDataUrl(EffectiveImageUrl, out var mimeType, out _))
        {
            return mimeType;
        }

        return string.IsNullOrWhiteSpace(ImageMimeType) ? "image/jpeg" : ImageMimeType;
    }

    private void EnsureSelectedApi(string? preferredApi = null)
    {
        var apis = AvailableApiOptions;
        if (!string.IsNullOrWhiteSpace(SelectedApi) && apis.Any(api => string.Equals(api.Id, SelectedApi, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        SelectedApi = apis.FirstOrDefault(api => string.Equals(api.Id, preferredApi, StringComparison.OrdinalIgnoreCase))?.Id
            ?? apis.FirstOrDefault()?.Id
            ?? string.Empty;
    }

