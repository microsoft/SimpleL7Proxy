    private IReadOnlyList<BlendedModelOption> FilteredModels
    {
        get
        {
            var query = ModelFilter?.Trim() ?? string.Empty;
            if (query.Length == 0 || query == "*")
            {
                return BlendedModels;
            }

            return BlendedModels
                .Where(model => model.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || model.Provider.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || model.Id.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private IReadOnlyList<ApiOption> AvailableApiOptions
    {
        get
        {
            var options = new List<ApiOption>();
            var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var api in ChatCatalog.ApisForModel(SelectedModel))
            {
                if (seen.Add(api.Id))
                {
                    options.Add(new ApiOption(api.Id, api.DisplayName, "Chat"));
                }
            }

            foreach (var api in VisionCatalog.ApisForModel(SelectedModel))
            {
                if (seen.Add(api.Id))
                {
                    options.Add(new ApiOption(api.Id, api.DisplayName, "Vision"));
                }
            }

            return options;
        }
    }

    private IReadOnlyList<BlendedModelOption> BuildBlendedModels()
    {
        var byId = new Dictionary<string, BlendedModelOption>(StringComparer.OrdinalIgnoreCase);
        var order = new List<string>();

        void Add(string id, string provider, string displayName)
        {
            if (string.IsNullOrWhiteSpace(id) || byId.ContainsKey(id))
            {
                return;
            }

            byId[id] = new BlendedModelOption(id, provider, displayName);
            order.Add(id);
        }

        foreach (var model in VisionCatalog.ListModels())
        {
            Add(model.Id, model.Provider, model.DisplayName);
        }

        foreach (var model in ChatCatalog.ListModels())
        {
            Add(model.Id, model.Provider, model.DisplayName);
        }

        return order.Select(id => byId[id]).ToList();
    }

