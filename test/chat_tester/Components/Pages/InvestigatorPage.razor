@page "/investigator"
@page "/vision"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@inject IOptions<ChatTesterOptions> Options
@inject HttpClient Http
@inject VisionModelCatalog VisionCatalog
@inject RequestDebugSettings DebugSettings
@inject AutoCollapseSettings AutoCollapseSettings
@inject ChatHistoryStore ChatHistoryStore
@inject ModelDefaults ChatCatalog
@inject UserPreferencesService Preferences
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using System.Diagnostics
@using System.Globalization
@using System.Text
@using System.Text.Json

<PageTitle>Investigator</PageTitle>

<InspectorPageShell Title="Investigator"
                    Tagline="@PageTagline"
                    HistoryEntries="HistoryEntries"
                    SelectedHistoryEntryId="@SelectedHistoryEntryId"
                    HistorySource="@HistorySource"
                    AutoCollapse="@AutoCollapse"
                    AutoCollapseChanged="SetAutoCollapseAsync"
                    ShowRequestPanel="@ShowRequestPanel"
                    RequestPanelVisibleChanged="SetRequestPanelVisibleAsync"
                    ShowResultPanel="@ShowVisionResultPanel"
                    ResultPanelVisibleChanged="SetVisionResultPanelVisibleAsync"
                    ShowRawPanel="@ShowRawResponsePanel"
                    RawPanelVisibleChanged="SetRawResponsePanelVisibleAsync">
    <div class="row g-4 vision-workspace @WorkspaceStateCss">
        <div class="col-12 request-col @(IsRequestPanelMinimized ? "d-none" : string.Empty)">
            <TestFormPanel @ref="FormPanel"
                           Settings="AuthSettings"
                           UserSettings="UserSettings"
                           HeaderSettings="HeaderSettings"
                           InitialServerBaseUrl="@InitialServerBaseUrl"
                           DisplayState="@RequestPanelState"
                           DisplayStateChanged="SetRequestPanelStateAsync"
                           HeaderSubtitle="@RequestSubtitle"
                           PromptTabLabel="Model"
                           SubmitLabel="Investigate"
                           BusyLabel="Investigating..."
                           IsBusy="@IsRunning"
                           RightAlignSubmit="true"
                           OnAbort="AbortRequestAsync"
                           OnSubmit="SendVisionRequestAsync">
                <PromptContent>
                    <div class="vision-body-panel rounded border p-3 mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                            <label class="form-label mb-0" for="visionModelFilter">Filter models</label>
                            <input class="form-control form-control-sm vision-model-filter" id="visionModelFilter" type="search"
                                   placeholder="filter (blank or * = all)"
                                   value="@ModelFilter" @oninput="OnModelFilterChanged" />
                            <div class="form-check mb-0 ms-auto">
                                <input class="form-check-input" type="checkbox" id="visionDebugCheck"
                                       checked="@DebugSettings.DebugEnabled" @onchange="OnDebugChanged" />
                                <label class="form-check-label" for="visionDebugCheck">Debug</label>
                            </div>
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="visionSimpleModeCheck"
                                    checked="@SimpleMode" @onchange="OnSimpleModeChanged" />
                                <label class="form-check-label" for="visionSimpleModeCheck">Simple</label>
                            </div>
                        </div>

                        <div class="vision-advanced-collapsible @(UpperRowsCollapsed ? "collapsed" : string.Empty)">
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label" for="visionModelSelect">@ModelSelectLabel</label>
                                    <select class="form-select" id="visionModelSelect" value="@SelectedModel" @onchange="OnModelSelected">
                                        <option value="">@ModelSelectPlaceholder</option>
                                        @foreach (var group in FilteredModels.GroupBy(model => model.Provider))
                                        {
                                            <optgroup label="@group.Key">
                                                @foreach (var model in group)
                                                {
                                                    <option value="@model.Id">@model.DisplayName</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="form-label" for="visionApiSelect">API</label>
                                    <select class="form-select" id="visionApiSelect" value="@SelectedApi" @onchange="OnApiSelected" disabled="@(!AvailableApiOptions.Any())">
                                        <option value="">API...</option>
                                        @foreach (var group in AvailableApiOptions.GroupBy(api => api.Kind))
                                        {
                                            <optgroup label="@group.Key">
                                                @foreach (var api in group)
                                                {
                                                    <option value="@api.Id">@api.DisplayName</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12 col-lg-6">
                                    <label class="form-label" for="visionEndpointPath">Path</label>
                                    <input class="form-control" id="visionEndpointPath" value="@EndpointPath" @oninput="OnEndpointPathChanged" />
                                </div>
                                <div class="col-12 col-lg-6">
                                    <label class="form-label" for="visionContentType">Content-Type</label>
                                    <select class="form-select" id="visionContentType" value="@ContentType" @onchange="OnContentTypeChanged">
                                        <option value="application/json">application/json</option>
                                        <option value="application/json; charset=utf-8">application/json; charset=utf-8</option>
                                    </select>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <label class="form-label" for="visionRequestCount">Number of requests</label>
                                    <input class="form-control" id="visionRequestCount" type="number" min="1" max="@MaxVisionRequestCount" value="@NumberOfRequests" @onchange="OnNumberOfRequestsChanged" />
                                </div>
                            </div>
                        </div>

                        @if (UsesPrompt && SimpleMode)
                        {
                            <div class="row g-3 mb-3">
                                <div class="col-12">
                                    <label class="form-label" for="visionPrompt">Prompt</label>
                                    <textarea class="form-control" id="visionPrompt" rows="3" value="@Prompt" @oninput="OnPromptChanged"></textarea>
                                </div>
                            </div>
                        }

                        @if (SimpleMode && FieldValues.Count > 0)
                        {
                            <ModelParameters Label="@ApiParametersLabel"
                                             ModelId="@SelectedModel"
                                             Fields="FieldValues"
                                             FieldChanged="args => OnFieldChanged(args.Name, args.Value)"
                                             FeatureChanged="args => OnFeatureChanged(args.Feature, args.Selected)"
                                             AdditionalFeaturesChanged="OnAdditionalFeaturesChanged" />
                        }

                        @if (SimpleMode && SelectedApiInfo is not null)
                        {
                            <div class="row g-3 mb-3 align-items-end">
                                <div class="col-12 col-lg-3">
                                    <label class="form-label" for="visionImageSource">Image source</label>
                                    <select class="form-select" id="visionImageSource" value="@ImageSource" @onchange="OnImageSourceChanged">
                                        <option value="url">URL</option>
                                        @if (!RequiresExternalImageUrl)
                                        {
                                            <option value="data-url">Data URL</option>
                                            <option value="file">File</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-lg">
                                    @if (ImageSource == FileImageSource)
                                    {
                                        <label class="form-label" for="visionImageFile">Image file</label>
                                        <InputFile id="visionImageFile" class="form-control" OnChange="OnImageFileSelected" accept="image/*" />
                                        @if (!string.IsNullOrWhiteSpace(ImageFileName))
                                        {
                                            <div class="form-text">@ImageFileName</div>
                                        }
                                    }
                                    else if (ImageSource == DataUrlImageSource)
                                    {
                                        <label class="form-label" for="visionDataUrl">Image data URL</label>
                                        <textarea class="form-control font-monospace" id="visionDataUrl" rows="3" value="@ImageUrl" @oninput="OnImageUrlChanged"></textarea>
                                    }
                                    else
                                    {
                                        <label class="form-label" for="visionImageUrl">Image URL</label>
                                        <input class="form-control" id="visionImageUrl" value="@ImageUrl" @oninput="OnImageUrlChanged" />
                                    }
                                </div>

                                <div class="col-12 col-lg-auto">
                                    <button class="btn btn-outline-primary w-100" type="button" disabled="@(!HasImagePreview)" @onclick="ShowImagePreview">Preview</button>
                                </div>
                            </div>
                        }

                        @if (UseCustomJson)
                        {
                            <div class="mb-0 vision-json-area @(UpperRowsCollapsed ? "expanded" : string.Empty)"
                                 @onmouseenter="() => UpperRowsCollapsed = true" @onmouseleave="() => UpperRowsCollapsed = false">
                                <label class="form-label" for="visionRequestJson">@RequestBodyLabel</label>
                                <textarea class="form-control font-monospace" id="visionRequestJson" rows="10" value="@CustomRequestBody" @oninput="OnCustomRequestBodyChanged"></textarea>
                            </div>
                        }
                    </div>
                </PromptContent>
            </TestFormPanel>
        </div>

        <div class="col-12 response-col @(IsResponseColumnHidden ? "d-none" : string.Empty)">
            @if (ShowMultiRequestStatus)
            {
                <div class="vision-batch-status-shell">
                    <MultiRequestStatus Items="@MultiRequestStatuses" />
                </div>
            }
            @if (!ShowMultiRequestStatus)
            {
                <div class="response-stack">
                    <div class="@(IsVisionResultMinimized ? "d-none" : "d-flex flex-column flex-fill min-h-0")">
                        @if (HasError)
                        {
                            <ErrorResultPanel Title="Error result"
                                              StatusMessage="@StatusMessage"
                                              CurrentStatus="@ErrorStatus"
                                              CurrentMessage="@ErrorMessage"
                                              CurrentTime="@ErrorTimestamp"
                                              CurrentDuration="@ResponseMetrics.Duration"
                                              CurrentRequestUrl="@CurrentErrorRequestUrl"
                                              Errors="@ErrorHistory"
                                              AllEntries="@HistoryEntries"
                                              DisplayState="@VisionResultState"
                                              DisplayStateChanged="SetVisionResultStateAsync" />
                        }
                        else
                        {
                            <VisionResultPanel Result="@VisionResult"
                                               StatusMessage="@StatusMessage"
                                               HasResult="@HasVisionResult"
                                               IsChat="@ResultIsChat"
                                               ActiveTab="@ActiveResultTab"
                                               ActiveTabChanged="SetActiveResultTabAsync"
                                               DisplayState="@VisionResultState"
                                               DisplayStateChanged="SetVisionResultStateAsync"
                                               Status="@ResponseMetrics.Status"
                                               ContentType="@ResponseMetrics.ContentType"
                                               TimeToFirstByte="@ResponseMetrics.TimeToFirstByte"
                                               Duration="@ResponseMetrics.Duration"
                                               Chunks="@ResponseMetrics.Chunks"
                                               TotalBytes="@ResponseMetrics.TotalBytes"
                                               ResultRowCss="@VisionResultRowCss"
                                               ResultPanelLayoutCss="@VisionResultPanelLayoutCss">
                                <HeaderActions>
                                    @if (ShowRawResponsePanel)
                                    {
                                        <button class="btn btn-sm btn-outline-light" type="button" @onclick="OpenRawExchangeModal">Raw exchange</button>
                                    }
                                </HeaderActions>
                            </VisionResultPanel>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</InspectorPageShell>

@if (IsImagePreviewOpen && HasImagePreview)
{
    <div class="vision-preview-backdrop" @onclick="CloseImagePreview"></div>
    <div class="vision-preview-dialog" role="dialog" aria-modal="true" aria-labelledby="visionPreviewTitle">
        <div class="card shadow-lg">
            <div class="card-header d-flex align-items-center gap-3">
                <h2 class="h6 mb-0" id="visionPreviewTitle">Image preview</h2>
                <button class="btn-close ms-auto" type="button" aria-label="Close" @onclick="CloseImagePreview"></button>
            </div>
            <div class="card-body">
                <img src="@ImagePreviewUrl" alt="Selected vision input" />
            </div>
        </div>
    </div>
}

@if (IsRawExchangeModalOpen)
{
    <div class="vision-preview-backdrop" @onclick="CloseRawExchangeModal"></div>
    <div class="raw-exchange-dialog" role="dialog" aria-modal="true" aria-labelledby="rawExchangeTitle" @onclick:stopPropagation="true">
        <div class="card shadow-lg raw-exchange-shell">
            <div class="card-header d-flex align-items-center gap-3">
                <h2 class="h6 mb-0" id="rawExchangeTitle">Raw exchange</h2>
                <button class="btn-close ms-auto" type="button" aria-label="Close raw exchange" @onclick="CloseRawExchangeModal"></button>
            </div>
            <div class="card-body">
                <RawResponsePanel Title="Raw exchange"
                                  StatusMessage="@StatusMessage"
                                  ActiveTab="@ActiveResponseTab"
                                  ActiveTabChanged="SetActiveResponseTabAsync"
                                  DisplayState="@RawResponseState"
                                  DisplayStateChanged="SetRawResponseStateAsync"
                                  RequestHeadersText="@RequestHeadersText"
                                  ResponseHeadersText="@ResponseHeadersText"
                                  RequestBodyDisplay="@RequestBodyDisplay"
                                  ObservedResponse="@ObservedResponse"
                                  DisplayResponse="@DisplayResponse"
                                  ShowDisplayToggle="false">
                </RawResponsePanel>
            </div>
        </div>
    </div>
}

<style>
    .vision-workspace {
        margin-left: 0;
        margin-right: 0;
    }

    .vision-batch-status-shell {
        margin-bottom: 1rem;
        flex: 1 1 auto;
        min-height: 0;
    }

    .vision-body-panel {
        background-color: #eef4ff;
        border-color: #cdddf7 !important;
    }

    .vision-model-filter {
        flex: 0 0 auto;
        width: 16rem;
        max-width: 100%;
    }

    .vision-features-row {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        gap: 0.75rem 1.25rem;
    }

    .vision-feature-checks {
        display: flex;
        flex: 1 1 34rem;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
    }

    .vision-feature-extra {
        flex: 1 1 16rem;
    }

    .vision-preview-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1090;
        background: rgba(0, 0, 0, 0.55);
    }

    .vision-preview-dialog {
        position: fixed;
        inset: 2rem;
        z-index: 1091;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .vision-preview-dialog .card {
        max-width: min(72rem, 100%);
        max-height: 100%;
        pointer-events: auto;
    }

    .vision-preview-dialog .card-body {
        overflow: auto;
    }

    .vision-preview-dialog img {
        display: block;
        max-width: 100%;
        max-height: calc(100vh - 10rem);
        object-fit: contain;
    }

    .raw-exchange-dialog {
        position: fixed;
        inset: 2rem;
        z-index: 1091;
        display: flex;
        align-items: stretch;
        justify-content: center;
        pointer-events: none;
    }

    .raw-exchange-shell {
        width: min(72rem, 100%);
        height: 100%;
        pointer-events: auto;
        display: flex;
        flex-direction: column;
    }

    .raw-exchange-shell > .card-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
        padding: 0.75rem;
    }

    .raw-exchange-shell .raw-card {
        display: flex;
        flex-direction: column;
        height: calc(100% - 0.5rem);
        margin-top: 0 !important;
        min-height: 0;
    }

    .raw-exchange-shell .raw-card .card-body {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        padding-bottom: 0;
    }

    .raw-exchange-shell .raw-card .card-body > div {
        flex: 1 1 auto;
        min-height: 0;
        max-height: none !important;
        height: 100%;
        overflow-y: auto;
    }

    @@media (min-width: 1200px) {
        .vision-workspace.request-minimized .vision-result-panel.two-column-result {
            column-count: 2;
            column-gap: 1rem;
        }

        .vision-workspace.request-minimized .vision-result-panel.two-column-result > * {
            break-inside: avoid;
        }
    }

    .result-tabs .nav-link {
        color: rgba(255, 255, 255, 0.85);
        border-color: transparent;
        padding-top: 0.15rem;
        padding-bottom: 0.15rem;
    }

    .result-tabs .nav-link:hover {
        color: #fff;
        border-color: rgba(255, 255, 255, 0.4);
    }

    .result-tabs .nav-link.active {
        color: #495057;
        background-color: #fff;
        border-color: #fff #fff #fff;
    }

    .vision-response-card.fs-overlay {
        position: fixed;
        inset: 0;
        z-index: 1080;
        margin: 0 !important;
        border-radius: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .vision-response-card.fs-overlay .card-body {
        flex: 1 1 auto;
        min-height: 0;
    }

    .vision-response-card.panel-minimized {
        flex: 0 0 auto !important;
        min-height: 0 !important;
    }

    .result-callout {
        border-left: 4px solid #0d6efd;
        background: #f4f8ff;
        border-radius: 0.375rem;
        padding: 0.75rem 1rem;
    }

    .result-stat-grid,
    .metadata-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
        gap: 0.75rem;
    }

    .result-stat-grid > div,
    .metadata-grid > div {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        background: #f8f9fa;
        padding: 0.65rem 0.75rem;
    }

    .result-stat-grid span,
    .metadata-grid span {
        display: block;
        color: #6c757d;
        font-size: 0.78rem;
        line-height: 1.2;
    }

    .result-stat-grid strong,
    .metadata-grid strong {
        display: block;
        margin-top: 0.2rem;
        overflow-wrap: anywhere;
    }

    .metadata-grid-wide {
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }

    .tag-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .vision-tag {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        background: #e7f1ff;
        color: #084298;
        padding: 0.35rem 0.6rem;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .vision-tag span {
        color: #426786;
        font-weight: 500;
    }

    .tag-list {
        display: grid;
        gap: 0.5rem;
    }

    .tag-row {
        display: grid;
        grid-template-columns: minmax(8rem, 1fr) minmax(8rem, 2fr) 4rem;
        align-items: center;
        gap: 0.75rem;
    }

    .tag-confidence {
        height: 0.5rem;
        border-radius: 999px;
        background: #e9ecef;
        overflow: hidden;
    }

    .tag-confidence-fill {
        height: 100%;
        border-radius: inherit;
        background: #198754;
    }

    .confidence-cell {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .vision-result-table td,
    .vision-result-table th {
        vertical-align: top;
    }

    .vision-text-pre,
    .vision-json-pre {
        white-space: pre-wrap;
        word-break: break-word;
        margin: 0;
    }

    .vision-json-pre {
        font-family: var(--bs-font-monospace);
        font-size: 0.82rem;
    }

    .empty-result {
        color: #6c757d;
        background: #f8f9fa;
        border: 1px dashed #ced4da;
        border-radius: 0.375rem;
        padding: 1rem;
    }

    .read-lines li + li {
        margin-top: 0.5rem;
    }

    @@media (min-width: 992px) {
        .request-col {
            flex: 0 0 40%;
            max-width: 40%;
            height: calc(100dvh - 8.75rem);
        }

        .vision-workspace.response-hidden .request-col {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .request-col > .card {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .request-col > .card > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        .response-col {
            flex: 0 0 60%;
            max-width: 60%;
            display: flex;
            flex-direction: column;
            min-height: 0;
            height: calc(100dvh - 8.75rem);
        }

        .vision-workspace.request-minimized .response-col {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .vision-workspace.manual-layout .request-col {
            flex: 0 0 33.333333%;
            max-width: 33.333333%;
        }

        .vision-workspace.manual-layout .response-col {
            flex: 0 0 66.666667%;
            max-width: 66.666667%;
        }

        .vision-workspace.multi-request-layout .vision-batch-status-shell {
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
            gap: 0.75rem;
        }

        .vision-workspace.multi-request-layout .multi-request-status {
            display: flex;
            flex: 1 1 auto;
            flex-direction: column;
            min-height: 0;
        }

        .vision-workspace.multi-request-layout .multi-request-status-list {
            flex: 1 1 auto;
            max-height: none;
        }

        .response-stack {
            display: flex;
            flex-direction: column;
            flex: 1 1 auto;
            min-height: 0;
            height: 100%;
            overflow: visible;
        }

        .vision-response-card {
            flex: 1 1 auto;
            min-height: 0;
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .response-stack > div {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .vision-response-card .card-body {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .vision-response-card .card-body > .row {
            flex: 1 1 auto;
            height: 100%;
            min-height: 0;
        }

        .vision-workspace.request-minimized .vision-result-wide .vision-result-content-col {
            flex: 0 0 72%;
            max-width: 72%;
        }

        .vision-workspace.request-minimized .vision-result-wide .vision-result-metrics-col {
            flex: 0 0 28%;
            max-width: 28%;
        }

        .raw-card {
            flex: 1 1 50%;
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .raw-card .card-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

    }

    @@media (max-width: 767.98px) {
        .raw-exchange-dialog {
            inset: 0.75rem;
        }
    }

    .vision-advanced-collapsible {
        overflow: hidden;
        max-height: 40rem;
        opacity: 1;
        transition: max-height 0.25s ease, opacity 0.2s ease, margin 0.25s ease;
    }

    .vision-advanced-collapsible.collapsed {
        max-height: 0;
        opacity: 0;
        margin-bottom: 0 !important;
        pointer-events: none;
    }

    .vision-json-area textarea {
        transition: height 0.25s ease;
    }

    .vision-json-area.expanded textarea {
        height: 34rem;
    }
</style>

@code {
    private const string UrlImageSource = "url";
    private const string DataUrlImageSource = "data-url";
    private const string FileImageSource = "file";
    private const string DefaultPageTagline = "Send an image to a configured vision API and inspect the proxy exchange.";
    private const string SummaryResultTab = "summary";
    private const string CaptionResultTab = "caption";
    private const string DenseCaptionsResultTab = "dense-captions";
    private const string TagsResultTab = "tags";
    private const string ObjectsResultTab = "objects";
    private const string PeopleResultTab = "people";
    private const string ReadResultTab = "read";
    private const string MetadataResultTab = "metadata";
    private const string RawResultTab = "raw";
    private const string HistorySource = "Vision investigator";
    private const string RequestPanel = PanelDisplayStateCoordinator.RequestPanel;
    private const string ResultPanel = PanelDisplayStateCoordinator.ResultPanel;
    private const string RawPanel = PanelDisplayStateCoordinator.RawPanel;
    private const int MaxImageBytes = 8 * 1024 * 1024;
    private const int MaxVisionRequestCount = 100;

    private static readonly (string Value, string Label)[] FeatureOptions =
    {
        ("caption", "Caption"),
        ("denseCaptions", "Dense captions"),
        ("read", "Read"),
        ("tags", "Tags"),
        ("objects", "Objects"),
        ("people", "People")
    };

    private sealed class VisionResponseMetrics
    {
        public string Status { get; set; } = "-";
        public string ContentType { get; set; } = "-";
        public TimeSpan? TimeToFirstByte { get; set; }
        public TimeSpan? Duration { get; set; }
        public int Chunks { get; set; }
        public long TotalBytes { get; set; }
    }

    private sealed record PreparedVisionRequest(int RequestIndex, HttpRequestMessage Request, string RequestHeadersText);

    private sealed record VisionBatchResult(
        int RequestIndex,
        string RequestHeadersText,
        string ResponseHeadersText,
        string ObservedResponse,
