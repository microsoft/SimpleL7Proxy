    protected override void OnInitialized()
    {
        AutoCollapse = AutoCollapseSettings.Enabled;
        if (!AutoCollapse)
        {
            EnsureAllPanesVisible();
        }

        var options = Options.Value;
        InitialServerBaseUrl = options.ServerBaseUrl;
        AuthSettings.ApplyDefaultsIfMissing(options.AuthorizationHeaderName, options.AuthorizationHeaderPrefix);
        UserSettings.ApplyDefaultsIfMissing(options.UserHeaderName, options.PriorityKeyHeader, options.UserNames);
        HeaderSettings.ApplyDefaultsIfMissing(options.DefaultHeaders);

        SelectedModel = !string.IsNullOrWhiteSpace(VisionCatalog.DefaultModel)
            ? VisionCatalog.DefaultModel
            : VisionCatalog.ListModels().FirstOrDefault()?.Id ?? string.Empty;
        Prompt = VisionCatalog.DefaultPrompt;
        EnsureSelectedApi(VisionCatalog.DefaultApi);
        EnsureCompatibleImageSource();
        ResetFields();
        RefreshEndpointPath();
        DefaultModel = SelectedModel;
    }

    private async Task OnNumberOfRequestsChanged(ChangeEventArgs args)
    {
        NumberOfRequests = ClampRequestCount(args.Value?.ToString());
        ResetMultiRequestStatuses();
        await PersistSelectionsAsync();
    }

    private static int ClampRequestCount(string? value)
    {
        if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var requestCount))
        {
            return 1;
        }

        return Math.Clamp(requestCount, 1, MaxVisionRequestCount);
    }

    private string GeneratedEndpointPath() => IsChatApi
        ? ChatCatalog.ResolveEndpointPath(SelectedModel, SelectedApi)
        : StripManagedQueryParameters(VisionCatalog.ResolveEndpointPath(SelectedModel, SelectedApi), FieldValues.Keys);

    private string AutoApiForCurrentModel()
    {
        var apis = AvailableApiOptions;
        return apis.FirstOrDefault(api => string.Equals(api.Id, VisionCatalog.DefaultApi, StringComparison.OrdinalIgnoreCase))?.Id
            ?? apis.FirstOrDefault()?.Id
            ?? string.Empty;
    }

    private async Task PersistSelectionsAsync()
    {
        var selections = Preferences.RequestSelections;
        selections.ModelFilter = string.IsNullOrEmpty(ModelFilter) ? null : ModelFilter;
        selections.SelectedModel = string.Equals(SelectedModel, DefaultModel, StringComparison.Ordinal) || string.IsNullOrEmpty(SelectedModel)
            ? null
            : SelectedModel;
        selections.SelectedApi = string.Equals(SelectedApi, AutoApiForCurrentModel(), StringComparison.Ordinal) || string.IsNullOrEmpty(SelectedApi)
            ? null
            : SelectedApi;
        selections.EndpointPath = string.Equals(EndpointPath, GeneratedEndpointPath(), StringComparison.Ordinal) || string.IsNullOrEmpty(EndpointPath)
            ? null
            : EndpointPath;
        selections.ContentType = string.Equals(ContentType, ChatTesterHttp.JsonContentType, StringComparison.Ordinal)
            ? null
            : ContentType;
        selections.RequestCount = NumberOfRequests == 1 ? null : NumberOfRequests;

        await Preferences.SaveAsync();
    }

    private void ApplyStoredSelections()
    {
        var selections = Preferences.RequestSelections;

        if (!string.IsNullOrEmpty(selections.ModelFilter))
        {
            ModelFilter = selections.ModelFilter;
        }

        if (!string.IsNullOrEmpty(selections.SelectedModel))
        {
            SelectedModel = selections.SelectedModel;
            SelectedApi = string.Empty;
            EnsureSelectedApi(string.IsNullOrEmpty(selections.SelectedApi) ? VisionCatalog.DefaultApi : selections.SelectedApi);
            EnsureCompatibleImageSource();
            ResetFields();
            RefreshEndpointPath();
        }
        else if (!string.IsNullOrEmpty(selections.SelectedApi))
        {
            SelectedApi = selections.SelectedApi;
            EnsureCompatibleImageSource();
            ResetFields();
            RefreshEndpointPath();
        }

        if (!string.IsNullOrEmpty(selections.ContentType))
        {
            ContentType = selections.ContentType;
        }

        if (selections.RequestCount is { } requestCount)
        {
            NumberOfRequests = Math.Clamp(requestCount, 1, MaxVisionRequestCount);
        }

        if (!string.IsNullOrEmpty(selections.EndpointPath))
        {
            EndpointPath = selections.EndpointPath;
        }

        RefreshCustomRequestBodyIfNeeded();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Preferences.LoadAsync();
            ApplyStoredSelections();
            StateHasChanged();
        }

        await LoadRequestedHistoryEntryAsync();
    }

    private async Task LoadRequestedHistoryEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(HistoryEntryId)
            || string.Equals(LoadedHistoryEntryId, HistoryEntryId, StringComparison.Ordinal))
        {
            return;
        }

        LoadedHistoryEntryId = HistoryEntryId;
        var entry = HistoryEntries.FirstOrDefault(entry => string.Equals(entry.Id, HistoryEntryId, StringComparison.Ordinal)
            && string.Equals(entry.Source, HistorySource, StringComparison.OrdinalIgnoreCase));
        if (entry is null)
        {
            return;
        }

        await SelectHistoryEntry(entry);
        StateHasChanged();
    }

    private async Task SendVisionRequestAsync()
    {
        var serverBaseUrl = FormPanel?.ServerBaseUrl ?? string.Empty;
        var endpointPath = EffectiveEndpointPath;
        var requestBody = RequestBody;
        var requestBodyDisplay = RedactLargeImageData(requestBody);
        if (string.IsNullOrWhiteSpace(serverBaseUrl) || string.IsNullOrWhiteSpace(endpointPath))
        {
            StatusMessage = "Set both the server URL and endpoint path before sending the request.";
            return;
        }

        if (!ValidateImageInput())
        {
            return;
        }

        NumberOfRequests = Math.Clamp(NumberOfRequests, 1, MaxVisionRequestCount);
        ResetMultiRequestStatuses();
        IsRunning = true;
        HasVisionResult = true;
        HasError = false;
        ResultIsChat = IsChatApi;
        SelectedHistoryEntryId = null;
        PageTagline = DefaultPageTagline;
        StatusMessage = NumberOfRequests == 1
            ? "Sending the vision request and waiting for the response..."
            : $"Sending {NumberOfRequests} vision requests...";
        ObservedResponse = "Awaiting response...";
        SetVisionResultMessage("Investigating image...");
        ResponseHeadersText = "No response has been received yet.";
        ResponseMetrics = new VisionResponseMetrics { Status = "Sending" };
        RequestBodyDisplay = requestBodyDisplay;
        RequestCts?.Dispose();
        RequestCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var client = Http;
            if (NumberOfRequests == 1)
            {
                await SendVisionRequestOnceAsync(client, serverBaseUrl, endpointPath, requestBody, requestIndex: 0);
            }
            else
            {
                await SendVisionRequestsInParallelAsync(client, serverBaseUrl, endpointPath, requestBody);
            }

            if (NumberOfRequests > 1)
            {
                StatusMessage = $"Completed {NumberOfRequests} vision requests. Latest status: {ResponseMetrics.Status}";
            }
        }
        finally
        {
            await SaveHistoryEntryAsync(serverBaseUrl, endpointPath, requestBodyDisplay);
            IsRunning = false;
            RequestCts?.Dispose();
            RequestCts = null;
            StateHasChanged();
        }
    }

    private Task AbortRequestAsync()
    {
        if (RequestCts is not null && !RequestCts.IsCancellationRequested)
        {
            StatusMessage = "Aborting the request...";
            RequestCts.Cancel();
        }

        return Task.CompletedTask;
    }

    private void SetError(string status, string message)
    {
        HasError = true;
        ErrorStatus = status;
        ErrorMessage = message;
        ErrorTimestamp = DateTimeOffset.Now;
    }

    private async Task SendVisionRequestOnceAsync(HttpClient client, string serverBaseUrl, string endpointPath, string requestBody, int requestIndex)
    {
        var requestNumber = requestIndex + 1;
        var statusItem = StartMultiRequestStatus(requestIndex);
        StatusMessage = NumberOfRequests == 1
            ? "Sending the vision request and waiting for the response..."
            : $"Sending request {requestNumber} of {NumberOfRequests}...";
        ObservedResponse = "Awaiting response...";
        SetVisionResultMessage("Investigating image...");
        ResponseHeadersText = "No response has been received yet.";
        ResponseMetrics = new VisionResponseMetrics { Status = "Sending" };
        StateHasChanged();

        using var metricsTimer = new CancellationTokenSource();
        var stopwatch = Stopwatch.StartNew();
        var metricsTimerTask = RunMetricsTimerAsync(stopwatch, metricsTimer.Token, ResponseMetrics, statusItem);

        try
        {
            using var request = ChatTesterHttp.CreateRequest(SelectedApiInfo?.Method ?? "POST", ChatTesterHttp.BuildUri(serverBaseUrl, endpointPath), requestBody, ContentType);
            request.Headers.TryAddWithoutValidation(ChatTesterHttp.AcceptHeaderName, IsStreamingRequested ? ChatTesterHttp.EventStreamContentType : ChatTesterHttp.JsonContentType);
            ChatTesterHttp.ApplyDebugHeader(request, DebugSettings);

            if (FormPanel is not null)
            {
                await FormPanel.ApplyAuthorizationAsync(request);
                FormPanel.ApplyUser(request, requestIndex);
                FormPanel.ApplyHeaders(request, requestIndex);
            }

            RequestHeadersText = ChatTesterHttp.SummarizeRequestHeaders(request);

            var cancellationToken = RequestCts?.Token ?? CancellationToken.None;
            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
            var statusCode = (int)response.StatusCode;
            ResponseMetrics.TimeToFirstByte = stopwatch.Elapsed;
            ResponseMetrics.Status = $"{statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            ResponseMetrics.ContentType = response.Content.Headers.ContentType?.ToString() ?? "-";
            ResponseHeadersText = ChatTesterHttp.SummarizeResponseHeaders(response);
            StatusMessage = NumberOfRequests == 1
                ? $"Reading response: {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim()
                : $"Reading response {requestNumber} of {NumberOfRequests}: {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, statusCode, isComplete: false, isFailed: false, StatusMessage);
            ShowResultPanelAfterResponse();
            StateHasChanged();

            if (ResponseMetrics.ContentType.Contains("event-stream", StringComparison.OrdinalIgnoreCase))
            {
                await StreamResponseAsync(response, stopwatch, cancellationToken);
            }
            else
            {
                await ReadBufferedResponseAsync(response, stopwatch, cancellationToken);
            }

            ResponseMetrics.Duration = stopwatch.Elapsed;
            if (statusCode >= 400)
            {
                SetError($"{statusCode} {response.ReasonPhrase ?? string.Empty}".Trim(), ObservedResponse);
            }

            StatusMessage = NumberOfRequests == 1
                ? $"Completed with {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim()
                : $"Request {requestNumber} of {NumberOfRequests} completed with {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, statusCode, isComplete: true, isFailed: false, StatusMessage);
        }
        catch (OperationCanceledException) when (RequestCts?.IsCancellationRequested == true)
        {
            ObservedResponse = "The request was aborted.";
            ResponseHeadersText = "No response headers available.";
            StatusMessage = NumberOfRequests == 1
                ? "The request was aborted."
                : $"Request {requestNumber} of {NumberOfRequests} was aborted.";
            ResponseMetrics.Status = "Aborted";
            ResponseMetrics.Duration = stopwatch.Elapsed;
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, null, isComplete: true, isFailed: true, StatusMessage);
            SetError("Aborted", "The request was aborted before a response was received.");
            ShowResultPanelAfterResponse();
        }
        catch (Exception ex)
        {
            ObservedResponse = ex.Message;
            SetVisionResultMessage($"I could not receive a response from the server.\nReason: {ex.Message}");
            ResponseHeadersText = "No response headers available.";
            StatusMessage = NumberOfRequests == 1
                ? "The request failed before a full response was received."
                : $"Request {requestNumber} of {NumberOfRequests} failed before a full response was received.";
            ResponseMetrics.Status = "Failed";
            ResponseMetrics.Duration = stopwatch.Elapsed;
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, null, isComplete: true, isFailed: true, StatusMessage);
            SetError("Failed", ex.Message);
            ShowResultPanelAfterResponse();
        }
        finally
        {
            metricsTimer.Cancel();
            try
            {
                await metricsTimerTask;
            }
            catch (OperationCanceledException)
            {
            }

            ResponseMetrics.Duration = stopwatch.Elapsed;
            StateHasChanged();
        }
    }

    private async Task SendVisionRequestsInParallelAsync(HttpClient client, string serverBaseUrl, string endpointPath, string requestBody)
    {
        var preparedRequests = new List<PreparedVisionRequest>(NumberOfRequests);
        for (var requestIndex = 0; requestIndex < NumberOfRequests; requestIndex++)
        {
            preparedRequests.Add(await PrepareVisionRequestAsync(serverBaseUrl, endpointPath, requestBody, requestIndex));
        }

        RequestHeadersText = preparedRequests.FirstOrDefault()?.RequestHeadersText ?? "No request has been sent yet.";
        ShowResultPanelAfterResponse();
        await InvokeAsync(StateHasChanged);

        var results = await Task.WhenAll(preparedRequests.Select(request => SendVisionBatchRequestAsync(client, request)));
        var representativeResult = results.OrderBy(result => result.RequestIndex).LastOrDefault();
        if (representativeResult is not null)
        {
            ApplyVisionBatchResult(representativeResult);
        }
    }

    private async Task<PreparedVisionRequest> PrepareVisionRequestAsync(string serverBaseUrl, string endpointPath, string requestBody, int requestIndex)
    {
        var request = ChatTesterHttp.CreateRequest(
            SelectedApiInfo?.Method ?? "POST",
            ChatTesterHttp.BuildUri(serverBaseUrl, endpointPath),
            requestBody,
            ContentType);

        request.Headers.TryAddWithoutValidation(
            ChatTesterHttp.AcceptHeaderName,
            IsStreamingRequested ? ChatTesterHttp.EventStreamContentType : ChatTesterHttp.JsonContentType);
        ChatTesterHttp.ApplyDebugHeader(request, DebugSettings);

        if (FormPanel is not null)
        {
            await FormPanel.ApplyAuthorizationAsync(request);
            FormPanel.ApplyUser(request, requestIndex);
            FormPanel.ApplyHeaders(request, requestIndex);
        }

        return new PreparedVisionRequest(requestIndex, request, ChatTesterHttp.SummarizeRequestHeaders(request));
    }

    private async Task<VisionBatchResult> SendVisionBatchRequestAsync(HttpClient client, PreparedVisionRequest preparedRequest)
    {
        var statusItem = StartMultiRequestStatus(preparedRequest.RequestIndex);
        var metrics = new VisionResponseMetrics { Status = "Sending" };
        UpdateMultiRequestStatus(statusItem, metrics, null, isComplete: false, isFailed: false, $"Sending request {preparedRequest.RequestIndex + 1} of {NumberOfRequests}...");
        await InvokeAsync(StateHasChanged);

        using var metricsTimer = new CancellationTokenSource();
        var stopwatch = Stopwatch.StartNew();
        var metricsTimerTask = RunMetricsTimerAsync(stopwatch, metricsTimer.Token, metrics, statusItem);

        try
        {
            var cancellationToken = RequestCts?.Token ?? CancellationToken.None;
            using var response = await client.SendAsync(preparedRequest.Request, HttpCompletionOption.ResponseHeadersRead, cancellationToken);
            var statusCode = (int)response.StatusCode;
            metrics.TimeToFirstByte = stopwatch.Elapsed;
            metrics.Status = $"{statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            metrics.ContentType = response.Content.Headers.ContentType?.ToString() ?? "-";
            var responseHeaders = ChatTesterHttp.SummarizeResponseHeaders(response);
            UpdateMultiRequestStatus(statusItem, metrics, statusCode, isComplete: false, isFailed: false, $"Reading response {preparedRequest.RequestIndex + 1} of {NumberOfRequests}: {metrics.Status}");
            await InvokeAsync(StateHasChanged);

            var body = await response.Content.ReadAsStringAsync(cancellationToken);
            metrics.Chunks = string.IsNullOrEmpty(body) ? 0 : 1;
            metrics.TotalBytes = Encoding.UTF8.GetByteCount(body);
            metrics.Duration = stopwatch.Elapsed;

            var observed = string.IsNullOrWhiteSpace(body) ? "The server returned an empty response body." : body;
            var display = VisionResponseParser.BuildDisplayResponse(observed);
            var visionResult = VisionResponseParser.BuildVisionResultView(observed, display);
            UpdateMultiRequestStatus(statusItem, metrics, statusCode, isComplete: true, isFailed: false, $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} completed with {metrics.Status}");
            var result = new VisionBatchResult(
                preparedRequest.RequestIndex,
                preparedRequest.RequestHeadersText,
                responseHeaders,
                observed,
                display,
                $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} completed with {metrics.Status}",
                metrics,
                visionResult);
            ApplyMultiRequestPayload(statusItem, result);
            await InvokeAsync(StateHasChanged);

            return result;
        }
        catch (Exception ex)
        {
            metrics.Status = "Failed";
            metrics.Duration = stopwatch.Elapsed;
            var observed = ex.Message;
            var display = $"I could not receive a response from the server.\nReason: {ex.Message}";
            UpdateMultiRequestStatus(statusItem, metrics, null, isComplete: true, isFailed: true, $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} failed before a full response was received.");
            var result = new VisionBatchResult(
                preparedRequest.RequestIndex,
                preparedRequest.RequestHeadersText,
                "No response headers available.",
                observed,
                display,
                $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} failed before a full response was received.",
                metrics,
                VisionResponseParser.BuildPlainVisionResult(display));
            ApplyMultiRequestPayload(statusItem, result);
            await InvokeAsync(StateHasChanged);

            return result;
        }
        finally
        {
            metricsTimer.Cancel();
            try
            {
                await metricsTimerTask;
            }
            catch (OperationCanceledException)
            {
            }

            preparedRequest.Request.Dispose();
        }
    }

    private void ApplyVisionBatchResult(VisionBatchResult result)
    {
        RequestHeadersText = result.RequestHeadersText;
        ResponseHeadersText = result.ResponseHeadersText;
        ObservedResponse = result.ObservedResponse;
        DisplayResponse = result.DisplayResponse;
        StatusMessage = result.StatusMessage;
        ResponseMetrics = result.Metrics;
        VisionResult = result.VisionResult;
        HasVisionResult = true;
        EnsureActiveResultTab();
        if (!ShowMultiRequestStatus)
        {
            ShowResultPanelAfterResponse();
        }
    }

    private void ResetMultiRequestStatuses()
    {
        MultiRequestStatuses.Clear();
        if (NumberOfRequests <= 1)
        {
            return;
        }

        for (var requestNumber = 1; requestNumber <= NumberOfRequests; requestNumber++)
        {
            MultiRequestStatuses.Add(new MultiRequestStatusItem { RequestNumber = requestNumber });
        }
    }

    private MultiRequestStatusItem? StartMultiRequestStatus(int requestIndex)
    {
        if (NumberOfRequests <= 1 || requestIndex >= MultiRequestStatuses.Count)
        {
            return null;
        }

        var statusItem = MultiRequestStatuses[requestIndex];
        statusItem.Status = "Sending";
        statusItem.StatusMessage = $"Sending request {requestIndex + 1} of {NumberOfRequests}...";
        statusItem.StatusCode = null;
        statusItem.ContentType = "-";
        statusItem.TimeToFirstByte = null;
        statusItem.Duration = null;
        statusItem.Chunks = 0;
        statusItem.TotalBytes = 0;
        statusItem.RequestHeadersText = string.Empty;
        statusItem.ResponseHeadersText = string.Empty;
        statusItem.RequestBodyDisplay = RequestBodyDisplay;
        statusItem.ResponseBody = string.Empty;
        statusItem.VisionResult = null;
        statusItem.IsRunning = true;
        statusItem.IsComplete = false;
        statusItem.IsFailed = false;
        return statusItem;
    }

    private void UpdateMultiRequestStatus(MultiRequestStatusItem? statusItem, VisionResponseMetrics metrics, int? statusCode, bool isComplete, bool isFailed, string? statusMessage = null)
    {
        if (statusItem is null)
        {
            return;
        }

        statusItem.Status = metrics.Status;
        if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            statusItem.StatusMessage = statusMessage;
        }

        statusItem.StatusCode = statusCode;
        statusItem.ContentType = metrics.ContentType;
        statusItem.TimeToFirstByte = metrics.TimeToFirstByte;
        statusItem.Duration = metrics.Duration;
        statusItem.Chunks = metrics.Chunks;
        statusItem.TotalBytes = metrics.TotalBytes;
        statusItem.IsRunning = !isComplete;
        statusItem.IsComplete = isComplete;
        statusItem.IsFailed = isFailed || statusCode is >= 400;
    }

    private static void ApplyMultiRequestPayload(MultiRequestStatusItem? statusItem, VisionBatchResult result)
    {
        if (statusItem is null)
        {
            return;
        }

        statusItem.RequestHeadersText = result.RequestHeadersText;
        statusItem.ResponseHeadersText = result.ResponseHeadersText;
        statusItem.ResponseBody = result.ObservedResponse;
        statusItem.StatusMessage = result.StatusMessage;
        statusItem.VisionResult = result.VisionResult;
    }

