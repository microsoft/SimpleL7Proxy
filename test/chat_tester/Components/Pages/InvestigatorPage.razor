    private static bool IsErrorEntry(ChatHistoryEntry entry)
    {
        if (string.Equals(entry.Metrics.Status, "Failed", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var statusCode = HistoryEntryFormatter.GetHistoryStatusCode(entry);
        return statusCode is >= 400;
    }

