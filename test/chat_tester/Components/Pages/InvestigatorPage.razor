    private IReadOnlyList<VisionResultTab> BuildResultTabs()
    {
        var tabs = new List<VisionResultTab>
        {
            new(SummaryResultTab, "Summary")
        };

        if (VisionResult.HasCaptionResult)
        {
            tabs.Add(new VisionResultTab(CaptionResultTab, "Caption"));
        }

        if (VisionResult.HasDenseCaptionsResult)
        {
            tabs.Add(new VisionResultTab(DenseCaptionsResultTab, "Dense", VisionResult.DenseCaptions.Count.ToString(CultureInfo.InvariantCulture)));
        }

        if (VisionResult.HasTagsResult)
        {
            tabs.Add(new VisionResultTab(TagsResultTab, "Tags", VisionResult.Tags.Count.ToString(CultureInfo.InvariantCulture)));
        }

        if (VisionResult.HasObjectsResult)
        {
            tabs.Add(new VisionResultTab(ObjectsResultTab, "Objects", VisionResult.Objects.Count.ToString(CultureInfo.InvariantCulture)));
        }

        if (VisionResult.HasPeopleResult)
        {
            tabs.Add(new VisionResultTab(PeopleResultTab, "People", VisionResult.People.Count.ToString(CultureInfo.InvariantCulture)));
        }

        if (VisionResult.HasReadResult)
        {
            tabs.Add(new VisionResultTab(ReadResultTab, "Read", VisionResult.ReadLines.Count.ToString(CultureInfo.InvariantCulture)));
        }

        if (VisionResult.HasMetadataResult || VisionResult.Metadata.HasDimensions || !string.IsNullOrWhiteSpace(VisionResult.ModelVersion))
        {
            tabs.Add(new VisionResultTab(MetadataResultTab, "Metadata"));
        }

        tabs.Add(new VisionResultTab(RawResultTab, "Raw"));
        return tabs;
    }

    private static bool TryParseDataUrl(string value, out string mimeType, out string data)
    {
        mimeType = string.Empty;
        data = string.Empty;
        if (!value.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var commaIndex = value.IndexOf(',', StringComparison.Ordinal);
        if (commaIndex < 0)
        {
            return false;
        }

        var metadata = value[5..commaIndex];
        var metadataParts = metadata.Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        mimeType = metadataParts.FirstOrDefault(part => part.Contains('/', StringComparison.Ordinal)) ?? "image/jpeg";
        data = value[(commaIndex + 1)..];
        return metadataParts.Any(part => part.Equals("base64", StringComparison.OrdinalIgnoreCase)) && !string.IsNullOrWhiteSpace(data);
    }

    private static string RedactLargeImageData(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        return System.Text.RegularExpressions.Regex.Replace(
            value,
            "(data:image/[^;]+;base64,)[A-Za-z0-9+/=]{512,}",
            match => match.Groups[1].Value + "...[base64 image omitted]...",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private static string FormatHistoryTimestamp(DateTimeOffset value) =>
        value.LocalDateTime.ToString("MMM d, yyyy h:mm tt", CultureInfo.InvariantCulture);

