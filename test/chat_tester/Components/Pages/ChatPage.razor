@page "/chat"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@inject IOptions<ChatTesterOptions> Options
@inject HttpClient Http
@inject IJSRuntime JS
@inject RequestDebugSettings DebugSettings
@inject ChatHistoryStore ChatHistoryStore
@inject ChatConversationStore ChatConversationStore
@implements IDisposable
@using chat_tester.Components.Shared
@using Microsoft.Extensions.Options
@using System.Diagnostics
@using System.Globalization
@using System.Text

<PageTitle>Chat</PageTitle>

<SectionContent SectionName="page-heading">
    <div class="d-flex flex-wrap align-items-baseline gap-3">
        <h1 class="h4 mb-0">Chat</h1>
        <span class="text-muted small mb-0">Send each prompt with the conversation history.</span>
    </div>
</SectionContent>

<div class="row g-4 chat-workspace">
    <div class="col-12 request-col">
        <TestFormPanel @ref="FormPanel"
                      Settings="AuthSettings"
                      UserSettings="UserSettings"
                      HeaderSettings="HeaderSettings"
                      InitialServerBaseUrl="@InitialServerBaseUrl"
                      HeaderSubtitle="Each request includes the prior turns."
                      CardTitle="Chat settings"
                      PromptTabLabel="Model"
                      SubmitLabel="Send next turn"
                      BusyLabel="Sending..."
                      IsBusy="@IsRunning"
                      ShowSubmitButton="false"
                      OnSubmit="SendNextTurnAsync">
            <PromptContent>
                <RequestBodyPanel @ref="BodyPanel"
                                      Rows="8"
                                      InitialBody="@InitialRequestBody"
                                      InitialEndpointPath="@InitialEndpointPath"
                                      InitialContentType="@InitialContentType"
                                      AllowModeToggle="false"
                                      ShowPrompt="false" />
            </PromptContent>
        </TestFormPanel>
    </div>

    <div class="col-12 response-col">
        <div class="response-stack">
            <div class="card shadow-sm chat-response-card h-100">
                <div class="card-header bg-primary text-white d-flex flex-wrap align-items-baseline gap-2">
                    <span class="fw-semibold">Chat</span>
                    <span class="text-white-50 small">@StatusMessage</span>
                    <div class="conversation-toolbar ms-auto">
                        <select class="form-select form-select-sm conversation-select" value="@SelectedConversationId" @onchange="OnConversationChangedAsync" disabled="@IsRunning" title="Recall a previous conversation">
                            <option value="">New conversation</option>
                            @foreach (var conversation in ConversationChoices)
                            {
                                <option value="@conversation.Id">@FormatConversationOption(conversation)</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-light" type="button" disabled="@IsRunning" @onclick="StartNewConversation">New</button>
                        <button class="btn btn-sm btn-light" type="button" disabled="@(IsRunning || Conversation.Count == 0)" @onclick="ClearConversation">Clear</button>
                    </div>
                </div>
                <div class="card-body p-0 chat-response-body">
                    <div class="conversation-scroll" @ref="ConversationRef">
                        <div class="conversation-content">
                            @if (Conversation.Count == 0 && !IsRunning)
                            {
                                <div class="empty-conversation text-muted">No turns yet.</div>
                            }
                            else
                            {
                                @foreach (var turn in Conversation)
                                {
                                    <div class="turn-group">
                                        <ChatBubble Role="User" Message="@turn.UserMessage" />
                                        <ChatBubble Role="Assistant"
                                                     Message="@turn.AssistantMessage"
                                                     Status="@turn.Status"
                                                     Metrics="@turn.Metrics"
                                                     RequestHeadersText="@turn.RequestHeadersText"
                                                     ResponseHeadersText="@turn.ResponseHeadersText"
                                                     RawResponseText="@turn.RawResponseText"
                                                     ShowRawExchangeAction="@(!string.IsNullOrWhiteSpace(turn.RawResponseText))"
                                                     RawExchangeRequested="@(() => OpenRawExchangeAsync(turn))" />
                                    </div>
                                }

                                @if (PendingTurn is not null)
                                {
                                    <div class="turn-group active-turn">
                                        <ChatBubble Role="User" Message="@PendingTurn.UserMessage" />
                                        <ChatBubble Role="Assistant" Message="@PendingTurn.AssistantMessage" Status="Streaming" />
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="card-footer chat-composer">
                    <label class="form-label small text-muted" for="multiStepChatInput">Message</label>
                    <div class="chat-composer-row">
                        <textarea class="form-control" id="multiStepChatInput" rows="3" placeholder="Type the next message..." @ref="ChatInputRef" @bind="ChatInput" @bind:event="oninput"></textarea>
                        <button class="btn btn-primary composer-send" type="button" disabled="@(!CanSend)" @onclick="SendNextTurnAsync">
                            @(IsRunning ? "Sending..." : "Send")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (IsRawExchangeModalOpen)
{
    <div class="chat-raw-exchange-backdrop" @onclick="CloseRawExchangeModal"></div>
    <div class="chat-raw-exchange-dialog" role="dialog" aria-modal="true" aria-labelledby="chatRawExchangeTitle" @onclick:stopPropagation="true">
        <div class="card shadow-lg chat-raw-exchange-shell">
            <div class="card-header d-flex align-items-center gap-3">
                <h2 class="h6 mb-0" id="chatRawExchangeTitle">Raw exchange</h2>
                <button class="btn-close ms-auto" type="button" aria-label="Close raw exchange" @onclick="CloseRawExchangeModal"></button>
            </div>
            <div class="card-body">
                <RawResponsePanel Title="Raw exchange"
                                  StatusMessage="@RawExchangeStatusMessage"
                                  ActiveTab="@ActiveRawExchangeTab"
                                  ActiveTabChanged="SetActiveRawExchangeTabAsync"
                                  DisplayState="@PanelDisplayState.Expanded"
                                  DisplayStateChanged="SetRawExchangeDisplayStateAsync"
                                  RequestHeadersText="@RawExchangeRequestHeadersText"
                                  ResponseHeadersText="@RawExchangeResponseHeadersText"
                                  RequestBodyDisplay="@RawExchangeRequestBodyDisplay"
                                  ObservedResponse="@RawExchangeObservedResponse"
                                  DisplayResponse="@RawExchangeDisplayResponse"
                                  ShowDisplayToggle="false">
                </RawResponsePanel>
            </div>
        </div>
    </div>
}

<style>
    body {
        overflow: hidden;
    }

    main {
        display: flex;
        flex-direction: column;
        height: 100dvh;
        min-height: 0;
        overflow: hidden;
    }

    article.content {
        flex: 1 1 auto;
        min-height: 0;
        padding-bottom: 0.5rem;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .chat-workspace {
        flex: 1 1 auto;
        height: auto;
        max-height: none;
        min-height: 0;
        overflow: hidden;
        align-items: stretch;
        margin-left: 0;
        margin-right: 0;
    }

    .chat-workspace > .request-col,
    .chat-workspace > .response-col {
        height: 100%;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .chat-workspace > .request-col {
        min-height: 0;
    }

    .chat-workspace > .response-col {
        min-height: 0;
    }

    .chat-workspace > .request-col > .card,
    .chat-workspace > .response-col > .card {
        width: 100%;
        height: 100%;
        max-height: 100%;
        min-height: 0;
    }

    .chat-workspace > .request-col > .card > .card-body {
        min-height: 0;
        overflow-y: auto;
    }

    .response-stack {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
        overflow: visible;
    }

    .chat-response-card {
        display: flex;
        height: 100%;
        max-height: 100%;
        min-height: 0;
        overflow: hidden;
        flex-direction: column;
    }

    .chat-response-body {
        display: flex;
        flex-direction: column;
        min-height: 0;
        flex: 1 1 auto;
        overflow: hidden;
    }

    .chat-response-body > .conversation-scroll {
        flex: 1 1 auto;
        min-height: 0;
        height: 100%;
    }

    .chat-workspace > .request-col > .request-card,
    .chat-workspace > .response-col > .chat-response-card {
        height: 100%;
        min-height: 0;
    }

    .conversation-toolbar {
        display: grid;
        grid-template-columns: minmax(12rem, 20rem) auto auto;
        gap: 0.5rem;
        align-items: center;
    }

    .conversation-select {
        min-width: 0;
    }

    .conversation-scroll {
        height: 100%;
        max-height: 100%;
        min-height: 0;
        overflow-y: scroll;
        overflow-x: hidden;
        padding: 1rem;
        background: #f6f8fb;
        display: flex;
        flex-direction: column;
        scrollbar-gutter: stable;
    }

    .conversation-content {
        width: 100%;
        min-height: min-content;
    }

    .empty-conversation {
        display: flex;
        min-height: 18rem;
        align-items: center;
        justify-content: center;
        border: 1px dashed #ced4da;
        border-radius: 0.5rem;
        background: #fff;
    }

    .turn-group {
        display: grid;
        gap: 0.65rem;
        margin-bottom: 1rem;
    }

    .chat-composer {
        flex: 0 0 auto;
        background: #fff;
        padding: 0.5rem 1rem 0.625rem;
        overflow: visible;
    }

    .chat-composer-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.75rem;
        align-items: end;
    }

    .chat-composer textarea {
        resize: vertical;
        min-height: 3.5rem;
        max-height: 5.5rem;
    }

    .composer-send {
        min-width: 5.75rem;
    }

    .chat-raw-exchange-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1090;
        background: rgba(0, 0, 0, 0.55);
    }

    .chat-raw-exchange-dialog {
        position: fixed;
        inset: 2rem;
        z-index: 1091;
        display: flex;
        align-items: stretch;
        justify-content: center;
        pointer-events: none;
    }

    .chat-raw-exchange-shell {
        width: min(72rem, 100%);
        height: 100%;
        pointer-events: auto;
        display: flex;
        flex-direction: column;
    }

    .chat-raw-exchange-shell > .card-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
        padding: 0.75rem;
    }

    .chat-raw-exchange-shell .raw-card {
        display: flex;
        flex-direction: column;
        height: calc(100% - 0.5rem);
        margin-top: 0 !important;
        min-height: 0;
    }

    .chat-raw-exchange-shell .raw-card .card-body {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        padding-bottom: 0;
    }

    .chat-raw-exchange-shell .raw-card .card-body > div {
        flex: 1 1 auto;
        min-height: 0;
        max-height: none !important;
        height: 100%;
        overflow-y: auto;
    }

    @@media (max-width: 575.98px) {
        body {
            overflow: auto;
        }

        .chat-workspace {
            height: auto;
            max-height: none;
            min-height: calc(100vh - 7.25rem);
            overflow: visible;
        }

        article.content {
            height: auto;
            overflow: visible;
        }

        .conversation-scroll {
            height: 55vh;
        }

        .chat-composer-row {
            grid-template-columns: 1fr;
        }

        .conversation-toolbar {
            width: 100%;
            grid-template-columns: minmax(0, 1fr) auto auto;
        }

        .composer-send {
            width: 100%;
        }

        .chat-raw-exchange-dialog {
            inset: 0.75rem;
        }
    }

    @@media (min-width: 992px) {
        .chat-workspace {
            --chat-panel-height: calc(100dvh - 8.75rem);
        }

        .chat-workspace .request-col {
            flex: 0 0 40%;
            max-width: 40%;
            height: var(--chat-panel-height);
        }

        .chat-workspace .response-col {
            flex: 0 0 60%;
            max-width: 60%;
            height: var(--chat-panel-height);
        }
    }
</style>

@code {
    private sealed class PendingChatTurn
    {
        public string UserMessage { get; init; } = string.Empty;
        public string AssistantMessage { get; set; } = string.Empty;
    }

    private string InitialServerBaseUrl { get; set; } = string.Empty;
    private string InitialEndpointPath { get; set; } = string.Empty;
    private string InitialContentType { get; set; } = ChatTesterHttp.JsonContentType;
    private string InitialRequestBody { get; set; } = string.Empty;
    [Inject]
    private AuthTokenSettings AuthSettings { get; set; } = default!;
    [Inject]
    private UserSettings UserSettings { get; set; } = default!;
    [Inject]
    private HeaderSettings HeaderSettings { get; set; } = default!;
    private TestFormPanel? FormPanel { get; set; }
    private RequestBodyPanel? BodyPanel { get; set; }
    private ElementReference ConversationRef;
    private ElementReference ChatInputRef;
    private List<MultiStepChatTurn> Conversation { get; } = new();
    private IReadOnlyList<ChatConversationSummary> ConversationChoices { get; set; } = Array.Empty<ChatConversationSummary>();
    private string ActiveConversationId { get; set; } = string.Empty;
    private string SelectedConversationId { get; set; } = string.Empty;
    private PendingChatTurn? PendingTurn { get; set; }
    private bool IsRunning { get; set; }
    private string StatusMessage { get; set; } = "Ready.";
    private string ChatInput { get; set; } = "tell me a joke";
    private bool IsRawExchangeModalOpen { get; set; }
    private string ActiveRawExchangeTab { get; set; } = "response-body";
    private string RawExchangeStatusMessage { get; set; } = string.Empty;
    private string RawExchangeRequestHeadersText { get; set; } = "No request headers.";
    private string RawExchangeResponseHeadersText { get; set; } = "No response headers.";
    private string RawExchangeRequestBodyDisplay { get; set; } = "No request body captured for this turn.";
    private string RawExchangeObservedResponse { get; set; } = "No response yet.";
    private string RawExchangeDisplayResponse { get; set; } = string.Empty;
    private DotNetObjectReference<ChatPage>? SelfReference { get; set; }
    private bool CanSend => !IsRunning && !string.IsNullOrWhiteSpace(ChatInput);

    protected override void OnInitialized()
    {
        var options = Options.Value;
        InitialServerBaseUrl = options.ServerBaseUrl;
        InitialEndpointPath = options.ChatEndpointPath;
        InitialRequestBody = options.ChatRequestBody;
        AuthSettings.ApplyDefaultsIfMissing(options.AuthorizationHeaderName, options.AuthorizationHeaderPrefix);
        UserSettings.ApplyDefaultsIfMissing(options.UserHeaderName, options.PriorityKeyHeader, options.UserNames);
        HeaderSettings.ApplyDefaultsIfMissing(options.DefaultHeaders);
        RefreshConversationChoices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                SelfReference = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("chatComposer.register", ChatInputRef, SelfReference);
                await JS.InvokeVoidAsync("chatScroll.register", ConversationRef);
                await JS.InvokeVoidAsync("chatResponseDetails.register", ConversationRef);
            }

            await JS.InvokeVoidAsync("chatScroll.scrollIfStuck", ConversationRef);
        }
        catch (JSException)
        {
        }
    }

    private async Task SendNextTurnAsync()
    {
        var serverBaseUrl = FormPanel?.ServerBaseUrl ?? string.Empty;
        var currentRequest = BodyPanel?.CurrentRequest ?? new ModelRequest(string.Empty, string.Empty, ChatTesterHttp.JsonContentType);
        var currentUserMessage = ChatInput.Trim();
        if (string.IsNullOrWhiteSpace(serverBaseUrl) || string.IsNullOrWhiteSpace(currentRequest.EndpointPath))
        {
            StatusMessage = "Set both the server URL and endpoint path before sending the request.";
            return;
        }

        if (string.IsNullOrWhiteSpace(currentUserMessage))
        {
            StatusMessage = "Enter a user message before sending the next turn.";
            return;
        }

        var conversationId = EnsureConversationId();
        var requestBody = MultiStepChatRequestBuilder.Build(currentRequest.Body, Conversation, currentUserMessage);
        PendingTurn = new PendingChatTurn
        {
            UserMessage = currentUserMessage,
            AssistantMessage = "Waiting for response..."
        };
        IsRunning = true;
        StatusMessage = $"Sending turn {Conversation.Count + 1} to {currentRequest.EndpointPath}";
        StateHasChanged();

        var stopwatch = Stopwatch.StartNew();
        var assistantText = string.Empty;
        var finalStatus = "Completed";
        var requestHeadersText = "No request headers.";
        var responseHeadersText = "No response headers.";
        var rawResponseText = string.Empty;
        var metrics = new MultiStepChatMetrics
        {
            Status = "Sending"
        };

        try
        {
            var client = Http;
            using var request = new HttpRequestMessage(HttpMethod.Post, ChatTesterHttp.BuildUri(serverBaseUrl, currentRequest.EndpointPath));
            request.Content = new StringContent(requestBody, Encoding.UTF8, currentRequest.ContentType);
            request.Headers.Add(ChatTesterHttp.AcceptHeaderName, ChatTesterHttp.EventStreamContentType);
            ChatTesterHttp.ApplyDebugHeader(request, DebugSettings);

            if (FormPanel is not null)
            {
                await FormPanel.ApplyAuthorizationAsync(request);
                FormPanel.ApplyUser(request, Conversation.Count);
                FormPanel.ApplyHeaders(request, Conversation.Count);
            }

            requestHeadersText = ChatTesterHttp.SummarizeRequestHeaders(request);

            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            metrics.TimeToFirstByte = stopwatch.Elapsed;
            metrics.Status = $"{(int)response.StatusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            metrics.ContentType = response.Content.Headers.ContentType?.ToString() ?? "-";
            responseHeadersText = ChatTesterHttp.SummarizeResponseHeaders(response);
            StatusMessage = $"Receiving {(int)response.StatusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            if (PendingTurn is not null)
            {
                PendingTurn.AssistantMessage = $"Received {(int)response.StatusCode} {response.ReasonPhrase ?? string.Empty}...".Trim();
            }

            await InvokeAsync(StateHasChanged);
            var responseBody = await ReadAssistantResponseAsync(response, metrics);
            assistantText = responseBody.DisplayText;
            rawResponseText = responseBody.RawText;
            if (string.IsNullOrWhiteSpace(assistantText))
            {
                assistantText = response.IsSuccessStatusCode
                    ? "The server returned an empty response body."
                    : $"Request failed with {(int)response.StatusCode} {response.ReasonPhrase ?? string.Empty}.".Trim();
            }

            finalStatus = $"{(int)response.StatusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
        }
        catch (Exception ex)
        {
            assistantText = $"Request failed: {ex.Message}";
            finalStatus = "Failed";
            metrics.Status = "Failed";
        }
        finally
        {
            stopwatch.Stop();
            metrics.Duration = stopwatch.Elapsed;
            if (string.IsNullOrWhiteSpace(rawResponseText))
            {
                rawResponseText = assistantText;
            }

            var completedTurn = new MultiStepChatTurn(currentUserMessage, assistantText, DateTimeOffset.Now, finalStatus, metrics, requestHeadersText, responseHeadersText, rawResponseText);
            Conversation.Add(completedTurn);
            var conversationSaveError = string.Empty;
            try
            {
                await ChatConversationStore.AddTurnAsync(new NewConversationTurn
                {
                    ConversationId = conversationId,
                    Method = "POST",
                    ServerBaseUrl = serverBaseUrl,
                    EndpointPath = currentRequest.EndpointPath,
                    ContentType = currentRequest.ContentType,
                    RequestHeadersText = requestHeadersText,
                    ResponseHeadersText = responseHeadersText,
                    RequestBody = currentRequest.Body,
                    RawResponseText = rawResponseText,
                    UserMessage = currentUserMessage,
                    AssistantMessage = assistantText,
                    Status = finalStatus,
                    Metrics = metrics
                });
            }
            catch (Exception ex)
            {
                conversationSaveError = ex.Message;
            }

            await ChatHistoryStore.AddRequest(new RequestHistoryEntry
            {
                Source = "Chat",
                Method = "POST",
                ServerBaseUrl = serverBaseUrl,
                EndpointPath = currentRequest.EndpointPath,
                ContentType = currentRequest.ContentType,
                RequestHeadersText = requestHeadersText,
                ResponseHeadersText = responseHeadersText,
                RequestBody = requestBody,
                ResponseBody = rawResponseText,
                DisplayResponse = assistantText,
                StatusMessage = finalStatus,
                Metrics = new ChatHistoryMetrics
                {
                    Status = metrics.Status,
                    ContentType = metrics.ContentType,
                    TimeToFirstByte = metrics.TimeToFirstByte,
                    Duration = metrics.Duration,
                    Chunks = metrics.Chunks,
                    TotalBytes = metrics.TotalBytes
                }
            });
            PendingTurn = null;
            IsRunning = false;
            if (!string.Equals(finalStatus, "Failed", StringComparison.OrdinalIgnoreCase))
            {
                ChatInput = string.Empty;
            }

            StatusMessage = string.IsNullOrWhiteSpace(conversationSaveError)
                ? $"{finalStatus} in {stopwatch.Elapsed.TotalMilliseconds:0} ms"
                : $"Conversation save failed: {conversationSaveError}";
            RefreshConversationChoices();
            StateHasChanged();
        }
    }

    private async Task<(string DisplayText, string RawText)> ReadAssistantResponseAsync(HttpResponseMessage response, MultiStepChatMetrics metrics)
    {
        var contentType = response.Content.Headers.ContentType?.ToString() ?? string.Empty;
        if (!contentType.Contains("event-stream", StringComparison.OrdinalIgnoreCase))
        {
            // Non-streaming responses (including auth failures such as 401/403) are buffered so the
            // reader cannot block waiting for stream data that will never arrive on a kept-alive connection.
            var body = await response.Content.ReadAsStringAsync();
            metrics.Chunks = string.IsNullOrEmpty(body) ? 0 : 1;
            metrics.TotalBytes = Encoding.UTF8.GetByteCount(body);
            var displayText = ChatStreamParser.ExtractDisplayContent(body);
            return (string.IsNullOrWhiteSpace(displayText) ? body.Trim() : displayText, body);
        }

        var rawBuilder = new StringBuilder();
        var assistantBuilder = new StringBuilder();
        using var stream = await response.Content.ReadAsStreamAsync();
        using var reader = new StreamReader(stream);

        while (await reader.ReadLineAsync() is { } line)
        {
            metrics.Chunks++;
            metrics.TotalBytes += Encoding.UTF8.GetByteCount(line) + 1;
            rawBuilder.AppendLine(line);
            var payload = ChatStreamParser.ExtractDataPayload(line);
            if (payload is not null)
            {
                var piece = ChatStreamParser.ExtractDeltaText(payload);
                if (!string.IsNullOrEmpty(piece))
                {
                    assistantBuilder.Append(piece);
                    if (PendingTurn is not null)
                    {
                        PendingTurn.AssistantMessage = assistantBuilder.ToString();
                    }

                    await InvokeAsync(StateHasChanged);
                }
            }
        }

        var rawResponse = rawBuilder.ToString();
        var streamedText = assistantBuilder.ToString().Trim();
        if (!string.IsNullOrWhiteSpace(streamedText))
        {
            return (streamedText, rawResponse);
        }

        var extractedText = ChatStreamParser.ExtractAllContent(rawResponse);
        if (!string.IsNullOrWhiteSpace(extractedText))
        {
            return (extractedText, rawResponse);
        }

        extractedText = ChatStreamParser.ExtractDisplayContent(rawResponse);
        return (string.IsNullOrWhiteSpace(extractedText) ? rawResponse.Trim() : extractedText, rawResponse);
    }

    [JSInvokable]
    public Task SubmitComposerAsync() => CanSend ? SendNextTurnAsync() : Task.CompletedTask;

    private async Task OnConversationChangedAsync(ChangeEventArgs args)
    {
        var conversationId = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(conversationId))
        {
            StartNewConversation();
            return;
        }

        await LoadConversationAsync(conversationId);
    }

    private async Task LoadConversationAsync(string conversationId)
    {
        var conversation = await ChatConversationStore.GetConversationAsync(conversationId);
        var turns = conversation.Turns;
        if (turns.Count == 0)
        {
            SelectedConversationId = ActiveConversationId;
            StatusMessage = "Conversation not found.";
            RefreshConversationChoices();
            return;
        }

        Conversation.Clear();
    foreach (var turn in turns)
        {
            Conversation.Add(new MultiStepChatTurn(
        turn.UserMessage,
        turn.AssistantMessage,
        turn.CreatedAt,
        turn.Status,
        turn.Metrics,
        turn.RequestHeadersText,
        turn.ResponseHeadersText,
        turn.RawResponseText));
        }

        ActiveConversationId = conversation.Id;
        SelectedConversationId = conversation.Id;
        PendingTurn = null;
        IsRunning = false;
        ChatInput = string.Empty;

        var lastTurn = turns.Last();
        FormPanel?.LoadServerBaseUrl(lastTurn.ServerBaseUrl);
        if (BodyPanel is not null)
        {
            await BodyPanel.LoadRequestAsync(new ChatHistoryEntry
            {
                EndpointPath = lastTurn.EndpointPath,
                RequestBody = lastTurn.RequestBody,
                ContentType = lastTurn.ContentType
            });
        }

        RefreshConversationChoices();
        StatusMessage = $"Loaded {Conversation.Count} turn{(Conversation.Count == 1 ? string.Empty : "s")}.";
    }

    private void StartNewConversation()
    {
        Conversation.Clear();
        PendingTurn = null;
        ActiveConversationId = string.Empty;
        SelectedConversationId = string.Empty;
        StatusMessage = "Ready.";
        ChatInput = string.Empty;
        RefreshConversationChoices();
    }

    private void ClearConversation()
    {
        StartNewConversation();
    }

    private Task OpenRawExchangeAsync(MultiStepChatTurn turn)
    {
        RawExchangeStatusMessage = turn.Status;
        RawExchangeRequestHeadersText = string.IsNullOrWhiteSpace(turn.RequestHeadersText)
            ? "No request headers."
            : turn.RequestHeadersText;
        RawExchangeResponseHeadersText = string.IsNullOrWhiteSpace(turn.ResponseHeadersText)
            ? "No response headers."
            : turn.ResponseHeadersText;
        RawExchangeObservedResponse = string.IsNullOrWhiteSpace(turn.RawResponseText)
            ? "No response yet."
            : turn.RawResponseText;
        RawExchangeDisplayResponse = turn.AssistantMessage;
        ActiveRawExchangeTab = "response-body";
        IsRawExchangeModalOpen = true;
        return Task.CompletedTask;
    }

    private void CloseRawExchangeModal() => IsRawExchangeModalOpen = false;

    private Task SetActiveRawExchangeTabAsync(string tab)
    {
        ActiveRawExchangeTab = tab;
        return Task.CompletedTask;
    }

    private Task SetRawExchangeDisplayStateAsync(PanelDisplayState state) => Task.CompletedTask;

    private string EnsureConversationId()
    {
        if (string.IsNullOrWhiteSpace(ActiveConversationId))
        {
            ActiveConversationId = Guid.NewGuid().ToString("N");
        }

        SelectedConversationId = ActiveConversationId;
        return ActiveConversationId;
    }

    private void RefreshConversationChoices()
    {
        ConversationChoices = ChatConversationStore.GetSnapshot();
    }

    private static string FormatConversationOption(ChatConversationSummary conversation)
    {
        var when = conversation.UpdatedAt.LocalDateTime.ToString("MMM d HH:mm", CultureInfo.InvariantCulture);
        return $"{when} - {conversation.Title} ({conversation.MessageCount})";
    }

    private static string ShortId(string conversationId)
    {
        return string.IsNullOrWhiteSpace(conversationId)
            ? "new"
            : conversationId[..Math.Min(8, conversationId.Length)];
    }

    public void Dispose()
    {
        SelfReference?.Dispose();
    }
}