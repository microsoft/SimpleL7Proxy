@page "/"
@namespace chat_tester.Components.Pages

<PageTitle>chat-tester</PageTitle>

<h1>chat-tester</h1>
<p class="lead">A local Blazor app for sending chat-style requests through a server and inspecting the response stream.</p>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card shadow-sm h-100 border-success">
            <div class="card-body">
                <h5 class="card-title">Request inspector</h5>
                <p class="card-text">Send a chat-style request, pick a model template, attach authorization, and inspect the streamed response alongside the raw payload, request, and response headers.</p>
                <a class="btn btn-success" href="inspect">Open request inspector</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-body">
                <h5 class="card-title">Chat</h5>
                <p class="card-text">Continue a multi-step conversation where each request carries the prior turns into the next API call.</p>
                <a class="btn btn-primary" href="chat">Open chat</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100 border-primary">
            <div class="card-body">
                <h5 class="card-title">Investigator</h5>
                <p class="card-text">Send image prompts through OpenAI, Anthropic, Gemini, or Azure AI Vision schemas and inspect the response payload.</p>
                <a class="btn btn-primary" href="vision-investigator">Open investigator</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Highlights</h5>
                <ul>
                    <li>Model template picker (OpenAI, Anthropic, Gemini, and more)</li>
                    <li>Key or OAuth bearer authorization</li>
                    <li>Live streaming response with raw payload inspection</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<h2 class="h5 text-uppercase text-muted mt-4">fail-test</h2>
<div class="row g-4 mt-0">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Rapid disconnect</h5>
                <p class="card-text">Open many rapid requests to a configurable base URL and abort them before the server replies.</p>
                <a class="btn btn-outline-primary" href="abort-test">Open rapid disconnect test</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">URL tester</h5>
                <p class="card-text">Check multiple URLs rapidly and inspect the status, response headers, and content for each. Supports optional auth headers.</p>
                <a class="btn btn-outline-primary" href="url-tester">Open URL tester</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <h5 class="card-title">Burst test</h5>
                <p class="card-text">Run many parallel requests and measure bytes returned, total time, and time to first byte for each.</p>
                <a class="btn btn-outline-primary" href="stress-test">Open burst test</a>
            </div>
        </div>
    </div>
</div>
