    private static IEnumerable<string> ParseFeatureList(string value)
    {
        return value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(feature => !string.IsNullOrWhiteSpace(feature));
    }

    private static bool IsKnownFeature(string feature) => FeatureOptions.Any(option => string.Equals(option.Value, feature, StringComparison.OrdinalIgnoreCase));

    private void SetFeatures(IEnumerable<string> features)
    {
        var normalized = features
            .Select(feature => feature.Trim())
            .Where(feature => !string.IsNullOrWhiteSpace(feature))
            .Distinct(StringComparer.OrdinalIgnoreCase);

        OnFieldChanged("features", string.Join(',', normalized));
    }

