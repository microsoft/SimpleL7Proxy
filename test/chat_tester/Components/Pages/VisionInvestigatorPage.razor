    private bool IsComputerVisionAnalysisApi => SelectedApiInfo?.RequestFormat.StartsWith("azure-ai-vision", StringComparison.OrdinalIgnoreCase) == true;

    private bool UsesPrompt => !IsComputerVisionAnalysisApi;

    private bool RequiresExternalImageUrl => VisionCatalog.RequiresExternalImageUrl(SelectedApi);

    private string ModelSelectLabel => IsComputerVisionAnalysisApi ? "Vision API" : "Model";

    private string ModelSelectPlaceholder => IsComputerVisionAnalysisApi ? "Vision API..." : "Model...";

    private string ApiParametersLabel => IsComputerVisionAnalysisApi ? "Query parameters" : "API parameters";

    private string RequestBodyLabel => "Request JSON";

    private bool SimpleMode => !UseCustomJson;

    private IReadOnlyList<VisionResultTab> ResultTabs => BuildResultTabs();

    private bool IsRequestPanelMinimized => RequestPanelState == PanelDisplayState.Minimized;

    private bool ShowRequestPanel => !IsRequestPanelMinimized;

    private bool IsVisionResultMinimized => VisionResultState == PanelDisplayState.Minimized;

    private bool ShowVisionResultPanel => !ShowMultiRequestStatus && !IsVisionResultMinimized;

    private bool IsVisionResultFullscreen => VisionResultState == PanelDisplayState.Fullscreen;

    private bool IsRawResponseMinimized => RawResponseState == PanelDisplayState.Minimized;

    private bool ShowRawResponsePanel => !ShowMultiRequestStatus && !IsRawResponseMinimized;

    private bool IsResponseColumnHidden => ShowMultiRequestStatus ? false : IsVisionResultMinimized && IsRawResponseMinimized;

    private bool ShowMultiRequestStatus => NumberOfRequests > 1;

    private bool IsRequestHiddenWithExpandedResult => IsRequestPanelMinimized && !IsVisionResultMinimized;

    private string WorkspaceStateCss
    {
        get
        {
            var classes = new List<string>();
            if (IsRequestPanelMinimized)
            {
                classes.Add("request-minimized");
            }

            if (IsResponseColumnHidden)
            {
                classes.Add("response-hidden");
            }

            if (ShowMultiRequestStatus)
            {
                classes.Add("multi-request-layout");
            }

            if (!AutoCollapse)
            {
                classes.Add("manual-layout");
            }

            return string.Join(' ', classes);
        }
    }

    private string VisionResultRowCss => IsRequestHiddenWithExpandedResult ? "vision-result-wide" : string.Empty;

    private string VisionResultPanelLayoutCss => IsRequestHiddenWithExpandedResult ? "two-column-result" : string.Empty;

    private string VisionResultCardStateCss => VisionResultState switch
    {
        PanelDisplayState.Minimized => "panel-minimized",
        PanelDisplayState.Fullscreen => "fs-overlay",
        _ => string.Empty
    };

    private Task SelectPanelAsync(string panel)
    {
        if (!AutoCollapse)
        {
            ActivePanel = panel;
            EnsureAllPanesVisible();
            return Task.CompletedTask;
        }

        ApplyPanelState(PanelDisplayStateCoordinator.SelectPanel(panel));
        return Task.CompletedTask;
    }

    private Task SetAutoCollapseAsync(bool autoCollapse)
    {
        AutoCollapse = autoCollapse;
        AutoCollapseSettings.Enabled = autoCollapse;

        if (autoCollapse)
        {
            ApplyPanelState(PanelDisplayStateCoordinator.SelectPanel(ActivePanel));
        }
        else
        {
            EnsureAllPanesVisible();
        }

        return Task.CompletedTask;
    }

    private Task SetRequestPanelVisibleAsync(ChangeEventArgs args)
    {
        RequestPanelState = args.Value is bool selected && selected ? PanelDisplayState.Expanded : PanelDisplayState.Minimized;
        if (RequestPanelState != PanelDisplayState.Minimized)
        {
            ActivePanel = RequestPanel;
        }

        NormalizePanelStates();
        return Task.CompletedTask;
    }

    private Task SetVisionResultPanelVisibleAsync(ChangeEventArgs args)
    {
        VisionResultState = args.Value is bool selected && selected ? PanelDisplayState.Expanded : PanelDisplayState.Minimized;
        if (VisionResultState != PanelDisplayState.Minimized)
        {
            ActivePanel = ResultPanel;
        }

        NormalizePanelStates();
        return Task.CompletedTask;
    }

    private Task SetRawResponsePanelVisibleAsync(ChangeEventArgs args)
    {
        RawResponseState = args.Value is bool selected && selected ? PanelDisplayState.Expanded : PanelDisplayState.Minimized;
        if (RawResponseState != PanelDisplayState.Minimized)
        {
            ActivePanel = RawPanel;
        }

        NormalizePanelStates();
        return Task.CompletedTask;
    }

    private Task SetRequestPanelStateAsync(PanelDisplayState state)
    {
        RequestPanelState = state;
        NormalizePanelStates();
        return Task.CompletedTask;
    }

    private Task SetVisionResultStateAsync(PanelDisplayState state)
    {
        VisionResultState = state;
        NormalizePanelStates();
        return Task.CompletedTask;
    }

    private Task SetRawResponseStateAsync(PanelDisplayState state)
    {
        RawResponseState = state;
        NormalizePanelStates();
        return Task.CompletedTask;
    }

    private Task SetActiveResponseTabAsync(string tab)
    {
        ActiveResponseTab = tab;
        return Task.CompletedTask;
    }

    private void ShowResultPanelAfterResponse()
    {
        if (!AutoCollapse)
        {
            ActivePanel = ResultPanel;
            EnsureAllPanesVisible();
            return;
        }

        ApplyPanelState(PanelDisplayStateCoordinator.SelectPanel(ResultPanel));
    }

    private void NormalizePanelStates()
    {
        ApplyPanelState(PanelDisplayStateCoordinator.Normalize(
            RequestPanelState,
            VisionResultState,
            RawResponseState,
            ActivePanel));
    }

    private void ApplyPanelState(PanelDisplayStateGroup panelState)
    {
        ActivePanel = panelState.ActivePanel;
        RequestPanelState = panelState.Request;
        VisionResultState = panelState.Result;
        RawResponseState = panelState.Raw;
    }

    private void EnsureAllPanesVisible()
    {
        ActivePanel = string.IsNullOrWhiteSpace(ActivePanel) ? RequestPanel : ActivePanel;
        RequestPanelState = PanelDisplayState.Expanded;
        VisionResultState = PanelDisplayState.Expanded;
        RawResponseState = PanelDisplayState.Expanded;
    }

    private IEnumerable<KeyValuePair<string, string>> FieldsForDisplay => FieldValues.OrderBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase);

    private string RequestBody => UseCustomJson ? CustomRequestBody : BuildGeneratedRequestBody();

    private string RequestBodyPreview => RedactLargeImageData(RequestBody);

    private string EffectiveEndpointPath => SimpleMode ? AppendFieldQueryParameters(EndpointPath, FieldValues) : EndpointPath;

    private string EffectiveImageUrl => ImageSource == FileImageSource && !string.IsNullOrWhiteSpace(ImageBase64)
        ? $"data:{ImageMimeType};base64,{ImageBase64}"
        : ImageUrl.Trim();

    private string ImagePreviewUrl => EffectiveImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) || EffectiveImageUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase)
        ? EffectiveImageUrl
        : string.Empty;

    private bool HasImagePreview => !string.IsNullOrWhiteSpace(ImagePreviewUrl);

    private string AdditionalFeaturesText => string.Join(", ", GetCurrentFeatures().Where(feature => !IsKnownFeature(feature)));

    private bool IsStreamingRequested => SelectedApiInfo?.SupportsStreaming == true
        && FieldValues.TryGetValue("stream", out var streamValue)
        && bool.TryParse(streamValue, out var stream)
        && stream;

    protected override void OnInitialized()
    {
        AutoCollapse = AutoCollapseSettings.Enabled;
        if (!AutoCollapse)
        {
            EnsureAllPanesVisible();
        }

        var options = Options.Value;
        InitialServerBaseUrl = options.ServerBaseUrl;
        AuthSettings.ApplyDefaultsIfMissing(options.AuthorizationHeaderName, options.AuthorizationHeaderPrefix);
        UserSettings.ApplyDefaultsIfMissing(options.UserHeaderName, options.PriorityKeyHeader, options.UserNames);
        HeaderSettings.ApplyDefaultsIfMissing(options.DefaultHeaders);

        SelectedModel = !string.IsNullOrWhiteSpace(VisionCatalog.DefaultModel)
            ? VisionCatalog.DefaultModel
            : VisionCatalog.ListModels().FirstOrDefault()?.Id ?? string.Empty;
        Prompt = VisionCatalog.DefaultPrompt;
        EnsureSelectedApi(VisionCatalog.DefaultApi);
        EnsureCompatibleImageSource();
        ResetFields();
        RefreshEndpointPath();
    }

    private void OnNumberOfRequestsChanged(ChangeEventArgs args)
    {
        NumberOfRequests = ClampRequestCount(args.Value?.ToString());
        ResetMultiRequestStatuses();
    }

    private static int ClampRequestCount(string? value)
    {
        if (!int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var requestCount))
        {
            return 1;
        }

        return Math.Clamp(requestCount, 1, MaxVisionRequestCount);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LoadRequestedHistoryEntryAsync();
    }

    private async Task LoadRequestedHistoryEntryAsync()
    {
        if (string.IsNullOrWhiteSpace(HistoryEntryId)
            || string.Equals(LoadedHistoryEntryId, HistoryEntryId, StringComparison.Ordinal))
        {
            return;
        }

        LoadedHistoryEntryId = HistoryEntryId;
        var entry = HistoryEntries.FirstOrDefault(entry => string.Equals(entry.Id, HistoryEntryId, StringComparison.Ordinal)
            && string.Equals(entry.Source, HistorySource, StringComparison.OrdinalIgnoreCase));
        if (entry is null)
        {
            return;
        }

        await SelectHistoryEntry(entry);
        StateHasChanged();
    }

    private async Task SendVisionRequestAsync()
    {
        var serverBaseUrl = FormPanel?.ServerBaseUrl ?? string.Empty;
        var endpointPath = EffectiveEndpointPath;
        var requestBody = RequestBody;
        var requestBodyDisplay = RedactLargeImageData(requestBody);
        if (string.IsNullOrWhiteSpace(serverBaseUrl) || string.IsNullOrWhiteSpace(endpointPath))
        {
            StatusMessage = "Set both the server URL and endpoint path before sending the request.";
            return;
        }

        if (!ValidateImageInput())
        {
            return;
        }

        NumberOfRequests = Math.Clamp(NumberOfRequests, 1, MaxVisionRequestCount);
        ResetMultiRequestStatuses();
        IsRunning = true;
        SelectedHistoryEntryId = null;
        PageTagline = DefaultPageTagline;
        StatusMessage = NumberOfRequests == 1
            ? "Sending the vision request and waiting for the response..."
            : $"Sending {NumberOfRequests} vision requests...";
        ObservedResponse = "Awaiting response...";
        SetVisionResultMessage("Investigating image...");
        ResponseHeadersText = "No response has been received yet.";
        ResponseMetrics = new VisionResponseMetrics { Status = "Sending" };
        RequestBodyDisplay = requestBodyDisplay;
        StateHasChanged();

        try
        {
            using var client = new HttpClient();
            if (NumberOfRequests == 1)
            {
                await SendVisionRequestOnceAsync(client, serverBaseUrl, endpointPath, requestBody, requestIndex: 0);
            }
            else
            {
                await SendVisionRequestsInParallelAsync(client, serverBaseUrl, endpointPath, requestBody);
            }

            if (NumberOfRequests > 1)
            {
                StatusMessage = $"Completed {NumberOfRequests} vision requests. Latest status: {ResponseMetrics.Status}";
            }
        }
        finally
        {
            await SaveHistoryEntryAsync(serverBaseUrl, endpointPath, requestBodyDisplay);
            IsRunning = false;
            StateHasChanged();
        }
    }

    private async Task SendVisionRequestOnceAsync(HttpClient client, string serverBaseUrl, string endpointPath, string requestBody, int requestIndex)
    {
        var requestNumber = requestIndex + 1;
        var statusItem = StartMultiRequestStatus(requestIndex);
        StatusMessage = NumberOfRequests == 1
            ? "Sending the vision request and waiting for the response..."
            : $"Sending request {requestNumber} of {NumberOfRequests}...";
        ObservedResponse = "Awaiting response...";
        SetVisionResultMessage("Investigating image...");
        ResponseHeadersText = "No response has been received yet.";
        ResponseMetrics = new VisionResponseMetrics { Status = "Sending" };
        StateHasChanged();

        using var metricsTimer = new CancellationTokenSource();
        var stopwatch = Stopwatch.StartNew();
        var metricsTimerTask = RunMetricsTimerAsync(stopwatch, metricsTimer.Token, ResponseMetrics, statusItem);

        try
        {
            using var request = ChatTesterHttp.CreateRequest(SelectedApiInfo?.Method ?? "POST", ChatTesterHttp.BuildUri(serverBaseUrl, endpointPath), requestBody, ContentType);
            request.Headers.TryAddWithoutValidation(ChatTesterHttp.AcceptHeaderName, IsStreamingRequested ? ChatTesterHttp.EventStreamContentType : ChatTesterHttp.JsonContentType);
            ChatTesterHttp.ApplyDebugHeader(request, DebugSettings);

            if (FormPanel is not null)
            {
                await FormPanel.ApplyAuthorizationAsync(request);
                FormPanel.ApplyUser(request, requestIndex);
                FormPanel.ApplyHeaders(request, requestIndex);
            }

            RequestHeadersText = ChatTesterHttp.SummarizeRequestHeaders(request);

            using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
            var statusCode = (int)response.StatusCode;
            ResponseMetrics.TimeToFirstByte = stopwatch.Elapsed;
            ResponseMetrics.Status = $"{statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            ResponseMetrics.ContentType = response.Content.Headers.ContentType?.ToString() ?? "-";
            ResponseHeadersText = ChatTesterHttp.SummarizeResponseHeaders(response);
            StatusMessage = NumberOfRequests == 1
                ? $"Reading response: {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim()
                : $"Reading response {requestNumber} of {NumberOfRequests}: {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, statusCode, isComplete: false, isFailed: false, StatusMessage);
            ShowResultPanelAfterResponse();
            StateHasChanged();

            if (ResponseMetrics.ContentType.Contains("event-stream", StringComparison.OrdinalIgnoreCase))
            {
                await StreamResponseAsync(response, stopwatch);
            }
            else
            {
                await ReadBufferedResponseAsync(response, stopwatch);
            }

            ResponseMetrics.Duration = stopwatch.Elapsed;
            StatusMessage = NumberOfRequests == 1
                ? $"Completed with {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim()
                : $"Request {requestNumber} of {NumberOfRequests} completed with {statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, statusCode, isComplete: true, isFailed: false, StatusMessage);
        }
        catch (Exception ex)
        {
            ObservedResponse = ex.Message;
            SetVisionResultMessage($"I could not receive a response from the server.\nReason: {ex.Message}");
            ResponseHeadersText = "No response headers available.";
            StatusMessage = NumberOfRequests == 1
                ? "The request failed before a full response was received."
                : $"Request {requestNumber} of {NumberOfRequests} failed before a full response was received.";
            ResponseMetrics.Status = "Failed";
            ResponseMetrics.Duration = stopwatch.Elapsed;
            UpdateMultiRequestStatus(statusItem, ResponseMetrics, null, isComplete: true, isFailed: true, StatusMessage);
            ShowResultPanelAfterResponse();
        }
        finally
        {
            metricsTimer.Cancel();
            try
            {
                await metricsTimerTask;
            }
            catch (OperationCanceledException)
            {
            }

            ResponseMetrics.Duration = stopwatch.Elapsed;
            StateHasChanged();
        }
    }

    private async Task SendVisionRequestsInParallelAsync(HttpClient client, string serverBaseUrl, string endpointPath, string requestBody)
    {
        var preparedRequests = new List<PreparedVisionRequest>(NumberOfRequests);
        for (var requestIndex = 0; requestIndex < NumberOfRequests; requestIndex++)
        {
            preparedRequests.Add(await PrepareVisionRequestAsync(serverBaseUrl, endpointPath, requestBody, requestIndex));
        }

        RequestHeadersText = preparedRequests.FirstOrDefault()?.RequestHeadersText ?? "No request has been sent yet.";
        ShowResultPanelAfterResponse();
        await InvokeAsync(StateHasChanged);

        var results = await Task.WhenAll(preparedRequests.Select(request => SendVisionBatchRequestAsync(client, request)));
        var representativeResult = results.OrderBy(result => result.RequestIndex).LastOrDefault();
        if (representativeResult is not null)
        {
            ApplyVisionBatchResult(representativeResult);
        }
    }

    private async Task<PreparedVisionRequest> PrepareVisionRequestAsync(string serverBaseUrl, string endpointPath, string requestBody, int requestIndex)
    {
        var request = ChatTesterHttp.CreateRequest(
            SelectedApiInfo?.Method ?? "POST",
            ChatTesterHttp.BuildUri(serverBaseUrl, endpointPath),
            requestBody,
            ContentType);

        request.Headers.TryAddWithoutValidation(
            ChatTesterHttp.AcceptHeaderName,
            IsStreamingRequested ? ChatTesterHttp.EventStreamContentType : ChatTesterHttp.JsonContentType);
        ChatTesterHttp.ApplyDebugHeader(request, DebugSettings);

        if (FormPanel is not null)
        {
            await FormPanel.ApplyAuthorizationAsync(request);
            FormPanel.ApplyUser(request, requestIndex);
            FormPanel.ApplyHeaders(request, requestIndex);
        }

        return new PreparedVisionRequest(requestIndex, request, ChatTesterHttp.SummarizeRequestHeaders(request));
    }

    private async Task<VisionBatchResult> SendVisionBatchRequestAsync(HttpClient client, PreparedVisionRequest preparedRequest)
    {
        var statusItem = StartMultiRequestStatus(preparedRequest.RequestIndex);
        var metrics = new VisionResponseMetrics { Status = "Sending" };
        UpdateMultiRequestStatus(statusItem, metrics, null, isComplete: false, isFailed: false, $"Sending request {preparedRequest.RequestIndex + 1} of {NumberOfRequests}...");
        await InvokeAsync(StateHasChanged);

        using var metricsTimer = new CancellationTokenSource();
        var stopwatch = Stopwatch.StartNew();
        var metricsTimerTask = RunMetricsTimerAsync(stopwatch, metricsTimer.Token, metrics, statusItem);

        try
        {
            using var response = await client.SendAsync(preparedRequest.Request, HttpCompletionOption.ResponseHeadersRead);
            var statusCode = (int)response.StatusCode;
            metrics.TimeToFirstByte = stopwatch.Elapsed;
            metrics.Status = $"{statusCode} {response.ReasonPhrase ?? string.Empty}".Trim();
            metrics.ContentType = response.Content.Headers.ContentType?.ToString() ?? "-";
            var responseHeaders = ChatTesterHttp.SummarizeResponseHeaders(response);
            UpdateMultiRequestStatus(statusItem, metrics, statusCode, isComplete: false, isFailed: false, $"Reading response {preparedRequest.RequestIndex + 1} of {NumberOfRequests}: {metrics.Status}");
            await InvokeAsync(StateHasChanged);

            var body = await response.Content.ReadAsStringAsync();
            metrics.Chunks = string.IsNullOrEmpty(body) ? 0 : 1;
            metrics.TotalBytes = Encoding.UTF8.GetByteCount(body);
            metrics.Duration = stopwatch.Elapsed;

            var observed = string.IsNullOrWhiteSpace(body) ? "The server returned an empty response body." : body;
            var display = BuildDisplayResponse(observed);
            var visionResult = BuildVisionResultView(observed, display);
            UpdateMultiRequestStatus(statusItem, metrics, statusCode, isComplete: true, isFailed: false, $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} completed with {metrics.Status}");
            var result = new VisionBatchResult(
                preparedRequest.RequestIndex,
                preparedRequest.RequestHeadersText,
                responseHeaders,
                observed,
                display,
                $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} completed with {metrics.Status}",
                metrics,
                visionResult);
            ApplyMultiRequestPayload(statusItem, result);
            await InvokeAsync(StateHasChanged);

            return result;
        }
        catch (Exception ex)
        {
            metrics.Status = "Failed";
            metrics.Duration = stopwatch.Elapsed;
            var observed = ex.Message;
            var display = $"I could not receive a response from the server.\nReason: {ex.Message}";
            UpdateMultiRequestStatus(statusItem, metrics, null, isComplete: true, isFailed: true, $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} failed before a full response was received.");
            var result = new VisionBatchResult(
                preparedRequest.RequestIndex,
                preparedRequest.RequestHeadersText,
                "No response headers available.",
                observed,
                display,
                $"Request {preparedRequest.RequestIndex + 1} of {NumberOfRequests} failed before a full response was received.",
                metrics,
                BuildPlainVisionResult(display));
            ApplyMultiRequestPayload(statusItem, result);
            await InvokeAsync(StateHasChanged);

            return result;
        }
        finally
        {
            metricsTimer.Cancel();
            try
            {
                await metricsTimerTask;
            }
            catch (OperationCanceledException)
            {
            }

            preparedRequest.Request.Dispose();
        }
    }

    private void ApplyVisionBatchResult(VisionBatchResult result)
    {
        RequestHeadersText = result.RequestHeadersText;
        ResponseHeadersText = result.ResponseHeadersText;
        ObservedResponse = result.ObservedResponse;
        DisplayResponse = result.DisplayResponse;
        StatusMessage = result.StatusMessage;
        ResponseMetrics = result.Metrics;
        VisionResult = result.VisionResult;
        EnsureActiveResultTab();
        if (!ShowMultiRequestStatus)
        {
            ShowResultPanelAfterResponse();
        }
    }

    private void ResetMultiRequestStatuses()
    {
        MultiRequestStatuses.Clear();
        if (NumberOfRequests <= 1)
        {
            return;
        }

        for (var requestNumber = 1; requestNumber <= NumberOfRequests; requestNumber++)
        {
            MultiRequestStatuses.Add(new MultiRequestStatusItem { RequestNumber = requestNumber });
        }
    }

    private MultiRequestStatusItem? StartMultiRequestStatus(int requestIndex)
    {
        if (NumberOfRequests <= 1 || requestIndex >= MultiRequestStatuses.Count)
        {
            return null;
        }

        var statusItem = MultiRequestStatuses[requestIndex];
        statusItem.Status = "Sending";
        statusItem.StatusMessage = $"Sending request {requestIndex + 1} of {NumberOfRequests}...";
        statusItem.StatusCode = null;
        statusItem.ContentType = "-";
        statusItem.TimeToFirstByte = null;
        statusItem.Duration = null;
        statusItem.Chunks = 0;
        statusItem.TotalBytes = 0;
        statusItem.RequestHeadersText = string.Empty;
        statusItem.ResponseHeadersText = string.Empty;
        statusItem.RequestBodyDisplay = RequestBodyDisplay;
        statusItem.ResponseBody = string.Empty;
        statusItem.VisionResult = null;
        statusItem.IsRunning = true;
        statusItem.IsComplete = false;
        statusItem.IsFailed = false;
        return statusItem;
    }

    private void UpdateMultiRequestStatus(MultiRequestStatusItem? statusItem, VisionResponseMetrics metrics, int? statusCode, bool isComplete, bool isFailed, string? statusMessage = null)
    {
        if (statusItem is null)
        {
            return;
        }

        statusItem.Status = metrics.Status;
        if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            statusItem.StatusMessage = statusMessage;
        }

        statusItem.StatusCode = statusCode;
        statusItem.ContentType = metrics.ContentType;
        statusItem.TimeToFirstByte = metrics.TimeToFirstByte;
        statusItem.Duration = metrics.Duration;
        statusItem.Chunks = metrics.Chunks;
        statusItem.TotalBytes = metrics.TotalBytes;
        statusItem.IsRunning = !isComplete;
        statusItem.IsComplete = isComplete;
        statusItem.IsFailed = isFailed || statusCode is >= 400;
    }

    private static void ApplyMultiRequestPayload(MultiRequestStatusItem? statusItem, VisionBatchResult result)
    {
        if (statusItem is null)
        {
            return;
        }

        statusItem.RequestHeadersText = result.RequestHeadersText;
        statusItem.ResponseHeadersText = result.ResponseHeadersText;
        statusItem.ResponseBody = result.ObservedResponse;
        statusItem.StatusMessage = result.StatusMessage;
        statusItem.VisionResult = result.VisionResult;
    }

    private async Task SaveHistoryEntryAsync(string serverBaseUrl, string endpointPath, string requestBodyDisplay)
    {
        var entry = await ChatHistoryStore.AddRequest(new RequestHistoryEntry
        {
            Source = HistorySource,
            Method = SelectedApiInfo?.Method ?? "POST",
            ServerBaseUrl = serverBaseUrl,
            EndpointPath = endpointPath,
            ContentType = ContentType,
            RequestHeadersText = RequestHeadersText,
            ResponseHeadersText = ResponseHeadersText,
            RequestBody = requestBodyDisplay,
            ResponseBody = ObservedResponse,
            DisplayResponse = DisplayResponse,
            StatusMessage = StatusMessage,
            ActiveResponseTab = ActiveResponseTab,
            Metrics = new ChatHistoryMetrics
            {
                Status = ResponseMetrics.Status,
                ContentType = ResponseMetrics.ContentType,
                TimeToFirstByte = ResponseMetrics.TimeToFirstByte,
                Duration = ResponseMetrics.Duration,
                Chunks = ResponseMetrics.Chunks,
                TotalBytes = ResponseMetrics.TotalBytes
            }
        });

        SelectedHistoryEntryId = entry.Id;
        PageTagline = $"Showing response from {FormatHistoryTimestamp(entry.CreatedAt)}.";
    }

    private Task SelectHistoryEntry(ChatHistoryEntry entry)
    {
        SelectedHistoryEntryId = entry.Id;
        PageTagline = $"Showing response from {FormatHistoryTimestamp(entry.CreatedAt)}.";
        FormPanel?.LoadServerBaseUrl(entry.ServerBaseUrl);

        EndpointPath = entry.EndpointPath;
        ContentType = string.IsNullOrWhiteSpace(entry.ContentType) ? ChatTesterHttp.JsonContentType : entry.ContentType;
        UseCustomJson = true;
        CustomRequestBody = entry.RequestBody;
        RequestHeadersText = entry.RequestHeadersText;
        ResponseHeadersText = entry.ResponseHeadersText;
        RequestBodyDisplay = entry.RequestBody;
        ObservedResponse = entry.ResponseBody;
        DisplayResponse = entry.DisplayResponse;
        StatusMessage = entry.StatusMessage;
        ActiveResponseTab = string.IsNullOrWhiteSpace(entry.ActiveResponseTab) ? "response-body" : entry.ActiveResponseTab;
        ResponseMetrics = new VisionResponseMetrics
        {
            Status = entry.Metrics.Status,
            ContentType = entry.Metrics.ContentType,
            TimeToFirstByte = entry.Metrics.TimeToFirstByte,
            Duration = entry.Metrics.Duration,
            Chunks = entry.Metrics.Chunks,
            TotalBytes = entry.Metrics.TotalBytes
        };
        VisionResult = BuildVisionResultView(ObservedResponse, DisplayResponse);
        ActiveResultTab = SummaryResultTab;
        EnsureActiveResultTab();
        ShowResultPanelAfterResponse();

        return Task.CompletedTask;
    }

    private async Task DeleteHistoryEntryAsync(ChatHistoryEntry entry)
    {
        var wasSelected = string.Equals(SelectedHistoryEntryId, entry.Id, StringComparison.Ordinal);
        if (await ChatHistoryStore.DeleteAsync(entry.Id) && wasSelected)
        {
            SelectedHistoryEntryId = null;
            PageTagline = DefaultPageTagline;
        }
    }

    private bool ValidateImageInput()
    {
        if (UseCustomJson)
        {
            return true;
        }

        if (string.IsNullOrWhiteSpace(EffectiveImageUrl))
        {
            StatusMessage = "Select an image before sending the request.";
            return false;
        }

        if (VisionCatalog.RequiresExternalImageUrl(SelectedApi) && EffectiveImageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
        {
            StatusMessage = "Azure AI Vision Image Analysis expects an externally reachable image URL.";
            return false;
        }

        if (VisionCatalog.RequiresBase64Image(SelectedApi) && string.IsNullOrWhiteSpace(ResolveImageBase64()))
        {
            StatusMessage = "This API expects an uploaded image or data URL image.";
            return false;
        }

        return true;
    }

    private async Task StreamResponseAsync(HttpResponseMessage response, Stopwatch stopwatch)
    {
        var rawBuilder = new StringBuilder();
        var displayBuilder = new StringBuilder();
        SetVisionResultMessage(string.Empty);
        ObservedResponse = string.Empty;

        using var stream = await response.Content.ReadAsStreamAsync();
        using var reader = new StreamReader(stream);
        while (await reader.ReadLineAsync() is { } line)
        {
            ResponseMetrics.Chunks++;
            ResponseMetrics.TotalBytes += Encoding.UTF8.GetByteCount(line) + 1;
            rawBuilder.AppendLine(line);
            ObservedResponse = rawBuilder.ToString();

            var payload = ChatStreamParser.ExtractDataPayload(line);
            if (payload is not null)
            {
                var piece = ChatStreamParser.ExtractDeltaText(payload);
                if (!string.IsNullOrEmpty(piece))
                {
                    displayBuilder.Append(piece);
                    DisplayResponse = displayBuilder.ToString();
                    VisionResult = BuildPlainVisionResult(DisplayResponse);
                    EnsureActiveResultTab();
                }
            }

            ResponseMetrics.Duration = stopwatch.Elapsed;
            await InvokeAsync(StateHasChanged);
        }

        if (rawBuilder.Length == 0)
        {
            ObservedResponse = "The server returned an empty response body.";
            SetVisionResultMessage("I did not receive any content from the server.");
        }
        else if (string.IsNullOrWhiteSpace(DisplayResponse))
        {
            SetVisionResultFromObserved(rawBuilder.ToString());
        }
    }

    private async Task ReadBufferedResponseAsync(HttpResponseMessage response, Stopwatch stopwatch)
    {
        var body = await response.Content.ReadAsStringAsync();
        ResponseMetrics.Chunks = string.IsNullOrEmpty(body) ? 0 : 1;
        ResponseMetrics.TotalBytes = Encoding.UTF8.GetByteCount(body);
        ResponseMetrics.Duration = stopwatch.Elapsed;
        ObservedResponse = string.IsNullOrWhiteSpace(body) ? "The server returned an empty response body." : body;
        SetVisionResultFromObserved(ObservedResponse);
    }

    private async Task RunMetricsTimerAsync(Stopwatch stopwatch, CancellationToken cancellationToken, VisionResponseMetrics metrics, MultiRequestStatusItem? statusItem = null)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            metrics.Duration = stopwatch.Elapsed;
            if (statusItem is not null)
            {
                statusItem.Duration = metrics.Duration;
                statusItem.TimeToFirstByte = metrics.TimeToFirstByte;
                statusItem.Chunks = metrics.Chunks;
                statusItem.TotalBytes = metrics.TotalBytes;
            }

            await InvokeAsync(StateHasChanged);
            await Task.Delay(100, cancellationToken);
        }
    }

    private string BuildGeneratedRequestBody()
    {
        return VisionCatalog.BuildRequestBody(new VisionRequestBuildContext
        {
            ApiId = SelectedApi,
            ModelId = SelectedModel,
            Prompt = Prompt,
            ImageUrl = EffectiveImageUrl,
            ImageBase64 = ResolveImageBase64(),
            ImageMimeType = ResolveImageMimeType(),
            Fields = FieldValues
        });
    }

    private string ResolveImageBase64()
    {
        if (!string.IsNullOrWhiteSpace(ImageBase64))
        {
            return ImageBase64;
        }

        return TryParseDataUrl(EffectiveImageUrl, out _, out var data) ? data : string.Empty;
    }

    private string ResolveImageMimeType()
    {
        if (TryParseDataUrl(EffectiveImageUrl, out var mimeType, out _))
        {
            return mimeType;
        }

        return string.IsNullOrWhiteSpace(ImageMimeType) ? "image/jpeg" : ImageMimeType;
    }

    private void EnsureSelectedApi(string? preferredApi = null)
    {
        var apis = AvailableApis;
        if (!string.IsNullOrWhiteSpace(SelectedApi) && apis.Any(api => string.Equals(api.Id, SelectedApi, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }

        SelectedApi = apis.FirstOrDefault(api => string.Equals(api.Id, preferredApi, StringComparison.OrdinalIgnoreCase))?.Id
            ?? apis.FirstOrDefault()?.Id
            ?? string.Empty;
    }

