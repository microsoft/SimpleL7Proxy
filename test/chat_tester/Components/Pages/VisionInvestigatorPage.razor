    private void ApplyManagedQueryValues(string endpointPath)
    {
        var queryIndex = endpointPath.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex < 0)
        {
            return;
        }

        var query = endpointPath[(queryIndex + 1)..];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = part.Split('=', 2);
            var name = DecodeQueryPart(pieces[0]);
            if (!FieldValues.ContainsKey(name))
            {
                continue;
            }

            FieldValues[name] = pieces.Length > 1 ? DecodeQueryPart(pieces[1]) : string.Empty;
        }
    }

    private static string AppendFieldQueryParameters(string endpointPath, IReadOnlyDictionary<string, string> fields)
    {
        var result = endpointPath.Trim();
        if (string.IsNullOrWhiteSpace(result))
        {
            return result;
        }

        foreach (var (name, value) in fields)
        {
            if (!string.IsNullOrWhiteSpace(value) && !ContainsQueryParameter(result, name))
            {
                result = AppendQueryParameter(result, name, value);
            }
        }

        return result;
    }

    private static string StripManagedQueryParameters(string endpointPath, IEnumerable<string> managedNames)
    {
        var queryIndex = endpointPath.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex < 0)
        {
            return endpointPath;
        }

        var managedNameSet = managedNames.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var basePath = endpointPath[..queryIndex];
        var query = endpointPath[(queryIndex + 1)..];
        var retainedParts = query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Where(part =>
            {
                var key = part.Split('=', 2)[0];
                return !managedNameSet.Contains(DecodeQueryPart(key));
            })
            .ToArray();

        return retainedParts.Length == 0 ? basePath : $"{basePath}?{string.Join('&', retainedParts)}";
    }

    private static string AppendQueryParameter(string endpointPath, string name, string value)
    {
        var separator = endpointPath.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return endpointPath + separator + Uri.EscapeDataString(name) + "=" + Uri.EscapeDataString(value);
    }

    private static bool ContainsQueryParameter(string endpointPath, string name)
    {
        var queryIndex = endpointPath.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex < 0)
        {
            return false;
        }

        var query = endpointPath[(queryIndex + 1)..];
        return query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => DecodeQueryPart(part.Split('=', 2)[0]))
            .Any(key => string.Equals(key, name, StringComparison.OrdinalIgnoreCase));
    }

    private static string DecodeQueryPart(string value) => Uri.UnescapeDataString(value.Replace("+", "%20", StringComparison.Ordinal));

    private void OnFieldChanged(string name, string value)
    {
        FieldValues[name] = value;
        RefreshCustomRequestBodyIfNeeded();
    }

    private void OnFeatureChanged(string feature, bool isSelected)
    {
        var features = GetCurrentFeatures().ToList();
        if (isSelected && !features.Contains(feature, StringComparer.OrdinalIgnoreCase))
        {
            features.Add(feature);
        }
        else if (!isSelected)
        {
            features.RemoveAll(item => string.Equals(item, feature, StringComparison.OrdinalIgnoreCase));
        }

        SetFeatures(features);
    }

    private void OnAdditionalFeaturesChanged(ChangeEventArgs args)
    {
        var selectedKnownFeatures = GetCurrentFeatures().Where(IsKnownFeature);
        var additionalFeatures = ParseFeatureList(args.Value?.ToString() ?? string.Empty).Where(feature => !IsKnownFeature(feature));
        SetFeatures(selectedKnownFeatures.Concat(additionalFeatures));
    }

