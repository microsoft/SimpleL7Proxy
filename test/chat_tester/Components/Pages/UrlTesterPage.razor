@page "/url-tester"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@inject IOptions<ChatTesterOptions> Options
@inject HttpClient Http
@inject IJSRuntime JS
@inject ChatHistoryStore ChatHistoryStore
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Extensions.Options
@using System.Diagnostics

<PageTitle>URL tester</PageTitle>

<SectionContent SectionName="page-heading">
    <div class="d-flex flex-wrap align-items-baseline gap-3">
        <h1 class="h4 mb-0">URL tester</h1>
        <span class="text-muted small mb-0">Check multiple URLs rapidly and inspect the status, response headers, and content for each.</span>
    </div>
</SectionContent>

<div class="row g-4">
    <div class="col-lg-5">
        <TestFormPanel @ref="FormPanel"
                      Settings="AuthSettings"
                      UserSettings="UserSettings"
                      HeaderSettings="HeaderSettings"
                      InitialServerBaseUrl="@InitialServerBaseUrl"
                      HeaderSubtitle="Test URLs rapidly."
                      PromptTabLabel="URLs"
                      CardTitle="URL tester settings"
                      SubmitLabel="Run URL test"
                      BusyLabel="Testing..."
                      IsBusy="@IsRunning"
                      SubmitButtonClass="btn-primary"
                      OnSubmit="RunProbeAsync">
            <PromptContent>
                <div class="mb-3">
                    <label class="form-label">Method</label>
                    <InputSelect class="form-select" @bind-Value="SelectedMethod">
                        <option value="GET">GET</option>
                        <option value="POST">POST</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">Target URLs (one per line)</label>
                    <InputTextArea class="form-control font-monospace" rows="10" @bind-Value="TargetUrlsText" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Payload</label>
                    <InputTextArea class="form-control font-monospace" rows="3" @bind-Value="Payload" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Request count</label>
                    <InputNumber class="form-control" @bind-Value="RequestCount" />
                </div>
            </PromptContent>
        </TestFormPanel>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Results</h5>
                <p class="mb-3">@StatusMessage</p>

                @if (Results.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle url-tester-table" @ref="ResultsTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Endpoint</th>
                                    <th>Status</th>
                                    <th>Outcome</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var result in Results.Take(50))
                                {
                                    <tr class="result-row @(result.StatusCode == 0 || result.StatusCode >= 400 ? "table-danger" : string.Empty)">
                                        <td>@result.Index</td>
                                        <td><code>@result.Url</code></td>
                                        <td>@result.StatusCode</td>
                                        <td class="result-outcome-cell">
                                            @result.Outcome
                                            <UrlTestResultPopup Result="result" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No URL tests have run yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .url-tester-table tbody tr.result-row { position: relative; }
    .result-outcome-cell { position: relative; white-space: nowrap; }

    /* panel default — JS overrides position/size/display on hover */
    .probe-summary-panel {
        display: none;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.18);
        padding: 0.75rem;
        font-size: 0.8rem;
        text-align: left;
        overflow-y: auto;
        z-index: 9999;
    }
    .probe-summary-url {
        margin-bottom: 0.5rem;
        word-break: break-all;
        color: #495057;
    }
    .probe-summary-metrics {
        display: grid;
        grid-template-columns: 6.5rem 1fr;
        gap: 0.2rem 0.5rem;
        margin-bottom: 0.5rem;
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 0.5rem;
    }
    .psm-row { display: contents; }
    .psm-row > span:first-child { color: #6c757d; }
    .psm-row > span.prs-ok { color: #198754; font-weight: 600; }
    .psm-row > span.prs-err { color: #dc3545; font-weight: 600; }
    .probe-summary-section { margin-top: 0.5rem; }
    .probe-summary-label { font-weight: 600; color: #495057; margin-bottom: 0.25rem; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.03em; }
    .probe-summary-pre {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 0.25rem;
        padding: 0.4rem 0.5rem;
        margin: 0;
        font-size: 0.73rem;
        white-space: pre-wrap;
        word-break: break-all;
        max-height: 150px;
        overflow-y: auto;
    }
</style>

@code {
    private string InitialServerBaseUrl { get; set; } = string.Empty;
    private string SelectedMethod { get; set; } = "GET";
    [Inject]
    private AuthTokenSettings AuthSettings { get; set; } = default!;
    [Inject]
    private UserSettings UserSettings { get; set; } = default!;
    [Inject]
    private HeaderSettings HeaderSettings { get; set; } = default!;
    private TestFormPanel? FormPanel { get; set; }
    private ElementReference ResultsTable { get; set; }
    private string TargetUrlsText { get; set; } = string.Empty;
    private string Payload { get; set; } = "{\"message\":\"auth-probe\"}";
    private int RequestCount { get; set; } = 20;
    private bool IsRunning { get; set; }
    private string StatusMessage { get; set; } = "Ready to start.";
    private List<ProbeResult> Results { get; set; } = new();

    protected override void OnInitialized()
    {
        var options = Options.Value;
        InitialServerBaseUrl = options.ServerBaseUrl;
        AuthSettings.ApplyDefaultsIfMissing(options.AuthorizationHeaderName, options.AuthorizationHeaderPrefix);
        UserSettings.ApplyDefaultsIfMissing(options.UserHeaderName, options.PriorityKeyHeader, options.UserNames);
        HeaderSettings.ApplyDefaultsIfMissing(options.DefaultHeaders);
        TargetUrlsText = string.Join(Environment.NewLine, options.AuthTargetUrls);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Results.Count > 0)
        {
            try { await JS.InvokeVoidAsync("probeTable.register", ResultsTable); }
            catch (JSException) { }
        }
    }

    private async Task RunProbeAsync()
    {
        var serverBaseUrl = FormPanel?.ServerBaseUrl ?? string.Empty;
        if (string.IsNullOrWhiteSpace(serverBaseUrl))
        {
            StatusMessage = "Set a server base URL before running the probe.";
            return;
        }

        var targets = ChatTesterHttp.ParseTargetLines(TargetUrlsText);
        if (targets.Count == 0)
        {
            StatusMessage = "Add at least one target URL before running the probe.";
            return;
        }

        IsRunning = true;
        StatusMessage = "Resolving token and sending requests...";
        Results.Clear();
        StateHasChanged();

        try
        {
            var headerValue = await (FormPanel?.ResolveHeaderValueAsync() ?? Task.FromResult(string.Empty));
            var hasAuth = !string.IsNullOrWhiteSpace(headerValue);
            if (!hasAuth)
            {
                StatusMessage = "No token resolved \u2014 sending unauthenticated requests.";
                StateHasChanged();
            }
            var client = Http;
            for (var requestIndex = 1; requestIndex <= RequestCount; requestIndex++)
            {
                foreach (var target in targets)
                {
                    var endpoint = ChatTesterHttp.BuildSessionEndpoint(serverBaseUrl, target, requestIndex);
                    var request = BuildRequest(endpoint, requestIndex);
                    try
                    {
                        if (hasAuth && FormPanel is not null)
                        {
                            await FormPanel.ApplyAuthorizationAsync(request);
                        }

                        UserSettings.ApplyUser(request, requestIndex);
                        HeaderSettings.ApplyHeaders(request, requestIndex);
                        var requestHeaders = ChatTesterHttp.SummarizeRequestHeaders(request);

                        var sw = Stopwatch.StartNew();
                        using var response = await client.SendAsync(request, HttpCompletionOption.ResponseHeadersRead);
                        var ttfb = sw.Elapsed;
                        var body = await response.Content.ReadAsStringAsync();
                        sw.Stop();

                        var outcome = response.ReasonPhrase?.Trim() ?? string.Empty;
                        var responseHeaders = ChatTesterHttp.SummarizeResponseHeaders(response);
                        var contentType = response.Content.Headers.ContentType?.ToString() ?? string.Empty;
                        Results.Add(new ProbeResult(
                            requestIndex, endpoint.ToString(), (int)response.StatusCode, outcome,
                            responseHeaders, body, ttfb, sw.Elapsed, contentType, body.Length));
                        await ChatHistoryStore.AddRequest(new RequestHistoryEntry
                        {
                            Source = "URL tester",
                            Method = SelectedMethod,
                            ServerBaseUrl = serverBaseUrl,
                            EndpointPath = endpoint.PathAndQuery,
                            ContentType = contentType,
                            RequestHeadersText = requestHeaders,
                            ResponseHeadersText = responseHeaders,
                            RequestBody = Payload,
                            ResponseBody = body,
                            DisplayResponse = body,
                            StatusMessage = $"{(int)response.StatusCode} {outcome}".Trim(),
                            Metrics = new ChatHistoryMetrics
                            {
                                Status = $"{(int)response.StatusCode} {outcome}".Trim(),
                                ContentType = contentType,
                                TimeToFirstByte = ttfb,
                                Duration = sw.Elapsed,
                                TotalBytes = body.Length
                            }
                        });
                    }
                    catch (Exception ex)
                    {
                        Results.Add(new ProbeResult(requestIndex, endpoint.ToString(), 0, ex.Message));
                        await ChatHistoryStore.AddRequest(new RequestHistoryEntry
                        {
                            Source = "URL tester",
                            Method = SelectedMethod,
                            ServerBaseUrl = serverBaseUrl,
                            EndpointPath = endpoint.PathAndQuery,
                            RequestBody = Payload,
                            ResponseBody = ex.Message,
                            DisplayResponse = ex.Message,
                            StatusMessage = "Failed",
                            Metrics = new ChatHistoryMetrics { Status = "Failed" }
                        });
                    }
                }
            }

            StatusMessage = hasAuth
                ? $"Completed {RequestCount * targets.Count} requests with header '{AuthSettings.HeaderName}'."
                : $"Completed {RequestCount * targets.Count} unauthenticated requests.";
        }
        catch (Exception ex)
        {
            StatusMessage = $"The URL test stopped with an error: {ex.Message}";
        }
        finally
        {
            IsRunning = false;
            StateHasChanged();
        }
    }

    private HttpRequestMessage BuildRequest(Uri endpoint, int requestIndex)
    {
        var request = ChatTesterHttp.CreateRequest(SelectedMethod, endpoint, Payload);
        request.Headers.Add("X-Url-Test-Id", requestIndex.ToString());
        return request;
    }
}
