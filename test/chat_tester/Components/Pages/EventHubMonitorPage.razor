            new StatTile("Request", stats.TotalRequests.ToString("N0"), "last hour",
                stats.SuccessRate >= 95 ? "success" : "warning",
                new[]
                {
                    new TileMetric("Req / sec", stats.RequestsPerSecond.ToString("0.#")),
                    new TileMetric("Success", $"{stats.SuccessRate:0.#}%"),
                    new TileMetric("Failed", stats.Failed.ToString("N0")),
                    new TileMetric("Enqueued", stats.EnqueuedCount.ToString("N0")),
                    new TileMetric("Processing", stats.ProcessingCount.ToString("N0")),
                    new TileMetric("Completed", stats.CompletedCount.ToString("N0")),
                    new TileMetric("Avg size", FormatBytes(stats.AverageRequestSizeBytes)),
                }),
            new StatTile("Server", $"{stats.AvgLatencyMs:0} ms", "backend avg", "info",
                new[]
                {
                    new TileMetric("Probe", $"{stats.BackendProbeLatencyMs:0} ms"),
                    new TileMetric("Balancing", stats.LoadBalancingMode),
                    new TileMetric("Enqueue", $"{serverErrors.EnqueueSuccess}/{serverErrors.EnqueueAttempts} ({serverErrors.EnqueueSuccessRate:0.#}%)"),
                    new TileMetric("Enqueue failed", serverErrors.EnqueueFailed.ToString("N0")),
                    new TileMetric("Enqueue Q/AH", $"{serverErrors.LastEnqueueQueueLength}/{serverErrors.LastEnqueueActiveHosts}"),
                    new TileMetric("Rejected", serverErrors.RejectedRequests.ToString("N0")),
                    new TileMetric("403 NotAuth", serverErrors.NotAuthorized403Count.ToString("N0")),
                    new TileMetric("Queue len", $"{serverErrors.LatestQueueLength} (max {serverErrors.MaxQueueLength})"),
                },
                CornerStatus: circuitState,
                CornerCss: circuitCss,
                CornerHoverDetails: circuitHoverDetails),
        };
    }

    private static string FormatRelativeTime(DateTimeOffset timestampUtc)
    {
        var delta = DateTimeOffset.UtcNow - timestampUtc;
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta.TotalSeconds < 60)
        {
            var seconds = Math.Max(1, (int)delta.TotalSeconds);
            return seconds == 1 ? "1 second ago" : $"{seconds} seconds ago";
        }

        if (delta.TotalMinutes < 60)
        {
            var minutes = (int)delta.TotalMinutes;
            return minutes == 1 ? "1 minute ago" : $"{minutes} minutes ago";
        }

        if (delta.TotalHours < 24)
        {
            var hours = (int)delta.TotalHours;
            return hours == 1 ? "1 hour ago" : $"{hours} hours ago";
        }

        var days = (int)delta.TotalDays;
        return days == 1 ? "1 day ago" : $"{days} days ago";
    }

    private static string FormatBytes(double bytes)
    {
        if (bytes <= 0)
        {
            return "—";
        }

        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024 * 1024):0.#} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024:0.#} KB";
        }

        return $"{bytes:0} B";
    }

    private static string GetHeaderCssClass(string tone)
    {
        return tone switch
        {
            "error" => "card-header eventhub-header eventhub-header-error",
            "warn" => "card-header eventhub-header eventhub-header-warn",
            _ => "card-header eventhub-header eventhub-header-good",
        };
    }

    private string GetRuntimeHeaderTone()
    {
        if (!IsConnected || !_snapshot.HasData)
        {
            return "warn";
        }

        var stats = _snapshot.Stats;
        if (stats.ServerCircuitBreakerOpen || stats.SuccessRate < 80)
        {
            return "error";
        }

        if (stats.Failed > 0 || stats.SuccessRate < 95)
        {
            return "warn";
        }

        return "good";
    }

    private string GetRuntimeHeaderReason()
    {
        if (!string.Equals(RuntimeHeaderTone, "good", StringComparison.OrdinalIgnoreCase))
        {
            if (!IsConnected || !_snapshot.HasData)
            {
                return "No live runtime data yet.";
            }

            var stats = _snapshot.Stats;
            if (stats.ServerCircuitBreakerOpen)
            {
                return "Server circuit breaker is open.";
            }

            if (stats.Failed > 0)
            {
                return $"Failed requests observed: {stats.Failed}.";
            }

            return $"Success rate is {stats.SuccessRate:0.#}% (below target).";
        }

        return string.Empty;
    }

    private string GetBackendsHeaderTone()
    {
        if (!IsConnected || Backends.Count == 0)
        {
            return "warn";
        }

        if (Backends.Any(backend => string.Equals(backend.Css, "down", StringComparison.OrdinalIgnoreCase)))
        {
            return "error";
        }

        if (Backends.Any(backend => string.Equals(backend.Css, "degraded", StringComparison.OrdinalIgnoreCase)))
        {
            return "warn";
        }

        return "good";
    }

    private string GetBackendsHeaderReason()
    {
        if (!string.Equals(BackendsHeaderTone, "good", StringComparison.OrdinalIgnoreCase))
        {
            if (!IsConnected || Backends.Count == 0)
            {
                return "No backend health records received.";
            }

            var down = Backends
                .Where(backend => string.Equals(backend.Css, "down", StringComparison.OrdinalIgnoreCase))
                .Select(backend => backend.Name)
                .ToArray();
            if (down.Length > 0)
            {
                return $"Down backends: {string.Join(", ", down)}.";
            }

            var degraded = Backends
                .Where(backend => string.Equals(backend.Css, "degraded", StringComparison.OrdinalIgnoreCase))
                .Select(backend => backend.Name)
                .ToArray();
            if (degraded.Length > 0)
            {
                return $"Degraded backends: {string.Join(", ", degraded)}.";
            }
        }

        return string.Empty;
    }

    private string GetEndpointsHeaderTone()
    {
        if (!IsConnected || EndpointTiles.Count == 0)
        {
            return "warn";
        }

        if (EndpointTiles.Any(tile => string.Equals(tile.Css, "down", StringComparison.OrdinalIgnoreCase)))
        {
            return "error";
        }

        if (EndpointTiles.Any(tile => string.Equals(tile.Css, "degraded", StringComparison.OrdinalIgnoreCase)))
        {
            return "warn";
        }

        return "good";
    }

    private string GetEndpointsHeaderReason()
    {
        if (!string.Equals(EndpointsHeaderTone, "good", StringComparison.OrdinalIgnoreCase))
        {
            if (!IsConnected || EndpointTiles.Count == 0)
            {
                return "No endpoint usage records received.";
            }

            var down = EndpointTiles
                .Where(tile => string.Equals(tile.Css, "down", StringComparison.OrdinalIgnoreCase))
                .Select(tile => tile.Path)
                .ToArray();
            if (down.Length > 0)
            {
                return $"High failure models: {string.Join(", ", down)}.";
            }

            var degraded = EndpointTiles
                .Where(tile => string.Equals(tile.Css, "degraded", StringComparison.OrdinalIgnoreCase))
                .Select(tile => tile.Path)
                .ToArray();
            if (degraded.Length > 0)
            {
                return $"Some model endpoints are degraded.";
            }
        }

        return string.Empty;
    }

    private string GetRequestHeaderTone()
    {
        var items = HistoryItems;
        if (!IsConnected || items.Count == 0)
        {
            return "warn";
        }

        var failedItems = items.Count(item => item.StatusCode is >= 400);
        if (items.Any(item => item.StatusCode is >= 500))
        {
            return "error";
        }

        return failedItems > 0 ? "warn" : "good";
    }

    private string GetPathsHeaderTone()
    {
        if (!IsConnected)
        {
            return "warn";
        }

        var failed = FailedPaths.Sum(item => item.Count);
        var succeeded = SuccessfulPaths.Sum(item => item.Count);
        var total = failed + succeeded;

        if (total == 0)
        {
            return "warn";
        }

        var failedRate = (double)failed / total;
        if (failedRate >= 0.25)
        {
            return "error";
        }

        return failed > 0 ? "warn" : "good";
    }

    private string GetPathsHeaderReason()
    {
        if (!string.Equals(PathsHeaderTone, "good", StringComparison.OrdinalIgnoreCase))
        {
            if (!IsConnected)
            {
                return "Not connected to Event Hub.";
            }

            var failed = FailedPaths.Sum(item => item.Count);
            var succeeded = SuccessfulPaths.Sum(item => item.Count);
            var total = failed + succeeded;
            if (total == 0)
            {
                return "No path outcomes recorded.";
            }

            return $"Failed path requests: {failed}/{total}.";
        }

        return string.Empty;
    }

