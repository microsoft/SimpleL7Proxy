@page "/eventhub"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@implements IAsyncDisposable
@using chat_tester.Components.Shared
@using chat_tester.Components.Shared.EventHub
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using System.Globalization
@using System.Text.RegularExpressions
@inject EventHubMonitorStore Store
@inject ProxyMetricsCatalog MetricsCatalog
@inject IOptions<EventHubMonitorOptions> MonitorOptions
@inject IJSRuntime JS

<PageTitle>EventHub Monitor</PageTitle>

<InspectorPageShell Title="EventHub Monitor"
                    Tagline="@Tagline"
                    MetadataLine1="@HeaderMetadataLine1"
                    MetadataLine2="@HeaderMetadataLine2"
                    HideControls="true"
                    HistoryEntries="@ScopeHistoryEntries"
                    SelectedHistoryEntryId="@SelectedScopeId"
                    HistorySource="EventHub monitor">
    <div class="eventhub-toprow">
        <div class="eventhub-toprow-filters">
            <div class="card shadow-sm eventhub-card eventhub-filters-card">
                <div class="card-header eventhub-filters-header">
                    <span class="fw-semibold eventhub-filters-header-label">Filters</span>
                    <button type="button"
                            class="btn btn-link p-0 eventhub-filters-header-trigger"
                            @onclick="OpenFilterDialog"
                            aria-haspopup="dialog"
                            aria-expanded="@_isFilterDialogOpen"
                            aria-controls="eventhub-filters-dialog">
                        Filters
                    </button>
                </div>
                <div class="card-body eventhub-card-body">
                    <EventHubTopFilters EnvironmentOptions="@EnvironmentFilterOptions"
                                        SelectedEnvironment="@SelectedEnvironmentFilter"
                                        SelectedEnvironmentChanged="OnEnvironmentUiChanged"
                                        ShowUserFilter="@_snapshot.HasUserInfo"
                                        UserOptions="@UserFilterOptions"
                                        SelectedUser="@SelectedUserFilter"
                                        SelectedUserChanged="OnUserUiChanged"
                                        ShowModelFilter="@_snapshot.HasModelInfo"
                                        ModelOptions="@ModelFilterOptions"
                                        SelectedModel="@SelectedModelFilter"
                                        SelectedModelChanged="OnModelUiChanged" />
                </div>
            </div>
        </div>
    </div>

    @if (_isFilterDialogOpen)
    {
        <div class="eventhub-filter-dialog-backdrop" @onclick="CloseFilterDialog"></div>
        <div id="eventhub-filters-dialog"
             class="eventhub-filter-dialog"
             role="dialog"
             aria-modal="true"
             aria-label="Filters"
             @onclick:stopPropagation="true">
            <div class="eventhub-filter-dialog-header">
                <span class="fw-semibold">Filters</span>
                <button type="button" class="btn-close" aria-label="Close filters" @onclick="CloseFilterDialog"></button>
            </div>
            <div class="eventhub-filter-dialog-body">
                <EventHubTopFilters EnvironmentOptions="@EnvironmentFilterOptions"
                                    SelectedEnvironment="@SelectedEnvironmentFilter"
                                    SelectedEnvironmentChanged="OnEnvironmentUiChanged"
                                    ShowUserFilter="@_snapshot.HasUserInfo"
                                    UserOptions="@UserFilterOptions"
                                    SelectedUser="@SelectedUserFilter"
                                    SelectedUserChanged="OnUserUiChanged"
                                    ShowModelFilter="@_snapshot.HasModelInfo"
                                    ModelOptions="@ModelFilterOptions"
                                    SelectedModel="@SelectedModelFilter"
                                    SelectedModelChanged="OnModelUiChanged" />
            </div>
        </div>
    }

    <div class="row g-4 eventhub-workspace">

        @* ── Backends column ── *@
        <div class="col-12 col-lg-3 eventhub-config-col order-3">
            <div class="card shadow-sm eventhub-card eventhub-backends-card">
                <div class="@GetHeaderCssClass(BackendsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Backends</span>
                        <span class="text-white-50 small">@BackendSubtitle</span>
                        @if (!string.IsNullOrWhiteSpace(BackendsHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@BackendsHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-form-content">
                        @if (Backends.Count > 0)
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm eventhub-backend-table mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Backend</th>
                                            <th scope="col">Status</th>
                                            <th scope="col" class="text-end">Lat</th>
                                            <th scope="col" class="text-end">Succ</th>
                                            <th scope="col" class="text-end">Calls</th>
                                            <th scope="col" class="text-end">Fail</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var backend in Backends)
                                        {
                                            <tr>
                                                <td title="@backend.Url">@backend.Name</td>
                                                <td title="@GetBackendCircuitBreakerTitle(backend)">
                                                    @backend.Status
                                                    <span class="eventhub-cb-indicator @GetBackendCircuitBreakerCss(backend) ms-1" aria-hidden="true">@GetBackendCircuitBreakerGlyph(backend)</span>
                                                </td>
                                                <td class="text-end">@backend.LatencyText</td>
                                                <td class="text-end" title="Probe OK/Fail: @backend.ProbeSuccesses/@backend.ProbeFailures">@backend.SuccessRate%</td>
                                                <td class="text-end">@backend.RequestCalls</td>
                                                <td class="text-end">@backend.RequestFailures</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No backend health received yet.</div>
                        }

                        <div class="eventhub-catalog-groups">
                            @foreach (var group in ProxyMetricGroups)
                            {
                                <section class="eventhub-catalog-group">
                                    <h6 class="eventhub-catalog-group-title">@group.Name</h6>
                                    <dl class="eventhub-catalog-metrics">
                                        @foreach (var metric in group.Metrics)
                                        {
                                            <div class="eventhub-catalog-row" title="@metric.Description">
                                                <dt>@metric.Name</dt>
                                                <dd>@metric.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="eventhub-row-resizer" role="separator" aria-orientation="horizontal" aria-label="Resize Backends and Endpoints heights">
                <span class="eventhub-row-resizer-grip" aria-hidden="true">===</span>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-endpoints-card">
                <div class="@GetHeaderCssClass(EndpointsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Endpoints</span>
                        @if (!string.IsNullOrWhiteSpace(EndpointsHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@EndpointsHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (EndpointTiles.Count == 0)
                    {
                        <div class="text-muted small">No endpoint backend-call records received yet.</div>
                    }
                    else
                    {
                        <div class="eventhub-model-list">
                            @foreach (var endpoint in EndpointTiles)
                            {
                                <div class="eventhub-model-card @endpoint.Css">
                                    <div class="eventhub-model-head">
                                        <span class="eventhub-model-name">@endpoint.Path</span>
                                        <span class="eventhub-model-status">@endpoint.Status</span>
                                    </div>
                                    <div class="eventhub-model-summary">
                                        <span>Calls <strong>@endpoint.Calls</strong></span>
                                        <span>Fail <strong>@endpoint.Failures</strong></span>
                                        <span>Throttled <strong>@endpoint.ThrottledEvents</strong></span>
                                        <span>Endpoints <strong>@endpoint.EndpointCount</strong></span>
                                        <span>P1 <strong>@endpoint.Priority1Count</strong></span>
                                        <span>P2 <strong>@endpoint.Priority2Count</strong></span>
                                        <span>P3 <strong>@endpoint.Priority3Count</strong></span>
                                    </div>

                                    @if (endpoint.EndpointUsages.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm eventhub-model-table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th scope="col">Label</th>
                                                        <th scope="col" class="text-end">Calls</th>
                                                        <th scope="col" class="text-end">Fail</th>
                                                        <th scope="col" class="text-end">Throttled</th>
                                                        <th scope="col" class="text-end">P1</th>
                                                        <th scope="col" class="text-end">P2</th>
                                                        <th scope="col" class="text-end">P3</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var usage in endpoint.EndpointUsages)
                                                    {
                                                        <tr>
                                                            <td title="@usage.TargetUrl">@usage.TargetName</td>
                                                            <td class="text-end">@usage.Calls</td>
                                                            <td class="text-end">@usage.Failures</td>
                                                            <td class="text-end">@usage.ThrottledEvents</td>
                                                            <td class="text-end">@usage.Priority1Count</td>
                                                            <td class="text-end">@usage.Priority2Count</td>
                                                            <td class="text-end">@usage.Priority3Count</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Server column (runtime stats + endpoints + paths + users) ── *@
        <div class="col-12 col-lg-5 eventhub-endpoints-col order-2">
            <div class="card shadow-sm eventhub-card">
                <div class="@($"{GetHeaderCssClass(RuntimeHeaderTone)} eventhub-header-with-resize")">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Runtime Stats</span>
                        @if (!string.IsNullOrWhiteSpace(RuntimeHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@RuntimeHeaderReason</span>
                        }
                    </div>
                    <button type="button"
                            class="eventhub-col-resizer-grip eventhub-col-handle-mr"
                            aria-label="Resize Runtime Stats and Backends columns"></button>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-stats-grid">
                        @foreach (var tile in StatTiles)
                        {
                            <div class="eventhub-stat-tile @tile.Css">
                                <div class="eventhub-tile-head">
                                    <div class="eventhub-tile-head-main">
                                        <span class="eventhub-tile-title">@tile.Title</span>
                                        <span class="eventhub-tile-primary">@tile.Primary</span>
                                        @if (!string.IsNullOrWhiteSpace(tile.PrimaryDetail))
                                        {
                                            <span class="eventhub-tile-primary-detail">@tile.PrimaryDetail</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(tile.CornerStatus))
                                    {
                                        <div class="eventhub-tile-corner" title="@tile.CornerHoverDetails" aria-label="Circuit breaker @tile.CornerStatus">
                                            <span class="eventhub-cb-indicator @tile.CornerCss" aria-hidden="true">@(tile.CornerCss == "closed" ? "👍" : "✕")</span>
                                        </div>
                                    }
                                </div>
                                @if (tile.Metrics.Count > 0)
                                {
                                    <div class="eventhub-tile-metrics">
                                        @foreach (var metric in tile.Metrics)
                                        {
                                            <div class="eventhub-tile-metric">
                                                <span class="eventhub-tile-metric-label">@metric.Label</span>
                                                <span class="eventhub-tile-metric-value">@metric.Value</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @{
                // Shared success/failed two-column markup for both the Paths and Users cards
                // (used by the always-present wide cards and, at <=860px viewport height, by the
                // merged tabbed card below) so the list rendering isn't duplicated per card.
                RenderFragment<(IReadOnlyList<LabeledCount> Success, IReadOnlyList<LabeledCount> Failed, string SuccessEmptyText, string FailedEmptyText)> groupsTemplate = ctx =>
                    @<div class="eventhub-path-groups">
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title success">Success</div>
                            @if (ctx.Success.Count == 0)
                            {
                                <div class="text-muted small">@ctx.SuccessEmptyText</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var item in ctx.Success)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@item.Label">@item.Label</dt>
                                            <dd>@item.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title failed">Failed</div>
                            @if (ctx.Failed.Count == 0)
                            {
                                <div class="text-muted small">@ctx.FailedEmptyText</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var item in ctx.Failed)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@item.Label">@item.Label</dt>
                                            <dd>@item.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                    </div>;
            }

            <div class="card shadow-sm eventhub-card eventhub-paths-card">
                <div class="@GetHeaderCssClass(PathsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Paths</span>
                        <span class="text-white-50 small">success vs failed</span>
                        @if (!string.IsNullOrWhiteSpace(PathsHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@PathsHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @groupsTemplate((SuccessfulPathsLabeled, FailedPathsLabeled, "No successful paths yet.", "No failed paths yet."))
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-paths-card eventhub-users-card">
                <div class="@GetHeaderCssClass(UsersHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Users</span>
                        <span class="text-white-50 small">success vs failed</span>
                        @if (!string.IsNullOrWhiteSpace(UsersHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@UsersHeaderReason</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @groupsTemplate((SuccessfulUsersLabeled, FailedUsersLabeled, "No successful users yet.", "No failed users yet."))
                </div>
            </div>

            @* ── Merged Paths/Users card: shown instead of the two cards above when the
               viewport height is 860px or less, so both stay reachable via tabs. ── *@
            <div class="card shadow-sm eventhub-card eventhub-paths-users-tabbed">
                <div class="@GetHeaderCssClass(_pathsUsersTab == "users" ? UsersHeaderTone : PathsHeaderTone)">
                    <div class="d-flex flex-wrap align-items-center gap-2 pe-3">
                        <span class="fw-semibold">Paths &amp; Users</span>
                        <span class="text-white-50 small">success vs failed</span>
                        @{
                            var tabbedHeaderReason = _pathsUsersTab == "users" ? UsersHeaderReason : PathsHeaderReason;
                        }
                        @if (!string.IsNullOrWhiteSpace(tabbedHeaderReason))
                        {
                            <span class="text-white-50 small eventhub-header-reason ms-auto">@tabbedHeaderReason</span>
                        }
                    </div>
                    <div class="eventhub-paths-users-tabs" role="tablist" aria-label="Paths and users">
                        <button type="button"
                                class="eventhub-tab-button @(_pathsUsersTab == "paths" ? "active" : string.Empty)"
                                role="tab"
                                aria-selected="@(_pathsUsersTab == "paths" ? "true" : "false")"
                                @onclick='() => SelectPathsUsersTab("paths")'>
                            Paths
                        </button>
                        <button type="button"
                                class="eventhub-tab-button @(_pathsUsersTab == "users" ? "active" : string.Empty)"
                                role="tab"
                                aria-selected="@(_pathsUsersTab == "users" ? "true" : "false")"
                                @onclick='() => SelectPathsUsersTab("users")'>
                            Users
                        </button>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (_pathsUsersTab == "users")
                    {
                        @groupsTemplate((SuccessfulUsersLabeled, FailedUsersLabeled, "No successful users yet.", "No failed users yet."))
                    }
                    else
                    {
                        @groupsTemplate((SuccessfulPathsLabeled, FailedPathsLabeled, "No successful paths yet.", "No failed paths yet."))
                    }
                </div>
            </div>
        </div>

        @* ── Request column (request status) ── *@
        <div class="col-12 col-lg-4 eventhub-monitor-col order-1">
            <div class="eventhub-history-shell eventhub-request-stats-compact">
                <EventHubRequestStatus Items="@HistoryItems" HeaderTone="@RequestHeaderTone" />
            </div>
        </div>

    </div>
</InspectorPageShell>

<style>
    .eventhub-header-reason {
        opacity: 0.95;
        font-style: italic;
    }

    .eventhub-toprow,
    .eventhub-workspace {
        --eventhub-col-request: 33%;
        --eventhub-col-runtime: 42%;
        --eventhub-col-backends: 25%;
        --eventhub-col-gap: 0.65rem;
        --eventhub-right-col-width: max(16rem, calc(25% - 0.45rem));
    }

    .eventhub-workspace {
        margin-left: 0;
        margin-right: 0;
        margin-top: var(--bs-gutter-y, 1rem);
        position: relative;
    }

    /* Float the filters box top-right within the shell, layered above the
       fixed header (same mechanism as .inspector-page-controls), so it
       stays merged with the header row at every width instead of pushing
       the workspace grid down. */
    .eventhub-toprow {
        position: absolute;
        top: 0.5rem;
        right: 1.5rem;
        z-index: 30;
        width: var(--eventhub-right-col-width);
        max-width: calc(100% - 3rem);
    }

    .eventhub-toprow-filters {
        width: 100%;
        max-width: 100%;
    }

    .eventhub-toprow-filters > .eventhub-filters-card {
        height: auto;
    }

    .eventhub-toprow-filters > .eventhub-filters-card > .card-body {
        padding: 0.2rem 0.5rem 0.24rem;
    }

    .eventhub-filters-header {
        padding: 0.16rem 0.5rem;
        border-bottom: 1px solid #dde1e6;
        font-size: 0.72rem;
        line-height: 1.2;
        background: #f7f7f7;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    @@media (max-width: 1199.98px) {
        .eventhub-col-resizer-grip {
            display: none;
        }
    }

    .eventhub-filters-header-trigger {
        display: none;
        font-size: 0.74rem;
        font-weight: 700;
        color: #1f2937;
        text-decoration: none;
        line-height: 1.1;
    }

    .eventhub-filters-header-trigger:hover,
    .eventhub-filters-header-trigger:focus-visible {
        text-decoration: underline;
        color: #111827;
    }

    .eventhub-filter-dialog-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.35);
        z-index: 1040;
    }

    .eventhub-filter-dialog {
        position: fixed;
        top: 4.5rem;
        left: 0.75rem;
        right: 0.75rem;
        z-index: 1050;
        background: #fff;
        border: 1px solid #d7dde5;
        border-radius: 0.5rem;
        box-shadow: 0 14px 38px rgba(15, 23, 42, 0.28);
        max-height: calc(100dvh - 6rem);
        overflow: auto;
    }

    .eventhub-filter-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid #dde1e6;
        background: #f7f7f7;
        color: #374151;
    }

    .eventhub-filter-dialog-body {
        padding: 0.65rem 0.75rem 0.75rem;
    }

    .eventhub-header {
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }

    .eventhub-header .text-white-50 {
        color: inherit !important;
        opacity: 0.75;
    }

    .eventhub-header-good {
        background: #d9f5df;
        color: #1f5131;
    }

    .eventhub-header-warn {
        background: #fff5bf;
        color: #6b4e00;
    }

    .eventhub-header-error {
        background: #7f1d1d;
        color: #fff;
    }

    .eventhub-col-resizer-grip {
        position: relative;
        z-index: 1;
        pointer-events: auto;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: #64748b;
        line-height: 1;
        background: #e8eef5;
        border: 1px solid #b9c5d4;
        border-radius: 3px;
        padding: 0 0.55rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.15);
        margin-top: 0;
        margin-left: 0.2rem;
        white-space: nowrap;
        transform: none;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: ew-resize !important;
        border: 1px solid #8ea0b8;
    }

    .eventhub-col-resizer-grip::before {
        content: "|||";
    }

    .eventhub-header-with-resize {
        position: relative;
        padding-right: 3.15rem !important;
        overflow: visible;
    }

    .eventhub-header-with-resize > .eventhub-col-resizer-grip {
        position: absolute;
        top: -1px;
        right: -1px;
        bottom: -1px;
        height: auto;
        margin: 0;
        transform: none;
        border-radius: 0 0.25rem 0.25rem 0;
        border-left-width: 1px;
        border-left-color: #8ea0b8;
    }

    .eventhub-col-resizer-grip:hover,
    .eventhub-col-resizer-grip:focus-visible,
    .eventhub-col-resizer-grip.dragging {
        background: #d0def0;
        border-color: #7f93ad;
        color: #2d4a6e;
        box-shadow: 0 1px 4px rgba(56, 115, 197, 0.25);
        cursor: ew-resize !important;
    }

    .eventhub-row-resizer {
        display: none;
        height: 0;
        position: relative;
        cursor: row-resize;
        user-select: none;
        border-radius: 0;
        align-items: center;
        justify-content: center;
        overflow: visible;
        z-index: 2;
    }

    .eventhub-row-resizer::before {
        content: none;
    }

    .eventhub-row-resizer-grip {
        position: relative;
        z-index: 1;
        pointer-events: auto;
        font-size: 0.66rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: #64748b;
        line-height: 1;
        background: #e8eef5;
        border: 1px solid #b9c5d4;
        border-radius: 3px;
        padding: 0.12rem 0.5rem;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.15);
        white-space: nowrap;
        transform: translateY(-50%);
        cursor: row-resize;
    }

    .eventhub-row-resizer:hover::before,
    .eventhub-row-resizer.dragging::before {
        background: #7f93ad;
    }

    .eventhub-row-resizer:hover .eventhub-row-resizer-grip,
    .eventhub-row-resizer.dragging .eventhub-row-resizer-grip {
        background: #d0def0;
        border-color: #7f93ad;
        color: #2d4a6e;
        box-shadow: 0 1px 4px rgba(56, 115, 197, 0.25);
    }

    @@media (min-width: 1200px) {
        ::deep .inspector-page-controls {
            width: max(16rem, calc(25% - 0.45rem));
        }

        .eventhub-workspace {
            display: grid;
            grid-template-columns:
                minmax(18rem, var(--eventhub-col-request))
                minmax(22rem, var(--eventhub-col-runtime))
                minmax(16rem, var(--eventhub-col-backends));
            column-gap: var(--eventhub-col-gap);
            row-gap: 1rem;
            align-items: stretch;
        }


        .eventhub-workspace > [class*="col-"] {
            width: auto;
            max-width: none;
            padding-left: 0;
            padding-right: 0;
            margin-top: 0;
        }

        .eventhub-monitor-col {
            grid-column: 1;
        }

        .eventhub-endpoints-col {
            grid-column: 2;
        }

        .eventhub-config-col {
            grid-column: 3;
        }

        .eventhub-config-col {
            height: var(--eventhub-col-height, calc(100dvh - 6.2rem - 1rem));
            display: flex;
            flex-direction: column;
            gap: 1rem;
            --eventhub-backends-height: 50%;
        }

        .eventhub-endpoints-col {
            height: var(--eventhub-col-height, calc(100dvh - 6.2rem - 1rem));
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .eventhub-config-col > .card {
            min-height: 0;
            display: flex;
            flex-direction: column;
            width: 100%;
            align-self: stretch;
            box-sizing: border-box;
        }

        .eventhub-config-col > .eventhub-backends-card {
            flex: 0 0 auto;
            height: var(--eventhub-backends-height);
            min-height: 12rem;
        }

        .eventhub-config-col > .eventhub-row-resizer {
            display: flex;
            flex: 0 0 auto;
            align-self: center;
            margin-top: -1rem;
            margin-bottom: 0;
        }

        .eventhub-config-col > .eventhub-endpoints-card {
            flex: 1 1 auto;
            min-height: 0;
        }

        .eventhub-endpoints-col > .eventhub-paths-card {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            margin-right: 0.65rem;
        }

        .eventhub-endpoints-col > .eventhub-users-card {
            flex: 1 1 auto;
            min-height: 0;
        }

        .eventhub-endpoints-col > .eventhub-users-card > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        .eventhub-endpoints-col > .eventhub-paths-users-tabbed {
            flex: 1 1 auto;
            min-height: 0;
        }

        .eventhub-endpoints-col > .eventhub-paths-users-tabbed > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        .eventhub-config-col > .card:first-child > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .eventhub-config-col > .eventhub-endpoints-card > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        .eventhub-monitor-col {
            height: var(--eventhub-col-height, calc(100dvh - 6.2rem - 1rem));
            display: flex;
            flex-direction: column;
            min-height: 0;
            gap: 1rem;
        }

        .eventhub-monitor-col > .eventhub-history-shell {
            flex: 1 1 auto;
            min-height: 0;
        }
    }

    @@media (min-width: 992px) and (max-width: 1199.98px) {
        .eventhub-toprow {
            width: auto;
        }

        .eventhub-toprow-filters {
            width: auto;
            max-width: none;
            height: auto;
        }

        .eventhub-filters-header-label {
            display: none;
        }

        .eventhub-filters-header-trigger {
            display: inline;
        }

        .eventhub-toprow-filters > .eventhub-filters-card > .card-body {
            display: none;
        }

        .eventhub-workspace {
            display: grid;
            grid-template-columns: minmax(20rem, 1fr) minmax(20rem, 1fr);
            column-gap: var(--eventhub-col-gap);
            row-gap: 1rem;
            align-items: start;
        }

        .eventhub-workspace > [class*="col-"] {
            width: auto;
            max-width: none;
            padding-left: 0;
            padding-right: 0;
            margin-top: 0;
        }

        .eventhub-monitor-col {
            grid-column: 1;
            height: auto;
        }

        .eventhub-endpoints-col {
            grid-column: 2;
            height: auto;
        }

        .eventhub-config-col {
            grid-column: 1 / span 2;
            height: auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .eventhub-row-resizer {
            display: none;
        }

        .eventhub-config-col > .eventhub-backends-card,
        .eventhub-config-col > .eventhub-endpoints-card,
        .eventhub-endpoints-col > .eventhub-paths-card,
        .eventhub-endpoints-col > .eventhub-paths-users-tabbed {
            height: auto;
            min-height: 0;
            margin-right: 0;
        }

        .eventhub-config-col > .card:first-child > .card-body,
        .eventhub-config-col > .eventhub-endpoints-card > .card-body {
            overflow: visible;
        }
    }

    @@media (max-width: 991.98px) {
        .eventhub-toprow {
            width: auto;
            right: 0.75rem;
        }

        .eventhub-toprow-filters {
            width: auto;
            max-width: none;
            min-height: auto;
        }

        .eventhub-filters-header-label {
            display: none;
        }

        .eventhub-filters-header-trigger {
            display: inline;
        }

        .eventhub-toprow-filters > .eventhub-filters-card > .card-body {
            display: none;
        }

        .eventhub-filter-dialog {
            top: 3.9rem;
            left: 0.5rem;
            right: 0.5rem;
            max-height: calc(100dvh - 4.9rem);
        }
    }

    .eventhub-form-content {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .eventhub-form-actions {
        flex: 0 0 auto;
        display: flex;
        gap: 0.5rem;
        margin: 0 -1rem -1rem;
        padding: 0.65rem 1rem;
        border-top: 1px solid #dde1e6;
    }

    .eventhub-live-dot {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #fff;
        margin-right: 0.15rem;
        animation: eventhub-pulse 1.2s ease-in-out infinite;
    }

    @@keyframes eventhub-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    .eventhub-stats-shell {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.85rem 1rem 1rem;
    }

    .eventhub-section-header {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .eventhub-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 0.75rem;
    }

    .eventhub-stat-tile {
        border: 1px solid #e2e6eb;
        border-top-width: 3px;
        border-radius: 0.5rem;
        padding: 0.6rem 0.7rem;
        background: #f8f9fb;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .eventhub-stat-tile.success { border-top-color: #2f9e44; }
    .eventhub-stat-tile.info { border-top-color: #1971c2; }
    .eventhub-stat-tile.warning { border-top-color: #f59f00; }
    .eventhub-stat-tile.neutral { border-top-color: #868e96; }

    .eventhub-tile-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        line-height: 1.15;
        min-height: 2.55rem;
    }

    .eventhub-tile-head-main {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .eventhub-tile-corner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 1.5rem;
        min-height: 1.5rem;
        cursor: help;
    }

    .eventhub-cb-indicator {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1;
        background: #f8fafc;
        color: #94a3b8;
        flex: 0 0 auto;
    }

    /* OPEN means breaker tripped: show red. */
    .eventhub-cb-indicator.open {
        color: #e03131;
        border-color: #ffa8a8;
        background: #fff5f5;
        animation: eventhub-cb-pulse 2.6s ease-in-out infinite;
    }

    /* CLOSED means healthy: show green thumbs-up. */
    .eventhub-cb-indicator.closed {
        color: #2b8a3e;
        border-color: #b2f2bb;
        background: #e9fce9;
    }

    @@keyframes eventhub-cb-pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(224, 49, 49, 0.12);
            transform: scale(1);
        }

        50% {
            box-shadow: 0 0 0 3px rgba(224, 49, 49, 0.18);
            transform: scale(1.01);
        }
    }

    .eventhub-tile-title {
        font-size: 0.65rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 600;
    }

    .eventhub-tile-primary {
        font-size: 1.15rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
    }

    .eventhub-tile-primary-detail {
        font-size: 0.65rem;
        color: #868e96;
    }

    .eventhub-tile-metrics {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        border-top: 1px solid #e9ecef;
        padding-top: 0.4rem;
    }

    .eventhub-tile-metric {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 0.7rem;
    }

    .eventhub-tile-metric-label {
        color: #868e96;
    }

    .eventhub-tile-metric-value {
        font-weight: 600;
        color: #343a40;
        font-variant-numeric: tabular-nums;
    }

    /* ── Runtime stats (left) + request stats (right) row ── */
    .eventhub-bottom-row {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: stretch;
        min-height: 0;
        flex: 1 1 auto;
    }

    .eventhub-bottom-row .eventhub-stats-shell {
        flex: 0 0 18rem;
        max-width: 18rem;
        align-self: flex-start;
    }

    .eventhub-bottom-row .eventhub-stats-grid {
        grid-template-columns: 1fr;
    }

    .eventhub-bottom-row .eventhub-history-shell {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Smaller font for the request statistics on the right. */
    .eventhub-request-stats-compact .multi-request-stats > .card-body,
    .eventhub-request-stats-compact .multi-request-status > .card-body {
        padding: 0.75rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-title {
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-thermometer {
        height: 1.75rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-segment-label {
        font-size: 0.8rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-status-grid {
        gap: 0.5rem 1.25rem;
        margin-top: 0.6rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-status {
        min-width: 5.5rem;
        font-size: 0.72rem;
        line-height: 1.3;
        padding: 0.3rem 0.55rem;
    }

    .eventhub-backends-shell {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.85rem 1rem 1rem;
    }

    .eventhub-backend-list {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .eventhub-backend-tile {
        flex: 1 1 0;
        min-width: 9rem;
        border: 1px solid #e2e6eb;
        border-top-width: 4px;
        border-radius: 0.375rem;
        padding: 0.5rem 0.6rem;
        background: #fff;
        font-size: 0.72rem;
    }

    .eventhub-backend-tile.healthy { border-top-color: #2f9e44; }
    .eventhub-backend-tile.degraded { border-top-color: #f59f00; }
    .eventhub-backend-tile.down { border-top-color: #e03131; }

    .eventhub-backend-tile-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .eventhub-backend-tile-head-main {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
        flex: 1 1 auto;
    }

    .eventhub-backend-dot {
        flex: 0 0 auto;
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: #adb5bd;
    }

    .eventhub-backend-tile.healthy .eventhub-backend-dot { background: #2f9e44; }
    .eventhub-backend-tile.degraded .eventhub-backend-dot { background: #f59f00; }
    .eventhub-backend-tile.down .eventhub-backend-dot { background: #e03131; }

    .eventhub-backend-name {
        font-weight: 600;
        font-size: 0.82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .eventhub-backend-state {
        font-size: 0.68rem;
        color: #868e96;
        margin-top: 0.1rem;
    }

    .eventhub-backend-url {
        font-size: 0.66rem;
        color: #adb5bd;
        font-family: var(--bs-font-monospace, monospace);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.4rem;
    }

    .eventhub-backend-metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.15rem 0.6rem;
    }

    .eventhub-backend-metrics > div {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .eh-metric-label {
        font-size: 0.62rem;
        color: #adb5bd;
        text-transform: uppercase;
        margin-right: 0.3rem;
    }

    .eh-metric-value {
        font-size: 0.72rem;
        font-weight: 600;
        color: #343a40;
    }

    .eventhub-endpoint-list {
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        max-height: 8.75rem;
        overflow-y: auto;
        padding-right: 0.25rem;
    }

    .eventhub-endpoint-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        column-gap: 0.5rem;
        padding: 0.25rem 0;
        border-bottom: 1px solid #f1f3f5;
    }

    .eventhub-endpoint-item:last-child {
        border-bottom: 0;
    }

    .eventhub-endpoint-item dt {
        min-width: 0;
        font-size: 0.72rem;
        color: #868e96;
        font-weight: 500;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .eventhub-endpoint-item dd {
        min-width: 1.75rem;
        overflow: visible;
        font-size: 0.75rem;
        font-weight: 600;
        color: #343a40;
        margin: 0;
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .eventhub-model-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .eventhub-model-card {
        border: 1px solid #e2e6eb;
        border-top-width: 4px;
        border-radius: 0.375rem;
        padding: 0.5rem 0.6rem;
        background: #fff;
    }

    .eventhub-model-card.healthy { border-top-color: #2f9e44; }
    .eventhub-model-card.degraded { border-top-color: #f59f00; }
    .eventhub-model-card.down { border-top-color: #e03131; }

    .eventhub-model-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.25rem;
    }

    .eventhub-model-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: #111827;
    }

    .eventhub-model-status {
        font-size: 0.72rem;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    .eventhub-model-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem 1rem;
        font-size: 0.72rem;
        color: #4b5563;
        margin-bottom: 0.45rem;
    }

    .eventhub-model-summary strong {
        margin-left: 0.2rem;
        color: #111827;
        font-variant-numeric: tabular-nums;
    }

    .eventhub-model-table {
        font-size: 0.78rem;
    }

    .eventhub-model-table thead th {
        font-weight: 600;
        color: #4b5563;
        border-bottom: 1px solid #dbe1e8;
        white-space: nowrap;
    }

    .eventhub-model-table tbody td {
        font-variant-numeric: tabular-nums;
        vertical-align: middle;
    }

    .eventhub-model-table tbody td:first-child {
        font-weight: 600;
        color: #1f2937;
    }

    .eventhub-backend-table {
        font-size: 0.74rem;
    }

    .eventhub-backend-table thead th {
        font-size: 0.68rem;
        font-weight: 700;
        color: #4b5563;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        white-space: nowrap;
        border-bottom: 1px solid #dbe1e8;
    }

    .eventhub-backend-table tbody td {
        vertical-align: middle;
        font-variant-numeric: tabular-nums;
        padding-top: 0.24rem;
        padding-bottom: 0.24rem;
    }

    .eventhub-backend-table tbody td:first-child {
        font-weight: 600;
        color: #1f2937;
        max-width: 13rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .eventhub-model-endpoint-list {
        margin: 0.45rem 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        max-height: 9rem;
        overflow-y: auto;
        padding-right: 0.25rem;
        border-top: 1px dashed #e9ecef;
        padding-top: 0.4rem;
    }

    .eventhub-model-endpoint-item {
        display: block;
    }

    .eventhub-model-endpoint-item dt {
        margin: 0;
        font-size: 0.68rem;
        color: #495057;
        font-family: var(--bs-font-monospace, monospace);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .eventhub-history-shell {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .eventhub-path-groups {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }

    .eventhub-path-group {
        border: 1px solid #e9ecef;
        border-radius: 0.4rem;
        padding: 0.45rem 0.5rem;
        background: #f8f9fa;
        min-width: 0;
    }

    .eventhub-path-group-title {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 700;
        margin-bottom: 0.35rem;
    }

    .eventhub-path-group-title.success {
        color: #2f9e44;
    }

    .eventhub-path-group-title.failed {
        color: #e03131;
    }

    @@media (max-width: 1199px) {
        .eventhub-path-groups {
            grid-template-columns: 1fr;
        }
    }

    /* Merged Paths/Users tabbed card: hidden by default, shown instead of the two separate
       cards only when the viewport height is 860px or less. */
    .eventhub-paths-users-tabbed {
        display: none;
    }

    /* Folder-style tabs (same look as .eh-req-tab in EventHubRequestStatus.razor): the active
       tab is white and its bottom border is pulled up to visually merge into the card body
       directly below it; inactive tabs stay tinted with the header color behind them. */
    .eventhub-paths-users-tabs {
        display: flex;
        gap: 0.3rem;
        padding: 0.3rem 0.75rem 0;
        margin-bottom: -1px;
    }

    .eventhub-tab-button {
        border: 1px solid rgba(0, 0, 0, 0.18);
        border-bottom: none;
        background: rgba(255, 255, 255, 0.3);
        color: inherit;
        font-size: 0.76rem;
        font-weight: 700;
        line-height: 1.2;
        padding: 0.32rem 0.9rem;
        border-radius: 0.35rem 0.35rem 0 0;
        cursor: pointer;
        opacity: 0.8;
    }

    .eventhub-tab-button:hover,
    .eventhub-tab-button:focus-visible {
        background: rgba(255, 255, 255, 0.55);
        opacity: 1;
    }

    .eventhub-tab-button.active {
        background: #fff;
        color: #1f2937;
        border-color: rgba(0, 0, 0, 0.18);
        opacity: 1;
    }

    @@media (max-height: 860px) {
        /* Matches the ".eventhub-endpoints-col > .eventhub-paths-card" specificity used by the
           width breakpoints above (which set display:flex there) so this rule actually wins. */
        .eventhub-endpoints-col > .eventhub-paths-card,
        .eventhub-endpoints-col > .eventhub-users-card {
            display: none;
        }

        .eventhub-endpoints-col > .eventhub-paths-users-tabbed {
            display: flex;
            flex-direction: column;
        }
    }

    .eventhub-catalog-groups {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .eventhub-catalog-group {
        border: 1px solid #e9ecef;
        border-radius: 0.4rem;
        padding: 0.5rem 0.6rem;
        background: #f8f9fa;
    }

    .eventhub-catalog-group-title {
        margin: 0 0 0.35rem;
