        {
            return;
        }

        _columnResizerInitialized = true;
        await JS.InvokeVoidAsync("eventHubMonitorInitColumnResizers");
    }

    private void Connect()
    {
        if (IsConnected)
        {
            return;
        }

        IsConnected = true;
        _receivedFirst = false;
        _snapshot = Store.GetSnapshot();
        RefreshScopeState();
        _proxyMetricGroups = MetricsCatalog.GetActiveGroups(EffectiveScopeId);
        Store.Changed += OnStoreChanged;

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(1, RefreshSeconds)));
        _ = RefreshLoopAsync(_cts.Token);
    }

    private void Disconnect()
    {
        if (!IsConnected)
        {
            return;
        }

        IsConnected = false;
        Store.Changed -= OnStoreChanged;

        _cts?.Cancel();
        _timer?.Dispose();
        _timer = null;
        _cts?.Dispose();
        _cts = null;

        _snapshot = new MonitorSnapshot();
        _proxyMetricGroups = Array.Empty<ProxyMetricsCatalog.MetricGroupSnapshot>();
        _scopeOptions = Array.Empty<ProxyMetricsCatalog.ScopeOption>();
        _scopeHistoryEntries = Array.Empty<ChatHistoryEntry>();
    }

    // Fired from the store on every ingest. Used only to paint the first batch of data
    // immediately; subsequent updates are throttled to the refresh cadence below.
    private void OnStoreChanged()
    {
        if (_receivedFirst)
        {
            return;
        }

        _receivedFirst = true;
        _ = InvokeAsync(() =>
        {
            _snapshot = Store.GetSnapshot();
            RefreshScopeState();
            _proxyMetricGroups = MetricsCatalog.GetActiveGroups(EffectiveScopeId);
            StateHasChanged();
        });
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(token))
            {
                _snapshot = Store.GetSnapshot();
                RefreshScopeState();
                _proxyMetricGroups = MetricsCatalog.GetActiveGroups(EffectiveScopeId);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Expected on disconnect / disposal.
        }
    }

    public ValueTask DisposeAsync()
    {
        Disconnect();
        return ValueTask.CompletedTask;
    }

