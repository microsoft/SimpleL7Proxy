        var cb = _snapshot.CircuitBreaker;
        var serverErrors = _snapshot.ServerErrors;
        var lastCode = cb.LastErrorCode is { } code ? code.ToString() : "-";
        var circuitState = stats.ServerCircuitBreakerOpen ? "OPEN" : "CLOSED";
        var circuitCss = stats.ServerCircuitBreakerOpen ? "open" : "closed";
        var circuitHoverDetails = string.Join(
            Environment.NewLine,
            new[]
            {
                $"Circuit breaker: {circuitState}",
                $"Endpoint open: {stats.EndpointCircuitBreakerOpenCount}/{stats.EndpointCount}",
                $"Server CB events: {cb.ServerEventCount}",
                $"Last code: {lastCode}",
            });

        return new[]
