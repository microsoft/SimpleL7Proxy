        var versionSuffix = versions.Count > 0
            ? $" ( {string.Join(", ", versions.Select(v => $"v{v}"))} )"
            : string.Empty;
        var hasData = _snapshot.LastDataUtc != default;
        var lastUpdate = hasData ? $"  ·  Last update: {_snapshot.LastDataUtc.ToLocalTime():HH:mm:ss}" : string.Empty;
        return $"Streaming runtime stats from the Event Hub.{versionSuffix}{lastUpdate}";
    }

    private IReadOnlyList<string> GetDetectedVersions()
    {
        var versions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        
        if (!string.IsNullOrWhiteSpace(_snapshot.Stats.ProxyVersion))
        {
            versions.Add(_snapshot.Stats.ProxyVersion);
        }

        foreach (var backend in _snapshot.Backends)
        {
            // Versions could also come from backend-specific data if available
        }

        return versions.OrderBy(v => v, StringComparer.OrdinalIgnoreCase).ToList();
    }

