@page "/eventhub"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@implements IAsyncDisposable
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@using System.Globalization
@using System.Text.RegularExpressions
@inject EventHubMonitorStore Store
@inject ProxyMetricsCatalog MetricsCatalog
@inject IOptions<EventHubMonitorOptions> MonitorOptions

<PageTitle>EventHub Monitor</PageTitle>

<InspectorPageShell Title="EventHub Monitor"
                    Tagline="@Tagline"
                    HistoryEntries="@ScopeHistoryEntries"
                    SelectedHistoryEntryId="@SelectedScopeId"
                    HistorySource="EventHub monitor">
    <div class="row g-4 eventhub-workspace">
        @* ── Backends column ── *@
        <div class="col-12 col-lg-3 eventhub-config-col order-3">
            <div class="card shadow-sm eventhub-card">
                <div class="card-header bg-success text-white">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="fw-semibold">Backends</span>
                        <span class="text-white-50 small">@BackendSubtitle</span>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-form-content">
                        @if (Backends.Count > 0)
                        {
                            <div class="eventhub-backend-list mb-3">
                                @foreach (var backend in Backends)
                                {
                                    <div class="eventhub-backend-tile @backend.Css">
                                        <div class="eventhub-backend-tile-head">
                                            <div class="eventhub-backend-tile-head-main">
                                                <span class="eventhub-backend-dot" title="@backend.Status"></span>
                                                <span class="eventhub-backend-name">Backend: @backend.Name</span>
                                            </div>
                                            <div class="eventhub-tile-corner" title="@GetBackendCircuitBreakerTitle(backend)" aria-label="@GetBackendCircuitBreakerAriaLabel(backend)">
                                                <span class="eventhub-cb-indicator @GetBackendCircuitBreakerCss(backend)" aria-hidden="true">@GetBackendCircuitBreakerGlyph(backend)</span>
                                            </div>
                                        </div>
                                        <div class="eventhub-backend-state">@backend.Status</div>
                                        <div class="eventhub-backend-url" title="@backend.Url">@backend.Url</div>
                                        <div class="eventhub-backend-metrics">
                                            <div><span class="eh-metric-label">Lat</span><span class="eh-metric-value">@backend.LatencyText</span></div>
                                            <div><span class="eh-metric-label">Succ</span><span class="eh-metric-value">@backend.SuccessRate%</span></div>
                                            <div><span class="eh-metric-label">ProbeOK</span><span class="eh-metric-value">@backend.ProbeSuccesses</span></div>
                                            <div><span class="eh-metric-label">ProbeFail</span><span class="eh-metric-value">@backend.ProbeFailures</span></div>
                                            <div><span class="eh-metric-label">ReqCalls</span><span class="eh-metric-value">@backend.RequestCalls</span></div>
                                            <div><span class="eh-metric-label">ReqFail</span><span class="eh-metric-value">@backend.RequestFailures</span></div>
                                            <div><span class="eh-metric-label">ReqAvg</span><span class="eh-metric-value">@backend.AvgRequestLatencyMs.ToString("0.#") ms</span></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No backend health received yet.</div>
                        }

                        <div class="eventhub-section-header mt-3">
                            <span class="fw-semibold">Metrics by group</span>
                        </div>
                        <div class="eventhub-catalog-groups">
                            @foreach (var group in ProxyMetricGroups)
                            {
                                <section class="eventhub-catalog-group">
                                    <h6 class="eventhub-catalog-group-title">@group.Name</h6>
                                    <dl class="eventhub-catalog-metrics">
                                        @foreach (var metric in group.Metrics)
                                        {
                                            <div class="eventhub-catalog-row" title="@metric.Description">
                                                <dt>@metric.Name</dt>
                                                <dd>@metric.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                </section>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-endpoints-card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="fw-semibold">Endpoints</span>
                        <span class="text-white-50 small">@EndpointSubtitle</span>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    @if (EndpointTiles.Count == 0)
                    {
                        <div class="text-muted small">No endpoint backend-call records received yet.</div>
                    }
                    else
                    {
                        <div class="eventhub-backend-list">
                            @foreach (var endpoint in EndpointTiles)
                            {
                                <div class="eventhub-backend-tile @endpoint.Css">
                                    <div class="eventhub-backend-tile-head">
                                        <span class="eventhub-backend-dot" title="@endpoint.Status"></span>
                                        <span class="eventhub-backend-name">@endpoint.Path</span>
                                    </div>
                                    <div class="eventhub-backend-state">@endpoint.Status</div>
                                    <div class="eventhub-backend-url" title="@endpoint.TargetUrl">@endpoint.TargetUrl</div>
                                    <div class="eventhub-backend-metrics">
                                        <div><span class="eh-metric-label">Calls</span><span class="eh-metric-value">@endpoint.Calls</span></div>
                                        <div><span class="eh-metric-label">Fail</span><span class="eh-metric-value">@endpoint.Failures</span></div>
                                        <div><span class="eh-metric-label">Attempts</span><span class="eh-metric-value">@endpoint.AverageEndpointAttempts.ToString("0.##")</span></div>
                                        <div><span class="eh-metric-label">Proc(s)</span><span class="eh-metric-value">@endpoint.AverageRequestProcessDuration.ToString("0.###")</span></div>
                                        <div><span class="eh-metric-label">Queue</span><span class="eh-metric-value">@endpoint.AverageQueueDurationMs.ToString("0.###") ms</span></div>
                                        <div><span class="eh-metric-label">ProxyProc</span><span class="eh-metric-value">@endpoint.AverageProcessDurationMs.ToString("0.###") ms</span></div>
                                        <div><span class="eh-metric-label">Thrtl</span><span class="eh-metric-value">@endpoint.ThrottledEvents</span></div>
                                        <div><span class="eh-metric-label">TargetThr</span><span class="eh-metric-value">@endpoint.TargetThrottledEvents</span></div>
                                        <div><span class="eh-metric-label">Incomplete</span><span class="eh-metric-value">@endpoint.CallIncompleteEvents</span></div>
                                        <div><span class="eh-metric-label">Exhausted</span><span class="eh-metric-value">@endpoint.ExhaustedRetryEvents</span></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ── Server column (runtime stats + endpoints + paths + users) ── *@
        <div class="col-12 col-lg-5 eventhub-endpoints-col order-2">
            <div class="card shadow-sm eventhub-card">
                <div class="card-header bg-dark text-white">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-semibold">Runtime stats</span>
                        <span class="text-white-50 small">@StatsSubtitle</span>
                        @if (IsConnected)
                        {
                            var hasData = _snapshot.LastDataUtc != default;
                            var isLive = hasData && (DateTimeOffset.UtcNow - _snapshot.LastDataUtc) < TimeSpan.FromSeconds(5);
                            <span class="badge @(isLive ? "text-bg-success" : "text-bg-secondary") ms-auto"
                                  title="@(hasData ? FormatRelativeTime(_snapshot.LastDataUtc) : "no data yet")">
                                @if (isLive)
                                {
                                    <span class="eventhub-live-dot"></span>
                                }
                                <text>Last update: @(hasData ? _snapshot.LastDataUtc.ToLocalTime().ToString("HH:mm:ss") : "—")</text>
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary ms-auto">Awaiting data</span>
                        }
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-stats-grid">
                        @foreach (var tile in StatTiles)
                        {
                            <div class="eventhub-stat-tile @tile.Css">
                                <div class="eventhub-tile-head">
                                    <div class="eventhub-tile-head-main">
                                        <span class="eventhub-tile-title">@tile.Title</span>
                                        <span class="eventhub-tile-primary">@tile.Primary</span>
                                        @if (!string.IsNullOrWhiteSpace(tile.PrimaryDetail))
                                        {
                                            <span class="eventhub-tile-primary-detail">@tile.PrimaryDetail</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(tile.CornerStatus))
                                    {
                                        <div class="eventhub-tile-corner" title="@tile.CornerHoverDetails" aria-label="Circuit breaker @tile.CornerStatus">
                                            <span class="eventhub-cb-indicator @tile.CornerCss" aria-hidden="true">@(tile.CornerCss == "closed" ? "👍" : "✕")</span>
                                        </div>
                                    }
                                </div>
                                @if (tile.Metrics.Count > 0)
                                {
                                    <div class="eventhub-tile-metrics">
                                        @foreach (var metric in tile.Metrics)
                                        {
                                            <div class="eventhub-tile-metric">
                                                <span class="eventhub-tile-metric-label">@metric.Label</span>
                                                <span class="eventhub-tile-metric-value">@metric.Value</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-paths-card">
                <div class="card-header bg-secondary text-white">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="fw-semibold">Paths</span>
                        <span class="text-white-50 small">success vs failed</span>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-path-groups">
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title success">Success</div>
                            @if (SuccessfulPaths.Count == 0)
                            {
                                <div class="text-muted small">No successful paths yet.</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var path in SuccessfulPaths)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@path.Path">@path.Path</dt>
                                            <dd>@path.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title failed">Failed</div>
                            @if (FailedPaths.Count == 0)
                            {
                                <div class="text-muted small">No failed paths yet.</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var path in FailedPaths)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@path.Path">@path.Path</dt>
                                            <dd>@path.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm eventhub-card eventhub-paths-card">
                <div class="card-header bg-secondary text-white">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="fw-semibold">Users</span>
                        <span class="text-white-50 small">success vs failed</span>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-path-groups">
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title success">Success</div>
                            @if (SuccessfulUsers.Count == 0)
                            {
                                <div class="text-muted small">No successful users yet.</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var user in SuccessfulUsers)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@user.User">@user.User</dt>
                                            <dd>@user.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                        <div class="eventhub-path-group">
                            <div class="eventhub-path-group-title failed">Failed</div>
                            @if (FailedUsers.Count == 0)
                            {
                                <div class="text-muted small">No failed users yet.</div>
                            }
                            else
                            {
                                <dl class="eventhub-endpoint-list">
                                    @foreach (var user in FailedUsers)
                                    {
                                        <div class="eventhub-endpoint-item">
                                            <dt title="@user.User">@user.User</dt>
                                            <dd>@user.Count</dd>
                                        </div>
                                    }
                                </dl>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Request column (request status) ── *@
        <div class="col-12 col-lg-4 eventhub-monitor-col order-1">
            <div class="eventhub-history-shell eventhub-request-stats-compact">
                <EventHubRequestStatus Items="@HistoryItems" />
            </div>
        </div>

    </div>
</InspectorPageShell>

<style>
    .eventhub-workspace {
        margin-left: 0;
        margin-right: 0;
    }

    @@media (min-width: 992px) {
        .eventhub-config-col {
            height: calc(100dvh - 8.75rem);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .eventhub-endpoints-col {
            height: calc(100dvh - 8.75rem);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .eventhub-config-col > .card {
            min-height: 0;
            display: flex;
            flex-direction: column;
        }

        .eventhub-config-col > .card:first-child {
            flex: 1 1 auto;
        }

        .eventhub-config-col > .eventhub-endpoints-card {
            flex: 1 1 auto;
            min-height: 0;
        }

        .eventhub-endpoints-col > .eventhub-paths-card {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
        }

        .eventhub-config-col > .card:first-child > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .eventhub-config-col > .eventhub-endpoints-card > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        .eventhub-monitor-col {
            height: calc(100dvh - 8.75rem);
            display: flex;
            flex-direction: column;
            min-height: 0;
            gap: 1rem;
        }

        .eventhub-monitor-col > .eventhub-history-shell {
            flex: 1 1 auto;
            min-height: 0;
        }
    }

    .eventhub-form-content {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .eventhub-form-actions {
        flex: 0 0 auto;
        display: flex;
        gap: 0.5rem;
        margin: 0 -1rem -1rem;
        padding: 0.65rem 1rem;
        border-top: 1px solid #dde1e6;
    }

    .eventhub-live-dot {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #fff;
        margin-right: 0.15rem;
        animation: eventhub-pulse 1.2s ease-in-out infinite;
    }

    @@keyframes eventhub-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    .eventhub-stats-shell {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.85rem 1rem 1rem;
    }

    .eventhub-section-header {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .eventhub-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 0.75rem;
    }

    .eventhub-stat-tile {
        border: 1px solid #e2e6eb;
        border-top-width: 3px;
        border-radius: 0.5rem;
        padding: 0.6rem 0.7rem;
        background: #f8f9fb;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .eventhub-stat-tile.success { border-top-color: #2f9e44; }
    .eventhub-stat-tile.info { border-top-color: #1971c2; }
    .eventhub-stat-tile.warning { border-top-color: #f59f00; }
    .eventhub-stat-tile.neutral { border-top-color: #868e96; }

    .eventhub-tile-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        line-height: 1.15;
        min-height: 2.55rem;
    }

    .eventhub-tile-head-main {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .eventhub-tile-corner {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 1.5rem;
        min-height: 1.5rem;
        cursor: help;
    }

    .eventhub-cb-indicator {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        border: 1px solid #cbd5e1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        font-size: 0.82rem;
        font-weight: 700;
        line-height: 1;
        background: #f8fafc;
        color: #94a3b8;
        flex: 0 0 auto;
    }

    /* OPEN means breaker tripped: show red. */
    .eventhub-cb-indicator.open {
        color: #e03131;
        border-color: #ffa8a8;
        background: #fff5f5;
        animation: eventhub-cb-pulse 2.6s ease-in-out infinite;
    }

    /* CLOSED means healthy: show green thumbs-up. */
    .eventhub-cb-indicator.closed {
        color: #2b8a3e;
        border-color: #b2f2bb;
        background: #e9fce9;
    }

    @@keyframes eventhub-cb-pulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(224, 49, 49, 0.12);
            transform: scale(1);
        }

        50% {
            box-shadow: 0 0 0 3px rgba(224, 49, 49, 0.18);
            transform: scale(1.01);
        }
    }

    .eventhub-tile-title {
        font-size: 0.65rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 600;
    }

    .eventhub-tile-primary {
        font-size: 1.15rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
    }

    .eventhub-tile-primary-detail {
        font-size: 0.65rem;
        color: #868e96;
    }

    .eventhub-tile-metrics {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        border-top: 1px solid #e9ecef;
        padding-top: 0.4rem;
    }

    .eventhub-tile-metric {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 0.7rem;
    }

    .eventhub-tile-metric-label {
        color: #868e96;
    }

    .eventhub-tile-metric-value {
        font-weight: 600;
        color: #343a40;
        font-variant-numeric: tabular-nums;
    }

    /* ── Runtime stats (left) + request stats (right) row ── */
    .eventhub-bottom-row {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: stretch;
        min-height: 0;
        flex: 1 1 auto;
    }

    .eventhub-bottom-row .eventhub-stats-shell {
        flex: 0 0 18rem;
        max-width: 18rem;
        align-self: flex-start;
    }

    .eventhub-bottom-row .eventhub-stats-grid {
        grid-template-columns: 1fr;
    }

    .eventhub-bottom-row .eventhub-history-shell {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Smaller font for the request statistics on the right. */
    .eventhub-request-stats-compact .multi-request-stats > .card-body,
    .eventhub-request-stats-compact .multi-request-status > .card-body {
        padding: 0.75rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-title {
        font-size: 0.8rem;
        margin-bottom: 0.5rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-thermometer {
        height: 1.75rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-segment-label {
        font-size: 0.8rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-status-grid {
        gap: 0.5rem 1.25rem;
        margin-top: 0.6rem;
    }

    .eventhub-request-stats-compact .multi-request-stats-status {
        min-width: 5.5rem;
        font-size: 0.72rem;
        line-height: 1.3;
        padding: 0.3rem 0.55rem;
    }

    .eventhub-backends-shell {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.85rem 1rem 1rem;
    }

    .eventhub-backend-list {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .eventhub-backend-tile {
        flex: 1 1 0;
        min-width: 9rem;
        border: 1px solid #e2e6eb;
        border-top-width: 4px;
        border-radius: 0.375rem;
        padding: 0.5rem 0.6rem;
        background: #fff;
        font-size: 0.72rem;
    }

    .eventhub-backend-tile.healthy { border-top-color: #2f9e44; }
    .eventhub-backend-tile.degraded { border-top-color: #f59f00; }
    .eventhub-backend-tile.down { border-top-color: #e03131; }

    .eventhub-backend-tile-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
    }

    .eventhub-backend-tile-head-main {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        min-width: 0;
        flex: 1 1 auto;
    }

    .eventhub-backend-dot {
        flex: 0 0 auto;
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 50%;
        background: #adb5bd;
    }

    .eventhub-backend-tile.healthy .eventhub-backend-dot { background: #2f9e44; }
    .eventhub-backend-tile.degraded .eventhub-backend-dot { background: #f59f00; }
    .eventhub-backend-tile.down .eventhub-backend-dot { background: #e03131; }

    .eventhub-backend-name {
        font-weight: 600;
        font-size: 0.82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .eventhub-backend-state {
        font-size: 0.68rem;
        color: #868e96;
        margin-top: 0.1rem;
    }

    .eventhub-backend-url {
        font-size: 0.66rem;
        color: #adb5bd;
        font-family: var(--bs-font-monospace, monospace);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 0.4rem;
    }

    .eventhub-backend-metrics {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.15rem 0.6rem;
    }

    .eventhub-backend-metrics > div {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
