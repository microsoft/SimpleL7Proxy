        _columnResizerInitialized = true;
        await JS.InvokeVoidAsync("eventHubMonitorInitColumnResizers");
    }

    private void Connect()
    {
        if (IsConnected)
        {
            return;
        }

        IsConnected = true;
        _receivedFirst = false;
        _snapshot = Store.GetSnapshot();
        RefreshScopeState();
        _proxyMetricGroups = MetricsCatalog.GetActiveGroups(EffectiveScopeId);
        Store.Changed += OnStoreChanged;

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(Math.Max(1, RefreshSeconds)));
        _ = RefreshLoopAsync(_cts.Token);
