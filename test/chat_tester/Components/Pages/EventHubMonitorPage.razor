<script>
    (function () {
        const cookieName = "eventhub_monitor_col_widths";

        function readCookie(name) {
            const match = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/[-./\\^$*+?()[\]{}|]/g, "\\$&") + "=([^;]*)"));
            return match ? decodeURIComponent(match[1]) : null;
        }

        function writeCookie(name, value) {
            document.cookie = `${name}=${encodeURIComponent(value)}; path=/; max-age=31536000; samesite=lax`;
        }

        function clamp(value, min, max) {
            return Math.max(min, Math.min(max, value));
        }

        window.eventHubMonitorInitColumnResizers = function () {
            const workspace = document.querySelector(".eventhub-workspace");
            if (!workspace || workspace.dataset.resizerInit === "1") {
                return;
            }

            const requestCol = workspace.querySelector(".eventhub-monitor-col");
            const runtimeCol = workspace.querySelector(".eventhub-endpoints-col");
            const backendCol = workspace.querySelector(".eventhub-config-col");
            const splitterLm = workspace.querySelector(".eventhub-col-resizer-lm");
            const splitterMr = workspace.querySelector(".eventhub-col-resizer-mr");
            if (!requestCol || !runtimeCol || !backendCol || !splitterLm || !splitterMr) {
                return;
            }

            const minRequest = 300;
            const minRuntime = 360;
            const minBackends = 260;

            function setPercents(requestPct, runtimePct, backendsPct) {
                workspace.style.setProperty("--eventhub-col-request", `${requestPct}%`);
                workspace.style.setProperty("--eventhub-col-runtime", `${runtimePct}%`);
                workspace.style.setProperty("--eventhub-col-backends", `${backendsPct}%`);
                positionSplitters();
            }

            function positionSplitters() {
                if (window.matchMedia("(max-width: 991.98px)").matches) {
                    return;
                }

                const workspaceRect = workspace.getBoundingClientRect();
                const requestRect = requestCol.getBoundingClientRect();
                const runtimeRect = runtimeCol.getBoundingClientRect();
                splitterLm.style.left = `${requestRect.right - workspaceRect.left}px`;
                splitterMr.style.left = `${runtimeRect.right - workspaceRect.left}px`;
            }

            function normalizePercents(requestPct, runtimePct) {
                let request = clamp(Number(requestPct) || 33, 20, 60);
                let runtime = clamp(Number(runtimePct) || 42, 20, 65);
                let backends = 100 - request - runtime;

                if (backends < 15) {
                    runtime = 100 - request - 15;
                    backends = 15;
                }

                if (runtime < 20) {
                    runtime = 20;
                    backends = 100 - request - runtime;
                }

                return { request, runtime, backends };
            }

            function saveCurrentPercents() {
                const total = requestCol.getBoundingClientRect().width + runtimeCol.getBoundingClientRect().width + backendCol.getBoundingClientRect().width;
                if (total <= 0) {
                    return;
                }

                const requestPct = (requestCol.getBoundingClientRect().width / total) * 100;
                const runtimePct = (runtimeCol.getBoundingClientRect().width / total) * 100;
                const backendsPct = 100 - requestPct - runtimePct;
                writeCookie(cookieName, `${requestPct.toFixed(2)},${runtimePct.toFixed(2)},${backendsPct.toFixed(2)}`);
            }

            const saved = readCookie(cookieName);
            if (saved) {
                const parts = saved.split(",").map(Number);
                if (parts.length === 3 && parts.every(Number.isFinite) && parts[0] > 0 && parts[1] > 0 && parts[2] > 0) {
                    setPercents(parts[0], parts[1], parts[2]);
                }
            }
            else
            {
                positionSplitters();
            }

            window.addEventListener("resize", positionSplitters);

            window.eventHubMonitorSetColumnPercents = function (requestPct, runtimePct) {
                const normalized = normalizePercents(requestPct, runtimePct);
                setPercents(normalized.request, normalized.runtime, normalized.backends);
                writeCookie(cookieName, `${normalized.request.toFixed(2)},${normalized.runtime.toFixed(2)},${normalized.backends.toFixed(2)}`);
            };

            window.eventHubMonitorGetColumnPercents = function () {
                const saved = readCookie(cookieName);
                if (saved) {
                    const parts = saved.split(",").map(Number);
                    if (parts.length === 3 && parts.every(Number.isFinite)) {
                        return parts;
                    }
                }

                const total = requestCol.getBoundingClientRect().width + runtimeCol.getBoundingClientRect().width + backendCol.getBoundingClientRect().width;
                if (total <= 0) {
                    return [33, 42, 25];
                }

                return [
                    (requestCol.getBoundingClientRect().width / total) * 100,
                    (runtimeCol.getBoundingClientRect().width / total) * 100,
                    (backendCol.getBoundingClientRect().width / total) * 100
                ];
            };

            function startDrag(splitter, onMove) {
                splitter.style.touchAction = "none";
                splitter.addEventListener("pointerdown", (downEvent) => {
                    if (downEvent.pointerType === "mouse" && downEvent.button !== 0) {
                        return;
                    }

                    if (window.matchMedia("(max-width: 991.98px)").matches) {
                        return;
                    }

                    downEvent.preventDefault();
                    const startX = downEvent.clientX;
                    const requestStart = requestCol.getBoundingClientRect().width;
                    const runtimeStart = runtimeCol.getBoundingClientRect().width;
                    const backendsStart = backendCol.getBoundingClientRect().width;
                    const total = requestStart + runtimeStart + backendsStart;

                    splitter.classList.add("dragging");
                    document.body.style.cursor = "col-resize";

                    const handleMove = (moveEvent) => {
                        const delta = moveEvent.clientX - startX;
                        const updated = onMove(delta, { requestStart, runtimeStart, backendsStart, total });
                        if (!updated) {
                            return;
                        }

                        const requestPct = (updated.request / total) * 100;
                        const runtimePct = (updated.runtime / total) * 100;
                        const backendsPct = 100 - requestPct - runtimePct;
                        setPercents(requestPct, runtimePct, backendsPct);
                    };

                    const stopDrag = () => {
                        splitter.classList.remove("dragging");
                        document.body.style.cursor = "";
                        window.removeEventListener("pointermove", handleMove);
                        window.removeEventListener("pointerup", stopDrag);
                        saveCurrentPercents();
                    };

                    window.addEventListener("pointermove", handleMove);
                    window.addEventListener("pointerup", stopDrag);
                });
            }

            startDrag(splitterLm, (delta, state) => {
                const request = clamp(state.requestStart + delta, minRequest, state.total - minRuntime - minBackends);
                const runtime = state.total - state.backendsStart - request;
                if (runtime < minRuntime) {
                    return null;
                }

                return { request, runtime, backends: state.backendsStart };
            });

            startDrag(splitterMr, (delta, state) => {
                const runtime = clamp(state.runtimeStart + delta, minRuntime, state.total - state.requestStart - minBackends);
                const backends = state.total - state.requestStart - runtime;
                if (backends < minBackends) {
                    return null;
                }

                return { request: state.requestStart, runtime, backends };
            });

            workspace.dataset.resizerInit = "1";
        };
    })();
</script>

