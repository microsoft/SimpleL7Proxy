@page "/eventhub"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@implements IAsyncDisposable
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Options
@inject EventHubMonitorStore Store
@inject IOptions<EventHubMonitorOptions> MonitorOptions

<PageTitle>EventHub Monitor</PageTitle>

<InspectorPageShell Title="EventHub Monitor"
                    Tagline="@Tagline"
                    HistoryEntries="EmptyHistory"
                    HistorySource="EventHub monitor">
    <div class="row g-4 eventhub-workspace">
        @* ── Left: Backend + endpoint stats ── *@
        <div class="col-12 col-lg-4 eventhub-config-col">
            <div class="card shadow-sm eventhub-card">
                <div class="card-header bg-success text-white">
                    <div class="d-flex flex-wrap align-items-baseline gap-2">
                        <span class="fw-semibold">Backends &amp; endpoint</span>
                        <span class="text-white-50 small">@BackendSubtitle</span>
                    </div>
                </div>
                <div class="card-body eventhub-card-body">
                    <div class="eventhub-form-content">
                        @* ── Backend stats ── *@
                        <div class="eventhub-section-header">
                            <span class="fw-semibold">Backend stats</span>
                        </div>
                        @if (Backends.Count > 0)
                        {
                            <div class="eventhub-backend-list mb-3">
                                @foreach (var backend in Backends)
                                {
                                    <div class="eventhub-backend-tile @backend.Css">
                                        <div class="eventhub-backend-tile-head">
                                            <span class="eventhub-backend-dot" title="@backend.Status"></span>
                                            <span class="eventhub-backend-name">@backend.Name</span>
                                        </div>
                                        <div class="eventhub-backend-state">@backend.Status</div>
                                        <div class="eventhub-backend-url" title="@backend.Url">@backend.Url</div>
                                        <div class="eventhub-backend-metrics">
                                            <div><span class="eh-metric-label">Lat</span><span class="eh-metric-value">@backend.LatencyText</span></div>
                                            <div><span class="eh-metric-label">Succ</span><span class="eh-metric-value">@backend.SuccessRate%</span></div>
                                            <div><span class="eh-metric-label">Calls</span><span class="eh-metric-value">@backend.Calls</span></div>
                                            <div><span class="eh-metric-label">Err</span><span class="eh-metric-value">@backend.Errors</span></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No backend health received yet.</div>
                        }

                        @* ── Endpoint stats ── *@
                        <div class="eventhub-section-header">
                            <span class="fw-semibold">Endpoint stats</span>
                        </div>
                        <dl class="eventhub-endpoint-stats">
                            @foreach (var stat in EndpointStats)
                            {
                                <div class="eventhub-endpoint-row">
                                    <dt>@stat.Label</dt>
                                    <dd>@stat.Value</dd>
                                </div>
                            }
                        </dl>
                    </div>

                    <div class="eventhub-form-actions">
                        @if (IsConnected)
                        {
                            <span class="badge text-bg-success align-self-center me-auto">
                                <span class="eventhub-live-dot"></span> Live · updated @_snapshot.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary align-self-center me-auto">Awaiting data</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ── Right: Runtime stats + request stats ── *@
        <div class="col-12 col-lg-8 eventhub-monitor-col">
            @* ── Runtime stats + request stats row ── *@
            <div class="eventhub-bottom-row">
                <div class="eventhub-stats-shell">
                    <div class="eventhub-section-header">
                        <span class="fw-semibold">Runtime stats</span>
                        <span class="text-muted small">@StatsSubtitle</span>
                    </div>
                    <div class="eventhub-stats-grid">
                        @foreach (var tile in StatTiles)
                        {
                            <div class="eventhub-stat-tile @tile.Css">
                                <div class="eventhub-tile-head">
                                    <span class="eventhub-tile-title">@tile.Title</span>
                                    <span class="eventhub-tile-primary">@tile.Primary</span>
                                    @if (!string.IsNullOrWhiteSpace(tile.PrimaryDetail))
                                    {
                                        <span class="eventhub-tile-primary-detail">@tile.PrimaryDetail</span>
                                    }
                                </div>
                                @if (tile.Metrics.Count > 0)
                                {
                                    <div class="eventhub-tile-metrics">
                                        @foreach (var metric in tile.Metrics)
                                        {
                                            <div class="eventhub-tile-metric">
                                                <span class="eventhub-tile-metric-label">@metric.Label</span>
                                                <span class="eventhub-tile-metric-value">@metric.Value</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="eventhub-history-shell eventhub-request-stats-compact">
                    <MultiRequestStatus Items="@HistoryItems" />
                </div>
            </div>
        </div>
    </div>
</InspectorPageShell>

<style>
    .eventhub-workspace {
        margin-left: 0;
        margin-right: 0;
    }

    @@media (min-width: 992px) {
        .eventhub-config-col {
            height: calc(100dvh - 8.75rem);
        }

        .eventhub-config-col > .card {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .eventhub-config-col > .card > .card-body {
            flex: 1 1 auto;
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .eventhub-monitor-col {
            height: calc(100dvh - 8.75rem);
            display: flex;
            flex-direction: column;
            min-height: 0;
            gap: 1rem;
        }
    }

    .eventhub-form-content {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .eventhub-form-actions {
        flex: 0 0 auto;
        display: flex;
        gap: 0.5rem;
        margin: 0 -1rem -1rem;
        padding: 0.65rem 1rem;
        border-top: 1px solid #dde1e6;
    }

    .eventhub-live-dot {
        display: inline-block;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: #fff;
        margin-right: 0.15rem;
        animation: eventhub-pulse 1.2s ease-in-out infinite;
    }

    @@keyframes eventhub-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.35; }
    }

    .eventhub-stats-shell {
        flex: 0 0 auto;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.85rem 1rem 1rem;
    }

    .eventhub-section-header {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .eventhub-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
        gap: 0.75rem;
    }

    .eventhub-stat-tile {
        border: 1px solid #e2e6eb;
        border-top-width: 3px;
        border-radius: 0.5rem;
        padding: 0.6rem 0.7rem;
        background: #f8f9fb;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .eventhub-stat-tile.success { border-top-color: #2f9e44; }
    .eventhub-stat-tile.info { border-top-color: #1971c2; }
    .eventhub-stat-tile.warning { border-top-color: #f59f00; }
    .eventhub-stat-tile.neutral { border-top-color: #868e96; }

    .eventhub-tile-head {
        display: flex;
        flex-direction: column;
        line-height: 1.15;
    }

    .eventhub-tile-title {
        font-size: 0.65rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 600;
    }

    .eventhub-tile-primary {
        font-size: 1.15rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
    }

    .eventhub-tile-primary-detail {
        font-size: 0.65rem;
        color: #868e96;
    }

    .eventhub-tile-metrics {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        border-top: 1px solid #e9ecef;
        padding-top: 0.4rem;
    }

    .eventhub-tile-metric {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        font-size: 0.7rem;
    }

    .eventhub-tile-metric-label {
        color: #868e96;
    }

    .eventhub-tile-metric-value {
        font-weight: 600;
        color: #343a40;
        font-variant-numeric: tabular-nums;
    }

    /* ── Runtime stats (left) + request stats (right) row ── */
    .eventhub-bottom-row {
        display: flex;
        flex-direction: row;
        gap: 1rem;
        align-items: stretch;
        min-height: 0;
        flex: 1 1 auto;
    }

    .eventhub-bottom-row .eventhub-stats-shell {
        flex: 0 0 18rem;
        max-width: 18rem;
        align-self: flex-start;
    }

    .eventhub-bottom-row .eventhub-stats-grid {
        grid-template-columns: 1fr;
    }

    .eventhub-bottom-row .eventhub-history-shell {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Smaller font for the request statistics on the right. */
