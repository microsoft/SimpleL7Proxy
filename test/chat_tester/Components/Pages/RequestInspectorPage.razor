@page "/inspect"
@namespace chat_tester.Components.Pages
@rendermode InteractiveServer
@using chat_tester.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Request inspector</PageTitle>

<InspectorPageShell Title="Request inspector"
                    Tagline="@PageTagline"
                    HistoryEntries="HistoryEntries"
                    SelectedHistoryEntryId="@SelectedHistoryEntryId"
                    HistorySource="@HistorySource"
                    AutoCollapse="@AutoCollapse"
                    AutoCollapseChanged="SetAutoCollapseAsync"
                    ShowRequestPanel="@ShowRequestPanel"
                    RequestPanelVisibleChanged="SetRequestPanelVisibleAsync"
                    ShowResultPanel="@ShowChatResponsePanel"
                    ResultPanelVisibleChanged="SetChatResponsePanelVisibleAsync"
                    ShowRawPanel="@ShowRawResponsePanel"
                    RawPanelVisibleChanged="SetRawResponsePanelVisibleAsync">
        <div class="row g-4 request-workspace @WorkspaceStateCss">
            <div class="col-12 request-col @(ShouldHideRequestPanel ? "d-none" : string.Empty)">
                <TestFormPanel @ref="FormPanel"
                               Settings="AuthSettings"
                               UserSettings="UserSettings"
                               HeaderSettings="HeaderSettings"
                               InitialServerBaseUrl="@InitialServerBaseUrl"
                               DisplayState="@RequestPanelState"
                               DisplayStateChanged="SetRequestPanelStateAsync"
                               HeaderSubtitle="Send a chat request."
                               CardTitle="Request inspector"
                               SubmitLabel="Send single chat call"
                               BusyLabel="Sending..."
                               IsBusy="@IsRunning"
                               OnSubmit="SendSingleChatCallAsync">
                    <PromptContent>
                        <RequestBodyPanel @ref="BodyPanel"
                                          Rows="@RequestTextAreaRows"
                                          InitialBody="@InitialRequestBody"
                                          InitialEndpointPath="@InitialEndpointPath"
                                          InitialContentType="@InitialContentType" />
                    </PromptContent>
                </TestFormPanel>
            </div>

            <div class="col-12 response-col @(ShouldHideResponseColumn ? "d-none" : string.Empty)">
                <div class="response-stack">
                    <div class="card shadow-sm chat-card search-host @ChatResponseCardStateCss @(ShouldHideChatResponse ? "d-none" : string.Empty)">
                        <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
                            <span class="fw-semibold">Chat response</span>
                            <div class="d-flex flex-wrap align-items-center justify-content-end gap-3">
                                @if (!IsChatResponseMinimized)
                                {
                                    <TextResponseFormatOption CurrentFormat="@ResponseFormat" CurrentFormatChanged="SetResponseFormat" />
                                    <MarkdownResponseFormatOption CurrentFormat="@ResponseFormat" CurrentFormatChanged="SetResponseFormat" />
                                    <HtmlResponseFormatOption CurrentFormat="@ResponseFormat" CurrentFormatChanged="SetResponseFormat" />
                                }
                                <PanelDisplayToggle State="@ChatResponseState"
                                                    StateChanged="SetChatResponseStateAsync"
                                                    AriaLabel="Toggle chat response full screen" />
                            </div>
                        </div>
                        @if (!IsChatResponseMinimized)
                        {
                            <div class="card-body @(IsChatResponseFullscreen ? "overflow-auto" : string.Empty)">
                                <div class="row g-3 h-100">
                                    <div class="col-12 col-xl-9">
                                        @if (ResponseFormat == ResponseDisplayFormat.Html)
                                        {
                                            <div @ref="ChatResponseRef" class="response-rendered border rounded p-3 bg-white" style="@(IsChatResponseFullscreen ? "max-height: calc(100vh - 145px);" : "max-height: 360px;") overflow-y: auto;">@((MarkupString)DisplayResponse)</div>
                                        }
                                        else if (ResponseFormat == ResponseDisplayFormat.Markdown)
                                        {
                                            <div @ref="ChatResponseRef" class="response-rendered border rounded p-3 bg-white" style="@(IsChatResponseFullscreen ? "max-height: calc(100vh - 145px);" : "max-height: 360px;") overflow-y: auto;">@((MarkupString)MarkdownToHtml(DisplayResponse))</div>
                                        }
                                        else
                                        {
                                            <pre @ref="ChatResponseRef" class="bg-dark text-light p-3 rounded mb-0" style="white-space: pre-wrap; @(IsChatResponseFullscreen ? "max-height: calc(100vh - 145px);" : "max-height: 360px;") overflow-y: auto;">@DisplayResponse</pre>
                                        }
                                    </div>
                                    <div class="col-12 col-xl-3">
                                        <ResponseMetricsPanel Status="@ResponseMetrics.Status"
                                                              ContentType="@ResponseMetrics.ContentType"
                                                              TimeToFirstByte="@ResponseMetrics.TimeToFirstByte"
                                                              Duration="@ResponseMetrics.Duration"
                                                              Chunks="@ResponseMetrics.Chunks"
                                                              TotalBytes="@ResponseMetrics.TotalBytes"
                                                              ShowTokenMetrics="true"
                                                              InputTokens="@ResponseMetrics.InputTokens"
                                                              OutputTokens="@ResponseMetrics.OutputTokens"
                                                              ReasoningTokens="@ResponseMetrics.ReasoningTokens"
                                                              CachedInputTokens="@ResponseMetrics.CachedInputTokens"
                                                              TotalTokens="@ResponseMetrics.TotalTokens" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="raw-panel-shell @(ShouldHideRawResponse ? "d-none" : string.Empty)">
                        <RawResponsePanel StatusMessage="@StatusMessage"
                                          ActiveTab="@ActiveResponseTab"
                                          ActiveTabChanged="SetActiveResponseTabAsync"
                                          DisplayState="@RawResponseState"
                                          DisplayStateChanged="SetRawResponseStateAsync"
                                          RequestHeadersText="@RequestHeadersText"
                                          ResponseHeadersText="@ResponseHeadersText"
                                          RequestBodyDisplay="@RequestBodyDisplay"
                                          ObservedResponse="@ObservedResponse"
                                          HasProxyError="@HasProxyError" />
                    </div>
                </div>
            </div>
        </div>
</InspectorPageShell>
