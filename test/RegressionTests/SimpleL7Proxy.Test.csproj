<Project Sdk="MSTest.Sdk/3.7.0">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Displays error on console in addition to the log file. Note that this feature comes with a performance impact.
      For more information, visit https://learn.microsoft.com/dotnet/core/testing/unit-testing-platform-integration-dotnet-test#show-failure-per-test
      -->
    <TestingPlatformShowTestsFailure>true</TestingPlatformShowTestsFailure>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Framework\ReportRenderer\**\*.cs" />
    <ProjectReference Include="..\..\src\SimpleL7Proxy\SimpleL7Proxy.csproj" />
    <ProjectReference Include="..\..\src\MetricsServer\MetricsServer.csproj" />
    <ProjectReference Include="..\..\src\CompanionApp\CompanionApp.csproj" />
    <ProjectReference Include="Framework\ReportRenderer\RegressionReportRenderer.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\LLMSimulator\PolicyStressState.cs" Link="PolicyStressState.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="configs\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\src\SimpleL7Proxy\config.json" Link="configs\profile-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\nullserver\Python\stream_server.py" Link="tools\stream_server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyProxyRuntime" AfterTargets="Build">
    <MSBuild Projects="../../src/SimpleL7Proxy/SimpleL7Proxy.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_ProxyTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_ProxyRuntimeDirectory>@(_ProxyTargetPath->'%(RootDir)%(Directory)')</_ProxyRuntimeDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_ProxyRuntimeFile Include="$(_ProxyRuntimeDirectory)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ProxyRuntimeFile)"
          DestinationFiles="@(_ProxyRuntimeFile->'$(OutDir)proxy-runtime/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
