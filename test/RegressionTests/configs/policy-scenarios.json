      }
    },
    {
      "name": "api-key-is-cleared-before-no-auth-backend",
      "model": "policy-auth",
      "priorityKey": "high",
      "a": { "delayMs": 0, "status": 500, "body": "json-error" },
      "b": { "delayMs": 0, "status": 200, "body": "openai" },
      "expected": {
        "status": 200,
        "backendAttempts": 2,
        "requiredLog": ["Using SIM-A", "\"X-Sim-Has-Api-Key\":[\"true\"]", "Using SIM-B", "\"X-Sim-Has-Api-Key\":[\"false\"]"],
        "forbiddenLog": []
      }
    },
    {
      "name": "streaming-200-is-terminal",
      "model": "policy-stream",
      "priorityKey": "high",
      "a": { "delayMs": 0, "status": 200, "body": "sse" },
      "b": { "delayMs": 0, "status": 500, "body": "json-error" },
      "expected": {
        "status": 200,
        "backendAttempts": 1,
        "requiredLog": ["Using SIM-A"],
        "forbiddenLog": ["Using SIM-B"]
      }
    }
  ]
}
