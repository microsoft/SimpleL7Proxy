<fragment>
	<!-- Retry exhausted without a usable response (e.g. all backends throttled after a timeout).
	     The <retry> exits gracefully to outbound instead of on-error, so anything reaching here
	     with no unthrottled backend left is that leaked case: return 429 instead of a bare 500. -->
	<choose>
		<when condition="@(((context.Response?.StatusCode ?? 0) < 200 || (context.Response?.StatusCode ?? 0) >= 400) && context.Variables.GetValueOrDefault<int>("unThrottledBackends", -1) == 0)">
			<set-status code="429" reason="No Backends Available" />
			<set-body>@(new JObject { { "statusCode", 429 }, { "statusReason", "No Backends Available" } }.ToString(Newtonsoft.Json.Formatting.None))</set-body>
			<!-- Request the proxy requeue when configured, matching the in-retry and on-error 429 paths -->
			<choose>
				<when condition="@(((JObject)context.Variables["initObj"]).Value<bool>("RequeueAllowed"))">
					<set-header name="S7PREQUEUE" exists-action="override">
						<value>true</value>
					</set-header>
				</when>
			</choose>
			<set-header name="retry-after-ms" exists-action="override">
				<value>@(context.Variables.GetValueOrDefault<int>("sleepDuration", 10000).ToString())</value>
			</set-header>
		</when>
	</choose>
	<set-header name="TOKENPROCESSOR" exists-action="override">
		<value>@(context.Variables.GetValueOrDefault<JObject>("selectedBackend", null)?.Value<string>("tokenProcessor") ?? "DefaultStream")</value>
	</set-header>
	<set-header name="@((string)context.Variables["AffinityHeaderName"])" exists-action="override">
		<value>@(context.Variables.GetValueOrDefault<JObject>("selectedBackend", null)?.Value<string>("affinity") ?? "")</value>
	</set-header>
	<set-header name="x-Backend-Attempts" exists-action="override">
		<value>@(context.Variables.GetValueOrDefault<int>("backendCallCounter", 0).ToString())</value>
	</set-header>
	<set-header name="x-Backend-Label" exists-action="override">
		<value>@(context.Variables.GetValueOrDefault<JObject>("selectedBackend", null)?.Value<string>("label") ?? "")</value>
	</set-header>
	<set-header name="@((string)context.Variables["PolicyCycleCounterHeaderName"])" exists-action="override">
		<value>@(context.Variables.GetValueOrDefault<int>("PolicyCycleCounter", 0).ToString())</value>
	</set-header>
	<set-header name="backendLog" exists-action="override">
		<value>@{
			string dbgStr = ((JObject)context.Variables["initObj"]).Value<string>("DbgStr") ?? "";
			JArray actLog = (JArray)((JObject)context.Variables["initObj"])["activityLog"];
			string result = string.Join(" | ", actLog.Select(entry =>
				((JObject)entry).Value<string>("Elapsed") + "s " + ((JObject)entry).Value<string>("message")
			));
			result = string.IsNullOrEmpty(dbgStr) ? result : dbgStr + " | " + result;
			return result.Length > 4000 ? result.Substring(0, 4000) + "..." : result;
		}</value>
	</set-header>
	<set-header name="X-Policy-LastError" exists-action="override">
		<value>@{
			JArray errArr = (JArray)((JObject)context.Variables["initObj"])["lastPolicyError"];
			return errArr.Count == 0 ? "" : errArr.ToString(Newtonsoft.Json.Formatting.None);
		}</value>
	</set-header>
</fragment>